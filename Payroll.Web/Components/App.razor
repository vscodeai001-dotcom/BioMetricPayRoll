@using Microsoft.AspNetCore.Components.Authorization

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/cosmo/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="app.css" />

    <link rel="stylesheet"
          href="dark-theme.css" />

    <link rel="stylesheet"
          href="Payroll.Web.styles.css" />

    <link rel="icon"
          type="image/png"
          href="favicon.png" />

    <HeadOutlet />

</head>


<body>

    @*
       IMPORTANT: Routes.razor owns the single interactive Router.
       Do not add another Router here. A duplicate Router can leave stale
       PageTitle values in <head> after client-side navigation.
    *@

    <Routes @rendermode="InteractiveServer" />


    @* ============================================================
       BOOTSTRAP
       ============================================================ *@

    <script src="bootstrap/bootstrap.bundle.min.js"></script>


    @* ============================================================
       CUSTOM JAVASCRIPT
       IMPORTANT:
       themeInterop.js is loaded before Blazor starts.
       ============================================================ *@

    <script src="/js/themeInterop.js?v=20260913-title-sync-v1"></script>

    @* ============================================================
       EMPLOYEE GPS TRACKER
       IMPORTANT:
       Must load BEFORE Blazor starts so components can call it.
       ============================================================ *@

    <script src="/js/employee-gps-tracker.js?v=20260906-persistent-gps"></script>

    @* ============================================================
       REAL-TIME ATTENDANCE REFRESH
       ============================================================ *@

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.21/signalr.min.js"></script>
    <script src="/js/attendance-refresh.js?v=20260908-enterprise-realtime-v2"></script>


    @* ============================================================
       BLAZOR SERVER
       ============================================================ *@

    <script src="_framework/blazor.web.js?v=20260906-session-fix"></script>

    <div id="components-reconnect-modal" aria-live="polite">
        <span class="components-reconnect-show">Connection interrupted. Reconnecting...</span>
        <span class="components-reconnect-failed">Connection lost. Reload to continue.</span>
        <span class="components-reconnect-rejected">Session ended. Reload to sign in again.</span>
    </div>

    <script>
        (function () {
            function keepServerAwake() {
                fetch('/health', {
                    method: 'GET',
                    cache: 'no-store',
                    credentials: 'same-origin'
                }).catch(function () { });
            }

            keepServerAwake();
            window.setInterval(keepServerAwake, 20000);
            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) keepServerAwake();
            });
        })();
    </script>


    @* ============================================================
       BOOTSTRAP DROPDOWN INITIALIZATION
       ============================================================ *@

    <script>

        window.initBootstrapDropdowns = () => {

            var dropdownElementList =
                [].slice.call(
                    document.querySelectorAll(
                        '[data-bs-toggle="dropdown"]'
                    )
                );


            dropdownElementList.forEach(
                function (dropdownToggleEl) {

                    if (
                        typeof bootstrap !== 'undefined' &&
                        bootstrap.Dropdown
                    ) {

                        bootstrap.Dropdown.getOrCreateInstance(
                            dropdownToggleEl
                        );

                    }

                }
            );

        };


        document.addEventListener(
            'DOMContentLoaded',
            function () {

                if (
                    typeof window.initBootstrapDropdowns ===
                    'function'
                ) {

                    window.initBootstrapDropdowns();

                }

            }
        );

    </script>


    @* ============================================================
       PRINT FUNCTION
       ============================================================ *@

    <script>

        window.PrintElement = (elementId) => {

            const elementToPrint =
                document.getElementById(elementId);


            if (!elementToPrint) {

                console.error(
                    'Element to print not found:',
                    elementId
                );

                return;
            }


            elementToPrint.classList.add(
                'printable-payslip'
            );


            window.print();


            setTimeout(() => {

                elementToPrint.classList.remove(
                    'printable-payslip'
                );

            }, 500);

        };

    </script>


    @* ============================================================
       FILE DOWNLOAD
       ============================================================ *@

    <script>

        window.downloadFileFromStream =
            async (
                fileName,
                contentStreamReference
            ) => {

                const arrayBuffer =
                    await contentStreamReference.arrayBuffer();


                const blob =
                    new Blob([arrayBuffer]);


                const url =
                    URL.createObjectURL(blob);


                const anchorElement =
                    document.createElement('a');


                anchorElement.href =
                    url;


                anchorElement.download =
                    fileName ?? '';


                anchorElement.click();


                anchorElement.remove();


                URL.revokeObjectURL(url);

            };

    </script>

</body>

</html>