</style>

@code {
    [Parameter]
    public int EmployeeId { get; set; }

    [Parameter]
    public string EmployeeName { get; set; } = "You";

    private bool isModuleEnabled;
    private bool isBiometricAttendanceEnabled;
    private bool isAutomaticGeofencePunchingEnabled;
    private bool isProcessing;
    private bool isRefreshingLocation;
    private bool isPunching;
    private bool isLiveTracking;
    private bool hasLocation;
    private bool isWithinRadius;
    private bool mapNeedsUpdate;
    private bool mapReady;
    private bool mapRetryScheduled;
    private bool locationSettingsLoaded;
    private bool automaticTrackingCompleted;
    private bool automaticTrackingStarting;
    private readonly CancellationTokenSource automaticLocationCts = new();
    private int automaticTrackingAttempts;
    private int radius = 100;
    private double distanceMeters;
    private double officeLatitude;
    private double officeLongitude;
    private double currentLatitude;
    private double currentLongitude;
    private double accuracyMeters;
    private string? locationMessage;
    private string processingMessage = "Locating you...";
    private DateTime? lastLocationTime;
    private DateTime? liveSessionStartedAt;

    private string mapId => $"geo-map-{EmployeeId}";

    private bool CanPunch =>
        hasLocation &&
        isWithinRadius &&
        !isPunching &&
        !isRefreshingLocation &&
        !isBiometricAttendanceEnabled &&
        !isAutomaticGeofencePunchingEnabled;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var company = await db.CompanySettings
                .AsNoTracking()
                .FirstOrDefaultAsync(s => s.SettingID == 1);

            isModuleEnabled = await GeoAccess.IsEnabledAsync();

            var features = await db.FeatureSettings
                .AsNoTracking()
                .FirstOrDefaultAsync(f => f.Id == 1);

            isAutomaticGeofencePunchingEnabled =
                features?.EnableGeoFencing == true &&
                features.EnableAutomaticGeofencePunching;

            // Physical biometric is the highest-priority attendance source.
            // Existing single/dual mode semantics determine whether the
            // machine is active.
            isBiometricAttendanceEnabled =
                features != null &&
                (features.EnableDualAttendance || !features.EnableGeoFencing);

            radius = company?.GeoRadiusMeters ?? 100;
            officeLatitude = company?.OfficeLatitude ?? 0;
            officeLongitude = company?.OfficeLongitude ?? 0;

            if (isModuleEnabled && (officeLatitude == 0 || officeLongitude == 0))
            {
                locationMessage = "Office location is not configured.";
            }
        }
        catch (Exception ex)
        {
            isModuleEnabled = false;
            locationMessage = "Unable to load location settings.";
            Console.Error.WriteLine($"MobilePunchWidget initialization error: {ex}");
        }

        locationSettingsLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (locationSettingsLoaded &&
            isModuleEnabled &&
            EmployeeId > 0 &&
            !automaticTrackingCompleted &&
            !automaticTrackingStarting)
        {
            await EnsureAutomaticTrackingAsync();
            return;
        }

        if (!hasLocation || !mapNeedsUpdate)
            return;

        mapNeedsUpdate = false;

        try
        {
            var mapUpdated = await JSRuntime.InvokeAsync<bool>(
                "updateGeoMap",
                mapId,
                officeLatitude,
                officeLongitude,
                currentLatitude,
                currentLongitude,
                radius,
                isWithinRadius,
                EmployeeName,
                liveSessionStartedAt.HasValue ? liveSessionStartedAt.Value.ToUniversalTime().ToString("O") : null,
                accuracyMeters);

            mapReady = mapUpdated;
            mapNeedsUpdate = !mapUpdated;

            if (!mapUpdated)
                ScheduleMapRetry();
        }
        catch (Exception ex)
        {
            mapNeedsUpdate = true;
            mapReady = false;
            Console.Error.WriteLine($"Map update failed: {ex}");
            ScheduleMapRetry();
        }

        if (mapReady)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ScheduleMapRetry()
    {
        if (mapRetryScheduled)
            return;

        mapRetryScheduled = true;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(2000, automaticLocationCts.Token);

                if (hasLocation && !mapReady)
                    await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Map retry failed: {ex}");
            }
            finally
            {
                mapRetryScheduled = false;
            }
        });
    }

    private async Task EnsureAutomaticTrackingAsync()
    {
        if (!locationSettingsLoaded ||
            !isModuleEnabled ||
            EmployeeId <= 0 ||
            automaticTrackingCompleted ||
            automaticTrackingStarting ||
            automaticLocationCts.IsCancellationRequested)
        {
            return;
        }

        automaticTrackingStarting = true;

        try
        {
            while (!automaticLocationCts.IsCancellationRequested && !hasLocation)
            {
                automaticTrackingAttempts++;

                isProcessing = true;
                processingMessage =
                    automaticTrackingAttempts == 1
                        ? "Locating you..."
                        : "Waiting for device location...";

                locationMessage = null;

                await InvokeAsync(StateHasChanged);

                try
                {
                    var coords =
                        await GetBestAvailableLocationAsync();

                    await UpdateDistance(coords);

                    if (hasLocation)
                    {
                        await StartLiveTracking();

                        if (isLiveTracking)
                        {
                            automaticTrackingCompleted = true;
                            break;
                        }
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex)
                {
                    if (ex is TaskCanceledException || ex.InnerException is TaskCanceledException)
                    {
                        locationMessage = "Waiting for device location...";
                    }
                    else
                    {
                        Console.Error.WriteLine(
                            $"Automatic GPS attempt {automaticTrackingAttempts} failed: {ex.Message}");
                    }

                    isLiveTracking = false;

                    /*
                     * Permission denial cannot be fixed by repeatedly
                     * calling geolocation. Stop only in that case.
                     *
                     * For temporary GPS/location-service failures,
                     * continue retrying automatically.
                     */
                    if (IsLocationPermissionDenied(ex))
                    {
                        locationMessage = GetLocationErrorMessage(ex);
                        automaticTrackingCompleted = true;
                        break;
                    }

                    locationMessage =
                        "Waiting for device location...";
                }
                finally
                {
                    isProcessing = false;
                    await InvokeAsync(StateHasChanged);
                }

                if (!hasLocation &&
                    !automaticLocationCts.IsCancellationRequested)
                {
                    /*
                     * No manual "Check My Location" button is required.
                     * The component keeps trying automatically.
                     *
                     * This is intentionally a modest interval so the
                     * browser is not hammered with GPS requests.
                     */
                    try
                    {
                        await Task.Delay(
                            TimeSpan.FromSeconds(5),
                            automaticLocationCts.Token);
                    }
                    catch (TaskCanceledException)
                    {
                        break;
                    }
                }
            }
        }
        finally
        {
            isProcessing = false;
            automaticTrackingStarting = false;

            if (!hasLocation &&
                !automaticLocationCts.IsCancellationRequested &&
                !automaticTrackingCompleted)
            {
                locationMessage =
                    "Waiting for device location...";
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<LocationData> GetBestAvailableLocationAsync()
    {
        // EmployeeGpsTracker is the single persistent browser GPS watcher.
        // Reuse its newest fix first so this dashboard widget does not
        // compete with another getCurrentPosition request.
        try
        {
            var persistent = await JSRuntime.InvokeAsync<LocationData?>(
                "getPersistentEmployeeGpsLocation",
                300000);

            if (persistent != null &&
                double.IsFinite(persistent.Latitude) &&
                double.IsFinite(persistent.Longitude))
            {
                return persistent;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Persistent GPS fix was not available. Falling back to browser GPS: {ex.Message}");
        }

        return await JSRuntime.InvokeAsync<LocationData>("getCoords");
    }

    private async Task RefreshLocation()
    {
        if (isRefreshingLocation || isPunching)
            return;

        isRefreshingLocation = true;
        isProcessing = true;
        processingMessage = "Locating you...";
        locationMessage = null;

        try
        {
            var coords = await GetBestAvailableLocationAsync();
            await UpdateDistance(coords);

            if (hasLocation)
            {
                await StartLiveTracking();
                automaticTrackingCompleted = true;
            }
        }
        catch (Exception ex)
        {
            hasLocation = false;
            mapNeedsUpdate = false;
            mapReady = false;
            locationMessage = GetLocationErrorMessage(ex);
        }
        finally
        {
            isProcessing = false;
            isRefreshingLocation = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AllowLocationAsync()
    {
        if (isRefreshingLocation || isPunching)
            return;

        isRefreshingLocation = true;
        isProcessing = true;
        processingMessage = "Allowing location...";
        locationMessage = null;

        try
        {
            /*
             * This is intentionally a direct geolocation call from a
             * user click. Browsers are most willing to display their
             * native location permission prompt when the request is
             * associated with a user gesture.
             */
            var coords =
                await GetBestAvailableLocationAsync();

            await UpdateDistance(coords);

            if (hasLocation)
            {
                await StartLiveTracking();
                automaticTrackingCompleted = true;
            }
        }
        catch (Exception ex)
        {
            hasLocation = false;
            mapNeedsUpdate = false;
            mapReady = false;
            locationMessage = GetLocationErrorMessage(ex);
        }
        finally
        {
            isProcessing = false;
            isRefreshingLocation = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task StartLiveTracking()
    {
        isLiveTracking = true;

        if (!liveSessionStartedAt.HasValue)
        {
            liveSessionStartedAt = DateTime.Now;
        }

        return Task.CompletedTask;
    }

    private Task StopLiveTracking()
    {
        isLiveTracking = false;
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task UpdateLiveLocation(LocationData coords)
    {
        try
        {
            await UpdateDistance(coords);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Live location update failed: {ex}");
        }
    }

    [JSInvokable]
    public async Task LocationWatchError(string message)
    {
        Console.Error.WriteLine($"GPS watch message: {message}");

        if (!hasLocation)
        {
            locationMessage = message;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task AttemptPunch()
    {
        if (isPunching || isRefreshingLocation || !hasLocation)
            return;

        isPunching = true;
        isProcessing = true;
        processingMessage = "Checking your location...";
        locationMessage = null;

        try
        {
            var coords = await GetBestAvailableLocationAsync();

            await UpdateDistance(coords);

            if (!hasLocation)
            {
                toastService.ShowError("Unable to determine your location.");
                return;
            }

            if (!isLiveTracking)
            {
                await StartLiveTracking();
            }

            await InvokeAsync(StateHasChanged);

            /*
             * IMPORTANT:
             *
             * EmployeeGpsTracker owns the persistent GPS session.
             * Therefore we retrieve the session currently registered
             * in LiveLocationStore instead of generating a new GUID.
             */
            var liveLocation = LiveLocationStore.Get(EmployeeId);

            if (liveLocation == null ||
                liveLocation.SessionId == Guid.Empty)
            {
                toastService.ShowError(
                    "Live GPS session is not active. Please wait for GPS tracking to start and try again.");

                return;
            }

            var activeSessionId = liveLocation.SessionId;

            var result = await GeoService.ProcessMobilePunchAsync(
                EmployeeId,
                coords.Latitude,
                coords.Longitude,
                coords.Accuracy,
                activeSessionId);

            if (result.Success)
            {
                toastService.ShowSuccess(result.Message);
            }
            else
            {
                toastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            locationMessage = GetLocationErrorMessage(ex);
            toastService.ShowError($"Punch Failed: {locationMessage}");
        }
        finally
        {
            isPunching = false;
            isProcessing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateDistance(LocationData coords)
    {
        if (coords == null)
        {
            hasLocation = false;
            mapNeedsUpdate = false;
            mapReady = false;
            locationMessage = "No GPS coordinates were received.";
            return;
        }

        var distanceResult = await GeoService.GetDistanceFromOfficeAsync(
            coords.Latitude,
            coords.Longitude);

        if (!distanceResult.Success)
        {
            hasLocation = false;
            mapNeedsUpdate = false;
            mapReady = false;
            locationMessage = distanceResult.Message;
            return;
        }

        hasLocation = true;
        currentLatitude = coords.Latitude;
        currentLongitude = coords.Longitude;
        accuracyMeters = NormalizeAccuracy(coords.Accuracy);
        distanceMeters = distanceResult.DistanceMeters;
        radius = distanceResult.AllowedRadiusMeters;
        isWithinRadius = distanceResult.IsWithinAllowedRadius;
        lastLocationTime = DateTime.Now;
        locationMessage = null;
        mapNeedsUpdate = true;

        await SyncLiveGpsToServiceAsync(coords);
    }

    private async Task SyncLiveGpsToServiceAsync(LocationData coords)
    {
        if (coords == null || EmployeeId <= 0 || !hasLocation)
            return;

        try
        {
            var liveLocation = LiveLocationStore.Get(EmployeeId);
            Guid sessionId = liveLocation?.SessionId ?? Guid.Empty;

            if (sessionId == Guid.Empty)
            {
                try
                {
                    var sIdStr = await JSRuntime.InvokeAsync<string>(
                        "getOrCreateEmployeeGpsSessionId",
                        "payroll_employee_gps_session_id",
                        EmployeeId);

                    if (Guid.TryParse(sIdStr, out var parsedGuid) && parsedGuid != Guid.Empty)
                    {
                        sessionId = parsedGuid;
                    }
                }
                catch
                {
                    sessionId = Guid.NewGuid();
                }
            }

            if (sessionId == Guid.Empty)
            {
                sessionId = Guid.NewGuid();
            }

            await GeoService.UpdateGpsSessionAsync(
                EmployeeId,
                sessionId,
                coords.Latitude,
                coords.Longitude,
                NormalizeAccuracy(coords.Accuracy),
                distanceMeters,
                radius,
                isWithinRadius,
                DateTime.UtcNow,
                allowSessionRecovery: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to sync live GPS from widget: {ex.Message}");
        }
    }

    private TimeSpan GetLiveDuration()
    {
        if (!liveSessionStartedAt.HasValue)
            return TimeSpan.Zero;

        return DateTime.Now - liveSessionStartedAt.Value;
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours:00}:{duration.Minutes:00}:{duration.Seconds:00}";
        }

        return $"{duration.Minutes:00}:{duration.Seconds:00}";
    }

    private static double NormalizeAccuracy(double accuracy)
    {
        if (double.IsNaN(accuracy) ||
            double.IsInfinity(accuracy) ||
            accuracy < 0)
        {
            return 0;
        }

        return accuracy;
    }

    private static string FormatAccuracy(double accuracy)
    {
        if (accuracy <= 0)
            return "Unknown";

        return accuracy < 1000
            ? $"±{accuracy:F0} m"
            : $"±{accuracy / 1000:F2} km";
    }

    private string FormatDistance(double meters)
    {
        return meters < 1000
            ? $"{meters:F0} m"
            : $"{meters / 1000:F2} km";
    }

    private static bool IsLocationPermissionDenied(Exception ex)
    {
        var message = ex.Message ?? string.Empty;

        return message.Contains(
                   "permission was denied",
                   StringComparison.OrdinalIgnoreCase)
            || message.Contains(
                   "permission denied",
                   StringComparison.OrdinalIgnoreCase)
            || message.Contains(
                   "access was denied",
                   StringComparison.OrdinalIgnoreCase);
    }

    private string GetLocationErrorMessage(Exception ex)
    {
        var message = ex.Message ?? string.Empty;

        if (message.Contains("denied", StringComparison.OrdinalIgnoreCase))
            return "Please allow BioMetric to access your location.";

        if (message.Contains("permission", StringComparison.OrdinalIgnoreCase))
            return "Please allow location access in your browser.";

        if (message.Contains("unavailable", StringComparison.OrdinalIgnoreCase))
            return "Your location is currently unavailable.";

        if (message.Contains("timed out", StringComparison.OrdinalIgnoreCase) ||
            message.Contains("timeout", StringComparison.OrdinalIgnoreCase))
            return "Location request timed out. Please try again.";

        if (message.Contains("circuit", StringComparison.OrdinalIgnoreCase))
            return "Connection to the server was interrupted. Please refresh the page.";

        return "Unable to determine your location. Please try again.";
    }

    public async ValueTask DisposeAsync()
    {
        /*
         * DO NOT stop EmployeeGpsTracker here.
         *
         * EmployeeGpsTracker belongs to the employee layout and owns
         * the persistent browser GPS watcher.
         *
         * This component is allowed to disappear when the employee
         * navigates to:
         *
         * My Attendance
         * My Leave History
         * Payslips
         * Salary Advances
         * Regularization
         *
         * The employee must remain LIVE.
         */

        try
        {
            automaticLocationCts.Cancel();
        }
        catch
        {
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("destroyGeoMap", mapId);
        }
        catch
        {
        }

        automaticLocationCts.Dispose();
    }

    public class LocationData
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double Accuracy { get; set; }
    }
    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var company = await db.CompanySettings
                .AsNoTracking()
                .FirstOrDefaultAsync(s => s.SettingID == 1);

            var enabled = await GeoAccess.IsEnabledAsync();

            var features = await db.FeatureSettings
                .AsNoTracking()
                .FirstOrDefaultAsync(f => f.Id == 1);

            isAutomaticGeofencePunchingEnabled =
                features?.EnableGeoFencing == true &&
                features.EnableAutomaticGeofencePunching;
            isBiometricAttendanceEnabled =
                features != null &&
                (features.EnableDualAttendance || !features.EnableGeoFencing);

            radius = company?.GeoRadiusMeters ?? 100;
            officeLatitude = company?.OfficeLatitude ?? 0;
            officeLongitude = company?.OfficeLongitude ?? 0;
            isModuleEnabled = enabled;

            if (isModuleEnabled && (officeLatitude == 0 || officeLongitude == 0))
            {
                locationMessage = "Office location is not configured.";
            }
            else if (!isModuleEnabled)
            {
                locationMessage = null;
            }
            else if (hasLocation)
            {
                /*
                 * Re-evaluate the current GPS fix immediately against the
                 * newly saved office/radius settings. Do not wait for the
                 * browser to produce another GPS callback.
                 */
                var currentDistanceResult =
                    await GeoService.GetDistanceFromOfficeAsync(
                        currentLatitude,
                        currentLongitude);

                if (currentDistanceResult.Success)
                {
                    distanceMeters =
                        currentDistanceResult.DistanceMeters;

                    radius =
                        currentDistanceResult.AllowedRadiusMeters;

                    isWithinRadius =
                        currentDistanceResult.IsWithinAllowedRadius;
                }
            }

            mapNeedsUpdate = hasLocation && isModuleEnabled;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime mobile punch settings refresh failed: {ex}");
        }
    }

