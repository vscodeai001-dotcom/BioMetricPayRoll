<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh"
                           OnGeoSettingsChanged="HandleRealtimeRefresh" />

@using global::Payroll.Web.Services
@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject GeoLocationService GeoService
@inject IToastService toastService
@inject GeoFeatureAccessService GeoAccess
@inject IDbContextFactory<AppDbContext> DbFactory

@if (isModuleEnabled)
{
    <div class="card border-0 shadow-sm bg-primary bg-opacity-10 mb-3">
        <div class="card-body text-center p-3">
            <h6 class="text-primary fw-bold mb-2">
                <i class="bi bi-geo-alt-fill me-1"></i>
                Remote Punch
            </h6>

            @if (isProcessing)
            {
                <div class="py-3">
                    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                    <span class="ms-2 small text-primary">@processingMessage</span>

                    @if (automaticTrackingAttempts > 1)
                    {
                        <div class="small text-muted mt-1">Trying again...</div>
                    }
                </div>
            }
            else
            {
                @if (hasLocation)
                {
                    <div class="geo-map-panel mb-3">
                        <div class="geo-map-title">
                            <i class="bi bi-signpost-2 me-1"></i>
                            Office to Your Location
                        </div>

                        <div class="geo-map-wrapper">
                            <div id="@mapId" class="geo-real-map"></div>

                            @if (!mapReady)
                            {
                                <div class="geo-map-loading">
                                    <div class="text-muted small">
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        Loading map...
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="geo-map-legend">
                            <span>
                                <i class="bi bi-building-fill text-secondary"></i>
                                Office
                            </span>
                            <span>
                                <i class="bi bi-geo-alt-fill text-primary"></i>
                                You
                            </span>
                        </div>

                        <div class="geo-summary">
                            <div class="geo-summary-item">
                                <span>Distance</span>
                                <strong>@FormatDistance(distanceMeters)</strong>
                            </div>

                            <div class="geo-summary-divider"></div>

                            <div class="geo-summary-item">
                                <span>Allowed</span>
                                <strong>@radius m</strong>
                            </div>

                            <div class="geo-summary-divider"></div>

                            <div class="geo-summary-item">
                                <span>GPS Accuracy</span>
                                <strong>@FormatAccuracy(accuracyMeters)</strong>
                            </div>
                        </div>

                        @if (isWithinRadius)
                        {
                            <div class="geo-status geo-status-success">
                                <i class="bi bi-check-circle-fill me-1"></i>
                                Within allowed range
                            </div>
                        }
                        else
                        {
                            <div class="geo-status geo-status-danger">
                                <i class="bi bi-x-circle-fill me-1"></i>
                                Outside allowed range
                            </div>
                        }

                        @if (isLiveTracking)
                        {
                            <div class="geo-live-session">
                                <div class="geo-live-status">
                                    <span class="geo-live-dot"></span>
                                    Live location active
                                </div>

                                @if (liveSessionStartedAt.HasValue)
                                {
                                    <div class="geo-session-info">
                                        <span>
                                            Started @liveSessionStartedAt.Value.ToString("HH:mm:ss")
                                        </span>
                                        <span>
                                            Duration @FormatDuration(GetLiveDuration())
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="geo-live-session geo-live-warning">
                                <div class="geo-live-status geo-status-warning-text">
                                    <span class="geo-live-dot geo-live-dot-warning"></span>
                                    Location tracking inactive
                                </div>
                            </div>
                        }

                        @if (lastLocationTime.HasValue)
                        {
                            <div class="geo-updated">
                                <i class="bi bi-clock me-1"></i>
                                Last GPS update @lastLocationTime.Value.ToString("HH:mm:ss")
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(locationMessage))
                {
                    <div class="geo-location-message mb-3">
                        <i class="bi bi-geo-alt me-1"></i>
                        @locationMessage
                    </div>

                    @* 
                       Automatic location request is attempted first.
                       This single fallback button exists only when the
                       browser requires a user gesture to request location.
                       Clicking it directly calls the native browser
                       geolocation permission flow.
                    *@
                    @if (!hasLocation)
                    {
                        <button class="btn btn-outline-primary w-100 fw-semibold mb-3"
                                @onclick="AllowLocationAsync"
                                disabled="@isRefreshingLocation">

                            @if (isRefreshingLocation)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Allowing Location...</span>
                            }
                            else
                            {
                                <i class="bi bi-geo-alt-fill me-2"></i>
                                <span>ALLOW LOCATION</span>
                            }
                        </button>
                    }
                }

                @if (!isBiometricAttendanceEnabled && !isAutomaticGeofencePunchingEnabled)
                {
                    <button class="btn btn-primary w-100 fw-bold shadow-sm"
                            @onclick="AttemptPunch"
                            disabled="@(!CanPunch)">

                        @if (isPunching)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-fingerprint me-2"></i>
                            <span>PUNCH IN / OUT</span>
                        }
                    </button>
                }

                <small class="d-block mt-2 text-muted" style="font-size:.75em;">
                    @if (isLiveTracking)
                    {
                        <span>GPS tracking is active. </span>
                    }
                    else if (hasLocation)
                    {
                        <span>Location available. </span>
                    }
                    else
                    {
                        <span>Location access required. </span>
                    }

                    Max range: @radius m.
                </small>
            }
        </div>
    </div>
}

