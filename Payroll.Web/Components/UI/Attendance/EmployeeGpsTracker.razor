@using global::Payroll.Web.Services
@using global::Payroll.Web.Hubs
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.SignalR
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject GeoLocationService GeoService
@inject GeoFeatureAccessService GeoAccess
@inject IHubContext<AttendanceRefreshHub> AttendanceHub
@inject AuthenticationStateProvider AuthState
@inject FirebaseRealtimeService FirebaseRealtime
@inject FirebaseEmployeeManagementService FirebaseEmployees
@inject NavigationManager Navigation

@*
    Persistent employee GPS tracker.

    SESSION RULES
    -------------
    1. Normal navigation does NOT create a new GPS session.
    2. Circuit disposal does NOT end the database GPS session.
    3. Browser tab close does NOT immediately mark the employee logged out.
    4. The database session is allowed to timeout naturally.
    5. A real logout explicitly ends the GPS session.
    6. If an old browser session has already timed out, a new SessionId
       is automatically generated.
    
    LIVE STATUS
    -----------
    0-30 sec       LIVE
    30-120 sec     STALE
    120+ sec       OFFLINE
*@

@code
{
    [Parameter]
    public int EmployeeId { get; set; }

    private bool disposed;
    private bool started;
    private bool starting;
    private bool trackingEnabled;
    private bool sessionStarted;
    private bool sessionInvalidatedByOtherDevice;

    private DotNetObjectReference<EmployeeGpsTracker>? dotNetReference;

    private Guid liveLocationSessionId;
    private string? firebaseUid;
    private string? browserDeviceId;
    private CancellationTokenSource? sessionMonitorCts;
    private CancellationTokenSource? trackingConfigCts;

    private DateTime lastHistorySavedUtc =
        DateTime.MinValue;

    private int locationHistoryIntervalSeconds = 60;
    

    /*
     * TRACKER FOR CIRCUIT RECONNECT DETECTION
     * 
     * When a Blazor circuit reconnects, the component is reinitialized
     * but we should not create a new GPS session if one already exists
     * in the browser's localStorage.
     */
    private int reconnectAttempts = 0;
    private const int MaxReconnectAttempts = 3;

    /*
     * IMPORTANT:
     *
     * localStorage is used instead of sessionStorage.
     *
     * sessionStorage disappears when the browser tab is closed.
     *
     * localStorage allows:
     *
     * Close tab
     *     ↓
     * Open tab again
     *     ↓
     * Same browser GPS SessionId
     *
     * The key is employee-specific so different employees on the
     * same device do not accidentally share the same GPS session.
     */
    private const string BrowserSessionStorageKey =
        "payroll_employee_gps_session_id";

    protected override async Task OnInitializedAsync()
    {
        if (EmployeeId <= 0)
        {
            trackingEnabled = false;
            return;
        }

        try
        {
            trackingEnabled =
                await GeoAccess.IsEnabledAsync();

            var authState = await AuthState.GetAuthenticationStateAsync();
            firebaseUid = authState.User.FindFirst("FirebaseUid")?.Value;
            browserDeviceId = authState.User.FindFirst("BioMetric-Employee-Device")?.Value;

            if (string.IsNullOrWhiteSpace(firebaseUid) && EmployeeId > 0)
            {
                var userEmail = authState.User.Identity?.Name ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                if (!string.IsNullOrWhiteSpace(userEmail))
                {
                    firebaseUid = await FirebaseEmployees.GetFirebaseAuthUidByEmailAsync(userEmail);
                }
            }

            if (!trackingEnabled)
            {
                Console.WriteLine(
                    $"Employee GPS disabled. EmployeeId={EmployeeId}");
            }

            if (!string.IsNullOrWhiteSpace(firebaseUid))
            {
                sessionMonitorCts = new CancellationTokenSource();
                _ = MonitorSessionAsync(sessionMonitorCts.Token);

                trackingConfigCts = new CancellationTokenSource();
                await LoadTrackingConfigurationAsync();
                _ = MonitorTrackingConfigurationAsync(trackingConfigCts.Token);
            }
        }
        catch (Exception ex)
        {
            trackingEnabled = false;

            Console.Error.WriteLine(
                $"Employee GPS feature check failed. " +
                $"EmployeeId={EmployeeId}. Error={ex}");
        }
    }

    private async Task MonitorSessionAsync(CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(firebaseUid)) return;

        try
        {
            await FirebaseRealtime.StreamGlobalChangesAsync(
                $"employee_sessions/{firebaseUid}",
                async (path, data, token) =>
                {
                    if (disposed || token.IsCancellationRequested) return;

                    if (data == null || data.Value.ValueKind == System.Text.Json.JsonValueKind.Null)
                    {
                        // Session was explicitly deleted
                        await ForceLogoutAsync("Your session was ended by the administrator.");
                        return;
                    }

                    string? activeDevice = null;
                    var normalizedPath = (path ?? "/").Trim('/');

                    if (normalizedPath == "" || normalizedPath == "/")
                    {
                        // Full object snapshot
                        if (data.Value.ValueKind == System.Text.Json.JsonValueKind.Object &&
                            data.Value.TryGetProperty("deviceId", out var deviceProp))
                        {
                            activeDevice = deviceProp.GetString();
                        }
                    }
                    else if (normalizedPath.Equals("deviceId", StringComparison.OrdinalIgnoreCase))
                    {
                        // Direct property update
                        if (data.Value.ValueKind == System.Text.Json.JsonValueKind.String)
                        {
                            activeDevice = data.Value.GetString();
                        }
                    }

                    if (activeDevice != null)
                    {
                        // If the active device is not a WEB_BROWSER starting with our ID prefix,
                        // it means another device (Android or another Web session) logged in.
                        if (!string.IsNullOrWhiteSpace(browserDeviceId) &&
                            !activeDevice.StartsWith("WEB_BROWSER_" + browserDeviceId.Substring(0, Math.Min(8, browserDeviceId.Length))))
                        {
                            await ForceLogoutAsync("This account is now active on another device.");
                        }
                    }
                },
                ct);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Employee session monitor failed: {ex.Message}");
        }
    }

    private async Task ForceLogoutAsync(string reason)
    {
        if (disposed) return;
        sessionInvalidatedByOtherDevice = true;

        await InvokeAsync(async () => {
            // SignalR notification for the UI to show a toast
            await AttendanceHub.Clients.All.SendAsync("SessionInvalidated", EmployeeId, reason);

            // Perform explicit logout redirect
            Navigation.NavigateTo("/Identity/Account/Logout?force=true", true);
        });
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (disposed ||
            !trackingEnabled ||
            EmployeeId <= 0 ||
            started ||
            starting)
        {
            return;
        }

        /*
         * ============================================================
         * AUTO-RESTART GPS WATCHER
         * ============================================================
         *
         * If the component is created but the GPS watcher hasn't
         * started, begin the startup process.
         *
         * This handles:
         * 1. Initial page load
         * 2. Circuit reconnect
         * 3. Page navigation that recreates the component
         */
        await StartTracking();
    }

    private async Task StartTracking()
    {
        if (disposed ||
            started ||
            starting ||
            !trackingEnabled ||
            EmployeeId <= 0 ||
            sessionInvalidatedByOtherDevice)
        {
            return;
        }

        starting = true;
        reconnectAttempts++;

        try
        {
            /*
             * Employee-specific browser session ID.
             *
             * This survives closing/reopening the tab.
             */
            var sessionIdText =
                await JSRuntime.InvokeAsync<string>(
                    "getOrCreateEmployeeGpsSessionId",
                    BrowserSessionStorageKey,
                    EmployeeId);

            if (!Guid.TryParse(
                    sessionIdText,
                    out liveLocationSessionId) ||
                liveLocationSessionId == Guid.Empty)
            {
                Console.Error.WriteLine(
                    $"Invalid employee GPS session ID. " +
                    $"EmployeeId={EmployeeId}");

                return;
            }

            // Ensure the database GPS session is created/active and bound in Firebase
            sessionStarted = await GeoService.StartGpsSessionAsync(
                EmployeeId,
                liveLocationSessionId);

            dotNetReference ??=
                DotNetObjectReference.Create(this);

            /*
             * Bind the persistent browser GPS watcher only after the
             * authoritative database session is ready. If a previous browser
             * watcher is already alive, this call rebinds it to the current
             * session ID without changing the existing watcher lifecycle.
             */
            var gpsStarted =
                await JSRuntime.InvokeAsync<bool>(
                    "bindPersistentEmployeeGps",
                    dotNetReference,
                    EmployeeId,
                    liveLocationSessionId.ToString("D"),
                    "/api/employee-location/update");

            if (!gpsStarted)
            {
                Console.Error.WriteLine(
                    $"Browser GPS watcher could not start. " +
                    $"EmployeeId={EmployeeId}");

                return;
            }

            Console.WriteLine(
                $"GPS watcher initialized. " +
                $"EmployeeId={EmployeeId}, " +
                $"SessionId={liveLocationSessionId}, " +
                $"ReconnectAttempt={reconnectAttempts}");

            started = true;

            Console.WriteLine(
                $"Employee GPS started. " +
                $"EmployeeId={EmployeeId}, " +
                $"SessionId={liveLocationSessionId}, " +
                $"DatabaseSessionStarted={sessionStarted}, " +
                $"ReconnectAttempt={reconnectAttempts}");
        }
        catch (JSException ex)
        {
            Console.Error.WriteLine(
                $"Employee GPS JavaScript error. " +
                $"EmployeeId={EmployeeId}. " +
                $"ReconnectAttempt={reconnectAttempts}. " +
                $"Error={ex}");
        }
        catch (InvalidOperationException ex)
        {
            Console.Error.WriteLine(
                $"Employee GPS circuit error. " +
                $"EmployeeId={EmployeeId}. " +
                $"ReconnectAttempt={reconnectAttempts}. " +
                $"Error={ex}");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Employee GPS start failed. " +
                $"EmployeeId={EmployeeId}. " +
                $"ReconnectAttempt={reconnectAttempts}. " +
                $"Error={ex}");
        }
        finally
        {
            starting = false;
        }
    }

    [JSInvokable]
    public async Task UpdatePersistentEmployeeLocation(
        LocationData coords)
    {
        if (disposed ||
            EmployeeId <= 0 ||
            coords == null)
        {
            return;
        }

        try
        {
            if (!double.IsFinite(coords.Latitude) ||
                !double.IsFinite(coords.Longitude))
            {
                return;
            }

            if (coords.Latitude < -90 ||
                coords.Latitude > 90 ||
                coords.Longitude < -180 ||
                coords.Longitude > 180)
            {
                return;
            }

            var accuracy =
                NormalizeAccuracy(
                    coords.Accuracy);

            var distanceResult =
                await GeoService.GetDistanceFromOfficeAsync(
                    coords.Latitude,
                    coords.Longitude);

            if (coords.IsOfflineCapture)
            {
                await GeoService.SaveLocationHistoryAsync(
                    EmployeeId,
                    liveLocationSessionId,
                    coords.Latitude,
                    coords.Longitude,
                    0,
                    0,
                    false,
                    accuracy,
                    coords.Timestamp,
                    "OfflineSync",
                    Guid.NewGuid());

                await GeoService.ReconcileHistoricalGeofencePointAsync(
                    EmployeeId,
                    liveLocationSessionId,
                    coords.Latitude,
                    coords.Longitude,
                    accuracy,
                    0,
                    0,
                    false,
                    coords.Timestamp);
                return;
            }

            /*
             * Temporary GPS/network/database problems do NOT
             * terminate the GPS session.
             */
            if (!distanceResult.Success)
            {
                Console.Error.WriteLine(
                    $"Employee GPS validation failed. " +
                    $"EmployeeId={EmployeeId}. " +
                    $"Message={distanceResult.Message}");

                return;
            }

            /*
             * Recover the database session if necessary.
             */
            if (!sessionStarted)
            {
                sessionStarted =
                    await GeoService.StartGpsSessionAsync(
                        EmployeeId,
                        liveLocationSessionId);

                if (!sessionStarted)
                {
                    Console.Error.WriteLine(
                        $"Unable to recover GPS database session. " +
                        $"EmployeeId={EmployeeId}");

                    return;
                }
            }

            /*
             * Persist the GPS update through the authoritative service.
             * The service validates the active database session before
             * touching LiveLocationStore, so a stale browser request cannot
             * resurrect a logged-out employee.
             */
            try
            {
                var sessionUpdated =
                    await GeoService.UpdateGpsSessionAsync(
                        EmployeeId,
                        liveLocationSessionId,
                        coords.Latitude,
                        coords.Longitude,
                        accuracy,
                        distanceResult.DistanceMeters,
                        distanceResult.AllowedRadiusMeters,
                        distanceResult.IsWithinAllowedRadius);

                if (!sessionUpdated)
                {
                    Console.Error.WriteLine(
                        $"GPS update rejected because the session is no longer active. " +
                        $"EmployeeId={EmployeeId}, SessionId={liveLocationSessionId}");
                    return;
                }
            }
            catch (Exception sessionEx)
            {
                Console.Error.WriteLine(
                    $"GPS session update failed. EmployeeId={EmployeeId}. Error={sessionEx}");
                return;
            }

            /*
             * Save detailed GPS history every 10 seconds.
             */
            var nowUtc =
                DateTime.UtcNow;

            if ((nowUtc - lastHistorySavedUtc).TotalSeconds >=
                locationHistoryIntervalSeconds)
            {
                lastHistorySavedUtc =
                    nowUtc;

                try
                {
                    await GeoService.SaveLocationHistoryAsync(
                        EmployeeId,
                        liveLocationSessionId,
                        coords.Latitude,
                        coords.Longitude,
                        distanceResult.DistanceMeters,
                        distanceResult.AllowedRadiusMeters,
                        distanceResult.IsWithinAllowedRadius,
                        accuracy);
                }
                catch (Exception historyEx)
                {
                    Console.Error.WriteLine(
                        $"GPS history save failed. " +
                        $"EmployeeId={EmployeeId}. " +
                        $"Error={historyEx}");
                }
            }

            // Broadcast only after the store and any scheduled history point
            // are ready for the admin panel to read.
            try
            {
                await AttendanceHub.Clients.All.SendAsync(
                    "LocationChanged",
                    new
                    {
                        EmployeeId = EmployeeId,
                        Latitude = coords.Latitude,
                        Longitude = coords.Longitude,
                        AccuracyMeters = accuracy,
                        DistanceMeters = distanceResult.DistanceMeters,
                        AllowedRadiusMeters = distanceResult.AllowedRadiusMeters,
                        IsWithinAllowedRadius = distanceResult.IsWithinAllowedRadius,
                        SessionId = liveLocationSessionId,
                        LastUpdatedUtc = DateTime.UtcNow
                    });
            }
            catch (Exception signalREx)
            {
                Console.Error.WriteLine(
                    $"GPS SignalR broadcast failed. " +
                    $"EmployeeId={EmployeeId}. " +
                    $"Error={signalREx}");
            }
        }
        catch (Exception ex)
        {
            /*
             * Never terminate GPS because of a temporary exception.
             */
            Console.Error.WriteLine(
                $"Persistent employee GPS update failed. " +
                $"EmployeeId={EmployeeId}. " +
                $"Error={ex}");
        }
    }

    [JSInvokable]
    public Task PersistentEmployeeGpsError(
        string message)
    {
        if (disposed)
        {
            return Task.CompletedTask;
        }

        Console.Error.WriteLine(
            $"Employee GPS watcher error. " +
            $"EmployeeId={EmployeeId}. " +
            $"Message={message}");

        /*
         * DO NOT end the database session.
         *
         * LIVE
         *   ↓
         * STALE
         *   ↓
         * OFFLINE
         *
         * If GPS resumes, the same session becomes LIVE again.
         */
        return Task.CompletedTask;
    }

    /*
     * ============================================================
     * REAL LOGOUT
     * ============================================================
     *
     * ONLY call this from the actual employee logout flow.
     */
    public async Task StopTracking()
    {
        if (disposed)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "stopPersistentEmployeeGps");
        }
        catch
        {
        }

        started = false;

        if (sessionStarted)
        {
            try
            {
                await GeoService.EndGpsSessionAsync(
                    EmployeeId,
                    liveLocationSessionId,
                    "LOGGED_OUT");
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(
                    $"GPS session logout update failed. " +
                    $"EmployeeId={EmployeeId}. " +
                    $"Error={ex}");
            }

            sessionStarted = false;
        }

        try
        {
            LiveLocationStore.Remove(
                EmployeeId,
                liveLocationSessionId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live GPS session removal failed. " +
                $"EmployeeId={EmployeeId}. " +
                $"Error={ex}");
        }

        /*
         * IMPORTANT:
         *
         * Clear the persistent browser GPS session ONLY on
         * an actual logout.
         */
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "clearEmployeeGpsSessionId",
                BrowserSessionStorageKey,
                EmployeeId);
        }
        catch
        {
        }
    }

    /*
     * ============================================================
     * CIRCUIT DISPOSAL
     * ============================================================
     *
     * IMPORTANT:
     *
     * Circuit disposal != logout.
     *
     * Therefore NEVER call EndGpsSessionAsync() here.
     */
    private async Task LoadTrackingConfigurationAsync()
    {
        if (string.IsNullOrWhiteSpace(firebaseUid)) return;
        var ownerUid = FirebaseRealtime.ResolveOwnerUid(firebaseUid, "Employee");
        var data = await FirebaseRealtime.GetGlobalRecordAsync(
            $"owners/{ownerUid}/tracking_configuration", CancellationToken.None);
        ApplyTrackingConfiguration(data);
    }

    private async Task MonitorTrackingConfigurationAsync(CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(firebaseUid)) return;
        try
        {
            var ownerUid = FirebaseRealtime.ResolveOwnerUid(firebaseUid, "Employee");
            await FirebaseRealtime.StreamGlobalChangesAsync(
                $"owners/{ownerUid}/tracking_configuration",
                async (_, data, token) =>
                {
                    if (disposed || token.IsCancellationRequested) return;
                    ApplyTrackingConfiguration(data);
                    await InvokeAsync(StateHasChanged);
                }, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { Console.Error.WriteLine($"Employee GPS tracking config monitor failed: {ex.Message}"); }
    }

    private void ApplyTrackingConfiguration(System.Text.Json.JsonElement? data)
    {
        var next = 30;
        if (data.HasValue && data.Value.ValueKind == System.Text.Json.JsonValueKind.Object &&
            data.Value.TryGetProperty("intervalSeconds", out var p))
        {
            if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetInt32(out var n)) next = n;
            else if (p.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(p.GetString(), out n)) next = n;
        }
        next = next switch { 30 or 60 or 120 or 300 => next, _ => 30 };
        if (next != locationHistoryIntervalSeconds)
        {
            locationHistoryIntervalSeconds = next;
            lastHistorySavedUtc = DateTime.MinValue;
        }
    }

    [JSInvokable]
    public Task UpdateEmployeeGpsSessionId(string sessionId)
    {
        if (disposed || !Guid.TryParse(sessionId, out var parsed) || parsed == Guid.Empty)
            return Task.CompletedTask;

        liveLocationSessionId = parsed;
        sessionStarted = true;
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (disposed)
        {
            return;
        }

        disposed = true;

        /*
         * IMPORTANT:
         *
         * Circuit disposal is NOT logout.
         *
         * Never stop the browser GPS watcher and never remove the
         * live location here. The browser-side tracker is deliberately
         * independent from the Blazor circuit and the HTTP GPS endpoint
         * continues to be the source of live-location updates.
         *
         * If this component is recreated after reconnect/navigation,
         * StartTracking() rebinds the new DotNet reference without
         * creating another watcher.
         */
        trackingConfigCts?.Cancel();
        trackingConfigCts?.Dispose();
        trackingConfigCts = null;

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "detachPersistentEmployeeGpsReference");
        }
        catch
        {
        }

        try
        {
            dotNetReference?.Dispose();
        }
        catch
        {
        }

        dotNetReference = null;

        started = false;
        starting = false;

        /*
         * DO NOT:
         *
         * EndGpsSessionAsync()
         *
         * clearEmployeeGpsSessionId()
         *
         * here.
         *
         * Those belong only to real logout.
         */
    }

    private static double NormalizeAccuracy(
        double accuracy)
    {
        if (double.IsNaN(accuracy) ||
            double.IsInfinity(accuracy) ||
            accuracy < 0)
        {
            return 0;
        }

        return accuracy;
    }

    public sealed class LocationData
    {
        public double Latitude { get; set; }

        public double Longitude { get; set; }

        public double Accuracy { get; set; }

        public DateTime Timestamp { get; set; } = DateTime.UtcNow;

        public bool IsOfflineCapture { get; set; }
    }
}