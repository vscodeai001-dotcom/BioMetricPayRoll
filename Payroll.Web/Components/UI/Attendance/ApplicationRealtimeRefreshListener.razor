@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime

@code {
    private DotNetObjectReference<ApplicationRealtimeRefreshListener>? _dotNetRef;
    private bool _registered;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        try
        {
            _dotNetRef =
                DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(
                "attendanceRefresh.registerApplication",
                _dotNetRef);

            _registered = true;
        }
        catch
        {
            // Realtime refresh is an enhancement. It must never break
            // normal page rendering when the circuit is unavailable.
        }
    }

    [JSInvokable("ApplicationDataChanged")]
    public Task ApplicationDataChanged(object? data = null)
    {
        // Page-level AttendanceRefreshListener instances own their existing
        // loaders. Do not call Navigation.Refresh here: that would reload the
        // browser instead of delivering realtime data through the current
        // component flow.
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;

        try
        {
            if (_registered && _dotNetRef != null)
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterApplication",
                    _dotNetRef);
            }
        }
        catch
        {
            // Circuit may already be disconnected.
        }
        finally
        {
            _registered = false;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
    }
}
