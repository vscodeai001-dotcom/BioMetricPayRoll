@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime

@code {
    [Parameter]
    public EventCallback OnApplicationDataChanged { get; set; }

    /// <summary>
    /// Optional entity filter. When set, only Firebase application events
    /// containing a matching Entity change reach this component.
    /// </summary>
    [Parameter]
    public string? EntityFilter { get; set; }

    private DotNetObjectReference<ApplicationRealtimeRefreshListener>? _dotNetRef;
    private bool _registered;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        try
        {
            _dotNetRef =
                DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(
                "attendanceRefresh.registerApplication",
                _dotNetRef,
                EntityFilter);

            _registered = true;
        }
        catch
        {
            // Realtime refresh is an enhancement. It must never break
            // normal page rendering when the circuit is unavailable.
        }
    }

    [JSInvokable("ApplicationDataChanged")]
    public async Task ApplicationDataChanged(object? data = null)
    {
        // Existing pages that do not provide a callback retain their current
        // behavior. Migrated Firebase-SSOT pages can opt into a targeted
        // realtime reload without a browser refresh.
        if (OnApplicationDataChanged.HasDelegate)
        {
            try
            {
                await InvokeAsync(() => OnApplicationDataChanged.InvokeAsync());
            }
            catch
            {
                // The realtime enhancement must never break the page circuit.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;

        try
        {
            if (_registered && _dotNetRef != null)
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterApplication",
                    _dotNetRef);
            }
        }
        catch
        {
            // Circuit may already be disconnected.
        }
        finally
        {
            _registered = false;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
    }
}
