@using Microsoft.JSInterop
@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

@code {
    private DotNetObjectReference<ApplicationRealtimeRefreshListener>? _dotNetRef;
    private bool _registered;
    private bool _disposed;
    private bool _refreshScheduled;
    private DateTime _lastRefreshUtc = DateTime.MinValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        try
        {
            _dotNetRef =
                DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(
                "attendanceRefresh.registerApplication",
                _dotNetRef);

            _registered = true;
        }
        catch
        {
            // Realtime refresh is an enhancement. It must never break
            // normal page rendering when the circuit is unavailable.
        }
    }

    [JSInvokable]
    public async Task ApplicationDataChanged(object? data = null)
    {
        if (_disposed)
            return;

        await InvokeAsync(() =>
        {
            if (_disposed)
                return Task.CompletedTask;

            // Coalesce bursts of CRUD writes so a bulk operation does not
            // create a refresh storm. The database remains the source of truth.
            if (_refreshScheduled)
                return Task.CompletedTask;

            var now = DateTime.UtcNow;
            if ((now - _lastRefreshUtc) < TimeSpan.FromMilliseconds(300))
                return Task.CompletedTask;

            _refreshScheduled = true;

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(200);
                    await InvokeAsync(() =>
                    {
                        if (!_disposed)
                        {
                            _lastRefreshUtc = DateTime.UtcNow;
                            Navigation.Refresh(false);
                        }
                    });
                }
                catch
                {
                    // A disconnected circuit must never break successful CRUD.
                }
                finally
                {
                    _refreshScheduled = false;
                }
            });

            return Task.CompletedTask;
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;

        try
        {
            if (_registered && _dotNetRef != null)
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterApplication",
                    _dotNetRef);
            }
        }
        catch
        {
            // Circuit may already be disconnected.
        }
        finally
        {
            _registered = false;
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
    }
}
