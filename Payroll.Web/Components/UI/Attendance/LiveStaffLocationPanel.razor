    private async Task RefreshLocations()
    {
        if (isRefreshing)
        {
            refreshQueued = true;
            return;
        }

        isRefreshing = true;

        try
        {
            do
            {
                refreshQueued = false;

                await using var db =
                    await DbFactory.CreateDbContextAsync();

                // EmployeeGpsSessions is the authoritative lifecycle source.
                // Only EndedAtUtc == null sessions are allowed into the live
                // collection, and only the newest active session per employee
                // can appear. This prevents stale SignalR packets from creating
                // phantom Live entries such as 3 Live / 2 employees.
                var employeeIds = employees
                    .Select(e => e.EmployeeID)
                    .ToList();

                // A GPS session is live only when it belongs to a current
                // employee and the session itself is still active in the
                // authoritative database. Device locks are intentionally NOT
                // required here: web-browser employees have a valid GPS
                // session even when their device-lock lifecycle is different
                // from the mobile bearer lifecycle. Abandoned mobile sessions
                // are closed by the dedicated mobile lease cleanup service.
                var activeSessions = await (
                    from session in db.EmployeeGpsSessions.AsNoTracking()
                    join employee in db.Employees.AsNoTracking()
                        on session.EmployeeId equals employee.EmployeeID
                    where employeeIds.Contains(session.EmployeeId)
                          && !employee.IsDeleted
                          && !session.EndedAtUtc.HasValue
                          && session.LastLatitude.HasValue
                          && session.LastLongitude.HasValue
                    orderby session.EmployeeId, session.StartedAtUtc descending
                    select session)
                    .ToListAsync();

                var snapshot = new List<LiveEmployeeLocation>();
                var seenEmployees = new HashSet<int>();

                foreach (var session in activeSessions)
                {
                    if (!seenEmployees.Add(session.EmployeeId))
                        continue;

                    snapshot.Add(new LiveEmployeeLocation
                    {
                        EmployeeId = session.EmployeeId,
                        Latitude = session.LastLatitude!.Value,
                        Longitude = session.LastLongitude!.Value,
                        AccuracyMeters = session.LastAccuracyMeters ?? 0,
                        SpeedMps = session.LastSpeedMps ?? 0,
                        MovementState = session.LastMovementState ?? "Stopped",
                        DistanceMeters = session.LastDistanceFromOfficeMeters ?? 0,
                        AllowedRadiusMeters = session.LastAllowedRadiusMeters ?? 0,
                        IsWithinAllowedRadius = session.LastIsWithinAllowedRadius ?? false,
                        LastUpdatedUtc = session.LastUpdateAtUtc,
                        SessionStartedUtc = session.StartedAtUtc,
                        SessionId = session.SessionId
                    });
                }

                locations.Clear();
                locations.AddRange(snapshot);

                // Initialize currentOfficeRadius from DB on first load/refresh
                var office = await GetOfficeLocation();
                currentOfficeRadius = office.Radius;

                lastRefresh = DateTime.Now;
                mapNeedsUpdate = true;

                await InvokeAsync(StateHasChanged);
            }
            while (refreshQueued && !disposed);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live location refresh failed: {ex}");
        }
        finally
        {
            isRefreshing = false;
        }
    }

    // ============================================================
    // GPS SESSION ENDED
    // ============================================================
    //
    // Logout/session-end is a lifecycle event, not a location update.
    // Remove the employee from the active list immediately and then
    // reload the authoritative DB snapshot so an old in-memory entry
    // can never remain visible.
    // ============================================================

    [JSInvokable]
    public async Task SessionEnded(object? data = null)
    {
        if (disposed)
            return;

        try
        {
            // Fast path: remove the employee from the local collection immediately
            // to stop tracking on the UI while the authoritative DB refresh runs.
            if (TryGetPayloadEmployeeId(data, out var employeeId))
            {
                locations.RemoveAll(x => x.EmployeeId == employeeId);
            }

            await RefreshLocations();

            mapNeedsUpdate = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Admin GPS session-end refresh failed: {ex}");
        }
    }


