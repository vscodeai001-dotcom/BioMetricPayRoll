    private void StartPlaybackPolling()
    {
        StopPlaybackPolling();

        if (!CanPlayback || disposed)
            return;

        playbackStateCts = new CancellationTokenSource();
        var token = playbackStateCts.Token;

        _ = PlaybackPollingLoopAsync(token);
    }

    private async Task PlaybackPollingLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && !disposed)
            {
                await Task.Delay(250, token);
                if (token.IsCancellationRequested || disposed)
                    break;

                await PollPlaybackState();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Admin route playback polling failed: {ex}");
        }
    }

    private async Task PollPlaybackState()
    {
        if (disposed)
            return;

        try
        {
            var state = await JSRuntime.InvokeAsync<PlaybackState?>(
                "getAdminHistoryPlaybackState",
                mapId);

            if (state == null)
                return;

            var nextIndex = Math.Clamp(
                state.Index,
                0,
                Math.Max(0, PlaybackPoints.Count - 1));

            var nextSpeed = state.Speed > 0
                ? state.Speed
                : playbackSpeed;

            var previousIndex = playbackIndex;
            var previousSpeed = playbackSpeed;
            var previousStatus = playbackStatus;

            playbackIndex = nextIndex;
            playbackSpeed = nextSpeed;

            if (state.Completed)
            {
                playbackStatus = "Completed";
                StopPlaybackPolling();
            }
            else if (state.Playing)
            {
                playbackStatus = "Playing";
            }
            else if (playbackStatus == "Playing")
            {
                playbackStatus = "Paused";
                StopPlaybackPolling();
            }

            /*
             * Do not rerender Blazor when the browser state has not changed.
             * This keeps the rest of the page visually stable while playback
             * continues.
             */
            if (previousIndex != playbackIndex ||
                Math.Abs(previousSpeed - playbackSpeed) > 0.0001 ||
                !String.Equals(previousStatus, playbackStatus, StringComparison.Ordinal))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSDisconnectedException)
        {
            StopPlaybackPolling();
        }
        catch
        {
            // The map can disappear during navigation/disposal. Playback
            // controls must never break the rest of the admin screen.
        }
    }

    private void StopPlaybackPolling()
    {
        try
        {
            playbackStateCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            playbackStateCts?.Dispose();
        }
        catch
        {
        }

        playbackStateCts = null;
    }

