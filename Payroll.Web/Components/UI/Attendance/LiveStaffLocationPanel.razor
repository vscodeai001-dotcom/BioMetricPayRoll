    private double HistoryTravelDistance
    {
        get
        {
            if (selectedHistory.Count < 2)
                return 0;

            var points = selectedHistory.OrderBy(x => x.RecordedAtUtc).ToList();
            double total = 0;

            for (int i = 1; i < points.Count; i++)
            {
                var previous = points[i - 1];
                var current = points[i];
                var seconds = (current.RecordedAtUtc - previous.RecordedAtUtc).TotalSeconds;
                var accuracyOk = current.AccuracyMeters <= 80 && previous.AccuracyMeters <= 80;
                var segment = CalculateDistance(previous.Latitude, previous.Longitude, current.Latitude, current.Longitude);
                var speed = seconds > 0 ? segment / seconds : 0;

                if (accuracyOk && seconds >= 1 && seconds <= 300 && segment >= 10 && speed <= 55.56)
                    total += segment;
            }

            return total;
        }
    }

    private TimeSpan HistoryMovingTime => SumHistoryTime("Moving");
    private TimeSpan HistoryStationaryTime => SumHistoryTime("Stopped");
    private TimeSpan HistoryIdleTime => SumHistoryTime("Idle");

    private TimeSpan SumHistoryTime(string state)
    {
        if (selectedHistory.Count < 2) return TimeSpan.Zero;
        var points = selectedHistory.OrderBy(x => x.RecordedAtUtc).ToList();
        double secondsTotal = 0;
        for (int i = 1; i < points.Count; i++)
        {
            var previous = points[i - 1];
            var current = points[i];
            var seconds = (current.RecordedAtUtc - previous.RecordedAtUtc).TotalSeconds;
            if (seconds >= 1 && seconds <= 300 &&
                string.Equals(previous.MovementState, state, StringComparison.OrdinalIgnoreCase))
                secondsTotal += seconds;
        }
        return TimeSpan.FromSeconds(secondsTotal);
    }

    private double HistoryMaxSpeedMps => selectedHistory.Count == 0
        ? 0
        : selectedHistory.Where(x => double.IsFinite(x.SpeedMps) && x.SpeedMps >= 0).Select(x => x.SpeedMps).DefaultIfEmpty().Max();

    private int HistoryStopCount
    {
        get
        {
            if (selectedHistory.Count < 2) return 0;
            var points = selectedHistory.OrderBy(x => x.RecordedAtUtc).ToList();
            var count = 0;
            var inStop = false;
            DateTime? stopStart = null;

            for (int i = 1; i < points.Count; i++)
            {
                var p = points[i - 1];
                var c = points[i];
                var seconds = (c.RecordedAtUtc - p.RecordedAtUtc).TotalSeconds;
                var distance = CalculateDistance(p.Latitude, p.Longitude, c.Latitude, c.Longitude);
                var stationary = seconds >= 1 && seconds <= 300 &&
                                 distance <= 50 &&
                                 string.Equals(p.MovementState, "Stopped", StringComparison.OrdinalIgnoreCase);

                if (stationary)
                {
                    if (!inStop)
                    {
                        inStop = true;
                        stopStart = p.RecordedAtUtc;
                    }
                }
                else if (inStop)
                {
                    if (stopStart.HasValue && (p.RecordedAtUtc - stopStart.Value).TotalMinutes >= 5) count++;
                    inStop = false;
                    stopStart = null;
                }
            }

            if (inStop && stopStart.HasValue && (points[^1].RecordedAtUtc - stopStart.Value).TotalMinutes >= 5) count++;
            return count;
        }
    }

    private static double CalculateDistance(
        double lat1,
        double lon1,
        double lat2,
        double lon2)
    {
        const double earthRadius =
            6371000;

        var r1 =
            lat1 * Math.PI / 180;

        var r2 =
            lat2 * Math.PI / 180;

        var dLat =
            (lat2 - lat1) *
            Math.PI / 180;

        var dLon =
            (lon2 - lon1) *
            Math.PI / 180;

        var a =
            Math.Sin(dLat / 2) *
            Math.Sin(dLat / 2) +
            Math.Cos(r1) *
            Math.Cos(r2) *
            Math.Sin(dLon / 2) *
            Math.Sin(dLon / 2);

        var c =
            2 *
            Math.Atan2(
                Math.Sqrt(a),
                Math.Sqrt(1 - a));

        return earthRadius * c;
    }


    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "•";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }


    private LiveEmployeeLocation? GetLocation(
        int employeeId) =>
        locations.FirstOrDefault(
