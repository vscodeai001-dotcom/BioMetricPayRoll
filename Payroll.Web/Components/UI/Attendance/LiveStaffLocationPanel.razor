    private static bool TryGetPayloadEmployeeId(
        object? data,
        out int employeeId)
    {
        employeeId = 0;

        if (data is not JsonElement json ||
            json.ValueKind != JsonValueKind.Object)
        {
            return false;
        }

        if (!json.TryGetProperty("EmployeeId", out var idProperty) &&
            !json.TryGetProperty("employeeId", out idProperty))
        {
            return false;
        }

        if (idProperty.ValueKind == JsonValueKind.Number && idProperty.TryGetInt32(out employeeId))
            return employeeId > 0;

        if (idProperty.ValueKind == JsonValueKind.String && int.TryParse(idProperty.GetString(), out employeeId))
            return employeeId > 0;

        return false;
    }

    private bool TryApplyLocationPayload(
        object? data,
        out bool needsAuthoritativeRefresh)
    {
        needsAuthoritativeRefresh = false;

        if (data is not JsonElement json ||
            json.ValueKind != JsonValueKind.Object)
        {
            return false;
        }

        if (!TryGetPayloadEmployeeId(data, out var employeeId))
        {
            return false;
        }

        if (!TryGetJsonDouble(json, "Latitude", out var latitude) ||
            !TryGetJsonDouble(json, "Longitude", out var longitude) ||
            !double.IsFinite(latitude) ||
            !double.IsFinite(longitude) ||
            latitude < -90 || latitude > 90 ||
            longitude < -180 || longitude > 180 ||
            (latitude == 0 && longitude == 0))
        {
            // Never let malformed GPS data reach the map.
            return false;
        }

        // The Web map must never trust an older cached IsWithinAllowedRadius
        // flag when a fresh coordinate arrives. Recalculate the presentation
        // state against the same current office/radius used to draw the circle.
        // This is display synchronization only. Attendance/geofence business
        // calculations remain in GeoLocationService.
        var calculatedDistance = 0d;
        var calculatedWithin = false;
        var hasCurrentOffice =
            double.IsFinite(currentOfficeLatitude) &&
            double.IsFinite(currentOfficeLongitude) &&
            currentOfficeLatitude != 0 &&
            currentOfficeLongitude != 0 &&
            currentOfficeRadius > 0;

        if (hasCurrentOffice)
        {
            calculatedDistance = CalculateDistanceMeters(
                latitude, longitude,
                currentOfficeLatitude, currentOfficeLongitude);
            calculatedWithin = calculatedDistance <= currentOfficeRadius + 1;
        }

        var sessionId = Guid.Empty;

        if (TryGetJsonString(json, "SessionId", out var sessionText))
        {
            Guid.TryParse(sessionText, out sessionId);
        }

        var payloadAtUtc = TryGetJsonDateTime(json, "Timestamp", out var payloadTime)
            ? payloadTime.ToUniversalTime()
            : (TryGetJsonDateTime(json, "LastUpdatedUtc", out var lastTime)
                ? lastTime.ToUniversalTime()
                : DateTime.UtcNow);

        var existingIndex = locations.FindIndex(
            x => x.EmployeeId == employeeId);

        if (existingIndex < 0)
        {
            // If the employee is not in the list (e.g. session just started),
            // add them immediately using the data in this packet.
            // This avoids waiting for a database refresh and fixes the lag.
            var newLocation = new LiveEmployeeLocation
            {
                EmployeeId = employeeId,
                Latitude = latitude,
                Longitude = longitude,
                AccuracyMeters = TryGetJsonDouble(json, "AccuracyMeters", out var accVal) ? accVal : 0,
                DistanceMeters = hasCurrentOffice ? calculatedDistance : (TryGetJsonDouble(json, "DistanceMeters", out var distVal) ? distVal : 0),
                AllowedRadiusMeters = hasCurrentOffice ? currentOfficeRadius : (TryGetJsonInt(json, "AllowedRadiusMeters", out var radVal) ? radVal : 0),
                IsWithinAllowedRadius = hasCurrentOffice ? calculatedWithin : (TryGetJsonBool(json, "IsWithinAllowedRadius", out var withinVal) ? withinVal : true),
                LastUpdatedUtc = payloadAtUtc,
                SessionStartedUtc = TryGetJsonDateTime(json, "SessionStartedUtc", out var startVal) ? startVal : DateTime.UtcNow,
                SessionId = sessionId
            };

            locations.Add(newLocation);

            // Do not wait for the SQL compatibility snapshot here. The
            // employee's live Firebase GPS packet must appear immediately.
            // The existing employee list can supply the display name when
            // available; otherwise the map safely uses its existing fallback.
            needsAuthoritativeRefresh = false;
            return true;
        }

        var existing = locations[existingIndex];

        // A delayed packet from an older GPS session or an older capture
        // timestamp must never move the marker backwards.
        if (payloadAtUtc < existing.LastUpdatedUtc)
        {
            return true;
        }

        // A delayed packet from an older GPS session must never overwrite
        // the current session's coordinates.
        if (sessionId != Guid.Empty &&
            existing.SessionId != Guid.Empty &&
            existing.SessionId != sessionId)
        {
            // Never decide which session is newer from packet arrival order.
            // Re-read EmployeeGpsSessions and accept only its newest active
            // session. This prevents an old/stale marker from reappearing.
            needsAuthoritativeRefresh = true;
            return false;
        }

        // LiveEmployeeLocation intentionally exposes init-only properties.
        // Replace the immutable snapshot item instead of mutating it.
        var updatedLocation = new LiveEmployeeLocation
        {
            EmployeeId = existing.EmployeeId,
            Latitude = latitude,
            Longitude = longitude,
            AccuracyMeters = TryGetJsonDouble(json, "AccuracyMeters", out var accuracyVal)
                ? accuracyVal
                : existing.AccuracyMeters,
            DistanceMeters = hasCurrentOffice
                ? calculatedDistance
                : (TryGetJsonDouble(json, "DistanceMeters", out var distanceVal)
                    ? distanceVal
                    : existing.DistanceMeters),
            AllowedRadiusMeters = hasCurrentOffice
                ? currentOfficeRadius
                : (TryGetJsonInt(json, "AllowedRadiusMeters", out var radiusVal)
                    ? radiusVal
                    : existing.AllowedRadiusMeters),
            IsWithinAllowedRadius = hasCurrentOffice
                ? calculatedWithin
                : (TryGetJsonBool(json, "IsWithinAllowedRadius", out var updatedWithinVal)
                    ? updatedWithinVal
                    : existing.IsWithinAllowedRadius),
            LastUpdatedUtc = TryGetJsonDateTime(json, "LastUpdatedUtc", out var updatedTimeVal)
                ? updatedTimeVal.ToUniversalTime()
                : (TryGetJsonDateTime(json, "Timestamp", out var tsVal) ? tsVal.ToUniversalTime() : DateTime.UtcNow),
            SessionStartedUtc = existing.SessionStartedUtc,
            SessionId = sessionId != Guid.Empty
                ? sessionId
                : existing.SessionId
        };

        locations[existingIndex] = updatedLocation;
        return true;
    }

    private static bool TryGetJsonDouble(
    JsonElement json,
    string name,
    out double value)
{
    value = 0;

    if (json.ValueKind != JsonValueKind.Object)
        return false;

    if (!json.TryGetProperty(name, out var property) &&
        !json.TryGetProperty(
            char.ToLowerInvariant(name[0]) + name[1..],
            out property))
    {
        return false;
    }

    if (property.ValueKind == JsonValueKind.Number &&
        property.TryGetDouble(out value))
    {
        return true;
    }

    if (property.ValueKind == JsonValueKind.String &&
        double.TryParse(
            property.GetString(),
            NumberStyles.Float | NumberStyles.AllowThousands,
            CultureInfo.InvariantCulture,
            out value))
    {
        return true;
    }

    return false;
}

    private static bool TryGetJsonBool(
    JsonElement json,
    string name,
    out bool value)
{
    value = false;

    if (json.ValueKind != JsonValueKind.Object)
        return false;

    if (!json.TryGetProperty(name, out var property) &&
        !json.TryGetProperty(
            char.ToLowerInvariant(name[0]) + name[1..],
            out property))
    {
        return false;
    }

    if (property.ValueKind == JsonValueKind.True ||
        property.ValueKind == JsonValueKind.False)
    {
        value = property.GetBoolean();
        return true;
    }

    if (property.ValueKind == JsonValueKind.String &&
        bool.TryParse(property.GetString(), out value))
    {
        return true;
    }

    return false;
}

   private static bool TryGetJsonInt(
    JsonElement json,
    string name,
    out int value)
{
    value = 0;

    if (json.ValueKind != JsonValueKind.Object)
        return false;

    if (!json.TryGetProperty(name, out var property) &&
        !json.TryGetProperty(
            char.ToLowerInvariant(name[0]) + name[1..],
            out property))
    {
        return false;
    }

    if (property.ValueKind == JsonValueKind.Number &&
        property.TryGetInt32(out value))
    {
        return true;
    }

    if (property.ValueKind == JsonValueKind.String &&
        int.TryParse(
            property.GetString(),
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out value))
    {
        return true;
    }

    return false;
}

   private static bool TryGetJsonString(
    JsonElement json,
    string name,
    out string value)
{
    value = string.Empty;

    if (json.ValueKind != JsonValueKind.Object)
        return false;

    if (!json.TryGetProperty(name, out var property) &&
        !json.TryGetProperty(
            char.ToLowerInvariant(name[0]) + name[1..],
            out property))
    {
        return false;
    }

    if (property.ValueKind != JsonValueKind.String)
        return false;

    value = property.GetString() ?? string.Empty;

    return !string.IsNullOrWhiteSpace(value);
}

    private static bool TryGetJsonDateTime(
        JsonElement json,
        string name,
        out DateTime value)
    {
        value = default;

        if (json.ValueKind != JsonValueKind.Object)
            return false;

        if (!json.TryGetProperty(name, out var property) &&
            !json.TryGetProperty(
                char.ToLowerInvariant(name[0]) + name[1..],
                out property))
        {
            return false;
        }

        if (property.ValueKind == JsonValueKind.Number && property.TryGetInt64(out var unixMs))
        {
            value = DateTimeOffset.FromUnixTimeMilliseconds(unixMs).UtcDateTime;
            return true;
        }

        if (property.ValueKind == JsonValueKind.String)
        {
            var text = property.GetString();
            if (string.IsNullOrWhiteSpace(text))
                return false;

            if (DateTime.TryParse(
                    text,
                    System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                    out value))
            {
                value = DateTime.SpecifyKind(value, DateTimeKind.Utc);
                return true;
            }
        }

        return false;
    }

