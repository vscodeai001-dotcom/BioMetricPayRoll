    public async ValueTask DisposeAsync()
    {
        if (disposed)
            return;

        disposed = true;

        /*
         * Stop UI timer.
         */
        try
        {
            refreshCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            refreshCts?.Dispose();
        }
        catch
        {
        }

        refreshCts = null;

        lock (liveEmployeeReconcileGate)
        {
            foreach (var cts in liveEmployeeReconcileCts.Values)
            {
                try { cts.Cancel(); } catch { }
                cts.Dispose();
            }
            liveEmployeeReconcileCts.Clear();
            liveEmployeeLastReconcileUtc.Clear();
        }

        /*
         * Stop playback polling.
         */
        try
        {
            playbackStateCts?.Cancel();
        }
        catch
        {
        }

        try
        {
            playbackStateCts?.Dispose();
        }
        catch
        {
        }

        playbackStateCts = null;

        /*
         * Unregister this component from SignalR.
         */
        if (liveLocationSignalRReference != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregister",
                    liveLocationSignalRReference);
            }
            catch
            {
            }

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterLocationHealth",
                    liveLocationSignalRReference);
            }
            catch { }

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterApplication",
                    liveLocationSignalRReference);
            }
            catch { }

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "unregisterAdminLiveLocationRealtime",
                    mapId);
            }
            catch { }

            liveLocationSignalRReference.Dispose();

            liveLocationSignalRReference = null;
        }

        /*
         * Stop historical playback.
         */
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "stopAdminHistoryPlayback",
                mapId);
        }
        catch
        {
        }

        /*
         * Destroy only this admin map.
         */
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "destroyAdminLiveStaffMap",
                mapId);
        }
        catch
        {
        }
    }


