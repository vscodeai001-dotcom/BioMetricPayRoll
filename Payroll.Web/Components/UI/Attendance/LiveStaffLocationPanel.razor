    private async Task SelectEmployee(int employeeId)
    {
        if (employeeId <= 0)
        {
            if (selectedEmployeeId > 0)
            {
                await StopPlayback();

                selectedEmployeeId = 0;

                selectedHistory.Clear();
                selectedPunchAudits.Clear();

                selectedPunchAudit = null;

                gpsSessionLookup.Clear();

                selectedPlaybackSessionId = null;

                playbackIndex = 0;
                playbackStatus = "Ready";

                mapNeedsUpdate = true;

                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        /*
         * ============================================================
         * TOGGLE BEHAVIOUR
         *
         * Clicking the currently selected employee again collapses
         * ALL employee details.
         *
         * Clicking another employee switches the expanded details
         * to that employee.
         * ============================================================
         */
        if (selectedEmployeeId == employeeId)
        {
            await StopPlayback();

            selectedEmployeeId = 0;

            selectedHistory.Clear();
            selectedPunchAudits.Clear();

            selectedPunchAudit = null;

            gpsSessionLookup.Clear();

            selectedPlaybackSessionId = null;

            playbackIndex = 0;
            playbackStatus = "Ready";

            mapNeedsUpdate = true;

            await InvokeAsync(StateHasChanged);

            return;
        }

        /*
         * ============================================================
         * SELECT NEW EMPLOYEE
         * ============================================================
         */

        await StopPlayback();

        selectedEmployeeId = employeeId;

        historyDate = DateTime.Today;
        punchAuditDate = historyDate;

        selectedPunchAudit = null;

        playbackIndex = 0;
        playbackStatus = "Ready";

        await LoadSelectedEmployeeHistory();

        punchAuditDate = historyDate;

        await LoadSelectedEmployeePunchAudits();

        mapNeedsUpdate = true;

        await InvokeAsync(StateHasChanged);
    }


    private async Task LoadSelectedEmployeeHistory()
    {
        playbackTablePage = 0;
        if (selectedEmployeeId <= 0)
        {
            selectedHistory.Clear();
            playbackPoints.Clear();

            selectedPlaybackSessionId = null;

            gpsSessionLookup.Clear();

            playbackIndex = 0;

            return;
        }

        historyLoading = true;

        try
        {
            await StopPlayback();

            selectedHistory =
    await LocationHistoryService
        .GetDateAsync(
            selectedEmployeeId,
            historyDate);

            await LoadPlaybackCaptureIntervalAsync();
            RebuildPlaybackPoints();

            /*
             * Load the real GPS session records corresponding
             * to the history points.
             *
             * This allows the session timeline to distinguish
             * an active session from an ended session instead
             * of showing every session as "Recorded".
             */
            /*
             * IMPORTANT:
             * The live map is driven by the current Firebase ACTIVE session.
             * LocationHistory can lag behind that stream, especially immediately
             * after Web/Android login. Therefore the timeline must load the real
             * GPS session records for the selected date, not only sessions that
             * already have persisted history points.
             *
             * This is read-only presentation reconciliation. It does not create,
             * end, or modify any GPS session.
             */
            var daySessions =
                await LocationHistoryService
                    .GetGpsSessionsAsync(
                        selectedEmployeeId,
                        historyDate);

            gpsSessionLookup =
                daySessions
                    .Where(x => x.SessionId != Guid.Empty)
                    .GroupBy(x => x.SessionId)
                    .Select(g => g.OrderByDescending(x => x.StartedAtUtc).First())
                    .ToDictionary(
                        x => x.SessionId);

            playbackIndex = 0;
            selectedPlaybackSessionId = null;

            playbackStatus =
                "Ready";

            mapNeedsUpdate = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Location history load failed: {ex}");

            selectedHistory.Clear();
            playbackPoints.Clear();

            gpsSessionLookup.Clear();
            selectedPlaybackSessionId = null;

            playbackIndex = 0;

            playbackStatus =
                "Ready";
        }
        finally
        {
            historyLoading = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }


    private async Task LoadSelectedEmployeePunchAudits()
    {
        if (selectedEmployeeId <= 0)
        {
            selectedPunchAudits.Clear();
            return;
        }

        punchAuditLoading = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            TimeZoneInfo indiaTimeZone;

            try
            {
                indiaTimeZone =
                    TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");
            }
            catch (TimeZoneNotFoundException)
            {
                indiaTimeZone =
                    TimeZoneInfo.FindSystemTimeZoneById("India Standard Time");
            }

            var indiaStart =
                DateTime.SpecifyKind(
                    punchAuditDate.Date,
                    DateTimeKind.Unspecified);

            var indiaEnd =
                DateTime.SpecifyKind(
                    punchAuditDate.Date.AddDays(1),
                    DateTimeKind.Unspecified);

            var startUtc =
                TimeZoneInfo.ConvertTimeToUtc(
                    indiaStart,
                    indiaTimeZone);

            var endUtc =
                TimeZoneInfo.ConvertTimeToUtc(
                    indiaEnd,
                    indiaTimeZone);

            selectedPunchAudits = await db.GeoPunchAudits
                .AsNoTracking()
                .Where(x => x.EmployeeId == selectedEmployeeId &&
                            x.PunchTimeUtc >= startUtc &&
                            x.PunchTimeUtc < endUtc)
                .OrderByDescending(x => x.PunchTimeUtc)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Geo punch audit load failed: {ex}");
            selectedPunchAudits.Clear();
        }
        finally
        {
            punchAuditLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshSelectedEmployeePunchAuditsSilently()
    {
        /*
         * No employee selected = nothing to refresh.
         */
        if (selectedEmployeeId <= 0)
            return;

        /*
         * Do not compete with a manual/date-change audit load.
         */
        if (punchAuditLoading)
            return;

        try
        {
            await using var db =
                await DbFactory.CreateDbContextAsync();

            var employeeId = selectedEmployeeId;
            

            var indiaTimeZone =
     TimeZoneInfo.FindSystemTimeZoneById(
         "Asia/Kolkata");

            var indiaStart =
                DateTime.SpecifyKind(
                    punchAuditDate.Date,
                    DateTimeKind.Unspecified);

            var indiaEnd =
                DateTime.SpecifyKind(
                    punchAuditDate.Date.AddDays(1),
                    DateTimeKind.Unspecified);

            var startUtc =
                TimeZoneInfo.ConvertTimeToUtc(
                    indiaStart,
                    indiaTimeZone);

            var endUtc =
                TimeZoneInfo.ConvertTimeToUtc(
                    indiaEnd,
                    indiaTimeZone);

            var latestAudits =
                await db.GeoPunchAudits
                    .AsNoTracking()
                    .Where(x =>
                        x.EmployeeId == employeeId &&
                        x.PunchTimeUtc >= startUtc &&
                        x.PunchTimeUtc < endUtc)
                    .OrderByDescending(x => x.PunchTimeUtc)
                    .ToListAsync();

            /*
             * Replace the displayed snapshot atomically.
             * This makes a newly inserted mobile punch appear in
             * the existing audit card without leaving the page.
             */
            selectedPunchAudits = latestAudits;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            /*
             * Background refresh must never break the page/circuit.
             */
            Console.Error.WriteLine(
                $"Real-time geo punch audit refresh failed: {ex}");
        }
    }


