       PREMIUM REALTIME MAP COMMAND UI
       Responsive presentation-only controls.
       ============================================================ */
    /* The old Leaflet zoom host is initialization-only. The real +/- control
       is relocated into the horizontal toolbar below the map. */
    .admin-map-bottom-controls {
        display:none !important;
        min-height:0 !important;
        height:0 !important;
        padding:0 !important;
        border:0 !important;
    }

    .payroll-premium-map-ui {
        position:relative;
        inset:auto;
        z-index:1200;
        width:100%;
        box-sizing:border-box;
        pointer-events:none;
        font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        background:transparent;
        overflow:visible;
    }
    .payroll-map-commandbar {
        position:relative;
        left:auto;
        right:auto;
        top:auto;
        bottom:auto;
        transform:none;
        display:flex;
        flex-direction:row;
        flex-wrap:nowrap;
        gap:7px;
        align-items:center;
        width:100%;
        max-width:100%;
        min-height:56px;
        box-sizing:border-box;
        padding:8px 12px;
        border:1px solid rgba(15,23,42,.10);
        border-radius:0;
        background:#f1f4f8;
        box-shadow:inset 0 1px 0 rgba(255,255,255,.80);
        pointer-events:auto;
        overflow-x:auto;
        overflow-y:hidden;
        scrollbar-width:thin;
        scrollbar-color:rgba(100,116,139,.55) transparent;
        white-space:nowrap;
    }
    .payroll-map-commandbar::-webkit-scrollbar { height:6px; }
    .payroll-map-commandbar::-webkit-scrollbar-track { background:transparent; }
    .payroll-map-commandbar::-webkit-scrollbar-thumb { background:rgba(100,116,139,.45); border-radius:999px; }
    .payroll-map-commandbar .payroll-map-search-wrap { display:none !important; }
    .payroll-map-commandbar .payroll-map-filter {
        display:block !important;
        flex:0 0 auto;
        width:auto;
        min-width:112px;
        height:38px;
        border-radius:10px;
        border:1px solid rgba(15,23,42,.12);
        background:#fff;
        color:#172238;
        padding:0 10px;
        font-size:.70rem;
        font-weight:700;
        outline:0;
    }
    .payroll-map-commandbar .payroll-map-tools-group {
