    private async Task SelectHistoryPoint(int historyIndex)
    {
        if (historyIndex < 0 || historyIndex >= selectedHistory.Count)
            return;

        var point = selectedHistory[historyIndex];
        var points = PlaybackPoints.ToList();
        var targetIndex = points.FindIndex(x => ReferenceEquals(x, point));

        if (targetIndex < 0)
        {
            targetIndex = points.FindIndex(
                x => x.SessionId == point.SessionId &&
                     x.RecordedAtUtc == point.RecordedAtUtc &&
                     x.Latitude == point.Latitude &&
                     x.Longitude == point.Longitude);
        }

        if (targetIndex < 0)
            return;

        StopPlaybackPolling();
        playbackIndex = targetIndex;
        playbackStatus = "Ready";

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "seekAdminHistoryPlayback",
                mapId,
                playbackIndex);
        }
        catch
        {
        }

        await InvokeAsync(StateHasChanged);
    }

