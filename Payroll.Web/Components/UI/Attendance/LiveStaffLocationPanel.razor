    private async Task AutoRefresh(
    CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(
                    TimeSpan.FromSeconds(5),
                    token);

                if (token.IsCancellationRequested)
                    break;

                // Live location membership and coordinates are pushed through
                // SignalR. Do not poll the database every few seconds because
                // that creates unnecessary redraws and makes the map feel noisy.
                // This timer only ages the UI status and advances playback.
                await InvokeAsync(StateHasChanged);

                await PollPlaybackState();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live staff UI timer failed: {ex}");
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && liveLocationSignalRReference == null && !disposed)
        {
            liveLocationSignalRReference =
                DotNetObjectReference.Create(this);

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.register",
                    liveLocationSignalRReference);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(
                    $"Unable to register admin live location SignalR listener: {ex}");
            }

            // Register to receive periodic location health updates (lightweight)
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.registerLocationHealth",
                    liveLocationSignalRReference);
            }
            catch { }

            // Register a browser-side fast path for GPS coordinates. This
            // animates the existing Leaflet marker immediately when a
            // LocationChanged SignalR event arrives, while Blazor continues
            // to own authoritative state and lifecycle decisions.
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "registerAdminLiveLocationRealtime",
                    mapId);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(
                    $"Unable to register admin live location realtime bridge: {ex}");
            }

            // The first snapshot can race an employee login. One additional
            // authoritative snapshot after the component is interactive makes
            // initial markers appear without requiring the Refresh button.
            try
            {
                await RefreshLocations();
            }
            catch { }
        }

        if (!mapNeedsUpdate)
            return;

        mapNeedsUpdate = false;

        try
        {
            var office = await GetOfficeLocation();

            var staff = locations
                .Select(x => new AdminMapLocation
                {
                    EmployeeId = x.EmployeeId,
                    Name = employees
                        .FirstOrDefault(e => e.EmployeeID == x.EmployeeId)
                        ?.Name ?? "Employee",
                    Latitude = x.Latitude,
                    Longitude = x.Longitude,
                    DistanceMeters = x.DistanceMeters,
                    AllowedRadiusMeters = x.AllowedRadiusMeters,
                    IsWithinAllowedRadius = x.IsWithinAllowedRadius,
                    AccuracyMeters = x.AccuracyMeters,
                    SpeedMps = x.SpeedMps,
                    MovementState = x.MovementState,
                    LastUpdatedUtc = x.LastUpdatedUtc,
                    SessionStartedUtc = x.SessionStartedUtc,
                    Status = GetLocationStatus(x).ToString()
                })
                .ToList();

            await JSRuntime.InvokeVoidAsync(
                "updateAdminLiveStaffMap",
                mapId,
                office.Latitude,
                office.Longitude,
                currentOfficeRadius,
                staff,
                selectedEmployeeId,
                isPlaybackFullscreen,
                liveLocationSignalRReference);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Admin live map update failed: {ex}");
        }
    }


