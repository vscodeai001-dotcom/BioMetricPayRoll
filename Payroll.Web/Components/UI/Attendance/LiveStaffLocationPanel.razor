    private string GetHistorySessionStatus(Guid sessionId)
    {
        if (sessionId == Guid.Empty)
            return "Ended";

        if (!gpsSessionLookup.TryGetValue(
                sessionId,
                out var session))
        {
            return "Ended";
        }

        if (session.EndedAtUtc.HasValue)
            return "Ended";

        // An employee can only have at most ONE active session.
        // If there are multiple sessions with EndedAtUtc == null, only the newest is Active.
        var newestActiveSessionId = gpsSessionLookup.Values
            .Where(x => x.EndedAtUtc == null)
            .OrderByDescending(x => x.StartedAtUtc)
            .Select(x => x.SessionId)
            .FirstOrDefault();

        return newestActiveSessionId == sessionId ? "Active" : "Ended";
    }

    private async Task LoadPlaybackCaptureIntervalAsync()
    {
        try
        {
            var ownerUid = FirebaseEmployees.OwnerUid;
            if (string.IsNullOrWhiteSpace(ownerUid))
                return;

            var data = await FirebaseRealtime.GetGlobalRecordAsync(
                $"owners/{ownerUid}/tracking_configuration",
                CancellationToken.None);

            var next = 30;
            if (data.HasValue &&
                data.Value.ValueKind == JsonValueKind.Object &&
                data.Value.TryGetProperty("intervalSeconds", out var interval))
            {
                if (interval.ValueKind == JsonValueKind.Number &&
                    interval.TryGetInt32(out var numeric))
                    next = numeric;
                else if (interval.ValueKind == JsonValueKind.String &&
                         int.TryParse(interval.GetString(), out var parsed))
                    next = parsed;
            }

            playbackCaptureIntervalSeconds = NormalizePlaybackCaptureInterval(next);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Unable to load playback capture interval: {ex}");
        }
    }

    private static int NormalizePlaybackCaptureInterval(int seconds) =>
        seconds switch
        {
            30 or 60 or 120 or 300 => seconds,
            _ => 60
        };

    private void RebuildPlaybackPoints()
    {
        playbackPoints.Clear();

        IEnumerable<EmployeeLocationHistory> source =
            selectedPlaybackSessionId.HasValue
                ? selectedHistory.Where(x => x.SessionId == selectedPlaybackSessionId.Value)
                : selectedHistory;

        var groups = source
            .Where(x => x.SessionId != Guid.Empty)
            .GroupBy(x => x.SessionId);

        foreach (var group in groups)
        {
            var ordered = group
                .OrderBy(GetPlaybackTimestamp)
                .ToList();

            if (ordered.Count == 0)
                continue;

           EmployeeLocationHistory? lastKept = null;

foreach (var point in ordered)
{
    if (lastKept == null ||
        GetPlaybackTimestamp(point) - GetPlaybackTimestamp(lastKept) >=
        TimeSpan.FromSeconds(playbackCaptureIntervalSeconds))
    {
        playbackPoints.Add(point);
        lastKept = point;
    }
}

            // Always preserve the true final recorded point so playback ends
            // at the employee's actual final location.
            var final = ordered[^1];
            if (!ReferenceEquals(lastKept, final))
                playbackPoints.Add(final);
        }

        // Histories should play chronologically across multiple sessions.
        playbackPoints.Sort(
            (a, b) => GetPlaybackTimestamp(a).CompareTo(GetPlaybackTimestamp(b)));
    }

    private static DateTime GetPlaybackTimestamp(EmployeeLocationHistory point)
    {
        var captured = DateTime.SpecifyKind(
            point.CapturedAtUtc,
            DateTimeKind.Utc);

        return captured != default
            ? captured
            : DateTime.SpecifyKind(
                point.RecordedAtUtc,
                DateTimeKind.Utc);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
        await LoadPlaybackCaptureIntervalAsync();

        /*
         * Firebase is the shared live-location wire for both Web and Android.
         * Keep the initial snapshot and the realtime stream on the same
         * owner-scoped tracking/live branch. SQL EmployeeGpsSessions remains
         * the compatibility/calculation store, but it is no longer the source
         * used to decide which employee marker the Web Admin map displays.
         */
        await RefreshLocations();

        firebaseLiveCts = new CancellationTokenSource();
        var ownerUid = FirebaseEmployees.OwnerUid;

        firebaseLiveStreamTask = StreamFirebaseLiveLocationsAsync(
            ownerUid,
            firebaseLiveCts.Token);

        firebaseCompanySettingsStreamTask = StreamFirebaseCompanySettingsAsync(
            ownerUid,
            firebaseLiveCts.Token);

        /*
         * Keep the existing timer for presentation aging/playback only.
         */
        refreshCts = new CancellationTokenSource();
        _ = AutoRefresh(refreshCts.Token);
    }

    private async Task StreamFirebaseLiveLocationsAsync(
        string ownerUid,
        CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(ownerUid))
            return;

        /*
         * Firebase REST SSE is the primary Web realtime channel. Unlike the
         * Android Firebase SDK, the REST stream does not automatically recreate
         * itself after an EOF/network interruption. Keep one reconnect loop here
         * so the Web Admin map always converges to the same owner-scoped
         * tracking/live snapshot without requiring the Refresh button.
         */
        while (!token.IsCancellationRequested && !disposed)
        {
            try
            {
                await FirebaseRealtime.StreamGlobalChangesAsync(
                    $"owners/{ownerUid.Trim()}/tracking/live",
                    async (path, data, ct) =>
                    {
                        if (disposed || ct.IsCancellationRequested)
                            return;

                        try
                        {
                            await ApplyFirebaseTrackingChange(path, data);
                        }
                        catch (OperationCanceledException) when (ct.IsCancellationRequested)
                        {
                        }
                        catch (Exception ex)
                        {
                            Console.Error.WriteLine(
                                $"Firebase live-location event failed: {ex}");
                        }
                    },
                    token);

                if (token.IsCancellationRequested || disposed)
                    break;

                // EOF without an exception. Reconcile before reconnecting.
                await RefreshLocations();
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                break;
            }
            catch (Exception ex)
            {
                if (IsConnectionReset(ex))
                {
                    Logger.LogInformation("Firebase stream reconnected after timeout.");
                }
                else
                {
                    Logger.LogWarning(ex, "Firebase owner live-location stream ended: {Message}", ex.Message);
                }
            }

            if (token.IsCancellationRequested || disposed)
                break;

            try
            {
                await Task.Delay(
                    TimeSpan.FromSeconds(2),
                    token);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                break;
            }
        }
    }

    private static bool IsConnectionReset(Exception? ex)
    {
        while (ex != null)
        {
            if (ex is SocketException sockEx &&
                (sockEx.SocketErrorCode == SocketError.ConnectionReset || sockEx.ErrorCode == 10054))
            {
                return true;
            }
            if (ex is System.IO.IOException ioEx &&
                (ioEx.Message.Contains("unexpected EOF", StringComparison.OrdinalIgnoreCase) ||
                 ioEx.Message.Contains("0 bytes", StringComparison.OrdinalIgnoreCase) ||
                 ioEx.Message.Contains("aborted", StringComparison.OrdinalIgnoreCase)))
            {
                return true;
            }
            if (ex.Message.Contains("10054") ||
                ex.Message.Contains("forcibly closed by the remote host", StringComparison.OrdinalIgnoreCase) ||
                ex.Message.Contains("ConnectionReset", StringComparison.OrdinalIgnoreCase) ||
                ex.Message.Contains("unexpected EOF", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
            ex = ex.InnerException;
        }
        return false;
    }

    private async Task StreamFirebaseCompanySettingsAsync(
        string ownerUid,
        CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(ownerUid))
            return;

        while (!token.IsCancellationRequested && !disposed)
        {
            try
            {
                await FirebaseRealtime.StreamGlobalChangesAsync(
                    $"owners/{ownerUid.Trim()}/company_settings/1",
                    async (path, data, ct) =>
                    {
                        if (disposed || ct.IsCancellationRequested)
                            return;

                        try
                        {
                            await ApplyFirebaseCompanySettingsChange(data);
                        }
                        catch (OperationCanceledException) when (ct.IsCancellationRequested)
                        {
                        }
                        catch (Exception ex)
                        {
                            Console.Error.WriteLine(
                                $"Firebase company-settings event failed: {ex}");
                        }
                    },
                    token);

                if (token.IsCancellationRequested || disposed)
                    break;
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                break;
            }
            catch (Exception ex)
            {
                if (!IsConnectionReset(ex))
                {
                    Logger.LogWarning(ex, "Firebase owner company-settings stream ended: {Message}", ex.Message);
                }
            }

            if (token.IsCancellationRequested || disposed)
                break;

            try
            {
                await Task.Delay(
                    TimeSpan.FromSeconds(5),
                    token);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                break;
            }
        }
    }

    private async Task ApplyFirebaseCompanySettingsChange(JsonElement? data)
    {
        if (!data.HasValue || disposed)
            return;

        try
        {
            var root = data.Value;
            var target = root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var dProp) && dProp.ValueKind == JsonValueKind.Object
                ? dProp
                : root;

            var changed = false;
            if (TryGetJsonInt(target, "geoRadiusMeters", out var r) || TryGetJsonInt(target, "GeoRadiusMeters", out r))
            {
                if (r > 0 && currentOfficeRadius != r)
                {
                    currentOfficeRadius = r;
                    changed = true;
                }
            }
            if (TryGetJsonDouble(target, "officeLatitude", out var lat) || TryGetJsonDouble(target, "OfficeLatitude", out lat))
            {
                if (lat != 0 && currentOfficeLatitude != lat)
                {
                    currentOfficeLatitude = lat;
                    changed = true;
                }
            }
            if (TryGetJsonDouble(target, "officeLongitude", out var lng) || TryGetJsonDouble(target, "OfficeLongitude", out lng))
            {
                if (lng != 0 && currentOfficeLongitude != lng)
                {
                    currentOfficeLongitude = lng;
                    changed = true;
                }
            }
            if (TryGetJsonBool(target, "useSpeedBasedMarkers", out var speed) || TryGetJsonBool(target, "use_speed_based_markers", out speed))
            {
                if (useSpeedBasedMarkers != speed)
                {
                    useSpeedBasedMarkers = speed;
                    changed = true;
                }
            }

            if (changed && currentOfficeLatitude != 0 && currentOfficeLongitude != 0 && currentOfficeRadius > 0)
            {
                foreach (var loc in locations)
                {
                    var dist = CalculateDistanceMeters(loc.Latitude, loc.Longitude, currentOfficeLatitude, currentOfficeLongitude);
                    loc.DistanceMeters = dist;
                    loc.AllowedRadiusMeters = currentOfficeRadius;
                    loc.IsWithinAllowedRadius = dist <= currentOfficeRadius + 1;
                }
                mapNeedsUpdate = true;
                await InvokeAsync(StateHasChanged);

                _ = Task.Run(async () =>
                {
                    try
                    {
                        await using var db = await DbFactory.CreateDbContextAsync();
                        var existing = await db.CompanySettings.FirstOrDefaultAsync(s => s.SettingID == 1);
                        if (existing != null)
                        {
                            if (currentOfficeRadius > 0) existing.GeoRadiusMeters = currentOfficeRadius;
                            if (currentOfficeLatitude != 0) existing.OfficeLatitude = currentOfficeLatitude;
                            if (currentOfficeLongitude != 0) existing.OfficeLongitude = currentOfficeLongitude;
                            existing.UseSpeedBasedMarkers = useSpeedBasedMarkers;
                            await db.SaveChangesAsync();
                        }
                    }
                    catch { }
                });
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Live map Firebase company settings stream parse error: {ex}");
        }
    }


    private async Task LoadEmployees()
    {
        try
        {
            var data =
                (await FirebaseEmployees.GetEmployeesAsync())
                    .Where(e => !e.TerminationDate.HasValue)
                    .OrderBy(e => e.Name)
                    .ToList();

            employees.Clear();

            employees.AddRange(data);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live staff employee load failed: {ex}");
        }
    }


    private async Task ApplyFirebaseTrackingChange(
        string path,
        JsonElement? data)
    {
        if (disposed)
            return;

        var relative = path.Trim('/');
        _lastFirebaseTrackingEventUtc = DateTime.UtcNow;

        // Expected stream paths under owners/{ownerUid}/tracking/live:
        // / or "" (initial snapshot)
        // {employeeId} or live/{employeeId}
        if (string.IsNullOrEmpty(relative) ||
            relative == "/" ||
            relative.Equals("live", StringComparison.OrdinalIgnoreCase))
        {
            if (data is not JsonElement root ||
                root.ValueKind == JsonValueKind.Null)
            {
                // A transient SSE/root transport gap is not proof that all
                // employees became offline. Preserve the last known-good live
                // state and verify it against the authoritative Firebase node.
                _ = ReconcileLiveSnapshotAfterTransientGapAsync();
                mapNeedsUpdate = false;
                return;
            }
            else if (root.ValueKind == JsonValueKind.Object || root.ValueKind == JsonValueKind.Array)
            {
                var validEmployeeIds = employees
                    .Select(e => e.EmployeeID)
                    .ToHashSet();

                // Merge into dictionary: start with ALL current active employees
                // so partial patch events from Firebase never wipe unmentioned employees.
                var mergedByEmployee = locations.ToDictionary(x => x.EmployeeId);

                void ApplyLiveNode(
                    int employeeId,
                    JsonElement node)
                {
                    if (employeeId <= 0 ||
                        node.ValueKind != JsonValueKind.Object)
                        return;

                    var stateValue =
                        GetJsonStringValue(
                            node,
                            "State",
                            "state");

                    if (stateValue.Equals(
                            "ENDED",
                            StringComparison.OrdinalIgnoreCase) ||
                        stateValue.Equals(
                            "OFFLINE",
                            StringComparison.OrdinalIgnoreCase))
                    {
                        // Explicit terminal state is authoritative.
                        mergedByEmployee.Remove(employeeId);
                        return;
                    }

                    if (TryParseLiveEmployeeLocation(
                        employeeId,
                        node,
                        out var parsed))
                    {
                        mergedByEmployee[employeeId] = parsed;
                        return;
                    }

                    // If incoming node is partial/malformed, preserve the existing
                    // known-good active location instead of dropping it.
                }

                if (root.ValueKind == JsonValueKind.Object)
                {
                    foreach (var node in root.EnumerateObject())
                    {
                        if (int.TryParse(
                                node.Name,
                                out var employeeId))
                        {
                            ApplyLiveNode(
                                employeeId,
                                node.Value);
                        }
                    }
                }
                else
                {
                    var index = 0;
                    foreach (var node in root.EnumerateArray())
                    {
                        var fallbackId = index;
                        index++;

                        if (node.ValueKind != JsonValueKind.Object)
                            continue;

                        var employeeId =
                            GetJsonInt(
                                node,
                                "EmployeeId",
                                "employeeId");

                        if (employeeId <= 0)
                            employeeId = fallbackId;

                        ApplyLiveNode(
                            employeeId,
                            node);
                    }
                }

                var next =
                    mergedByEmployee.Values.ToList();

                var previousSignature = string.Join(
                    '|',
                    locations
                        .OrderBy(x => x.EmployeeId)
                        .ThenBy(x => x.SessionId)
                        .Select(x => $"{x.EmployeeId}:{x.SessionId}"));

                var nextSignature = string.Join(
                    '|',
                    next
                        .OrderBy(x => x.EmployeeId)
                        .ThenBy(x => x.SessionId)
                        .Select(x => $"{x.EmployeeId}:{x.SessionId}"));

                locations.Clear();
                locations.AddRange(next);

                lastRefresh = DateTime.Now;

                // Root-level Firebase snapshots can arrive as part of a
                // transport/reconnect sequence. Only render when the live
                // membership/session set actually changed. Coordinate-only
                // changes are handled by the Leaflet realtime bridge, so they
                // must not redraw the Blazor page.
                var membershipChanged =
                    !string.Equals(
                        previousSignature,
                        nextSignature,
                        StringComparison.Ordinal);

                if (membershipChanged)
                {
                    mapNeedsUpdate = true;
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    mapNeedsUpdate = false;
                }
            }
            return;
        }

        var isLivePrefix = relative.StartsWith("live/", StringComparison.OrdinalIgnoreCase);
        var firstPart = relative.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        var isNumericChild = int.TryParse(firstPart, out var parsedChildId) && parsedChildId > 0;

        if (isLivePrefix || isNumericChild)
        {
            var parts = relative.Split(
                '/',
                StringSplitOptions.RemoveEmptyEntries);

            var employeeId = 0;
            if (isLivePrefix && parts.Length >= 2)
                int.TryParse(parts[1], out employeeId);
            else if (isNumericChild && parts.Length >= 1)
                employeeId = parsedChildId;

            if (employeeId <= 0)
                return;

            /*
             * IMPORTANT:
             * A normal GPS coordinate update must never cause a full Blazor
             * component render. The browser-side Leaflet listener moves the
             * existing marker smoothly. Blazor only re-renders when the live
             * membership/session boundary changes.
             *
             * Firebase REST SSE can emit either:
             *   live/{employeeId}                -> complete/partial object
             *   live/{employeeId}/{field}        -> scalar field update
             *
             * For a nested field or an incomplete object, reconcile the complete
             * authoritative employee node once after a tiny debounce window.
             * This prevents a partial packet from making a healthy employee
             * disappear until the user presses Refresh.
             */
            if (parts.Length > 2)
            {
                QueueLiveEmployeeReconcile(employeeId);
                return;
            }

            var membershipChanged = false;

            if (data is not JsonElement node ||
                node.ValueKind == JsonValueKind.Null)
            {
                // Child-null can be a transient SSE deletion artifact. Verify
                // the authoritative employee node before removing the marker.
                QueueLiveEmployeeReconcile(employeeId);
                return;
            }
            else
            {
                var validEmployee =
                    employees.Any(
                        e => e.EmployeeID == employeeId);

                if (!validEmployee ||
                    node.ValueKind != JsonValueKind.Object)
                    return;

                var incomingState =
                    GetJsonStringValue(node, "State", "state");

                // Only an explicit terminal state is allowed to remove an
                // employee from this child-event path. Missing/partial fields
                // must preserve the last known-good live state.
                if (incomingState.Equals(
                        "ENDED",
                        StringComparison.OrdinalIgnoreCase) ||
                    incomingState.Equals(
                        "OFFLINE",
                        StringComparison.OrdinalIgnoreCase))
                {
                    membershipChanged =
                        locations.RemoveAll(
                            x => x.EmployeeId == employeeId) > 0;

                    if (membershipChanged)
                    {
                        lastRefresh = DateTime.Now;
                        mapNeedsUpdate = true;
                        await InvokeAsync(StateHasChanged);
                    }

                    return;
                }

                if (!incomingState.Equals(
                        "ACTIVE",
                        StringComparison.OrdinalIgnoreCase))
                    return;

                if (TryParseLiveEmployeeLocation(
                             employeeId,
                             node,
                             out var location))
                {
                    var index =
                        locations.FindIndex(
                            x => x.EmployeeId == employeeId);

                    if (index >= 0)
                    {
                        var previous = locations[index];

                        membershipChanged =
                            previous.SessionId != location.SessionId;

                        locations[index] = location;
                    }
                    else
                    {
                        locations.Add(location);
                        membershipChanged = true;
                    }
                }
                else
                {
                    // Partial/malformed update. Fetch the complete authoritative
                    // employee node after coalescing any sibling field events.
                    QueueLiveEmployeeReconcile(employeeId);
                    return;
                }
            }

            lastRefresh = DateTime.Now;
            mapNeedsUpdate = true;

            if (membershipChanged)
            {
                await InvokeAsync(StateHasChanged);
            }

            return;
        }

        if (relative.StartsWith(
                "sessions/",
                StringComparison.OrdinalIgnoreCase) &&
            data is JsonElement session &&
            session.ValueKind == JsonValueKind.Object)
        {
            var state =
                GetJsonStringValue(
                    session,
                    "State",
                    "state");

            if (state.Equals(
                    "ENDED",
                    StringComparison.OrdinalIgnoreCase))
            {
                var parts = relative.Split(
                    '/',
                    StringSplitOptions.RemoveEmptyEntries);

                if (parts.Length >= 2 &&
                    int.TryParse(parts[1], out var employeeId) &&
                    employeeId > 0)
                {
                    locations.RemoveAll(
                        x => x.EmployeeId == employeeId);
                    lastRefresh = DateTime.Now;
                    mapNeedsUpdate = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private bool TryParseLiveEmployeeLocation(
        int employeeId,
        JsonElement json,
        out LiveEmployeeLocation location)
    {
        location = new LiveEmployeeLocation();

        if (!TryGetJsonDouble(
                json,
                "Latitude",
                out var lat) ||
            !TryGetJsonDouble(
                json,
                "Longitude",
                out var lng) ||
            !double.IsFinite(lat) ||
            !double.IsFinite(lng) ||
            lat < -90 ||
            lat > 90 ||
            lng < -180 ||
            lng > 180 ||
            (lat == 0 && lng == 0))
        {
            return false;
        }

        var payloadEmployeeId =
            GetJsonInt(
                json,
                "EmployeeId",
                "employeeId");

        if (payloadEmployeeId > 0 &&
            payloadEmployeeId != employeeId)
            return false;

        var state =
            GetJsonStringValue(
                json,
                "State",
                "state");

        // LIVE is valid only when the Firebase live marker itself is ACTIVE.
        // A coordinate plus SessionId is not enough if that session is ended.
        if (!state.Equals(
                "ACTIVE",
                StringComparison.OrdinalIgnoreCase))
            return false;

        var accuracy =
            TryGetJsonDouble(
                json,
                "AccuracyMeters",
                out var acc)
                ? Math.Max(0, acc)
                : 0;

        var timestamp =
            TryGetJsonDateTime(
                json,
                "LastUpdatedUtc",
                out var updated)
                ? updated.ToUniversalTime()
                : TryGetJsonDateTime(
                    json,
                    "Timestamp",
                    out var captured)
                    ? captured.ToUniversalTime()
                    : DateTime.UtcNow;

        var sessionStarted =
            TryGetJsonDateTime(
                json,
                "SessionStartedUtc",
                out var started)
                ? started.ToUniversalTime()
                : timestamp;

        var sessionId = Guid.Empty;

        if (TryGetJsonString(json, "SessionId", out var sessionText))
        {
            Guid.TryParse(sessionText, out sessionId);
        }

        // A live marker without a valid GPS session is not authoritative.
        if (sessionId == Guid.Empty)
            return false;

        var distance =
            CalculateDistanceMeters(
                lat,
                lng,
                currentOfficeLatitude,
                currentOfficeLongitude);

        var within =
            currentOfficeRadius > 0 &&
            distance <= currentOfficeRadius + 1;

        // MIRROR ANDROID: Markers older than 24 hours are hidden.
        // This ensures the map shows stale/offline employees as markers
        // while they are still in the active Firebase node.
        var age = DateTime.UtcNow - timestamp;
        if (age > TimeSpan.FromHours(24))
            return false;

        location = new LiveEmployeeLocation
        {
            EmployeeId = employeeId,
            Latitude = lat,
            Longitude = lng,
            AccuracyMeters = accuracy,
            DistanceMeters = distance,
            AllowedRadiusMeters =
                currentOfficeRadius,
            IsWithinAllowedRadius = within,
            LastUpdatedUtc = timestamp,
            SessionStartedUtc = sessionStarted,
            SessionId = sessionId
        };

        return true;
    }

    private async Task RefreshLocations()
    {
        if (isRefreshing)
        {
            refreshQueued = true;
            return;
        }

        isRefreshing = true;

        try
        {
            do
            {
                refreshQueued = false;

                var office = await GetOfficeLocation();
                currentOfficeLatitude = office.Latitude;
                currentOfficeLongitude = office.Longitude;
                currentOfficeRadius = office.Radius;
                useSpeedBasedMarkers = office.UseSpeedBasedMarkers;

                /*
                 * Firebase is the single live-location wire shared by Web and
                 * Android. Only owner-scoped tracking/live records are read.
                 *
                 * An employee marker exists ONLY when:
                 *   1. the employee belongs to this owner, and
                 *   2. an active Firebase live record exists for that EmployeeID.
                 */
                var liveSnapshot =
                    await FirebaseRealtime.GetOwnerTrackingLiveAsync(
                        FirebaseEmployees.OwnerUid);

                // A null result from GetOwnerTrackingLiveAsync means the
                // Firebase REST read was unavailable, unauthorized, timed out,
                // or returned no JSON. It is NOT safe to interpret that as
                // "no live staff" because the helper intentionally collapses
                // transport failures and an empty Firebase node into null.
                // Preserve the currently visible live employees and let the
                // Firebase SSE child events/reconnect path converge the map.
                // This prevents a transient 401/network read during a periodic
                // reconciliation from wiping the live staff list until the user
                // presses Refresh.
                if (!liveSnapshot.HasValue)
                {
                    lastRefresh = DateTime.Now;
                    mapNeedsUpdate = false;
                    return;
                }

                var snapshot = new List<LiveEmployeeLocation>();

                // REQUIREMENT: Ensure new employees added on Android or through
                // the server provisioning path appear on the map without a
                // manual page refresh. Re-hydrate the employee master list
                // if an unknown location ID arrives.
                var validEmployeeIds =
                    employees.Select(e => e.EmployeeID).ToHashSet();

                var foundUnknownEmployee = false;

                if (liveSnapshot.HasValue &&
                    (liveSnapshot.Value.ValueKind == JsonValueKind.Object || liveSnapshot.Value.ValueKind == JsonValueKind.Array))
                {
                    if (liveSnapshot.Value.ValueKind == JsonValueKind.Object)
                    {
                        foreach (var employeeNode in liveSnapshot.Value.EnumerateObject())
{
    // Firebase may contain null placeholders such as:
    // "123": null
    // Ignore them safely.
    if (employeeNode.Value.ValueKind != JsonValueKind.Object)
        continue;

    if (!int.TryParse(
            employeeNode.Name,
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out var employeeId))
    {
        employeeId = GetJsonInt(
            employeeNode.Value,
            "EmployeeId",
            "employeeId");
    }

    if (employeeId <= 0)
        continue;

    if (!validEmployeeIds.Contains(employeeId))
    {
        foundUnknownEmployee = true;
        continue;
    }

    if (TryParseLiveEmployeeLocation(
            employeeId,
            employeeNode.Value,
            out var location))
    {
        snapshot.Add(location);
    }
}
                    }
                    else
                    {
                        var index = 0;
                        foreach (var node in liveSnapshot.Value.EnumerateArray())
                        {
                            var fallbackId = index; index++;
                            if (node.ValueKind != JsonValueKind.Object) continue;
                            var employeeId = GetJsonInt(node, "EmployeeId", "employeeId");
                            if (employeeId <= 0) employeeId = fallbackId;
                            if (employeeId <= 0) continue;
                            if (!validEmployeeIds.Contains(employeeId)) { foundUnknownEmployee = true; continue; }

                            if (TryParseLiveEmployeeLocation(employeeId, node, out var location))
                                snapshot.Add(location);
                        }
                    }
                }

                if (foundUnknownEmployee)
                {
                    // Discovery: an employee is sending locations but is not in
                    // our current cached list. Synchronize the master list and
                    // retry the snapshot parse to include the new employee.
                    await LoadEmployees();
                    validEmployeeIds = employees.Select(e => e.EmployeeID).ToHashSet();
                    snapshot.Clear();
                    // Re-parse with updated membership
                    if (liveSnapshot.HasValue)
                    {
                        if (liveSnapshot.Value.ValueKind == JsonValueKind.Object)
                        {
                            foreach (var node in liveSnapshot.Value.EnumerateObject())
{
    // Ignore Firebase null/non-object records.
    if (node.Value.ValueKind != JsonValueKind.Object)
        continue;

    int.TryParse(
        node.Name,
        NumberStyles.Integer,
        CultureInfo.InvariantCulture,
        out var id);

    if (id <= 0)
    {
        id = GetJsonInt(
            node.Value,
            "EmployeeId",
            "employeeId");
    }

    if (id > 0 &&
        validEmployeeIds.Contains(id) &&
        TryParseLiveEmployeeLocation(
            id,
            node.Value,
            out var loc))
    {
        snapshot.Add(loc);
    }
}
                        }
                        else
                        {
                            var idx = 0;
                           foreach (var node in liveSnapshot.Value.EnumerateArray())
{
    // Firebase array may contain null/non-object entries.
    if (node.ValueKind != JsonValueKind.Object)
    {
        idx++;
        continue;
    }

    var id = GetJsonInt(node, "EmployeeId");

    if (id <= 0)
        id = idx;

    if (id > 0 &&
        validEmployeeIds.Contains(id) &&
        TryParseLiveEmployeeLocation(
            id,
            node,
            out var loc))
    {
        snapshot.Add(loc);
    }

    idx++;
}
                        }
                    }
                }

                /*
                 * Replace the complete live collection atomically from the
                 * owner-scoped Firebase snapshot. This removes stale SQL-only
                 * employees and guarantees Web map membership matches Android.
                 *
                 * A short-lived empty snapshot can occur while the Firebase
                 * transport is reconnecting. Do not turn that transient gap
                 * into a visible empty map. Explicit SESSION_ENDED/OFFLINE
                 * events still remove employees immediately through the
                 * authoritative lifecycle path.
                 */
                if (snapshot.Count == 0 &&
                    locations.Count > 0 &&
                    lastKnownGoodLiveSnapshotAt != DateTime.MinValue &&
                    DateTime.UtcNow - lastKnownGoodLiveSnapshotAt < TimeSpan.FromSeconds(120))
                {
                    lastRefresh = DateTime.Now;
                    mapNeedsUpdate = false;
                    return;
                }

                if (snapshot.Count > 0)
                    lastKnownGoodLiveSnapshotAt = DateTime.UtcNow;

                locations.Clear();
                locations.AddRange(
                    snapshot
                        .GroupBy(x => x.EmployeeId)
                        .Select(g => g
                            .OrderByDescending(x => x.LastUpdatedUtc)
                            .First()));

                lastRefresh = DateTime.Now;
                mapNeedsUpdate = true;

                await InvokeAsync(StateHasChanged);
            }
            while (refreshQueued && !disposed);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live location Firebase refresh failed: {ex}");
        }
        finally
        {
            isRefreshing = false;
        }
    }


    private void QueueLiveEmployeeReconcile(int employeeId)
    {
        if (disposed || employeeId <= 0)
            return;

        CancellationTokenSource cts;

        lock (liveEmployeeReconcileGate)
        {
            var now = DateTime.UtcNow;
            if (liveEmployeeLastReconcileUtc.TryGetValue(employeeId, out var last) &&
                now - last < LiveEmployeeReconcileMinimumInterval)
            {
                return;
            }

            liveEmployeeLastReconcileUtc[employeeId] = now;

            if (liveEmployeeReconcileCts.TryGetValue(employeeId, out var previous))
            {
                try { previous.Cancel(); } catch { }
                previous.Dispose();
            }

            cts = new CancellationTokenSource();
            liveEmployeeReconcileCts[employeeId] = cts;
        }

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(180, cts.Token);
                if (!cts.IsCancellationRequested && !disposed)
                    await ReconcileSingleLiveEmployeeAsync(employeeId);
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(
                    $"Queued live employee reconciliation failed: {ex}");
            }
            finally
            {
                lock (liveEmployeeReconcileGate)
                {
                    if (liveEmployeeReconcileCts.TryGetValue(employeeId, out var current) &&
                        ReferenceEquals(current, cts))
                    {
                        liveEmployeeReconcileCts.Remove(employeeId);
                    }
                }
                cts.Dispose();
            }
        });
    }


    private async Task ReconcileSingleLiveEmployeeAsync(int employeeId)
    {
        if (disposed || employeeId <= 0)
            return;

        try
        {
            await Task.Delay(350);

            // IMPORTANT: never re-download the complete tracking/live tree here.
            // Firebase REST SSE commonly emits nested field events such as
            // live/{employeeId}/Latitude. The previous implementation responded
            // to those events by GETting the entire owner tracking/live tree, so
            // one GPS update could create repeated full-tree downloads and was a
            // major contributor to the Firebase 45+ GB download usage.
            // Reconcile only this employee node, and throttle it per employee.
            JsonElement? employeeNode =
                await FirebaseRealtime.GetOwnerTrackingLiveEmployeeAsync(
                    FirebaseEmployees.OwnerUid,
                    employeeId);

            if (!employeeNode.HasValue || employeeNode.Value.ValueKind == JsonValueKind.Null)
            {
                // A transient null or network timeout is not an authoritative ENDED/OFFLINE signal.
                // Preserve the last known-good active location instead of dropping it.
                return;
            }

            if (employeeNode.Value.ValueKind == JsonValueKind.Object)
            {
                var state = GetJsonStringValue(employeeNode.Value, "State", "state");
                if (state.Equals("ENDED", StringComparison.OrdinalIgnoreCase) ||
                    state.Equals("OFFLINE", StringComparison.OrdinalIgnoreCase))
                {
                    var removed = locations.RemoveAll(x => x.EmployeeId == employeeId) > 0;
                    if (removed)
                    {
                        lastRefresh = DateTime.Now;
                        mapNeedsUpdate = true;
                        await InvokeAsync(StateHasChanged);
                    }
                    return;
                }

                if (TryParseLiveEmployeeLocation(
                    employeeId,
                    employeeNode.Value,
                    out var location))
                {
                    var index =
                        locations.FindIndex(
                            x => x.EmployeeId == employeeId);

                    var membershipChanged = false;

                    if (index >= 0)
                    {
                        membershipChanged =
                            locations[index].SessionId != location.SessionId;
                        locations[index] = location;
                    }
                    else
                    {
                        locations.Add(location);
                        membershipChanged = true;
                    }

                    lastRefresh = DateTime.Now;
                    mapNeedsUpdate = true;

                    if (membershipChanged)
                        await InvokeAsync(StateHasChanged);

                    return;
                }

                // If node is an active object but a partial field caused parse to fail,
                // do NOT remove the employee. Preserve the last known-good live state.
                return;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live employee reconciliation failed: {ex}");
        }
    }

    private async Task ReconcileLiveSnapshotAfterTransientGapAsync()
    {
        if (disposed)
            return;

        try
        {
            await Task.Delay(500);

            var snapshot =
                await FirebaseRealtime.GetOwnerTrackingLiveAsync(
                    FirebaseEmployees.OwnerUid);

            if (!snapshot.HasValue)
                return;

            await ApplyFirebaseTrackingChange(
                "live",
                snapshot.Value);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live snapshot recovery failed: {ex}");
        }
    }

    private static int GetJsonInt(
    JsonElement json,
    params string[] names)
{
    // Firebase can contain null/primitive nodes.
    // TryGetProperty is valid only for JSON objects.
    if (json.ValueKind != JsonValueKind.Object)
        return 0;

    foreach (var name in names)
    {
        if (!json.TryGetProperty(name, out var property))
            continue;

        if (property.ValueKind == JsonValueKind.Number &&
            property.TryGetInt32(out var number))
        {
            return number;
        }

        if (property.ValueKind == JsonValueKind.String &&
            int.TryParse(
                property.GetString(),
                NumberStyles.Integer,
                CultureInfo.InvariantCulture,
                out number))
        {
            return number;
        }
    }

    return 0;
}


    private static string GetJsonStringValue(
    JsonElement json,
    params string[] names)
{
    // Firebase can contain null/primitive nodes.
    // TryGetProperty is valid only for JSON objects.
    if (json.ValueKind != JsonValueKind.Object)
        return string.Empty;

    foreach (var name in names)
    {
        if (!json.TryGetProperty(name, out var property))
            continue;

        if (property.ValueKind == JsonValueKind.String)
            return property.GetString() ?? string.Empty;
    }

    return string.Empty;
}


    // ============================================================
    // GPS SESSION ENDED
    // ============================================================
    //
    // Logout/session-end is a lifecycle event, not a location update.
    // Remove the employee from the active list immediately and then
    // reload the authoritative DB snapshot so an old in-memory entry
    // can never remain visible.
    // ============================================================

    [JSInvokable]
    public async Task SessionEnded(object? data = null)
    {
        if (disposed)
            return;

        try
        {
            // Fast path: remove the employee from the local collection immediately
            // to stop tracking on the UI while the authoritative DB refresh runs.
            if (TryGetPayloadEmployeeId(data, out var employeeId))
            {
                locations.RemoveAll(x => x.EmployeeId == employeeId);
            }

            await RefreshLocations();

            if (selectedEmployeeId > 0)
                await LoadSelectedEmployeeHistory();

            mapNeedsUpdate = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Admin GPS session-end refresh failed: {ex}");
        }
    }


    private async Task AutoRefresh(
    CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(
                    TimeSpan.FromSeconds(1),
                    token);

                if (token.IsCancellationRequested)
                    break;

                /*
                 * Do not periodically call RefreshLocations().
                 * Firebase SSE plus the browser-side realtime map bridge are
                 * authoritative for live GPS updates. A periodic full component
                 * refresh is unnecessary and can visibly blink the entire map/UI.
                 * The Firebase stream has its own reconnect loop, while explicit
                 * lifecycle/application events still call RefreshLocations() when
                 * they genuinely require an authoritative snapshot.
                 */

                /*
                 * Playback polling is only needed while the browser-side
                 * playback animation is actually running. Polling an idle
                 * player would cause unnecessary Blazor renders every second,
                 * which makes the screen appear to refresh/flicker.
                 */
                if (playbackStatus == "Playing")
                {
                    await PollPlaybackState();
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Live staff UI timer failed: {ex}");
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && liveLocationSignalRReference == null && !disposed)
        {
            liveLocationSignalRReference =
                DotNetObjectReference.Create(this);

            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.register",
                    liveLocationSignalRReference);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(
                    $"Unable to register admin live location SignalR listener: {ex}");
            }

            // Register to receive periodic location health updates (lightweight)
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.registerLocationHealth",
                    liveLocationSignalRReference);
            }
            catch { }

            // Subscribe this live-map component directly to the centralized
            // application invalidation stream. This avoids relying on a full
            // route refresh for current live state.
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.registerApplication",
                    liveLocationSignalRReference);
            }
            catch { }

            // Register a browser-side fast path for GPS coordinates. This
            // now consumes the same Firebase realtime event used by the
            // standalone tracking transport, so the admin map does not wait
            // for SignalR or a manual Refresh.
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "registerAdminLiveLocationRealtime",
                    mapId);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine(
                    $"Unable to register admin live location realtime bridge: {ex}");
            }

            // The first snapshot can race an employee login. One additional
            // authoritative snapshot after the component is interactive makes
            // initial markers appear without requiring the Refresh button.
            try
            {
                await RefreshLocations();
            }
            catch { }
        }

        if (!mapNeedsUpdate)
            return;

        mapNeedsUpdate = false;

        try
        {
            var office = await GetOfficeLocation();
            currentOfficeLatitude = office.Latitude;
            currentOfficeLongitude = office.Longitude;
            currentOfficeRadius = office.Radius;
            useSpeedBasedMarkers = office.UseSpeedBasedMarkers;

            var staff = locations
                .Select(x => new AdminMapLocation
                {
                    EmployeeId = x.EmployeeId,
                    SessionId = x.SessionId,
                    Name = employees
                        .FirstOrDefault(e => e.EmployeeID == x.EmployeeId)
                        ?.Name ?? "Employee",
                    Latitude = x.Latitude,
                    Longitude = x.Longitude,
                    DistanceMeters = x.DistanceMeters,
                    AllowedRadiusMeters = x.AllowedRadiusMeters,
                    IsWithinAllowedRadius = x.IsWithinAllowedRadius,
                    AccuracyMeters = x.AccuracyMeters,
                    LastUpdatedUtc = x.LastUpdatedUtc,
                    SessionStartedUtc = x.SessionStartedUtc,
                    SpeedMps = x.SpeedMps,
                    MovementState = x.MovementState,
                    Role = employees.FirstOrDefault(e => e.EmployeeID == x.EmployeeId)?.Role,
                    Status = GetLocationStatus(x).ToString()
                })
                .ToList();

            await JSRuntime.InvokeVoidAsync(
                "updateAdminLiveStaffMap",
                mapId,
                office.Latitude,
                office.Longitude,
                office.Radius,
                staff,
                selectedEmployeeId,
                false,
                liveLocationSignalRReference,
                office.UseSpeedBasedMarkers);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Admin live map update failed: {ex}");
        }
    }


    private static double CalculateDistanceMeters(
        double lat1, double lon1,
        double lat2, double lon2)
    {
        const double earthRadiusMeters = 6371000d;
        var dLat = (lat2 - lat1) * Math.PI / 180d;
        var dLon = (lon2 - lon1) * Math.PI / 180d;
        var a =
            Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
            Math.Cos(lat1 * Math.PI / 180d) *
            Math.Cos(lat2 * Math.PI / 180d) *
            Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        return earthRadiusMeters * 2d * Math.Atan2(Math.Sqrt(a), Math.Sqrt(Math.Max(0d, 1d - a)));
    }

    private async Task<(double Latitude, double Longitude, int Radius, bool UseSpeedBasedMarkers)>
        GetOfficeLocation()
    {
        await using var db =
            await DbFactory.CreateDbContextAsync();

        var company =
            await db.CompanySettings
                .AsNoTracking()
                .FirstOrDefaultAsync(
                    s => s.SettingID == 1);

        var radius = company?.GeoRadiusMeters ?? 100;
        if (currentOfficeRadius > 0 && radius != currentOfficeRadius)
        {
            radius = currentOfficeRadius;
        }

        var lat = company?.OfficeLatitude ?? 0;
        if (currentOfficeLatitude != 0 && lat == 0)
        {
            lat = currentOfficeLatitude;
        }

        var lon = company?.OfficeLongitude ?? 0;
        if (currentOfficeLongitude != 0 && lon == 0)
        {
            lon = currentOfficeLongitude;
        }

        return (
            lat,
            lon,
            radius,
            company?.UseSpeedBasedMarkers ?? useSpeedBasedMarkers);
    }


