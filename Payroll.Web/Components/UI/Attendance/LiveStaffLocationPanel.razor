    private List<SessionSummary> HistorySessions
    {
        get
        {
            /*
             * Build the timeline from BOTH sources:
             * 1. persisted GPS history points
             * 2. authoritative EmployeeGpsSessions records
             *
             * This is the important distinction for a newly active session:
             * the employee can already be LIVE while its first history points
             * have not yet been persisted/projected. The active session must
             * still appear in the timeline as ACTIVE.
             */
            var summaries = new List<SessionSummary>();

            var historyGroups =
                selectedHistory
                    .Where(x => x.SessionId != Guid.Empty)
                    .GroupBy(x => x.SessionId)
                    .ToDictionary(
                        g => g.Key,
                        g => g.OrderBy(x => x.RecordedAtUtc).ToList());

            foreach (var group in historyGroups)
            {
                var points = group.Value;

                double travel = 0;
                for (int i = 1; i < points.Count; i++)
                {
                    travel += CalculateDistance(
                        points[i - 1].Latitude,
                        points[i - 1].Longitude,
                        points[i].Latitude,
                        points[i].Longitude);
                }

                var accuracies =
                    points
                        .Where(x => x.AccuracyMeters > 0)
                        .Select(x => x.AccuracyMeters)
                        .ToList();

                gpsSessionLookup.TryGetValue(
                    group.Key,
                    out var session);

                var startUtc =
                    session?.StartedAtUtc
                    ?? points.First().RecordedAtUtc;

                var lastUpdateUtc =
                    session?.LastUpdateAtUtc
                    ?? points.Last().RecordedAtUtc;

                var endUtc =
                    session?.EndedAtUtc
                    ?? DateTime.UtcNow;

                summaries.Add(new SessionSummary
                {
                    SessionId = group.Key,
                    StartUtc = startUtc,
                    LastUpdateUtc = lastUpdateUtc,
                    EndUtc = endUtc,
                    PointCount = points.Count,
                    TravelMeters = travel,
                    AverageAccuracy =
                        accuracies.Count == 0
                            ? (session?.AverageAccuracyMeters ?? 0)
                            : accuracies.Average()
                });
            }

            /*
             * Add session records that do not have history points yet.
             * This is the case that previously made a LIVE employee appear
             * to have only ENDED sessions in the timeline.
             */
            foreach (var session in gpsSessionLookup.Values)
            {
                if (session.SessionId == Guid.Empty ||
                    historyGroups.ContainsKey(session.SessionId))
                {
                    continue;
                }

                summaries.Add(new SessionSummary
                {
                    SessionId = session.SessionId,
                    StartUtc = session.StartedAtUtc,
                    LastUpdateUtc = session.LastUpdateAtUtc,
                    EndUtc = session.EndedAtUtc ?? DateTime.UtcNow,
                    PointCount = session.TotalPoints,
                    TravelMeters = session.TotalDistanceMeters,
                    AverageAccuracy = session.AverageAccuracyMeters ?? 0
                });
            }

            return summaries
                .OrderByDescending(x => x.StartUtc)
                .ToList();
        }
    }

