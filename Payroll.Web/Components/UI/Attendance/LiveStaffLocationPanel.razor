    private static string FormatSpeed(double speedMps)
    {
        if (!double.IsFinite(speedMps) || speedMps < 0.1) return "0 km/h";
        return $"{speedMps * 3.6:0.0} km/h";
    }


    private static string FormatDuration(
        TimeSpan duration)
    {
        if (duration.TotalDays >= 1)
        {
            return
                $"{(int)duration.TotalDays}d " +
                $"{duration.Hours:00}h " +
                $"{duration.Minutes:00}m";
        }

        if (duration.TotalHours >= 1)
        {
            return
                $"{(int)duration.TotalHours}h " +
                $"{duration.Minutes:00}m";
        }

        return
            $"{duration.Minutes:00}m " +
            $"{duration.Seconds:00}s";
    }


