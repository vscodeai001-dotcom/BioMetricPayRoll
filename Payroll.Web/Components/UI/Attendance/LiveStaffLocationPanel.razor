    .payroll-map-search { width:100%; height:34px; box-sizing:border-box; border-radius:10px; border:1px solid rgba(255,255,255,.14); background:rgba(255,255,255,.09); color:#fff; outline:0; padding:0 10px 0 30px; font-size:.72rem; }
    .payroll-map-search::placeholder { color:rgba(255,255,255,.58); }
