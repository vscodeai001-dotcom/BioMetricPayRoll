    [JSInvokable]
    public async Task LocationChanged(object? data)
    {
        if (disposed)
            return;

        try
        {
            /*
             * Fast path:
             * the browser-side SignalR listener updates the existing Leaflet
             * marker immediately. Keep the Blazor state in sync without
             * forcing a database round-trip for every GPS fix.
             *
             * If the payload is not a normal coordinate update, or it belongs
             * to a new session/employee, fall back to the authoritative DB
             * snapshot. This preserves the existing lifecycle safety rules.
             */
            if (!TryApplyLocationPayload(data, out var needsAuthoritativeRefresh))
            {
                needsAuthoritativeRefresh = true;
            }

            if (needsAuthoritativeRefresh)
            {
                await RefreshLocations();
            }
            else
            {
                mapNeedsUpdate = true;
                await InvokeAsync(StateHasChanged);
            }

            // Refresh selected history only when the selected employee's
            // current session actually changed. Normal GPS fixes do not need
            // to reload the entire history table.
            if (selectedEmployeeId > 0 &&
                TryGetPayloadEmployeeId(data, out var changedEmployeeId) &&
                changedEmployeeId == selectedEmployeeId)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Admin SignalR location update failed: {ex}");
        }
    }

    [JSInvokable]
    public async Task SessionStarted(object? data = null)
    {
