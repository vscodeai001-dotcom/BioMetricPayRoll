    private async Task SelectPlaybackSession(Guid sessionId)
    {
        if (sessionId == Guid.Empty)
            return;

        if (!selectedHistory.Any(x => x.SessionId == sessionId))
            return;

        await StopPlayback();

        selectedPlaybackSessionId = sessionId;
        RebuildPlaybackPoints();
        playbackTablePage = 0;
        playbackIndex = 0;
        playbackStatus = "Ready";

        // Load the selected session route on the map without starting playback.
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "startAdminHistoryPlayback",
                mapId,
                PlaybackPoints,
                SelectedEmployeeName,
                playbackSpeed,
                0);

            await JSRuntime.InvokeVoidAsync(
                "pauseAdminHistoryPlayback",
                mapId);
        }
        catch { }

        await InvokeAsync(StateHasChanged);
    }

