@using global::Payroll.Web.Services
@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Text.Json
@using System.Globalization
@using Microsoft.Extensions.Logging
@using System.Net.Sockets

@implements IAsyncDisposable

@inject IJSRuntime JSRuntime
@inject LocationHistoryService LocationHistoryService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FirebaseEmployeeManagementService FirebaseEmployees
@inject FirebaseRealtimeService FirebaseRealtime
@inject ILogger<LiveStaffLocationPanel> Logger

<div class="live-staff-card card border-0 shadow-sm mb-4">

    <!-- ============================================================
         LIVE STAFF HEADER
         ============================================================ -->

    <div class="live-staff-header">

        <div class="live-staff-header-top d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex align-items-center gap-3 live-staff-title-wrap">
                <div class="emoji-icon-badge emoji-icon-badge-primary flex-shrink-0">
                    📍
                </div>
                <div>
                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2 flex-wrap">
                        <span class="live-staff-title-text">Live Staff GPS Radar</span>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 fs-6">🛰️ Active</span>
                    </h5>

                    <small class="text-muted d-block mt-1 live-staff-subtitle">
                        ⚡ Real-time employee positioning from active mobile GPS tracking sessions
                    </small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 live-staff-actions flex-wrap">

                <span class="live-count badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-semibold" data-live-count-for="@mapId">
                    <span class="pulse-indicator pulse-indicator-success me-1"></span>
                    🟢 @liveCount Live Staff / @employees.Count
                </span>

                <button type="button"
                        class="btn btn-outline-primary action-pill-btn btn-sm"
                        @onclick="RefreshLocations"
                        disabled="@isRefreshing">

                    <i class="bi bi-arrow-clockwise @(isRefreshing ? "spin" : "")"></i>

                    <span class="d-none d-md-inline ms-1">
                        🔄 Refresh
                    </span>

                </button>

            </div>

        </div>


        @if (selectedEmployeeId > 0)
        {
            var selectedEmployee = employees.FirstOrDefault(e => e.EmployeeID == selectedEmployeeId);
            var selectedLocation = GetLocation(selectedEmployeeId);
            if (selectedEmployee != null && selectedLocation != null)
            {
                var selectedStatus = GetLocationStatus(selectedLocation);
                <div class="admin-selected-employee-rail" data-admin-selected-rail="@mapId" tabindex="0" aria-label="Selected employee location details">
                    <div class="admin-selected-employee-rail-track">
                        <div class="admin-selected-employee-rail-set">
                            <div class="admin-selected-rail-item identity">
                                <span class="rail-label">Employee</span>
                                <strong>@selectedEmployee.Name</strong>
                                <small>#@selectedEmployee.EmployeeID · @(selectedEmployee.Role ?? "Staff")</small>
                            </div>
                            <div class="admin-selected-rail-item address" data-selected-address>
                                <span class="rail-label">Current Location</span>
                                <strong>Resolving current address...</strong>
                                <small data-selected-coords>@selectedLocation.Latitude.ToString("F6") · @selectedLocation.Longitude.ToString("F6")</small>
                            </div>
                            <div class="admin-selected-rail-item speed" data-selected-speed>
                                <span class="rail-label">Speed</span>
                                <strong>@FormatSpeed(selectedLocation.SpeedMps)</strong>
                                <small>@selectedLocation.MovementState</small>
                            </div>
                            <div class="admin-selected-rail-item">
                                <span class="rail-label">GPS Accuracy</span>
                                <strong>@FormatAccuracy(selectedLocation.AccuracyMeters)</strong>
                                <small>Precision</small>
                            </div>
                            <div class="admin-selected-rail-item">
                                <span class="rail-label">Tracking / Stay</span>
                                <strong>@FormatDuration(GetSessionDuration(selectedLocation))</strong>
                                <small>Current GPS session</small>
                            </div>
                            <div class="admin-selected-rail-item">
                                <span class="rail-label">Shop Distance</span>
                                <strong>@FormatDistance(selectedLocation.DistanceMeters)</strong>
                                <small>Distance from shop</small>
                            </div>
                            <div class="admin-selected-rail-item allowed-radius" data-selected-radius>
                                <span class="rail-label">Allowed Radius</span>
                                <strong>@selectedLocation.AllowedRadiusMeters m</strong>
                                <small>Configured geofence</small>
                            </div>
                            <div class="admin-selected-rail-item range-status" data-selected-range>
                                <span class="rail-label">Range</span>
                                <strong class="@(selectedLocation.IsWithinAllowedRadius ? "text-success" : "text-danger")">@(selectedLocation.IsWithinAllowedRadius ? "Inside range" : "Outside range")</strong>
                                <small>@FormatDistance(selectedLocation.DistanceMeters) from shop</small>
                            </div>
                            <div class="admin-selected-rail-item">
                                <span class="rail-label">Last Updated</span>
                                <strong>@ToLocalTime(selectedLocation.LastUpdatedUtc).ToString("HH:mm:ss")</strong>
                                <small>@selectedLocation.LastUpdatedUtc.ToLocalTime().ToString("dd MMM yyyy")</small>
                            </div>
                            <div class="admin-selected-rail-item coordinates">
                                <span class="rail-label">Exact GPS</span>
                                <strong>@selectedLocation.Latitude.ToString("F6"), @selectedLocation.Longitude.ToString("F6")</strong>
                                <small>Actual GPS point</small>
                            </div>
                        </div>
                        <div class="admin-selected-employee-rail-set" aria-hidden="true">
                            <div class="admin-selected-rail-item identity"><span class="rail-label">Employee</span><strong>@selectedEmployee.Name</strong><small>#@selectedEmployee.EmployeeID · @(selectedEmployee.Role ?? "Staff")</small></div>
                            <div class="admin-selected-rail-item address" data-selected-address><span class="rail-label">Current Location</span><strong>Resolving current address...</strong><small data-selected-coords>@selectedLocation.Latitude.ToString("F6") · @selectedLocation.Longitude.ToString("F6")</small></div>
                            <div class="admin-selected-rail-item speed" data-selected-speed><span class="rail-label">Speed</span><strong>@FormatSpeed(selectedLocation.SpeedMps)</strong><small>@selectedLocation.MovementState</small></div>
                            <div class="admin-selected-rail-item"><span class="rail-label">GPS Accuracy</span><strong>@FormatAccuracy(selectedLocation.AccuracyMeters)</strong><small>Precision</small></div>
                            <div class="admin-selected-rail-item"><span class="rail-label">Tracking / Stay</span><strong>@FormatDuration(GetSessionDuration(selectedLocation))</strong><small>Current GPS session</small></div>
                            <div class="admin-selected-rail-item"><span class="rail-label">Shop Distance</span><strong>@FormatDistance(selectedLocation.DistanceMeters)</strong><small>Distance from shop</small></div>
                            <div class="admin-selected-rail-item allowed-radius" data-selected-radius><span class="rail-label">Allowed Radius</span><strong>@selectedLocation.AllowedRadiusMeters m</strong><small>Configured geofence</small></div>
                            <div class="admin-selected-rail-item range-status" data-selected-range><span class="rail-label">Range</span><strong class="@(selectedLocation.IsWithinAllowedRadius ? "text-success" : "text-danger")">@(selectedLocation.IsWithinAllowedRadius ? "Inside range" : "Outside range")</strong><small>@FormatDistance(selectedLocation.DistanceMeters) from shop</small></div>
                            <div class="admin-selected-rail-item"><span class="rail-label">Last Updated</span><strong>@ToLocalTime(selectedLocation.LastUpdatedUtc).ToString("HH:mm:ss")</strong><small>@selectedLocation.LastUpdatedUtc.ToLocalTime().ToString("dd MMM yyyy")</small></div>
                            <div class="admin-selected-rail-item coordinates"><span class="rail-label">Exact GPS</span><strong>@selectedLocation.Latitude.ToString("F6"), @selectedLocation.Longitude.ToString("F6")</strong><small>Actual GPS point</small></div>
                        </div>
                    </div>
                </div>
            }
        }

    </div>


    <!-- ============================================================
         LIVE MAP + STAFF LIST
         ============================================================ -->

    <div class="live-staff-body">

        <div class="admin-map-wrapper">

            <div id="@mapId"
                 class="admin-live-map">
            </div>

            <!-- Google Maps-style Floating Navigation Controls Widget -->
            <div class="payroll-map-floating-nav" data-map-nav-for="@mapId">
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'zoom-in')" title="Zoom In" aria-label="Zoom In">
                    <i class="bi bi-plus-lg"></i>
                </button>
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'zoom-out')" title="Zoom Out" aria-label="Zoom Out">
                    <i class="bi bi-dash-lg"></i>
                </button>
                <div class="floating-nav-divider"></div>
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'follow')" title="Toggle Auto-Follow Selected Staff" aria-label="Follow Selected">
                    <i class="bi bi-geo"></i>
                </button>
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'recenter')" title="Recenter Selected / Staff" aria-label="Recenter Target">
                    <i class="bi bi-crosshair2"></i>
                </button>
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'office')" title="Focus Office" aria-label="Focus Office">
                    <i class="bi bi-building"></i>
                </button>
                <div class="floating-nav-divider"></div>
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'fit')" title="Fit All Staff" aria-label="Fit All Staff">
                    <i class="bi bi-bounding-box"></i>
                </button>
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'layer')" title="Switch Map Layer" aria-label="Switch Map Layer">
                    <i class="bi bi-layers"></i>
                </button>
                <button type="button" class="floating-nav-btn" onclick="window.handlePremiumAdminMapAction('@mapId', 'fullscreen')" title="Toggle Fullscreen (Esc to Exit)" aria-label="Toggle Fullscreen">
                    <i class="bi bi-fullscreen" data-fullscreen-icon="@mapId"></i>
                </button>
            </div>

            <!-- Leaflet zoom controls are moved by JavaScript into the horizontal
                 bottom map toolbar. The host remains only for initialization. -->
            <div id="@($"{mapId}-zoom-controls")"
                 class="admin-map-bottom-controls"
                 aria-hidden="true">
            </div>

            @if (locations.Count == 0)
            {
                <div class="map-empty-overlay" data-live-empty-overlay="@mapId">
                    <i class="bi bi-broadcast-pin display-6 text-muted"></i>
                    <span>No live staff locations</span>
                    <small>Live employee locations will appear automatically.</small>
                </div>
            }

            <div class="map-live-legend">
                <span><span class="legend-line arrived-route"></span> Way Arrived (Green Route)</span>
                <span><span class="legend-line office-route"></span> Office Path</span>
                <span><i class="legend-dot within"></i> Inside range</span>
                <span><i class="legend-dot outside"></i> Outside range</span>
            </div>


        </div>

        <!-- Selected employee detail card intentionally hidden. Selection is presented on the map and header rail only. -->

    </div>

    <!-- ============================================================
         FOOTER
         ============================================================ -->

    <div class="live-staff-footer">

        <span>
            <i class="bi bi-clock me-1"></i>
            @GetFooterText()
        </span>

        <span>
            @liveCount live · @staleCount stale · @offlineCount offline
        </span>

    </div>

</div>


<!-- ================================================================
     SELECTED EMPLOYEE DETAILS
     ================================================================ -->
@if (selectedEmployeeId > 0)
{
    var selectedEmployee =
        employees.FirstOrDefault(e => e.EmployeeID == selectedEmployeeId);

    var selectedLocation =
        GetLocation(selectedEmployeeId);

    if (selectedEmployee != null)
    {


        <!-- ============================================================
             GPS LOGS: HORIZONTAL TABBED / MINIMIZED BY DEFAULT
             ============================================================ -->
        <div class="admin-gps-log-tabs card border-0 shadow-sm mb-4">
            <div class="admin-gps-log-tab-strip" role="tablist" aria-label="Employee GPS logs">
                <button type="button"
                        class="admin-gps-log-tab @(activeLogTab == "punch" ? "active" : "")"
                        @onclick='() => ToggleLogTab("punch")'
                        aria-selected="@(activeLogTab == "punch")">
                    <i class="bi bi-shield-check"></i>
                    <span>Punch Audit</span>
                </button>

                <button type="button"
                        class="admin-gps-log-tab @(activeLogTab == "history" ? "active" : "")"
                        @onclick='() => ToggleLogTab("history")'
                        aria-selected="@(activeLogTab == "history")">
                    <i class="bi bi-clock-history"></i>
                    <span>Location History</span>
                </button>

                <button type="button"
                        class="admin-gps-log-tab @(activeLogTab == "playback" ? "active" : "")"
                        @onclick='() => ToggleLogTab("playback")'
                        aria-selected="@(activeLogTab == "playback")">
                    <i class="bi bi-play-circle-fill"></i>
                    <span>Route Playback</span>
                </button>

                @if (activeLogTab != null)
                {
                    <button type="button"
                            class="admin-gps-log-minimize"
                            title="Minimize GPS logs"
                            aria-label="Minimize GPS logs"
                            @onclick="MinimizeLogTabs">
                        <i class="bi bi-dash-lg"></i>
                    </button>
                }
            </div>
        </div>

        @if (activeLogTab == "punch")
        {
        <!-- ============================================================
             GEO PUNCH AUDIT
             ============================================================ -->
        <div class="geo-punch-audit-card card border-0 shadow-sm mb-4">
            <div class="geo-punch-audit-header d-flex justify-content-between align-items-center clickable" @onclick='() => ToggleLogTab("punch")'>
                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-shield-check text-primary me-2"></i>
                        @selectedEmployee.Name Punch Audit
                    </h5>
                    <small class="text-muted">GPS validation and attendance punch audit</small>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (activeLogTab == "punch")
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                title="Previous day" aria-label="Previous day"
                                @onclick="() => ChangeAuditDateByDays(-1)" @onclick:stopPropagation="true"
                                disabled="@punchAuditLoading">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <input type="date" class="form-control form-control-sm history-date-input"
                               value="@punchAuditDate.ToString("yyyy-MM-dd")"
                               @onchange="ChangePunchAuditDate" @onclick:stopPropagation="true" />
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                title="Next day" aria-label="Next day"
                                @onclick="() => ChangeAuditDateByDays(1)" @onclick:stopPropagation="true"
                                disabled="@punchAuditLoading">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                @onclick="LoadSelectedEmployeePunchAudits" @onclick:stopPropagation="true"
                                disabled="@punchAuditLoading">
                            <i class="bi bi-arrow-clockwise @(punchAuditLoading ? "spin" : "")"></i>
                            <span class="d-none d-md-inline ms-1">Refresh</span>
                        </button>
                    }
                    <i class="bi bi-dash-circle ms-2 opacity-50" title="Minimize"></i>
                </div>
            </div>
            @if (activeLogTab == "punch")
            {
                @if (punchAuditLoading)
                {
                    <div class="history-loading">
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        Loading punch audit...
                    </div>
                }
                else if (selectedPunchAudits.Count == 0)
                {
                    <div class="history-empty">
                        <i class="bi bi-shield-x"></i>
                        <strong>No GPS punch audit records</strong>
                        <span>No punch audit records were found for @punchAuditDate.ToString("dd MMM yyyy").</span>
                    </div>
                }
                else
                {
                    <div class="geo-punch-audit-summary">
                        <div><small>TOTAL</small><strong>@selectedPunchAudits.Count</strong></div>
                        <div><small>SUCCESS</small><strong class="text-success">@selectedPunchAudits.Count(x => x.Success)</strong></div>
                        <div><small>FAILED</small><strong class="text-danger">@selectedPunchAudits.Count(x => !x.Success)</strong></div>
                        <div><small>OUTSIDE RANGE</small><strong class="text-danger">@selectedPunchAudits.Count(x => !x.IsWithinAllowedRadius)</strong></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover geo-punch-audit-table mb-0">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Result</th>
                                    <th>Accuracy</th>
                                    <th>Distance</th>
                                    <th>Allowed</th>
                                    <th>Geofence</th>
                                    <th>Message</th>
                                    <th>Session</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var audit in selectedPunchAudits)
                                {
                                    <tr class="geo-punch-audit-row" @onclick="() => OpenPunchAudit(audit)" title="Click to view punch details">
                                        <td class="fw-semibold">@ToLocalTime(audit.PunchTimeUtc).ToString("HH:mm:ss")</td>
                                        <td>
                                            @if (audit.Success)
                                            {
                                                <span class="geo-audit-success"><i class="bi bi-check-circle-fill me-1"></i>Success</span>
                                            }
                                            else
                                            {
                                                <span class="geo-audit-failed"><i class="bi bi-x-circle-fill me-1"></i>Failed</span>
                                            }
                                        </td>
                                        <td><span class="gps-accuracy-badge @GetAccuracyClass(audit.AccuracyMeters)">@GetAccuracyLabel(audit.AccuracyMeters) <small>@FormatAccuracy(audit.AccuracyMeters)</small></span></td>
                                        <td>@FormatDistance(audit.DistanceFromOfficeMeters)</td>
                                        <td>@audit.AllowedRadiusMeters m</td>
                                        <td>
                                            @if (audit.IsWithinAllowedRadius)
                                            {
                                                <span class="geo-audit-within"><i class="bi bi-geo-alt-fill me-1"></i>Within</span>
                                            }
                                            else
                                            {
                                                <span class="geo-audit-outside"><i class="bi bi-geo-alt-fill me-1"></i>Outside</span>
                                            }
                                        </td>
                                        <td class="geo-audit-message" title="@audit.ResultMessage">@audit.ResultMessage</td>
                                        <td>
                                            @if (audit.SessionId.HasValue)
                                            {
                                                <span title="@audit.SessionId.Value">@audit.SessionId.Value.ToString("N").Substring(0, 8)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        @if (selectedPunchAudit != null)
        {
            <div class="geo-audit-modal-backdrop" @onclick="ClosePunchAudit">
                <div class="geo-audit-modal card border-0 shadow-lg" @onclick:stopPropagation="true">
                    <div class="geo-audit-modal-header d-flex justify-content-between align-items-center">
                        <div><h5 class="fw-bold mb-1"><i class="bi bi-shield-check text-primary me-2"></i>Punch Audit Details</h5><small class="text-muted">@selectedEmployee.Name · @ToLocalTime(selectedPunchAudit.PunchTimeUtc).ToString("dd MMM yyyy HH:mm:ss")</small></div>
                        <button type="button" class="btn btn-sm btn-light" @onclick="ClosePunchAudit"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div class="geo-audit-modal-body">
                        <div class="geo-audit-result-banner @(selectedPunchAudit.Success ? "success" : "failed")"><i class="bi @(selectedPunchAudit.Success ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i><div><strong>@(selectedPunchAudit.Success ? "Punch Accepted" : "Punch Rejected")</strong><span>@selectedPunchAudit.ResultMessage</span></div></div>
                        <div class="geo-audit-detail-grid">
                            <div><small>GPS ACCURACY</small><strong class="@GetAccuracyClass(selectedPunchAudit.AccuracyMeters)">@GetAccuracyLabel(selectedPunchAudit.AccuracyMeters)</strong><span>@FormatAccuracy(selectedPunchAudit.AccuracyMeters)</span></div>
                            <div><small>DISTANCE FROM OFFICE</small><strong>@FormatDistance(selectedPunchAudit.DistanceFromOfficeMeters)</strong><span>Allowed @selectedPunchAudit.AllowedRadiusMeters m</span></div>
                            <div><small>GEOFENCE</small><strong class="@(selectedPunchAudit.IsWithinAllowedRadius ? "text-success" : "text-danger")">@(selectedPunchAudit.IsWithinAllowedRadius ? "Within range" : "Outside range")</strong><span>@FormatDistance(selectedPunchAudit.DistanceFromOfficeMeters) / @selectedPunchAudit.AllowedRadiusMeters m</span></div>
                            <div><small>SOURCE</small><strong>@selectedPunchAudit.Source</strong><span>Attendance ID: @(selectedPunchAudit.AttendanceLogId?.ToString() ?? "-")</span></div>
                            <div><small>LATITUDE</small><strong>@selectedPunchAudit.Latitude.ToString("F6")</strong><span>GPS coordinate</span></div>
                            <div><small>LONGITUDE</small><strong>@selectedPunchAudit.Longitude.ToString("F6")</strong><span>GPS coordinate</span></div>
                            <div class="geo-audit-detail-wide"><small>SESSION ID</small><strong>@(selectedPunchAudit.SessionId?.ToString() ?? "-")</strong></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        }
        @if (activeLogTab == "history")
        {
        <!-- ============================================================
             LOCATION HISTORY
             ============================================================ -->

        <div class="location-history-card card border-0 shadow-sm mb-4">

            <div class="location-history-header d-flex justify-content-between align-items-center clickable" @onclick='() => ToggleLogTab("history")'>

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-clock-history text-primary me-2"></i>

                        @selectedEmployee.Name Location History

                    </h5>

                    <small class="text-muted">
                        GPS location history recorded for the selected date
                    </small>

                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (activeLogTab == "history")
                    {
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                title="Previous day" aria-label="Previous day"
                                @onclick="() => ChangeHistoryDateByDays(-1)" @onclick:stopPropagation="true"
                                disabled="@historyLoading">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        <input type="date"
                               class="form-control form-control-sm history-date-input"
                               value="@historyDate.ToString("yyyy-MM-dd")"
                               @onchange="ChangeHistoryDate" @onclick:stopPropagation="true" />

                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                title="Next day" aria-label="Next day"
                                @onclick="() => ChangeHistoryDateByDays(1)" @onclick:stopPropagation="true"
                                disabled="@historyLoading">
                            <i class="bi bi-chevron-right"></i>
                        </button>

                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                @onclick="LoadSelectedEmployeeHistory" @onclick:stopPropagation="true"
                                disabled="@historyLoading">

                            <i class="bi bi-arrow-clockwise @(historyLoading ? "spin" : "")"></i>

                            <span class="d-none d-md-inline ms-1">
                                Refresh
                            </span>

                        </button>
                    }
                    <i class="bi bi-dash-circle ms-2 opacity-50" title="Minimize"></i>
                </div>

            </div>


            @if (activeLogTab == "history")
            {
                @if (historyLoading)
                {
                    <div class="history-loading">

                        <span class="spinner-border spinner-border-sm me-2"></span>

                        Loading location history...

                    </div>
                }
                else if (selectedHistory.Count == 0 && HistorySessions.Count == 0)
                {
                    <div class="history-empty">

                        <i class="bi bi-geo-alt"></i>

                        <strong>
                            No GPS history recorded
                        </strong>

                        <span>
                            No location records were found for
                            @historyDate.ToString("dd MMM yyyy").
                        </span>

                    </div>
                }
                else
                {
                    <!-- ====================================================
                         HISTORY SUMMARY
                         ==================================================== -->

                    <div class="location-history-summary">

                        <div>
                            <small>STARTED</small>
                            <strong>@HistoryStartText</strong>
                        </div>

                        <div>
                            <small>LAST UPDATE</small>
                            <strong>@HistoryEndText</strong>
                        </div>

                        <div>
                            <small>GPS POINTS</small>
                            <strong>@selectedHistory.Count</strong>
                        </div>

                        <div>
                            <small>MAX DISTANCE</small>
                            <strong>@FormatDistance(HistoryMaxDistance)</strong>
                        </div>

                        <div>
                            <small>TRAVEL</small>
                            <strong>@FormatDistance(HistoryTravelDistance)</strong>
                        </div>

                        <div>
                            <small>CAPTURE INTERVAL</small>
                            <strong>@HistoryCaptureIntervalText</strong>
                        </div>

                    </div>



                    <!-- ====================================================
                         GPS QUALITY + SESSION SUMMARY
                         ==================================================== -->

                    <div class="gps-session-summary">
                        <div class="gps-quality-grid">
                            <div><small>AVG ACCURACY</small><strong class="@GetAccuracyClass(HistoryAverageAccuracy)">@GetAccuracyLabel(HistoryAverageAccuracy)</strong><span>@FormatAccuracy(HistoryAverageAccuracy)</span></div>
                            <div><small>WORST ACCURACY</small><strong class="@GetAccuracyClass(HistoryWorstAccuracy)">@GetAccuracyLabel(HistoryWorstAccuracy)</strong><span>@FormatAccuracy(HistoryWorstAccuracy)</span></div>
                            <div><small>POOR GPS POINTS</small><strong>@HistoryPoorAccuracyCount</strong><span>Accuracy &gt; 100 m</span></div>
                            <div><small>OUTSIDE RANGE</small><strong class="@(HistoryOutsideRangeCount > 0 ? "text-danger" : "text-success")">@HistoryOutsideRangeCount</strong><span>GPS points</span></div>
                            <div><small>SESSIONS</small><strong>@HistorySessionCount</strong><span>Tracking sessions</span></div>
                        </div>

                        @if (HistorySessions.Count > 0)
                        {
                            <div class="gps-session-timeline">
                                <div class="gps-session-title"><i class="bi bi-diagram-3 me-1"></i>GPS Session Timeline</div>
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0 gps-session-table">
                                        <thead><tr><th>Session</th><th>Started</th><th>Last Update</th><th>Duration</th><th>Points</th><th>Travel</th><th>Avg Accuracy</th><th>Status</th></tr></thead>
                                        <tbody>
                                            @foreach (var session in HistorySessions)
                                            {
                                                <tr class="@(selectedPlaybackSessionId == session.SessionId ? "gps-session-row-selected" : "")"
                                                    @onclick="() => SelectPlaybackSession(session.SessionId)"
                                                    title="Play this session route only">
                                                    <td><code>@ShortSessionId(session.SessionId)</code></td>
                                                    <td>@ToLocalTime(session.StartUtc).ToString("HH:mm:ss")</td>
                                                    <td>@ToLocalTime(session.LastUpdateUtc).ToString("HH:mm:ss")</td>
                                                    <td>@FormatDuration(session.EndUtc - session.StartUtc)</td>
                                                    <td>@session.PointCount</td>
                                                    <td>@FormatDistance(session.TravelMeters)</td>
                                                    <td><span class="gps-accuracy-badge @GetAccuracyClass(session.AverageAccuracy)">@GetAccuracyLabel(session.AverageAccuracy) <small>@FormatAccuracy(session.AverageAccuracy)</small></span></td>
                                                    <td>
                                                        @{
                                                            var sessionStatus =
                                                            GetHistorySessionStatus(session.SessionId);
                                                        }

                                                        @if (sessionStatus == "Active")
                                                        {
                                                            <span class="badge bg-success-subtle text-success">
                                                                <i class="bi bi-broadcast me-1"></i>
                                                                Active
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary">
                                                                <i class="bi bi-check-circle me-1"></i>
                                                                Ended
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>


        }
        @if (activeLogTab == "playback")
        {
        <!-- ====================================================
             ROUTE PLAYBACK
             ==================================================== -->
        <div class="location-history-card card border-0 shadow-sm mb-4">
            <div class="location-history-header d-flex justify-content-between align-items-center clickable" @onclick='() => ToggleLogTab("playback")'>
                <div class="history-playback-title">
                    <i class="bi bi-play-circle-fill text-primary me-1"></i>
                    Route Playback
                    @if (activeLogTab == "playback")
                    {
                        @if (selectedPlaybackSessionId.HasValue)
                        {
                            <span class="badge bg-primary-subtle text-primary ms-2">
                                Session @ShortSessionId(selectedPlaybackSessionId.Value)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary ms-2">
                                Full Day
                            </span>
                        }
                    }
                </div>
                <div class="d-flex align-items-center">
                    <i class="bi bi-dash-circle ms-2 opacity-50" title="Minimize"></i>
                </div>
            </div>

            @if (activeLogTab == "playback")
            {
                @if (selectedHistory.Count == 0)
                {
                    <div class="history-empty py-4">
                        <span class="text-muted small">Select a date with GPS history to use playback.</span>
                    </div>
                }
                else
                {
                    <div class="history-playback-toolbar">
                        <div class="history-playback-actions">
                            <button type="button"
                                    class="btn btn-sm @(selectedPlaybackSessionId.HasValue ? "btn-outline-secondary" : "btn-secondary")"
                                    @onclick="SelectFullDayPlayback"
                                    disabled="@(!selectedPlaybackSessionId.HasValue)">
                                <i class="bi bi-calendar3 me-1"></i>
                                Full Day
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-primary"
                                    @onclick="PlayHistory"
                                    disabled="@(!CanPlayback)">
                                <i class="bi bi-play-fill me-1"></i>
                                Play
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="PauseHistory"
                                    disabled="@(!CanPlayback)">
                                <i class="bi bi-pause-fill me-1"></i>
                                Pause
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    @onclick="ResetHistory"
                                    disabled="@(!CanPlayback)">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                Reset
                            </button>

                            <select class="form-select form-select-sm history-speed"
                                    value="@playbackSpeed"
                                    @onchange="ChangePlaybackSpeed">
                                <option value="0.25">0.25×</option>
                                <option value="0.5">0.5×</option>
                                <option value="1">1×</option>
                                <option value="2">2×</option>
                                <option value="4">4×</option>
                                <option value="8">8×</option>
                            </select>
                        </div>
                    </div>

                    <div class="history-playback-progress">
                        <div class="playback-progress-top">
                            <span><i class="bi bi-clock me-1"></i>@playbackStatus</span>
                            <strong>GPS @PlaybackDisplayIndex / @PlaybackPoints.Count</strong>
                        </div>
                        <input type="range"
                               class="form-range playback-range"
                               min="0"
                               max="@(Math.Max(0, PlaybackPoints.Count - 1))"
                               value="@PlaybackIndex"
                               @oninput="SeekHistoryFromSlider" />
                        <div class="playback-progress-bottom">
                            <span>@PlaybackTimeText</span>
                            <span>@PlaybackDistanceText</span>
                        </div>
                    </div>

                    <div class="history-playback-status">
                        <span><i class="bi bi-broadcast me-1"></i>Playback: <strong>@playbackStatus</strong></span>
                        <span><i class="bi bi-geo-alt me-1"></i>@PlaybackPoints.Count GPS points</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover location-history-table mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Time</th>
                                    <th>Accuracy</th>
                                    <th>Distance</th>
                                    <th>Allowed</th>
                                    <th>Status</th>
                                    <th>Latitude</th>
                                    <th>Longitude</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < PlaybackTablePoints.Count; i++)
                                {
                                    var point = PlaybackTablePoints[i];
                                    var globalIndex = PlaybackTableFirstIndex + i;
                                    var historyIndex = selectedHistory.IndexOf(point);
                                    <tr class="@(PlaybackIndex == globalIndex ? "history-row-active" : "")" @onclick="() => SelectHistoryPoint(historyIndex)">
                                        <td><span class="history-point-number">@(globalIndex + 1)</span></td>
                                        <td class="fw-semibold">@(ToLocalTime(point.RecordedAtUtc).ToString("HH:mm:ss"))</td>
                                        <td>@FormatAccuracy(point.AccuracyMeters)</td>
                                        <td>@FormatDistance(point.DistanceFromOfficeMeters)</td>
                                        <td>@point.AllowedRadiusMeters m</td>
                                        <td>
                                            @if (point.IsWithinAllowedRadius)
                                            {
                                                <span class="history-status within"><i class="bi bi-check-circle me-1"></i>Within range</span>
                                            }
                                            else
                                            {
                                                <span class="history-status outside"><i class="bi bi-exclamation-circle me-1"></i>Outside range</span>
                                            }
                                        </td>
                                        <td>@point.Latitude.ToString("F6")</td>
                                        <td>@point.Longitude.ToString("F6")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (PlaybackPoints.Count > PlaybackTablePageSize)
                    {
                        <div class="gps-playback-table-pager">
                            <span>
                                Showing @(PlaybackTableFirstIndex + 1)-@PlaybackTableLastIndex
                                of @PlaybackPoints.Count GPS points
                            </span>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        @onclick="PreviousPlaybackTablePage"
                                        disabled="@(playbackTablePage <= 0)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <span>Page @(playbackTablePage + 1) / @PlaybackTablePageCount</span>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary"
                                        @onclick="NextPlaybackTablePage"
                                        disabled="@(playbackTablePage >= PlaybackTablePageCount - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    }
                }
            }
        </div>
        }
    }
}
