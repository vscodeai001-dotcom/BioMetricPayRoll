@using global::Payroll.Web.Components.Pages.Attendance
@using global::Payroll.Web.Models

<style>
    .attendance-log-table-wrap {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .attendance-log-table {
        width: 100%;
        min-width: 980px;
        table-layout: auto;
    }

    .attendance-log-table .raw-punches-cell {
        min-width: 20rem;
        max-width: 30rem;
        white-space: pre-line !important;
        overflow-wrap: anywhere;
        word-break: break-word;
        line-height: 1.35;
        vertical-align: top;
    }

    .attendance-log-table td,
    .attendance-log-table th {
        vertical-align: middle;
    }

    @@media (max-width: 768px) {
        .attendance-log-table-wrap {
            overflow-x: visible;
        }

        .attendance-log-table {
            min-width: 0;
            width: 100%;
            display: block;
            border: 0;
        }

        .attendance-log-table thead {
            display: none;
        }

        .attendance-log-table tbody,
        .attendance-log-table tr,
        .attendance-log-table td {
            display: block;
            width: 100%;
        }

        .attendance-log-table tr {
            margin: 0 0 .75rem;
            border: 1px solid rgba(128,128,128,.35);
            border-radius: .5rem;
            overflow: hidden;
            background: var(--bs-body-bg, #fff);
        }

        .attendance-log-table td {
            white-space: normal !important;
            padding: .55rem .7rem !important;
            border-width: 0 0 1px 0;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: .75rem;
            text-align: right !important;
        }

        .attendance-log-table td:last-child {
            border-bottom: 0;
        }

        .attendance-log-table td::before {
            content: attr(data-label);
            flex: 0 0 42%;
            max-width: 42%;
            text-align: left;
            font-weight: 600;
            opacity: .8;
        }

        .attendance-log-table td.raw-punches-cell {
            display: block;
            min-width: 0;
            max-width: none;
            text-align: left !important;
            white-space: pre-line !important;
            font-family: var(--bs-font-monospace, monospace);
            font-size: .78rem !important;
            overflow-wrap: anywhere;
        }

        .attendance-log-table td.raw-punches-cell::before {
            display: block;
            max-width: none;
            margin-bottom: .35rem;
        }

        .attendance-log-table td.d-none-mobile {
            display: none !important;
        }

        .attendance-log-table td[data-label="Employee"] {
            font-size: 1rem;
            font-weight: 600;
        }
    }
</style>

@if (IsLoading)
{
    <p><em>Loading data...</em></p>
}
else if (Logs == null || !Logs.Any())
{
    <p class="text-muted"><em>No attendance records found for this period.</em></p>
}
else
{
    <div class="attendance-log-table-wrap table-responsive">
        <table class="table table-sm table-striped table-bordered mt-3 attendance-log-table"
               style="font-size: 0.85em; white-space: nowrap;">

            <thead class="table-dark">
                <tr>
                    <th>Employee</th>
                    <th>Date</th>
                    <th>Status</th>

                    <th class="text-center d-none-mobile">
                        Scheduled (HH:MM)
                    </th>

                    @* NEW: actual worked time INSIDE scheduled shift *@
                    <th class="text-center d-none-mobile"
                        title="Actual worked time inside the scheduled shift">
                        Shift Worked
                    </th>

                    <th class="text-center d-none-mobile"
                        title="Lunch Out-In">
                        Lunch
                    </th>

                    <th class="text-center d-none-mobile">
                        Gross Brk
                    </th>

                    @* Existing Gaps column - unchanged *@
                    <th class="text-center d-none-mobile">
                        Gaps
                    </th>

                    <th class="text-center d-none-mobile">
                        Late
                    </th>

                    <th class="text-center d-none-mobile">
                        Early
                    </th>

                    <th class="text-center text-danger">
                        Penalty
                    </th>

                    <th class="text-center d-none-mobile">
                        OT
                    </th>

                    @* Renamed from Worked to Gross Worked *@
                    <th class="text-center">
                        Gross Worked
                    </th>

                    <th>
                        Raw Punches
                    </th>

                    <th class="text-center">
                        Action
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var record in Logs)
                {
                    <tr>
                        <td data-label="Employee">
                            @record.EmployeeName
                        </td>

                        <td data-label="Date">
                            @record.Date.ToString("dd-MMM (ddd)")
                        </td>

                        <td data-label="Status">
                            <span class="badge @GetStatusColor(record.Status)">
                                @record.Status
                            </span>
                        </td>

                        @* ------------------------------------------------
                           SCHEDULED
                           ------------------------------------------------ *@
                        <td class="text-center d-none-mobile" data-label="Scheduled">
                            @if (record.ShiftStart.HasValue &&
                                                record.ShiftEnd.HasValue)
                            {
                                <div class="small">
                                    @($"{record.ShiftStart:HH:mm} - {record.ShiftEnd:HH:mm}")
                                </div>

                                <div class="fw-bold text-muted"
                                     style="font-size: 0.85em;">
                                    (@FormatTimeSpan(
                                                            record.ScheduledShiftDuration))
                    </div>
                                        }
                            else
                            {
                                @if (record.ScheduledShiftDuration > TimeSpan.Zero)
                                {
                                    <span>@FormatTimeSpan(record.ScheduledShiftDuration)</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            }
                        </td>

                        @* ------------------------------------------------
                           SHIFT WORKED
                           
                           Actual worked time INSIDE scheduled shift.
                           Does NOT include OT.
                           ------------------------------------------------ *@
                        <td class="text-center d-none-mobile fw-bold text-success" data-label="Shift Worked">
                            @FormatTimeSpan(
                            record.ShiftWorkedDuration)
                </td>

                @* ------------------------------------------------
                           LUNCH
                           ------------------------------------------------ *@
                <td class="text-center d-none-mobile small text-muted" data-label="Lunch">
                    @if (record.LunchOut.HasValue &&
                                        record.LunchIn.HasValue)
                            {
                                @($"{record.LunchOut:HH:mm}-{record.LunchIn:HH:mm}")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        @* ------------------------------------------------
                           GROSS BREAK
                           ------------------------------------------------ *@
                        <td class="text-center d-none-mobile" data-label="Gross Brk">
                            @FormatTimeSpan(
                            record.TotalBreakTime)
                </td>

                @* ------------------------------------------------
                           EXISTING GAPS
                           ------------------------------------------------ *@
                <td class="text-center d-none-mobile" data-label="Gaps">
                    @(record.GapsCount > 0
                                        ? record.GapsCount.ToString()
                                        : "-")
                </td>

                        @* ------------------------------------------------
                           LATE
                           ------------------------------------------------ *@
                        <td class="text-center d-none-mobile" data-label="Late">
                            @FormatTimeSpan(
                                        record.LatenessDuration)
                </td>

                @* ------------------------------------------------
                           EARLY
                           ------------------------------------------------ *@
                <td class="text-center d-none-mobile" data-label="Early">
                    @FormatTimeSpan(
                                        record.EarlyLeavePenalty)
                </td>

                @* ------------------------------------------------
                           PENALTY
                           ------------------------------------------------ *@
                <td class="text-center text-danger fw-bold" data-label="Penalty">
                    @FormatTimeSpan(
                                        record.TotalPenalty)
                </td>

                @* ------------------------------------------------
                           OT
                           ------------------------------------------------ *@
                <td class="text-center d-none-mobile" data-label="OT">
                    @FormatTimeSpan(
                                        record.OvertimeDuration)
                </td>

                @* ------------------------------------------------
                           GROSS WORKED
                           
                           Shift Worked + OT.
                           This replaces the old "Worked" label.
                           ------------------------------------------------ *@
                <td class="text-center fw-bold" data-label="Gross Worked">
                    @FormatDecimal(
                                        record.FinalWorkedHours)
                </td>

                @* ------------------------------------------------
                           RAW PUNCHES
                           ------------------------------------------------ *@
                <td class="small text-muted raw-punches-cell" data-label="Raw Punches"
                    title="@record.Punches">
                    @record.Punches
                </td>

                @* ------------------------------------------------
                           ACTION
                           ------------------------------------------------ *@
                <td class="text-center" data-label="Action">
                    @if (CanCorrect(record.Status))
                            {
                                <button class="btn btn-sm btn-outline-warning py-0 px-1"
                                        @onclick="() => OnCorrect.InvokeAsync(record)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public List<AttendanceLogDto>? Logs { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<AttendanceLogDto> OnCorrect { get; set; }

    private bool CanCorrect(string status) =>
        status == "Absent" ||
        status.StartsWith("Loss");

    private string GetStatusColor(string status) =>
        status switch
        {
            "Present" => "bg-success",
            "Absent" => "bg-danger",
            "Half Day" => "bg-warning text-dark",
            _ => "bg-secondary"
        };

    private string FormatTimeSpan(TimeSpan ts)
    {
        if (ts < TimeSpan.Zero)
        {
            ts = TimeSpan.Zero;
        }

        return $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}";
    }

    private string FormatDecimal(decimal d)
    {
        if (d < 0)
        {
            d = 0;
        }

        var ts =
            TimeSpan.FromHours(
                (double)d);

        ts =
            TimeSpan.FromMinutes(
                Math.Round(ts.TotalMinutes));

        return
            $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}";
    }
}