@using Microsoft.JSInterop

@implements IAsyncDisposable

@inject IJSRuntime JSRuntime


@code {

    // ============================================================
    // CALLBACKS
    // ============================================================

    [Parameter]
    public EventCallback OnAttendanceChanged { get; set; }


    [Parameter]
    public EventCallback OnLocationChanged { get; set; }


    [Parameter]
    public EventCallback OnSessionStarted { get; set; }


    [Parameter]
    public EventCallback OnRegularizationChanged { get; set; }


    // ============================================================
    // SIGNALR JS REFERENCE
    // ============================================================

    private DotNetObjectReference<AttendanceRefreshListener>?
        _dotNetRef;

    private bool _registered;

    private bool _disposed;


    // ============================================================
    // START
    // ============================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        try
        {
            _dotNetRef =
                DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(
                "attendanceRefresh.register",
                _dotNetRef);

            _registered = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Attendance refresh registration failed: {ex}");
        }
    }


    // ============================================================
    // ATTENDANCE CHANGED
    // ============================================================

    [JSInvokable]
    public async Task AttendanceChanged(object? data = null)
    {
        if (_disposed)
            return;

        try
        {
            if (OnAttendanceChanged.HasDelegate)
            {
                await InvokeAsync(
                    () =>
                        OnAttendanceChanged.InvokeAsync());
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"AttendanceChanged callback failed: {ex}");
        }
    }


    // ============================================================
    // APPLICATION-WIDE DATABASE CHANGED
    // ============================================================

    [JSInvokable]
    public async Task ApplicationDataChanged(object? data = null)
    {
        if (_disposed)
            return;

        try
        {
            if (OnAttendanceChanged.HasDelegate)
            {
                await InvokeAsync(
                    () =>
                        OnAttendanceChanged.InvokeAsync());
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"ApplicationDataChanged callback failed: {ex}");
        }
    }


    // ============================================================
    // LOCATION CHANGED
    // ============================================================

    [JSInvokable]
    public async Task LocationChanged(
        object? data)
    {
        if (_disposed)
            return;

        try
        {
            if (OnLocationChanged.HasDelegate)
            {
                await InvokeAsync(
                    () =>
                        OnLocationChanged.InvokeAsync());
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"LocationChanged callback failed: {ex}");
        }
    }


    // ============================================================
    // GPS SESSION STARTED
    // ============================================================

    [JSInvokable]
    public async Task SessionStarted(object? data = null)
    {
        if (_disposed)
            return;

        try
        {
            if (OnSessionStarted.HasDelegate)
            {
                await InvokeAsync(
                    () =>
                        OnSessionStarted.InvokeAsync());
            }
            else if (OnLocationChanged.HasDelegate)
            {
                // Fallback to LocationChanged for components that don't
                // distinguish session starts but need to refresh members.
                await InvokeAsync(
                    () =>
                        OnLocationChanged.InvokeAsync());
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"SessionStarted callback failed: {ex}");
        }
    }


    // ============================================================
    // REGULARIZATION CHANGED
    // ============================================================

    [JSInvokable]
    public async Task RegularizationChanged(object? data = null)
    {
        if (_disposed)
            return;

        try
        {
            if (OnRegularizationChanged.HasDelegate)
            {
                await InvokeAsync(
                    () =>
                        OnRegularizationChanged.InvokeAsync());
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"RegularizationChanged callback failed: {ex}");
        }
    }


    // ============================================================
    // DISPOSE
    // ============================================================

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;

        try
        {
            if (_dotNetRef != null &&
                _registered)
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregister",
                    _dotNetRef);
            }
        }
        catch
        {
            // Circuit may already be disconnected.
        }
        finally
        {
            _registered = false;

            _dotNetRef?.Dispose();

            _dotNetRef = null;
        }
    }

}