@using global::Payroll.Web.Services
@using global::Payroll.Shared.Data
@inject ITenantContextService TenantContext
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (isSuperAdmin && activeTenant != null)
{
    <div class="superadmin-context-banner shadow-sm">
        <div class="container-fluid px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                    <i class="bi bi-shield-shaded me-1"></i>👑 SuperAdmin Mode
                </span>
                <span class="text-white-50 small">Active Workspace:</span>
                <span class="fw-bold text-white fs-6">
                    <span class="me-1">@activeTenant.IconEmoji</span>@activeTenant.CompanyName
                </span>
                <span class="badge bg-light text-dark fw-bold px-2">@activeTenant.CompanyCode</span>
                <span class="badge @(activeTenant.PlanMode == "Blaze" ? "bg-danger" : "bg-success") px-2">
                    @(activeTenant.PlanMode == "Blaze" ? "🔥 Blaze" : "⚡ Spark")
                </span>
                <span class="text-white-50 small ms-2 d-none d-md-inline">
                    <i class="bi bi-person me-1"></i>@activeTenant.AdminEmail
                </span>
            </div>

            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                @if (allTenants.Count == 2)
                {
                    var otherTenant = allTenants.FirstOrDefault(t => t.TenantId != activeTenant.TenantId) ?? allTenants.First();
                    <button class="btn btn-sm btn-outline-light rounded-pill px-2.5 py-1 text-nowrap d-inline-flex align-items-center gap-1 shadow-sm" type="button"
                            @onclick="() => SwitchTenant(otherTenant.TenantId)"
                            title="Switch directly to @otherTenant.CompanyName (@otherTenant.CompanyCode)">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Switch to @otherTenant.CompanyCode</span>
                    </button>
                }
                else if (allTenants.Count > 2)
                {
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-light dropdown-toggle rounded-pill px-2.5 py-1 text-nowrap d-inline-flex align-items-center gap-1 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-arrow-left-right"></i>
                            <span>Switch Company</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            @foreach (var tenant in allTenants)
                            {
                                <li>
                                    <button class="dropdown-item d-flex align-items-center justify-content-between @(tenant.TenantId == activeTenant.TenantId ? "active fw-bold" : "")"
                                            @onclick="() => SwitchTenant(tenant.TenantId)">
                                        <span><span class="me-2">@tenant.IconEmoji</span>@tenant.CompanyName</span>
                                        <span class="badge bg-secondary ms-2">@tenant.CompanyCode</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <button class="btn btn-sm btn-warning text-dark fw-bold" @onclick="GoToSuperAdminPortal">
                    <i class="bi bi-grid-fill me-1"></i>SuperAdmin Portal
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isSuperAdmin = false;
    private CompanyTenant? activeTenant;
    private List<CompanyTenant> allTenants = new();

    protected override async Task OnInitializedAsync()
    {
        TenantContext.OnTenantChanged += HandleTenantChanged;
        await LoadStateAsync();
    }

    private async Task LoadStateAsync()
    {
        isSuperAdmin = await TenantContext.IsSuperAdminAsync();
        if (isSuperAdmin)
        {
            activeTenant = await TenantContext.GetActiveTenantAsync();
            allTenants = await TenantContext.GetAllTenantsAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleTenantChanged()
    {
        await LoadStateAsync();
    }

    private async Task SwitchTenant(string tenantId)
    {
        await TenantContext.SetActiveTenantIdAsync(tenantId);
        try
        {
            await JSRuntime.InvokeVoidAsync("setTenantCookie", tenantId);
        }
        catch { }
        await LoadStateAsync();
        Navigation.NavigateTo(Navigation.Uri, true);
    }

    private void GoToSuperAdminPortal()
    {
        Navigation.NavigateTo("/superadmin/tenants");
    }

    public void Dispose()
    {
        TenantContext.OnTenantChanged -= HandleTenantChanged;
    }
}
