@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IToastService toastService

@if (IsSuperAdmin || Features?.EnableStatutoryCompliance == true || Features?.EnableProfessionalTax == true)
{
    <div class="row g-4">
        @* --- PF & ESI --- *@
        <div class="col-lg-6">
            @if (IsSuperAdmin || Features?.EnableStatutoryCompliance == true)
            {
                <div class="card border rounded-4 shadow-sm h-100">
                    <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5">🏛️</span>
                            <h6 class="mb-0 fw-bold text-primary">Provident Fund (PF) &amp; ESI</h6>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(Settings.EnablePfEsiSystem ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") px-2 py-1 rounded-pill small">
                                @(Settings.EnablePfEsiSystem ? "✓ Active" : "Disabled")
                            </span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="Settings.EnablePfEsiSystem">
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        @if (Settings.EnablePfEsiSystem)
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary">
                                        <i class="bi bi-currency-rupee text-success"></i> ESI Wage Limit (₹)
                                    </label>
                                    <input type="number" class="form-control rounded-3" @bind="Settings.EsiWageLimit" placeholder="21000" />
                                    <div class="form-text small text-muted">Statutory monthly ceiling (₹21,000).</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary">
                                        <i class="bi bi-percent text-primary"></i> Basic Salary %
                                    </label>
                                    <input type="number" class="form-control rounded-3" @bind="Settings.BasicSalaryPercentage" placeholder="40" />
                                    <div class="form-text small text-muted">% of Gross allocated to Basic.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary">
                                        <i class="bi bi-person-fill text-primary"></i> Employee PF %
                                    </label>
                                    <input type="number" class="form-control rounded-3" @bind="Settings.EmployerPfPercentage" placeholder="12" />
                                    <div class="form-text small text-muted">Deducted from employee (12%).</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold text-secondary">
                                        <i class="bi bi-heart-pulse-fill text-danger"></i> Employee ESI %
                                    </label>
                                    <input type="number" class="form-control rounded-3" @bind="Settings.EmployerEsiPercentage" placeholder="0.75" />
                                    <div class="form-text small text-muted">Medical contribution (0.75%).</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted bg-body-tertiary rounded-3 border">
                                <i class="bi bi-slash-circle fs-3 text-secondary d-block mb-2"></i>
                                <span class="fw-semibold">PF &amp; ESI System is currently disabled</span>
                                <div class="small text-muted mt-1">Toggle the switch above to enable statutory deductions on payroll runs.</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* --- PROFESSIONAL TAX --- *@
        <div class="col-lg-6">
            @if (IsSuperAdmin || Features?.EnableProfessionalTax == true)
            {
                <div class="card border rounded-4 shadow-sm h-100">
                    <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5">📑</span>
                            <h6 class="mb-0 fw-bold text-info">Professional Tax (PT)</h6>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(Settings.EnableProfessionalTax ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") px-2 py-1 rounded-pill small">
                                @(Settings.EnableProfessionalTax ? "✓ Active" : "Disabled")
                            </span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="Settings.EnableProfessionalTax">
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        @if (Settings.EnableProfessionalTax)
                        {
                            <div>
                                <p class="small text-muted mb-3">
                                    State-mandated monthly deductions based on gross earnings. Slabs define exact tax amounts per salary bracket.
                                </p>
                                <div class="p-3 border rounded-3 bg-body-tertiary mb-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-layers-fill text-info fs-4"></i>
                                        <div>
                                            <div class="fw-bold small">Configured Slabs</div>
                                            <div class="text-muted small">State taxation rules</div>
                                        </div>
                                    </div>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill fw-bold">
                                        @(ptSlabs?.Count ?? 0) Active Slabs
                                    </span>
                                </div>
                            </div>
                            <button class="btn btn-outline-primary rounded-pill px-4 py-2 w-100 mt-2" @onclick="OpenSlabModal">
                                <i class="bi bi-table me-2"></i> Manage PT Slabs &amp; Brackets
                            </button>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted bg-body-tertiary rounded-3 border">
                                <i class="bi bi-slash-circle fs-3 text-secondary d-block mb-2"></i>
                                <span class="fw-semibold">Professional Tax is currently disabled</span>
                                <div class="small text-muted mt-1">Toggle the switch above to activate PT deduction brackets.</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* --- SHIFT ALLOWANCE --- *@
        @if (IsSuperAdmin || Features?.EnableShiftAllowance == true)
        {
            <div class="col-12">
                <div class="card border rounded-4 shadow-sm">
                    <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5">🌙</span>
                            <h6 class="mb-0 fw-bold text-warning">Night Shift Allowance Policy</h6>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(Settings.EnableShiftAllowance ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") px-2 py-1 rounded-pill small">
                                @(Settings.EnableShiftAllowance ? "✓ Active" : "Disabled")
                            </span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="Settings.EnableShiftAllowance">
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        @if (Settings.EnableShiftAllowance)
                        {
                            <div class="d-flex align-items-start gap-3 p-3 bg-warning-subtle bg-opacity-25 border border-warning-subtle rounded-3">
                                <i class="bi bi-moon-stars-fill text-warning fs-3 mt-1"></i>
                                <div>
                                    <h6 class="fw-bold mb-1 text-warning">Midnight Shift Benefit Active</h6>
                                    <p class="small text-muted mb-0">
                                        Employees assigned a "Night Shift Allowance" in their staff profile will automatically receive this allowance on any shift that crosses midnight (e.g. 22:00 to 06:00).
                                    </p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-muted bg-body-tertiary rounded-3 border small">
                                <i class="bi bi-info-circle me-1"></i> Shift allowance system is disabled. Night shifts will be calculated purely on regular hourly/monthly rates.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">Statutory Module is not enabled for your subscription.</div>
}

@* --- SLAB MODAL (Internal to this component now) --- *@
@if (showSlabModal)
{
    <div class="modal fade show" style="display:block; background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h5 class="modal-title">Manage Professional Tax Slabs</h5>
                    <button type="button" class="btn-close" @onclick="CloseSlabModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 align-items-end mb-3 border-bottom pb-3">
                        <div class="col-md-4"><label class="small fw-bold">Min Salary</label><input type="number" class="form-control form-control-sm" @bind="newSlab.MinSalary" placeholder="0" /></div>
                        <div class="col-md-4"><label class="small fw-bold">Max Salary</label><input type="number" class="form-control form-control-sm" @bind="newSlab.MaxSalary" placeholder="999999" /></div>
                        <div class="col-md-3"><label class="small fw-bold">Tax (₹)</label><input type="number" class="form-control form-control-sm" @bind="newSlab.TaxAmount" /></div>
                        <div class="col-md-1">
                            @if (newSlab.SlabID == 0)
                            {
                                <button class="btn btn-sm btn-success w-100" @onclick="SaveSlab" title="Add"><i class="bi bi-plus-lg"></i></button>
                            }
                            else
                            {

                                <div class="d-flex"><button class="btn btn-sm btn-primary w-50 me-1 p-0" @onclick="SaveSlab"><i class="bi bi-check-lg"></i></button><button class="btn btn-sm btn-secondary w-50 p-0" @onclick="CancelEdit"><i class="bi bi-x-lg"></i></button></div>
                            }
                        </div>
                    </div>
                    <table class="table table-sm table-striped table-bordered text-center">
                        <thead class="table-light"><tr><th>Min (₹)</th><th>Max (₹)</th><th>Tax (₹)</th><th>Actions</th></tr></thead>
                        <tbody>
                            @if (ptSlabs != null && ptSlabs.Any())
                            {
                                @foreach (var slab in ptSlabs.OrderBy(s => s.MinSalary))
                                {
                                    <tr class="@(newSlab.SlabID == slab.SlabID ? "table-primary" : "")">
                                        <td>@slab.MinSalary.ToString("N0")</td>
                                        <td>@slab.MaxSalary.ToString("N0")</td>
                                        <td>@slab.TaxAmount.ToString("N0")</td>
                                        <td><button class="btn btn-sm btn-outline-primary py-0 me-1" @onclick="() => EditSlab(slab)"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteSlab(slab)"><i class="bi bi-trash"></i></button></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-muted">No slabs defined.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public CompanySetting Settings { get; set; } = new();
    [Parameter] public FeatureSettings? Features { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }

    // Local State for Modal
    private bool showSlabModal = false;
    private List<ProfessionalTaxSlab> ptSlabs = new();
    private ProfessionalTaxSlab newSlab = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPtSlabs();
    }

    private async Task LoadPtSlabs()
    {
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            ptSlabs = await dbContext.ProfessionalTaxSlabs.ToListAsync();
            ptSlabs = ptSlabs.OrderBy(s => s.MinSalary).ToList();
        }
        catch { }
    }

    // PT Logic confined to this component
    private void OpenSlabModal() { newSlab = new ProfessionalTaxSlab(); showSlabModal = true; }
    private void CloseSlabModal() { showSlabModal = false; }
    private void CancelEdit() { newSlab = new ProfessionalTaxSlab(); }
    private void EditSlab(ProfessionalTaxSlab slab) { newSlab = new ProfessionalTaxSlab { SlabID = slab.SlabID, MinSalary = slab.MinSalary, MaxSalary = slab.MaxSalary, TaxAmount = slab.TaxAmount }; }

    private async Task SaveSlab()
    {
        if (newSlab.MaxSalary < newSlab.MinSalary) { toastService.ShowWarning("Max > Min required."); return; }
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        if (newSlab.SlabID == 0) dbContext.ProfessionalTaxSlabs.Add(newSlab);
        else
        {
            var ex = await dbContext.ProfessionalTaxSlabs.FindAsync(newSlab.SlabID);
            if (ex != null) { ex.MinSalary = newSlab.MinSalary; ex.MaxSalary = newSlab.MaxSalary; ex.TaxAmount = newSlab.TaxAmount; }
        }
        await dbContext.SaveChangesAsync();
        await LoadPtSlabs();
        newSlab = new ProfessionalTaxSlab();
        toastService.ShowSuccess("Slab saved.");
    }

    private async Task DeleteSlab(ProfessionalTaxSlab slab)
    {
        await using var dbContext = await DbFactory.CreateDbContextAsync();
        dbContext.ProfessionalTaxSlabs.Remove(slab);
        await dbContext.SaveChangesAsync();
        await LoadPtSlabs();
        toastService.ShowSuccess("Deleted.");
    }
}