@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@inject IToastService toastService
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject IDbContextFactory<AppDbContext> DbFactory

@if (Features?.EnableLeaveManagement != true && !IsSuperAdmin)
{
    <div class="alert alert-warning">
        <i class="bi bi-lock-fill me-2"></i> Leave Management Module is disabled.
    </div>
}
else
{
    <div class="row g-4">
        @* --- LEFT COL: RULES CONFIGURATION --- *@
        <div class="col-lg-5 d-flex flex-column gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-5">🏖️</span>
                <h6 class="mb-0 fw-bold text-primary">Leave Policies &amp; Accrual Rules</h6>
            </div>

            @{
                bool anyRuleVisible = false;
            }

            @* --- ACCRUAL RULE --- *@
            @if (IsSuperAdmin || Features?.EnableLeaveAccrual == true)
            {
                anyRuleVisible = true;
                <div class="card border rounded-4 shadow-sm">
                    <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5">📈</span>
                            <h6 class="fw-bold mb-0 text-primary">Automatic Monthly Accrual</h6>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(Settings.EnableLeaveAccrual ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") px-2 py-1 rounded-pill small">
                                @(Settings.EnableLeaveAccrual ? "✓ Active" : "Disabled")
                            </span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="Settings.EnableLeaveAccrual" id="c_accrual">
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <label class="form-label small fw-bold text-secondary">
                            <i class="bi bi-calendar-plus text-primary me-1"></i> Days Credited Monthly
                        </label>
                        <div class="input-group">
                            <input type="number" step="0.1" class="form-control rounded-start-3" @bind="Settings.LeaveAccrualRate" disabled="@(!Settings.EnableLeaveAccrual)" />
                            <span class="input-group-text bg-body-tertiary">Days / Month</span>
                        </div>
                        <small class="text-muted d-block mt-1">Standard entitlement is 1.5 days credited per completed work month.</small>
                    </div>
                </div>
            }

            @* --- SANDWICH RULE --- *@
            @if (IsSuperAdmin || Features?.EnableSandwichRule == true)
            {
                anyRuleVisible = true;
                <div class="card border rounded-4 shadow-sm">
                    <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-5">🥪</span>
                            <h6 class="fw-bold mb-0 text-warning">Sandwich Rule Policy</h6>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge @(Settings.EnableSandwichRule ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border") px-2 py-1 rounded-pill small">
                                @(Settings.EnableSandwichRule ? "✓ Active" : "Disabled")
                            </span>
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="Settings.EnableSandwichRule" id="c_sandwich">
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-0">
                            When enabled, non-working days (weekoffs or company holidays) sandwiched directly between two approved leave days will be treated as leave and deducted from the employee balance.
                        </p>
                    </div>
                </div>
            }

            @* --- FALLBACK IF NO RULES VISIBLE --- *@
            @if (!anyRuleVisible)
            {
                <div class="p-4 text-center text-muted bg-body-tertiary rounded-3 border">
                    <i class="bi bi-info-circle fs-3 text-secondary d-block mb-2"></i>
                    <span class="fw-semibold">No advanced leave automation rules enabled</span>
                    <div class="small text-muted mt-1">Employees can still apply for leave manually.</div>
                </div>
            }
        </div>

        @* --- RIGHT COL: EMPLOYEE BALANCES MANAGER --- *@
        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-secondary mb-0">Employee Balances</h5>
                <button class="btn btn-sm btn-success" @onclick="SaveBalances" disabled="@isSavingBalances">
                    @if (isSavingBalances)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-save me-1"></i>
                    }
                    Update Balances
                </button>
            </div>

            <div class="alert alert-info py-2 px-3 small mb-3">
                <i class="bi bi-info-circle-fill me-2"></i> 
                Use this table to manually adjust opening balances or correct discrepancies.
            </div>

            @if (isLoadingEmployees)
            {
                <p class="text-center text-muted my-5"><em>Loading employee list...</em></p>
            }
            else
            {
                <div class="table-responsive border rounded bg-white" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-sm table-hover small mb-0 align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3">Employee</th>
                                <th style="width: 120px;">Paid Bal</th>
                                <th style="width: 120px;">Sick Bal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Employees)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <strong>@emp.Name</strong><br />
                                        <span class="text-muted" style="font-size:0.85em">ID: @emp.BiometricID</span>
                                    </td>
                                    <td>
                                        <input type="number" step="0.5" class="form-control form-control-sm text-end" @bind="emp.PaidLeaveBalance" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.5" class="form-control form-control-sm text-end" @bind="emp.SickLeaveBalance" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public CompanySetting Settings { get; set; } = new();
    [Parameter] public FeatureSettings? Features { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }

    private List<Employee> Employees = new();
    private bool isLoadingEmployees = false;
    private bool isSavingBalances = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        // Only load if module is enabled OR user is SuperAdmin
        if (Features?.EnableLeaveManagement != true && !IsSuperAdmin) return;

        isLoadingEmployees = true;
        try
        {
            Employees = (await FirebaseEmployees.GetEmployeesAsync())
                .Where(e => !e.TerminationDate.HasValue) // Active Only
                .OrderBy(e => e.Name)
                .ToList();
        }
        catch (Exception) { /* Ignore for UI component */ }
        finally { isLoadingEmployees = false; }
    }

    private async Task SaveBalances()
    {
        isSavingBalances = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();

            foreach (var emp in Employees)
            {
                dbContext.Employees.Attach(emp);
                dbContext.Entry(emp).Property(e => e.PaidLeaveBalance).IsModified = true;
                dbContext.Entry(emp).Property(e => e.SickLeaveBalance).IsModified = true;
            }

            await dbContext.SaveChangesAsync();
            toastService.ShowSuccess("Employee leave balances updated.");
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error updating balances: {ex.Message}");
        }
        finally
        {
            isSavingBalances = false;
        }
    }
}