                                    <NavLink class="nav-link" href="admin/audit-logs">
                                        <i class="bi bi-journal-text me-2"></i> Audit Logs
                                    </NavLink>
                                </div>
                            }
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="admin/attendance-event-monitoring">
                                    <i class="bi bi-activity me-2"></i> Attendance Event Monitoring
                                </NavLink>
                            </div>
                        </AuthorizeView>

                        @* --- SUPERADMIN OR PERMITTED ADMIN LINK --- *@
                        @if (userIsSuperAdmin || settings.AdminCanManageEmployeePermissions)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="admin/feature-toggles">
                                    <i class="bi bi-toggle-on me-2"></i> Feature Toggles
                                </NavLink>
                            </div>
