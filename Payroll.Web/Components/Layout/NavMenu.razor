                                    @* Resignation (NEW) *@
                                    @if (settings.EnableResignationModule && settings.EmployeeCanViewResignation)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-resignation">
                                                <i class="bi bi-door-open me-2"></i> My Resignation
