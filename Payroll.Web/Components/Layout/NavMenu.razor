@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared
@using global::Payroll.Web.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<NavMenu> _logger
@inject IAppModeService AppMode

<input type="checkbox" title="Navigation menu" aria-label="Open navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        @if (settings == null)
        {
            <div class="nav-item px-3">
                <span class="nav-link">Loading menu...</span>
            </div>
        }
        else
        {
            @* --- Check for Admin/SuperAdmin FIRST --- *@
            <AuthorizeView Roles="Admin, SuperAdmin" Context="authContext">
                <Authorized>
                    @* --- ADMIN/SUPERADMIN MENU --- *@

                    @* 0. SuperAdmin Command Center (Online Multi-Tenant Mode Only) *@
                    @if (userIsSuperAdmin && !AppMode.IsOfflineMode)
                    {
                        <div class="nav-item px-3 mb-2">
                            <NavLink class="nav-link text-warning fw-bold border border-warning rounded-2 py-2" href="superadmin/tenants">
                                <span class="me-2">👑</span> Multi-Tenant Portal
                            </NavLink>
                        </div>
                    }

                    @* 1. Admin Dashboard *@
                    @if (userIsSuperAdmin || settings.AdminCanViewDashboard)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                                <span class="me-2">⚡</span> Admin Dashboard
                            </NavLink>
                        </div>
                    }

                    @* 2. Payroll Section *@
                    @if (userIsSuperAdmin || settings.EnablePayroll || settings.EnableSalaryAdvance || settings.EnableBonusManagement || settings.EnableResignationModule)
                    {
                        <details class="nav-group" open>
                            <summary class="nav-group-title px-3">
                                <span class="me-2">💰</span> Payroll Management
                            </summary>
                            @if (userIsSuperAdmin || (settings.EnablePayroll && settings.AdminCanRunPayroll))
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="run-payroll">
                                        <span class="me-2">💸</span> Run Payroll
                                    </NavLink>
                                </div>
                            }
                            @* --- YEAR-END SUMMARY LINK --- *@
                            @if (userIsSuperAdmin || (settings.AdminCanViewReports && settings.EnableYearEndSummary))
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="admin/year-end-summary">
                                        <span class="me-2">📊</span> Year-End Summary
                                    </NavLink>
                                </div>
                            }
                            @* --- SALARY ADVANCES --- *@
                            @if (userIsSuperAdmin || settings.EnableSalaryAdvance)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="salary-advances">
                                        <span class="me-2">💳</span> Salary Advances
                                    </NavLink>
                                </div>
                            }
                            @* --- TAX DECLARATIONS --- *@
                            @if (userIsSuperAdmin || (settings.EnablePayroll && settings.EnableTaxDeclarations))
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="admin/tax-declarations">
                                        <span class="me-2">📑</span> Tax Declarations
                                    </NavLink>
                                </div>
                            }
                            @* --- BONUS MANAGEMENT --- *@
                            @if (userIsSuperAdmin || settings.EnableBonusManagement)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="bonus-management">
                                        <span class="me-2">🎁</span> Bonus Management
                                    </NavLink>
                                </div>
                            }
                            @* --- FBP COMPONENT SETUP (Admin Link) --- *@
                            @if (userIsSuperAdmin || settings.EnableFlexibleBenefits)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="admin/fbp-components">
                                        <span class="me-2">🪙</span> FBP Component Setup
                                    </NavLink>
                                </div>
                            }
                            @* --- EXIT MANAGEMENT --- *@
                            @if (userIsSuperAdmin || (settings.EnablePayroll && settings.EnableResignationModule))
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="admin/exit-management">
                                        <span class="me-2">🚪</span> Exit &amp; Settlement
                                    </NavLink>
                                </div>
                            }
                        </details>
                    }

                    @* 3. Attendance Section *@
                    @if (userIsSuperAdmin || settings.AdminCanViewAttendance)
                    {
                        <details class="nav-group" open>
                            <summary class="nav-group-title px-3">
                                <span class="me-2">⏱️</span> Attendance &amp; Tracking
                            </summary>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="attendancelogs">
                                    <span class="me-2">📋</span> Daily Logs (All)
                                </NavLink>
                            </div>
                            @if (userIsSuperAdmin || (settings.EnableCompanyReports && settings.AdminCanViewReports))
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="company-attendance-report">
                                        <span class="me-2">📈</span> Company Report
                                    </NavLink>
                                </div>
                                @* --- ADMIN REPORT CENTER LINK --- *@
                                @if (settings.EnableCustomReporting)
                                {
                                    <div class="nav-item px-3">
                                        <NavLink class="nav-link" href="admin/report-center">
                                            <span class="me-2">📊</span> Report Center
                                        </NavLink>
                                    </div>
                                }
                            }
                            @if (userIsSuperAdmin || settings.EnableLeaveManagement)
                            {
                                @* HIGHLIGHT LEAVE LINK WITH PENDING COUNT *@
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="leave-management">
                                        <span class="me-2">🏖️</span> Leave Management
                                        @if (PendingLeaveCount > 0)
                                        {
                                            <span class="badge bg-warning text-dark ms-auto">@PendingLeaveCount</span>
                                        }
                                    </NavLink>
                                </div>
                            }
                            @if (userIsSuperAdmin || (settings.EnableShiftScheduling && settings.AdminCanManageShifts))
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="schedule">
                                        <span class="me-2">🗓️</span> Shift Schedule
                                    </NavLink>
                                </div>
                            }
                            @if (userIsSuperAdmin || settings.EnablePunchCorrection)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="manual-punch-correction">
                                        <span class="me-2">✏️</span> Punch Correction
                                    </NavLink>
                                </div>
                                @if (userIsSuperAdmin || settings.AdminCanManagePunchApprovals)
                                {
                                    <div class="nav-item px-3">
                                        <NavLink class="nav-link" href="attendance/punch-approval">
                                            <span class="me-2">🛡️</span> Punch Approvals
                                        </NavLink>
                                    </div>
                                }
                                 @* --- Regularization Approval Link --- *@
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="attendance/regularization-approval">
                                        <span class="me-2">⏳</span> Regularization Approval
                                    </NavLink>
                                </div>
                            }
                            @if (userIsSuperAdmin || settings.EnableGeoFencing)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="admin/offline-tracking-details">
                                        <span class="me-2">📡</span> Offline Tracking
                                    </NavLink>
                                </div>
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="admin/location-tracking-history">
                                        <span class="me-2">📍</span> Location History
                                    </NavLink>
                                </div>
                            }
                        </details>
                    }

                    @* 4. Admin & Settings Section *@
                    <details class="nav-group" open>
                        <summary class="nav-group-title px-3">
                            <span class="me-2">⚙️</span> Admin &amp; Settings
                        </summary>
                        @if (userIsSuperAdmin || (settings.EnableEmployeeManagement && settings.AdminCanManageEmployees))
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="employees">
                                    <span class="me-2">👥</span> Employee Records
                                </NavLink>
                            </div>
                        }

                        @* Accessible to both SuperAdmin & Company Admin *@
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="admin/users">
                                <span class="me-2">🛡️</span> User &amp; Role Mgmt
                            </NavLink>
                        </div>

                        @if (userIsSuperAdmin || settings.AdminCanEditSettings)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="holidays">
                                    <span class="me-2">🏖️</span> Holiday Management
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="settings/company">
                                    <span class="me-2">⚙️</span> Company Settings
                                </NavLink>
                            </div>
                        }

                        @* --- RECYCLE BIN (SuperAdmin only) --- *@
                        @if (userIsSuperAdmin && settings.EnableRecycleBin)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link text-danger" href="admin/recycle-bin">
                                    <span class="me-2">🗑️</span> Recycle Bin
                                </NavLink>
                            </div>
                        }
                        @* --- AUDIT LOGS & EVENT MONITORING --- *@
                        @if (userIsSuperAdmin || settings.EnableAuditLog)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="admin/audit-logs">
                                    <span class="me-2">📜</span> Audit Logs
                                </NavLink>
                                <NavLink class="nav-link" href="admin/attendance-event-monitoring">
                                    <span class="me-2">🛰️</span> Attendance Event Monitoring
                                </NavLink>
                            </div>
                        }

                        @* --- SUPERADMIN OR PERMITTED ADMIN LINK --- *@
                        @if (userIsSuperAdmin || settings.AdminCanManageFeatureToggles || settings.AdminCanManageEmployeePermissions)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="admin/feature-toggles">
                                    <span class="me-2">🎛️</span> Feature Toggles
                                </NavLink>
                            </div>
                        }
                    </details>

                    @* Employee Tools (SA View) completely removed per user request *@
                </Authorized>
                <NotAuthorized>
                    @* --- THIS IS THE EMPLOYEE-ONLY MENU (standard logic) --- *@
                    <AuthorizeView Roles="Employee">
                        <Authorized>
                            @if (settings.EmployeeCanViewDashboard)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="employee-home" Match="NavLinkMatch.All">
                                        <span class="me-2">🏠</span> Employee Home
                                    </NavLink>
                                </div>
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="my-profile">
                                        <span class="me-2">👤</span> My Profile
                                    </NavLink>
                                </div>
                            }
                            @if (settings.EmployeeToolsVisible)
                            {
                                <details class="nav-group" open>
                                    <summary class="nav-group-title px-3">
                                        <span class="me-2">👤</span> Employee Tools
                                    </summary>
                                    @if (settings.EnablePayroll && settings.EmployeeCanViewPayslip)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-payslips">
                                                <span class="me-2">📄</span> My Payslips
                                            </NavLink>
                                        </div>
                                    }
                                    @if (settings.EmployeeCanViewAttendance)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-attendance">
                                                <span class="me-2">📅</span> My Attendance
                                            </NavLink>
                                        </div>
                                    }
                                    @if (settings.EnableLeaveManagement && settings.EmployeeCanViewLeave)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-leave-request">
                                                <span class="me-2">🏖️</span> Request Leave
                                            </NavLink>
                                        </div>
                                    }
                                    @if (settings.EnableLeaveManagement && settings.EmployeeCanViewLeaveHistory)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-leave-history">
                                                <span class="me-2">📜</span> My Leave History
                                            </NavLink>
                                        </div>
                                    }
                                    @if (settings.EnableShiftScheduling && settings.EmployeeCanViewShifts)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-shifts">
                                                <span class="me-2">🗓️</span> My Shift Schedule
                                            </NavLink>
                                        </div>
                                    }
                                    @if (settings.EnableSalaryAdvance && settings.EmployeeCanViewAdvance)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-salary-advances">
                                                <span class="me-2">💳</span> My Salary Advances
                                            </NavLink>
                                        </div>
                                    }
                                    @* Tax Declaration (NEW) *@
                                    @if (settings.EnableTaxDeclarations && settings.EmployeeCanViewTax)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-tax-declaration">
                                                <span class="me-2">📑</span> My Tax Declaration
                                            </NavLink>
                                        </div>
                                    }
                                    @* Bonuses *@
                                    @if (settings.EnableBonusManagement && settings.EmployeeCanViewBonus)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-bonuses">
                                                <span class="me-2">🎁</span> My Bonuses
                                            </NavLink>
                                        </div>
                                    }
                                    @* Resignation (NEW) *@
                                    @if (settings.EnableResignationModule && settings.EmployeeCanViewResignation)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-resignation">
                                                <span class="me-2">🚪</span> My Resignation
                                            </NavLink>
                                        </div>
                                    }
                                    @* Regularization Request (NEW) *@
                                    @if (settings.EnableRegularizationRequest)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-regularization">
                                                <span class="me-2">⏳</span> Request Regularization
                                            </NavLink>
                                        </div>
                                    }
                                    @* My Reports (NEW) *@
                                    @if (settings.EnableCustomReporting && settings.EmployeeCanViewReports)
                                    {
                                        <div class="nav-item px-3">
                                            <NavLink class="nav-link" href="my-reports">
                                                <span class="me-2">📊</span> My Reports
                                            </NavLink>
                                        </div>
                                    }
                                </details>
                            }
                        </Authorized>
                    </AuthorizeView>
                </NotAuthorized>
            </AuthorizeView>
        }
    </nav>
</div>


@code {
    // PUBLIC PROPERTY FOR MAINLAYOUT TO ACCESS
    public int PendingLeaveCount { get; private set; } = 0;

    [CascadingParameter(Name = "Settings")]
    private FeatureSettings? settings { get; set; }

    [CascadingParameter(Name = "IsSuperAdmin")]
    private bool userIsSuperAdmin { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        // Null check is applied to settings
        if (settings != null && (userIsSuperAdmin || settings.AdminCanViewAttendance))
        {
            await LoadPendingData();
        }
    }

    private async Task LoadPendingData()
    {
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            // Count unapproved leave requests that are NOT automatic LOP entries
            PendingLeaveCount = await dbContext.LeaveRequests
                .Where(lr => !lr.IsApproved && lr.LeaveType != "Loss of Pay (Auto)")
                .CountAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load pending leave count.");
            PendingLeaveCount = 0;
        }
        // Do NOT call StateHasChanged() here.
        // This method is invoked from OnParametersSetAsync. Calling
        // StateHasChanged from the parameter lifecycle creates a render
        // -> OnParametersSetAsync -> StateHasChanged loop. Over time that
        // can hammer the database and eventually make the Blazor circuit
        // unresponsive, which matches the long-session navigation failure.
    }

    protected override void OnInitialized()
    {
        AppMode.OnAppModeChanged += HandleAppModeChanged;
    }

    private void HandleAppModeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AppMode.OnAppModeChanged -= HandleAppModeChanged;
    }
}
