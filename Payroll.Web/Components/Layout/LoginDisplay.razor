@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<AuthorizeView>

    <Authorized>

        <div class="login-display-wrapper">

            <!-- =====================================================
                 LOGGED-IN USER
                 ===================================================== -->

            <a class="nav-link login-user-link d-flex align-items-center gap-1"
               href="/my-profile"
               title="@context.User.Identity?.Name">

                <span class="user-avatar">
                    @if (context.User.IsInRole("SuperAdmin"))
                    {
                        <span>👑</span>
                    }
                    else if (context.User.IsInRole("Admin"))
                    {
                        <span>🛡️</span>
                    }
                    else
                    {
                        <span>👤</span>
                    }
                </span>

                <span class="hello-text text-muted small">
                    Hello,
                </span>

                <span class="user-name fw-semibold">
                    @context.User.Identity?.Name
                </span>

                @if (context.User.IsInRole("SuperAdmin"))
                {
                    <span class="badge bg-warning text-dark ms-1" style="font-size: 0.7rem;">Root SA</span>
                }
                else if (context.User.IsInRole("Admin"))
                {
                    <span class="badge bg-info text-dark ms-1" style="font-size: 0.7rem;">Admin</span>
                }
            </a>


            <!-- =====================================================
                 LOGOUT
                 ===================================================== -->

            <form id="employee-logout-form"
                  class="logout-form"
                  method="post"
                  action="/Identity/Account/Logout">

                <Microsoft.AspNetCore.Components.Forms.AntiforgeryToken />

                <button type="submit"
                        class="logout-button"
                        title="Logout"
                        aria-label="Logout"
                        @onclick="PrepareLogout"
                        @onclick:preventDefault>

                    <i class="bi bi-box-arrow-right logout-icon"
                       aria-hidden="true">
                    </i>

                    <span class="logout-text">
                        Logout
                    </span>

                </button>

            </form>

        </div>

    </Authorized>


    <NotAuthorized>

        <a class="nav-link text-light me-2"
           href="/Identity/Account/Register">
            Register
        </a>

        <a class="nav-link text-light"
           href="/Identity/Account/Login">
            Login
        </a>

    </NotAuthorized>

</AuthorizeView>


@code
{
    private async Task PrepareLogout()
    {
        /*
         * ============================================================
         * STOP EMPLOYEE GPS BEFORE REAL LOGOUT
         * ============================================================
         *
         * Logout is an authoritative lifecycle event. Stop the GPS
         * watcher in the browser before redirecting to the Identity
         * logout page.
         */

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "stopPersistentEmployeeGps");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Unable to stop employee GPS during logout: {ex}");
        }

        /*
         * Give the GPS watcher a moment to stop and then redirect
         * to the standard Identity logout model.
         */
        await Task.Delay(100);

        NavigationManager.NavigateTo("/Identity/Account/Logout", forceLoad: true);
    }
}
