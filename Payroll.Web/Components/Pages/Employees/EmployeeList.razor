@page "/employees"
@inject NavigationManager Navigation
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Components.Pages.Employees
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthState
@inject Payroll.Web.Services.FirebaseEmployeeDeletionService DeletionService
@inject Payroll.Web.Services.AttendanceRefreshService AttendanceRefresh
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject IJSRuntime JSRuntime
@inject ILogger<EmployeeList> _logger
@inject IToastService toastService
@attribute [Authorize(Roles = "Employee, Admin, SuperAdmin")]

<PageTitle>Employee Management</PageTitle>

@if (loadedFromOfflineCache)
{
    <div class="alert alert-warning py-2 d-flex align-items-center justify-content-between" role="status">
        <span><i class="bi bi-cloud-slash me-2"></i>Showing the last cached employee list. Changes will reconcile automatically when Firebase reconnects.</span>
        @if (cacheReconciliationInProgress)
        {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        }
    </div>
}

<div class="page-header-container">
    <div class="d-flex align-items-center gap-3">
        <div class="emoji-icon-badge emoji-icon-badge-primary">
            👥
        </div>
        <div>
            <h2 class="page-header-title">
                Employee Directory
            </h2>
            <p class="page-header-subtitle">
                <span>🏢 Manage staff profiles, compensation structures & biometric bindings</span>
                @if (employees != null)
                {
                    <span>• <strong class="text-primary">@employees.Count()</strong> Team Members</span>
                }
            </p>
        </div>
    </div>
    @if (!showForm)
    {
        <button class="btn btn-primary action-pill-btn" @onclick="OpenAddForm">
            <span>➕</span> <span class="bi bi-person-plus-fill"></span> Add New Employee
        </button>
    }
</div>

@* --- UNIFIED FORM CARD (Used for Add & Edit) --- *@
@if (showForm)
{
    <div class="card shadow-sm mb-4 border-primary rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3 px-4">
            <h5 class="mb-0 d-flex align-items-center gap-2">
                <span>@(currentEmployee.EmployeeID == 0 ? "➕" : "✏️")</span>
                <i class="bi @(currentEmployee.EmployeeID == 0 ? "bi-person-plus-fill" : "bi-pencil-square") me-1"></i>
                @(currentEmployee.EmployeeID == 0 ? "Add New Employee Profile" : $"Edit Profile: {currentEmployee.Name}")
            </h5>
            <button type="button" class="btn-close btn-close-white" @onclick="CloseForm"></button>
        </div>

        <div class="card-body p-4">
            <EmployeeForm Employee="currentEmployee"
                          CompanySettings="companySettings"
                          FeatureSettings="featureSettings"
                          IsSuperAdmin="isSuperAdmin"
                          @bind-Dob="modalDob"
                          @bind-HireDate="modalHireDate"
                          @bind-TerminationDate="modalTerminationDate"
                          @bind-ShiftStartTime="modalShiftStartTime"
                          @bind-ShiftEndTime="modalShiftEndTime" />
        </div>

        <div class="card-footer bg-light py-3 px-4 text-end d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary action-pill-btn" @onclick="CloseForm">
                <span>❌</span> Cancel
            </button>
            <button type="button" class="btn btn-success action-pill-btn px-4" @onclick="SaveEmployee">
                <span>💾</span> <span class="bi bi-check-lg"></span>
                @(currentEmployee.EmployeeID == 0 ? "Save Employee" : "Update Changes")
            </button>
        </div>
    </div>
}

@* --- EMPLOYEE LIST TABLE (compact, no horizontal scroll) --- *@
@if (employees == null)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">Loading employees... 👥</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle table-sm mb-0 w-100" style="table-layout: fixed;">
                <colgroup>
                    <col style="width:5%">    @* # *@
                    <col style="width:22%">   @* Name + Bio ID *@
                    <col style="width:13%">   @* Role *@
                    <col style="width:14%">   @* Pay + Hire/Term *@
                    <col style="width:20%">   @* Shift + Break *@
                    <col style="width:14%">   @* Comp Off + OT *@
                    <col style="width:12%">   @* Actions *@
                </colgroup>
                <thead class="table-light">
                    <tr>
                        <th class="small text-uppercase fw-bold ps-3">#</th>
                        <th class="small text-uppercase fw-bold">👤 Employee</th>
                        <th class="small text-uppercase fw-bold">💼 Role</th>
                        <th class="small text-uppercase fw-bold">💵 Pay</th>
                        <th class="small text-uppercase fw-bold text-center">⏰ Shift / Break</th>
                        <th class="small text-uppercase fw-bold text-center">🏖️ Off / OT</th>
                        <th class="small text-uppercase fw-bold text-center pe-3">⚙️ Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!employees.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <span class="fs-1 d-block mb-2">👥</span>
                                <p class="mb-2 fw-semibold">No employees found in directory.</p>
                                <button class="btn btn-primary action-pill-btn btn-sm" @onclick="OpenAddForm">
                                    <span>➕</span> Add First Employee
                                </button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emp in employees)
                        {
                            <tr class="@(currentEmployee?.EmployeeID == emp.EmployeeID ? "table-info" : "")">

                                @* ID *@
                                <td class="fw-bold text-muted ps-3 small">#@emp.EmployeeID</td>

                                @* Name + Bio ID *@
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width:30px; height:30px; font-size:0.8rem;">
                                            @(string.IsNullOrWhiteSpace(emp.Name) ? "?" : emp.Name.Substring(0, 1).ToUpper())
                                        </div>
                                        <div class="overflow-hidden">
                                            <div class="fw-semibold text-truncate" style="max-width:130px;" title="@emp.Name">@emp.Name</div>
                                            <div class="text-muted" style="font-size:0.72rem;">
                                                🧬 @(string.IsNullOrWhiteSpace(emp.BiometricID) ? "--" : emp.BiometricID)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                @* Role *@
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 small text-truncate d-inline-block" style="max-width:100%;" title="@emp.Role">
                                        @(string.IsNullOrWhiteSpace(emp.Role) ? "Staff" : emp.Role)
                                    </span>
                                </td>

                                @* Pay + Hire / Term dates *@
                                <td>
                                    <div class="fw-semibold small">
                                        @if (emp.DirectHourlyWage.HasValue && emp.DirectHourlyWage > 0)
                                        {
                                            <span class="text-success">@emp.DirectHourlyWage.Value.ToString("C2", inrCulture)<span class="text-muted fw-normal">/hr</span></span>
                                        }
                                        else
                                        {
                                            <span class="text-primary">@emp.MonthlySalary.ToString("C0", inrCulture)<span class="text-muted fw-normal">/mo</span></span>
                                        }
                                    </div>
                                    <div class="text-muted" style="font-size:0.7rem;">
                                        📅 @(emp.HireDate?.ToString("dd-MMM-yy") ?? "--")
                                        @if (emp.TerminationDate.HasValue)
                                        {
                                            <span class="text-danger"> → @emp.TerminationDate.Value.ToString("dd-MMM-yy")</span>
                                        }
                                    </div>
                                </td>

                                @* Shift + Break *@
                                <td class="text-center">
                                    <div class="badge bg-light text-dark border rounded-pill px-2 small text-truncate d-inline-block" style="max-width:100%;">
                                        @(emp.ShiftStartTime?.ToString("hh:mm tt") ?? "--") – @(emp.ShiftEndTime?.ToString("hh:mm tt") ?? "--")
                                    </div>
                                    <div class="text-muted" style="font-size:0.7rem;">
                                        ☕ @emp.StandardBreakMinutes min break
                                        <span class="badge @(emp.ShiftMode == "CONTINUOUS" ? "bg-info text-white" : "bg-light text-secondary border") ms-1" style="font-size:0.65rem;">@(emp.ShiftMode == "CONTINUOUS" ? "Continuous" : "Single Day")</span>
                                    </div>
                                </td>

                                @* Comp Off + OT *@
                                <td class="text-center">
                                    <div class="small">
                                        <span class="badge bg-light text-dark border rounded-pill px-2">
                                            🏖️ @(emp.CompOffDayOfWeek?.ToString() ?? "None")
                                        </span>
                                    </div>
                                    <div class="text-muted" style="font-size:0.7rem;">
                                        ⚡ @emp.OT_Rule
                                        @if (emp.OT_Rule == "Flat" && emp.OT_FlatRate > 0)
                                        {
                                            <span>(@emp.OT_FlatRate.ToString("N0", inrCulture))</span>
                                        }
                                    </div>
                                </td>

                                @* Actions *@
                                <td class="text-center pe-3">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-sm btn-outline-success px-2 py-1" href="/employees/insights/@emp.EmployeeID" title="Employee Insights 📊">
                                            <i class="bi bi-graph-up-arrow"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-info px-2 py-1" @onclick="() => GoToDetails(emp.EmployeeID)" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary px-2 py-1" @onclick="() => OpenEditForm(emp)" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger px-2 py-1" @onclick="() => DeleteEmployee(emp)" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleDataRefresh" />
<ApplicationRealtimeRefreshListener EntityFilter="Employee" OnApplicationDataChanged="HandleDataRefresh" />

@* --- DELETION CONFIRMATION MODAL --- *@
@if (showDeletionDialog && selectedEmployeeForDeletion != null)
{
    <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle me-2"></i>Delete Employee: @selectedEmployeeForDeletion.Name
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeletionDialog" disabled="@isProcessingDeletion"></button>
                </div>

                <div class="modal-body">
                    @if (isDeletionCheckLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary mb-3" role="status"></div>
                            <p class="text-muted">Checking employee records...</p>
                        </div>
                    }
                    else if (deletionDependencies != null)
                    {
                        @if (deletionDependencies.CanDelete)
                        {
                            <div class="alert alert-warning" role="alert">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>This employee can be deleted.</strong> Moving to Recycle Bin will hide the record but preserve history for reporting.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger" role="alert">
                                <i class="bi bi-exclamation-octagon-fill me-2"></i>
                                <strong>Cannot delete this employee!</strong>
                            </div>

                            <div class="alert alert-info">
                                <h6 class="fw-bold mb-3">This employee has the following related records:</h6>

                                <div class="card card-body bg-light">
                                    @{
                                        var dependencyList = deletionDependencies.GetDependenciesList();
                                        @foreach (var (category, count) in dependencyList)
                                        {
                                            <div class="row mb-2 pb-2 border-bottom">
                                                <div class="col">
                                                    <strong>@category</strong>
                                                </div>
                                                <div class="col-auto">
                                                    <span class="badge bg-danger">@count @(count == 1 ? "record" : "records")</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>

                                <div class="alert alert-warning mt-3 mb-0">
                                    <h6 class="fw-bold mb-2">
                                        <i class="bi bi-lightbulb me-2"></i>To delete this employee:
                                    </h6>
                                    <ol class="mb-0 ps-3">
                                        <li>Delete or archive related records first</li>
                                        <li>Start with oldest records (e.g., historical attendance)</li>
                                        <li>Then delete current/pending records (advances, leave)</li>
                                        <li>Once all related data is removed, you can delete the employee</li>
                                    </ol>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeletionDialog" disabled="@isProcessingDeletion">
                        <i class="bi bi-x-circle me-2"></i>Close
                    </button>

                    @if (deletionDependencies?.CanDelete == true)
                    {
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDeletion" disabled="@isProcessingDeletion">
                            @if (isProcessingDeletion)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Moving to Bin...</span>
                            }
                            else
                            {
                                <i class="bi bi-trash me-2"></i>
                                <span>Move to Recycle Bin</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
private CompanySetting? companySettings;
private List<Employee>? employees;
private FeatureSettings? featureSettings;
private bool showForm = false; // Controls the unified card
private Employee currentEmployee = new();
private bool isSuperAdmin = false;

// Deletion Dialog State
private bool showDeletionDialog = false;
private Employee? selectedEmployeeForDeletion;
private bool isDeletionCheckLoading = false;
private bool isProcessingDeletion = false;
private FirebaseEmployeeDeletionService.EmployeeDeletionDependencies? deletionDependencies;

// Helpers for Data Binding
private DateTime? modalDob, modalHireDate, modalTerminationDate, modalShiftStartTime, modalShiftEndTime;
private CultureInfo inrCulture = new CultureInfo("en-IN");
private bool loadedFromOfflineCache;
private bool cacheReconciliationInProgress;
private bool firebaseReadFailed;
private DotNetObjectReference<EmployeeList>? employeeCacheRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        isSuperAdmin = authState.User.IsInRole("SuperAdmin");
        await LoadEmployees();
    }

    private void ValidateSalaryComponents()
    {
        // Simple validation: Components should not exceed the Monthly Salary
        if (currentEmployee.MonthlySalary > 0)
        {
            decimal sum = currentEmployee.BasicSalaryComponent + currentEmployee.HraComponent + currentEmployee.DaComponent;
            if (sum > currentEmployee.MonthlySalary)
            {
                toastService.ShowWarning("The sum of Basic, HRA, and DA cannot exceed the Monthly Gross Salary.");
                // Optionally reset one component or prompt user to fix
                currentEmployee.DaComponent = currentEmployee.MonthlySalary - currentEmployee.BasicSalaryComponent - currentEmployee.HraComponent;
                if (currentEmployee.DaComponent < 0) currentEmployee.DaComponent = 0;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Blazor Server can prerender before JS is available. The cache is
        // therefore hydrated after the first interactive render. Firebase is
        // still the authoritative source and this only supplies a read fallback.
        try
        {
            employeeCacheRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("employeeCache.watchOnline", employeeCacheRef);
        }
        catch (Exception ex)
        {
            _logger.LogDebug(ex, "Employee browser online watcher could not be registered.");
        }

        if (firebaseReadFailed && (employees == null || employees.Count == 0))
            await TryLoadEmployeeCacheAsync();
    }

    [JSInvokable("EmployeeBrowserOnline")]
    public async Task EmployeeBrowserOnline()
    {
        // Browser connectivity returning is only a trigger. Firebase remains
        // authoritative, and a successful read fully reconciles the cache.
        await InvokeAsync(async () => await LoadEmployees());
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("employeeCache.unwatchOnline");
        }
        catch
        {
            // The Blazor circuit may already be disconnected.
        }
        finally
        {
            employeeCacheRef?.Dispose();
            employeeCacheRef = null;
        }
    }

    private async Task LoadEmployees()
    {
        if (employees == null)
            await InvokeAsync(StateHasChanged);

        try
        {
            cacheReconciliationInProgress = true;
            firebaseReadFailed = false;
            // Firebase is the shared Web + Android SSOT for Employee Management.
            // No EF/SQL read is used by this screen.
            var settingsTask = FirebaseEmployees.GetCompanySettingsAsync();
            var featuresTask = FirebaseEmployees.GetFeatureSettingsAsync();
            var employeesTask = FirebaseEmployees.GetEmployeesAsync();

            await Task.WhenAll(settingsTask, featuresTask, employeesTask);

            companySettings = await settingsTask;
            featureSettings = await featuresTask;
            employees = await employeesTask;
            loadedFromOfflineCache = false;

            // Reconciliation rule: every successful Firebase read completely
            // replaces the browser read cache. No local write is replayed.
            try
            {
                await JSRuntime.InvokeVoidAsync("employeeCache.save", employees, FirebaseEmployees.OwnerUid);
            }
            catch (Exception cacheEx)
            {
                _logger.LogDebug(cacheEx, "Employee browser cache could not be updated.");
            }

            if (companySettings == null)
                _logger.LogWarning("Firebase company_settings/1 is unavailable for Employee Management.");
            if (featureSettings == null)
                _logger.LogWarning("Firebase feature_settings/1 is unavailable for Employee Management.");
        }
        catch (Exception ex)
        {
            firebaseReadFailed = true;
            _logger.LogWarning(ex, "Firebase employee read failed. Attempting browser read-model cache.");
            if (!await TryLoadEmployeeCacheAsync())
            {
                toastService.ShowError($"Error loading employees from Firebase: {ex.Message}");
                employees = new List<Employee>();
            }
        }
        finally
        {
            cacheReconciliationInProgress = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> TryLoadEmployeeCacheAsync()
    {
        try
        {
            var cached = await JSRuntime.InvokeAsync<EmployeeCacheEnvelope?>("employeeCache.load", FirebaseEmployees.OwnerUid);
            if (cached?.payload == null || cached.payload.Count == 0)
                return false;

            employees = cached.payload;
            loadedFromOfflineCache = true;
            _logger.LogInformation(
                "Employee list restored from browser read cache. Cache age: {AgeMinutes} minutes; stale={Stale}.",
                cached.savedAt > 0 ? Math.Max(0, (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - cached.savedAt) / 60000) : -1,
                cached.stale);
            await InvokeAsync(StateHasChanged);
            return true;
        }
        catch (Exception ex)
        {
            _logger.LogDebug(ex, "Employee browser read cache unavailable.");
            return false;
        }
    }

    private sealed class EmployeeCacheEnvelope
    {
        public List<Employee>? payload { get; set; }
        public long savedAt { get; set; }
        public bool stale { get; set; }
    }

    private void OpenAddForm()
    {
        currentEmployee = new Employee
        {
            HireDate = DateOnly.FromDateTime(DateTime.Now.Date),
            CompOffDayOfWeek = null,
            StandardBreakMinutes = 60,
            OT_Rule = "No Overtime",
            SalaryCalculationMethod = "Pro-Rata Hourly"
        };
        ResetHelpers();
        showForm = true;
    }

    private void OpenEditForm(Employee emp)
    {
        // Clone data to avoid editing the table row directly before saving
        currentEmployee = new Employee
        {
            EmployeeID = emp.EmployeeID,
            Name = emp.Name,
            Role = emp.Role,
            BiometricID = emp.BiometricID,
            DOB = emp.DOB,
            HireDate = emp.HireDate,
            TerminationDate = emp.TerminationDate,
            MonthlySalary = emp.MonthlySalary,
            BasicSalaryComponent = emp.BasicSalaryComponent,
            HraComponent = emp.HraComponent,
            DaComponent = emp.DaComponent,
            StandardHours = emp.StandardHours,
            DirectHourlyWage = emp.DirectHourlyWage,
            PayrollTypeOverride = emp.PayrollTypeOverride,
            SalaryCalculationMethod = emp.SalaryCalculationMethod,
            PaidLeaveBalance = emp.PaidLeaveBalance,
            SickLeaveBalance = emp.SickLeaveBalance,
            ShiftStartTime = emp.ShiftStartTime,
            ShiftEndTime = emp.ShiftEndTime,
            StandardBreakMinutes = emp.StandardBreakMinutes,
            CompOffDayOfWeek = emp.CompOffDayOfWeek,
            OT_Rule = emp.OT_Rule,
            OT_FlatRate = emp.OT_FlatRate,
            NightShiftAllowance = emp.NightShiftAllowance,
            TdsRatePercent = emp.TdsRatePercent,
            Email = emp.Email,
            EnablePF = emp.EnablePF,
            UAN = emp.UAN,
            EnableESI = emp.EnableESI,
            ESINumber = emp.ESINumber,
            BankAccountNumber = emp.BankAccountNumber,
            BankIfscCode = emp.BankIfscCode,
            BankName = emp.BankName,
            LastRotatedDate = emp.LastRotatedDate,
            // --- NEW: ROTATION FIELDS ---
            EnableShiftRotation = emp.EnableShiftRotation,
            RotationGroup = emp.RotationGroup,
            ShiftRotationPattern = emp.ShiftRotationPattern,
            CurrentShiftIndex = emp.CurrentShiftIndex,
            // --- NEW: ANDROID SYNCHRONIZATION ---
            PhoneNumber = emp.PhoneNumber,
            SalaryType = emp.SalaryType,
            DailyAllowance = emp.DailyAllowance,
            IsBonusEligible = emp.IsBonusEligible,
            IsPaidLeaveEligible = emp.IsPaidLeaveEligible,
            PaidLeaveOnWeekdays = emp.PaidLeaveOnWeekdays,
            PaidLeaveOnWeekends = emp.PaidLeaveOnWeekends,
        };
        ResetHelpers();
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        currentEmployee = new();
    }

    private void ResetHelpers()
    {
        modalDob = currentEmployee.DOB?.ToDateTime(TimeOnly.MinValue);
        modalHireDate = currentEmployee.HireDate?.ToDateTime(TimeOnly.MinValue);
        modalTerminationDate = currentEmployee.TerminationDate?.ToDateTime(TimeOnly.MinValue);

        var baseD = DateTime.Today;
        modalShiftStartTime = currentEmployee.ShiftStartTime.HasValue ? baseD.Add(currentEmployee.ShiftStartTime.Value.ToTimeSpan()) : null;
        modalShiftEndTime = currentEmployee.ShiftEndTime.HasValue ? baseD.Add(currentEmployee.ShiftEndTime.Value.ToTimeSpan()) : null;
    }

    private async Task SaveEmployee()
    {
        if (currentEmployee == null) return;
        ValidateSalaryComponents();
        // Ensure logic consistency
        if (!currentEmployee.EnablePF) currentEmployee.UAN = null;
        if (!currentEmployee.EnableESI) currentEmployee.ESINumber = null;

        if (string.IsNullOrWhiteSpace(currentEmployee.Name) || string.IsNullOrWhiteSpace(currentEmployee.BiometricID))
        {
            toastService.ShowWarning("Name and Biometric ID are required.");
            return;
        }

        try
        {
            var wasNew = currentEmployee.EmployeeID == 0;
            var result = await FirebaseEmployees.SaveEmployeeAsync(currentEmployee);
            if (!result.Success)
            {
                toastService.ShowError(result.Message);
                return;
            }

            var reconciliation = await FirebaseEmployees.ReconcileAuthAsync(result.Employee);

            await AttendanceRefresh.NotifyEmployeeChangedAsync(
                result.Employee.EmployeeID,
                wasNew ? "CREATED" : "UPDATED");

            if (!reconciliation.Success)
            {
                // The Firebase employee row is saved, but Auth/profile
                // provisioning failed. Do not hide that state behind a
                // misleading green success-only message.
                toastService.ShowError(
                    $"Employee saved, but Firebase provisioning failed: {reconciliation.Message}");
            }
            else
            {
                toastService.ShowSuccess(
                    reconciliation.Message.Contains("password setup email", StringComparison.OrdinalIgnoreCase)
                        ? reconciliation.Message
                        : "Employee saved and Firebase provisioning completed.");
            }
            CloseForm();
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error saving employee to Firebase.");
            toastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task HandleDataRefresh()
    {
        await LoadEmployees();
    }

    private async Task DeleteEmployee(Employee emp)
    {
        // Show deletion dialog and check dependencies
        selectedEmployeeForDeletion = emp;
        showDeletionDialog = true;
        isDeletionCheckLoading = true;
        deletionDependencies = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Check if employee has related records
            deletionDependencies = await DeletionService.CheckDeletionDependenciesAsync(emp.EmployeeID);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error checking deletion dependencies");
            toastService.ShowError($"Error checking records: {ex.Message}");
            deletionDependencies = new FirebaseEmployeeDeletionService.EmployeeDeletionDependencies
            {
                EmployeeID = emp.EmployeeID,
                EmployeeName = emp.Name,
                CanDelete = false,
                BlockReason = "Error checking dependencies"
            };
        }
        finally
        {
            isDeletionCheckLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseDeletionDialog()
    {
        showDeletionDialog = false;
        selectedEmployeeForDeletion = null;
        deletionDependencies = null;
    }

    private async Task ConfirmDeletion()
    {
        if (selectedEmployeeForDeletion == null || deletionDependencies == null) return;

        isProcessingDeletion = true;
        try
        {
            var result = await FirebaseEmployees.SoftDeleteEmployeeAsync(selectedEmployeeForDeletion.EmployeeID);
            if (!result.Success || result.Employee == null)
            {
                toastService.ShowError(result.Message);
                return;
            }

            var reconciliation = await FirebaseEmployees.ReconcileAuthAsync(result.Employee);
            if (!reconciliation.Success)
                toastService.ShowWarning(reconciliation.Message);

            await AttendanceRefresh.NotifyEmployeeChangedAsync(result.Employee.EmployeeID, "DELETED");

            await FirebaseEmployees.LogAuditAsync(
                "SOFT DELETE",
                "Employee",
                result.Employee.EmployeeID.ToString(),
                $"Employee moved to Recycle Bin (Soft Deleted). Dependencies: {deletionDependencies.GetTotalDependencies()} related records preserved.");

            toastService.ShowSuccess($"'{result.Employee.Name}' moved to Recycle Bin. Related records preserved.");
            CloseDeletionDialog();
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error during employee deletion");
            toastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isProcessingDeletion = false;
        }
    }

    private void GoToDetails(int id) => Navigation.NavigateTo($"/employees/details/{id}");
    private bool IsPageActive() => Navigation.Uri.EndsWith("/employees", StringComparison.OrdinalIgnoreCase);
}