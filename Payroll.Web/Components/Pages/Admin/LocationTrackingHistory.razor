@page "/admin/location-tracking-history"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Services
@attribute [Authorize(Roles = "Admin, SuperAdmin")]
@implements IAsyncDisposable

@inject IDbContextFactory<AppDbContext> DbFactory
@inject FirebaseEmployeeManagementService FirebaseEmployees
@inject FirebaseRealtimeService FirebaseRealtime
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Location Tracking History</PageTitle>

<div class="location-stays-page container-fluid py-3">
    <div class="page-header-container mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="emoji-icon-badge emoji-icon-badge-primary">
                🛰️
            </div>
            <div>
                <h2 class="page-header-title">
                    Location Tracking History &amp; GPS Radar
                </h2>
                <p class="page-header-subtitle">
                    <span>📍 Historical GPS movement analysis: Dwell locations (50m radius), stay duration (≥10 min) &amp; travel trajectory</span>
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="action-pill-btn action-pill-btn-primary" @onclick="LoadAsync" disabled="@loading">
                <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i>
                <span>@(loading ? "Analyzing Radar..." : "🔄 Refresh Radar")</span>
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3 filter-card">
        <div class="card-body p-3">
            <div class="filter-grid">
                <div class="filter-item filter-item-employee">
                    <label class="form-label"><i class="bi bi-person me-1 text-primary"></i>Employee</label>
                    <select class="form-select" @bind="employeeFilter">
                        <option value="0">All employees</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.EmployeeID">@employee.Name (#@employee.EmployeeID)</option>
                        }
                    </select>
                </div>
                <div class="filter-item filter-item-date">
                    <label class="form-label"><i class="bi bi-calendar-event me-1 text-primary"></i>Date From</label>
                    <input type="date" class="form-control" @bind="fromDate" />
                </div>
                <div class="filter-item filter-item-date">
                    <label class="form-label"><i class="bi bi-calendar2-check me-1 text-primary"></i>Date To</label>
                    <input type="date" class="form-control" @bind="toDate" />
                </div>
                <div class="filter-item filter-item-time">
                    <label class="form-label"><i class="bi bi-clock me-1 text-primary"></i>From</label>
                    <input type="time" class="form-control" @bind="fromTime" />
                </div>
                <div class="filter-item filter-item-time">
                    <label class="form-label"><i class="bi bi-clock-history me-1 text-primary"></i>To</label>
                    <input type="time" class="form-control" @bind="toTime" />
                </div>
                <div class="filter-item filter-item-stay">
                    <label class="form-label"><i class="bi bi-geo-alt me-1 text-primary"></i>Min Stay (50m Radius)</label>
                    <select class="form-select" value="@minDurationFilterMinutes" @onchange="OnDurationFilterChanged">
                        <option value="10">≥ 10 mins (All)</option>
                        <option value="20">≥ 20 mins</option>
                        <option value="30">≥ 30 mins</option>
                        <option value="60">≥ 1 hour</option>
                        <option value="120">≥ 2 hours</option>
                    </select>
                </div>
                <div class="filter-item filter-item-btn">
                    <button class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm" @onclick="LoadAsync" disabled="@loading">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Searching...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Search</span>
                        }
                    </button>
                </div>
            </div>
            <div class="small text-muted mt-2 d-flex align-items-center gap-1">
                <i class="bi bi-shield-check text-success"></i>
                <span>No GPS records are changed. Stay records are derived from the existing <code>EmployeeLocationHistory</code> data clustered within a 50m radius for ≥10 minutes.</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger border-0 shadow-sm"><i class="bi bi-exclamation-triangle me-2"></i>@error</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3"><div class="metric-card"><span>Employees</span><strong>@summary.Employees</strong><i class="bi bi-people"></i></div></div>
        <div class="col-6 col-lg-3"><div class="metric-card"><span>Detected stays</span><strong>@summary.Stays</strong><i class="bi bi-pin-map"></i></div></div>
        <div class="col-6 col-lg-3"><div class="metric-card"><span>Total observed stay time</span><strong>@FormatDuration(summary.TotalStay)</strong><i class="bi bi-hourglass-split"></i></div></div>
        <div class="col-6 col-lg-3"><div class="metric-card"><span>GPS points analyzed</span><strong>@summary.Points</strong><i class="bi bi-broadcast-pin"></i></div></div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm h-100 report-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong><i class="bi bi-clock-history me-2"></i>Detected Stayed Locations</strong>
                        <div class="small text-muted">Stayed ≥ 10 minutes within 50-metre radius cluster</div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary">@stays.Count</span>
                </div>
                <div class="stay-list">
                    @if (loading)
                    {
                        <div class="p-4 text-center text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Analyzing GPS history...</div>
                    }
                    else if (stays.Count == 0)
                    {
                        <div class="p-4 text-center text-muted"><i class="bi bi-geo-alt display-6 d-block mb-2"></i>No qualifying ≥@(minDurationFilterMinutes)-minute stays found for the selected filters.</div>
                    }
                    else
                    {
                        @foreach (var stay in stays)
                        {
                            <button type="button" class="stay-row" id="stay-row-@stay.Id" @onclick="() => FocusStay(stay.Id)">
                                <div class="stay-row-top">
                                    <span class="stay-index">@stay.Sequence</span>
                                    <div class="stay-main">
                                        <div class="d-flex align-items-center gap-2">
                                            <strong>@stay.EmployeeName</strong>
                                            <span class="badge @(stay.PlaceCategory == "Worksite" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">
                                                @(stay.PlaceCategory == "Worksite" ? "🏢 Worksite" : "📍 Field Halt")
                                            </span>
                                        </div>
                                        <span class="small text-muted">@FormatIst(stay.StartUtc) · @FormatDuration(stay.Duration)</span>
                                    </div>
                                    <span class="stay-duration">@FormatDuration(stay.Duration)</span>
                                </div>
                                <div class="stay-location-line">
                                    <i class="bi bi-geo-alt"></i>
                                    <span data-stay-address="@stay.Id">Address unavailable</span>
                                </div>
                                <div class="small text-muted px-2 py-1 mb-1 rounded bg-light-subtle">
                                    <i class="bi bi-info-circle me-1 text-primary"></i>Stayed <strong>@FormatDuration(stay.Duration)</strong> at @stay.MatchedLocation (50m radius, ≥10m dwell)
                                </div>
                                <div class="stay-meta">
                                    <span><i class="bi bi-clock"></i>@FormatIst(stay.StartUtc, "HH:mm") - @FormatIst(stay.EndUtc, "HH:mm")</span>
                                    <span><i class="bi bi-bullseye"></i>@stay.AccuracyMeters.ToString("F1") m</span>
                                    <span><i class="bi bi-shop"></i>@stay.MatchedLocation</span>
                                </div>
                                <div class="stay-coords"><code>@stay.Latitude.ToString("F6"), @stay.Longitude.ToString("F6")</code><span>GPS points: @stay.PointCount</span></div>
                            </button>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm history-map-card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <strong><i class="bi bi-map me-2"></i>Location History Map</strong>
                        <div class="small text-muted">Movement path + highlighted stayed locations. Click a stay or marker to synchronize the report.</div>
                    </div>
                    <span class="badge bg-light text-dark border">@points.Count GPS points</span>
                </div>
                <div id="location-stay-history-map" class="location-stay-history-map"></div>
            </div>
        </div>
    </div>

    @if (stays.Count > 0)
    {
        <div class="card border-0 shadow-sm mt-3 detail-card">
            <div class="card-header"><strong><i class="bi bi-list-columns-reverse me-2"></i>Stay Details</strong></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Employee</th><th>Start</th><th>End</th><th>Duration</th><th>Location</th><th>Accuracy</th><th>Arrival</th><th>Departure</th><th>Distance</th><th>Radius</th><th>Coordinates</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var stay in stays)
                    {
                        <tr id="stay-detail-row-@stay.Id" class="stay-detail-row" @onclick="() => FocusStay(stay.Id)">
                            <td><strong>@stay.EmployeeName</strong><div class="small text-muted">ID @stay.EmployeeId</div></td>
                            <td class="nowrap">@FormatIst(stay.StartUtc)</td>
                            <td class="nowrap">@FormatIst(stay.EndUtc)</td>
                            <td><span class="badge bg-primary-subtle text-primary">@FormatDuration(stay.Duration)</span></td>
                            <td><strong data-stay-address="@stay.Id">Address unavailable</strong><div class="small text-muted">@stay.MatchedLocation</div></td>
                            <td>@stay.AccuracyMeters.ToString("F1") m</td>
                            <td>@FormatSpeed(stay.ArrivalSpeedKmh)</td>
                            <td>@FormatSpeed(stay.DepartureSpeedKmh)</td>
                            <td>@FormatDistance(stay.DistanceFromMatchedLocationMeters)</td>
                            <td>@(stay.RadiusMeters > 0 ? $"{stay.RadiusMeters} m" : "-")</td>
                            <td><code>@stay.Latitude.ToString("F6"), @stay.Longitude.ToString("F6")</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .location-stays-page { min-width: 0; }
    .location-stays-page .card { border-radius: 15px; overflow: hidden; }
    .filter-card {
        background: linear-gradient(180deg, rgba(127,127,127,.05), transparent);
        border-radius: 12px;
        container-type: inline-size;
        container-name: filterCard;
    }
    .filter-grid {
        display: grid;
        grid-template-columns: minmax(180px, 1.4fr) minmax(125px, 1fr) minmax(125px, 1fr) minmax(95px, 0.85fr) minmax(95px, 0.85fr) minmax(145px, 1.1fr) minmax(110px, auto);
        gap: 12px;
        align-items: flex-end;
    }
    .filter-item { min-width: 0; }
    .filter-item .form-label {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        white-space: nowrap;
    }
    .filter-item .form-control,
    .filter-item .form-select {
        height: 38px;
        font-size: .85rem;
        border-radius: 8px;
        padding: 6px 10px;
        width: 100%;
    }
    .filter-item input[type="time"] {
        font-variant-numeric: tabular-nums;
        min-width: 0;
    }
    .filter-item input[type="date"] {
        min-width: 0;
    }
    .filter-item .btn {
        height: 38px;
        font-weight: 600;
        font-size: .85rem;
        border-radius: 8px;
        white-space: nowrap;
    }
    @@container filterCard (max-width: 1200px) {
        .filter-grid {
            grid-template-columns: repeat(4, 1fr);
        }
        .filter-item-employee {
            grid-column: span 2;
        }
        .filter-item-stay {
            grid-column: span 1;
        }
        .filter-item-btn {
            grid-column: span 1;
        }
    }
    @@container filterCard (max-width: 680px) {
        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }
        .filter-item-employee,
        .filter-item-stay,
        .filter-item-btn {
            grid-column: 1 / -1;
        }
    }
    @@media (max-width: 1480px) {
        .filter-grid {
            grid-template-columns: repeat(4, 1fr);
        }
        .filter-item-employee {
            grid-column: span 2;
        }
        .filter-item-stay {
            grid-column: span 1;
        }
        .filter-item-btn {
            grid-column: span 1;
        }
    }
    @@media (max-width: 680px) {
        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }
        .filter-item-employee,
        .filter-item-stay,
        .filter-item-btn {
            grid-column: 1 / -1;
        }
    }
    .metric-card { min-height: 112px; padding: 16px 18px; border-radius: 15px; background: var(--bs-body-bg); box-shadow: 0 6px 22px rgba(0,0,0,.07); position: relative; overflow: hidden; border: 1px solid rgba(127,127,127,.12); }
    .metric-card span { display:block; color:#64748b; font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.03em; }
    .metric-card strong { display:block; margin-top:8px; font-size:1.55rem; }
    .metric-card i { position:absolute; right:16px; bottom:12px; font-size:1.7rem; opacity:.18; }
    .report-card .card-header, .history-map-card .card-header, .detail-card .card-header { background: rgba(127,127,127,.055); border-bottom-color: rgba(127,127,127,.14); }
    .stay-list { max-height: 620px; overflow:auto; }
    .stay-row { display:block; width:100%; text-align:left; border:0; border-bottom:1px solid rgba(127,127,127,.14); background:transparent; padding:14px 16px; color:inherit; transition:background .18s, transform .18s; }
    .stay-row:hover, .stay-row.selected { background:rgba(var(--bs-primary-rgb),.075); }
    .stay-row-top { display:flex; gap:10px; align-items:flex-start; }
    .stay-index { width:28px; height:28px; border-radius:50%; display:grid; place-items:center; background:var(--bs-primary); color:#fff; font-size:.72rem; font-weight:800; flex:0 0 auto; }
    .stay-main { min-width:0; flex:1; display:grid; gap:2px; }
    .stay-main strong { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .stay-duration { font-weight:800; white-space:nowrap; color:var(--bs-primary); }
    .stay-location-line { display:flex; gap:7px; margin:9px 0 7px 38px; font-size:.82rem; font-weight:650; }
    .stay-location-line i { color:var(--bs-primary); }
    .stay-location-line span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .stay-meta { display:flex; flex-wrap:wrap; gap:8px 12px; margin-left:38px; color:#64748b; font-size:.72rem; }
    .stay-meta span { white-space:nowrap; }
    .stay-coords { display:flex; justify-content:space-between; gap:10px; margin:8px 0 0 38px; color:#64748b; font-size:.68rem; }
    .stay-coords code { font-size:.68rem; }
    .location-stay-history-map { height:620px; min-height:420px; background:#dbe4ec; }
    .stay-detail-row { cursor:pointer; }
    .stay-detail-row.selected { background:rgba(var(--bs-primary-rgb),.09); }
    .detail-card .table { min-width:1200px; }
    .detail-card th { white-space:nowrap; font-size:.69rem; text-transform:uppercase; letter-spacing:.03em; }
    .detail-card td { font-size:.76rem; }
    .nowrap { white-space:nowrap; }
    .stay-map-popup { min-width:210px; }
    .stay-map-popup strong { display:block; margin-bottom:4px; }
    .stay-map-popup .popup-meta { display:grid; grid-template-columns:1fr 1fr; gap:4px; font-size:11px; }

