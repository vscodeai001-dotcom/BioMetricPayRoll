    }
    [data-theme="dark"] .location-stays-page .stay-coords,
    [data-bs-theme="dark"] .location-stays-page .stay-coords,
    body.dark .location-stays-page .stay-coords {
        color: #94a3b8 !important;
    }
    [data-theme="dark"] .location-stays-page .stay-coords span,
    [data-bs-theme="dark"] .location-stays-page .stay-coords span,
    body.dark .location-stays-page .stay-coords span {
        color: #94a3b8 !important;
    }
    [data-theme="dark"] .location-stays-page .badge.bg-light,
    [data-bs-theme="dark"] .location-stays-page .badge.bg-light,
    body.dark .location-stays-page .badge.bg-light {
        background: rgba(255,255,255,.09) !important;
        color: #cbd5e1 !important;
        border-color: rgba(255,255,255,.15) !important;
