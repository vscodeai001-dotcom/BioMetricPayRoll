    }
    [data-theme="dark"] .location-stays-page .stay-meta span,
    [data-bs-theme="dark"] .location-stays-page .stay-meta span,
    body.dark .location-stays-page .stay-meta span {
        color: #cbd5e1 !important;
    }
    [data-theme="dark"] .location-stays-page .stay-meta i,
    [data-bs-theme="dark"] .location-stays-page .stay-meta i,
    body.dark .location-stays-page .stay-meta i {
