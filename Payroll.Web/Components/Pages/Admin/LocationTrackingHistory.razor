    }
    [data-theme="dark"] .location-stays-page .stay-row:hover,
    [data-theme="dark"] .location-stays-page .stay-row.selected,
    [data-bs-theme="dark"] .location-stays-page .stay-row:hover,
    [data-bs-theme="dark"] .location-stays-page .stay-row.selected,
    body.dark .location-stays-page .stay-row:hover,
