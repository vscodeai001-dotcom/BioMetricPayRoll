    }
    [data-theme="dark"] .location-stays-page .card-header,
    [data-bs-theme="dark"] .location-stays-page .card-header,
    body.dark .location-stays-page .card-header {
        background:rgba(255,255,255,.035); border-color:rgba(255,255,255,.09);
        color:#e7edf6;
    }
    [data-theme="dark"] .location-stays-page .card-header strong,
    [data-bs-theme="dark"] .location-stays-page .card-header strong,
    body.dark .location-stays-page .card-header strong {
