@code {
    private bool loading;
    private string? error;
    private int employeeFilter;
    private int minDurationFilterMinutes = 10;
    private DateTime fromDate = DateTime.Today;
    private DateTime toDate = DateTime.Today;
    private TimeOnly fromTime = new(0, 0);
    private TimeOnly toTime = new(23, 59);
    private List<EmployeeOption> employees = new();
    private List<PointRow> points = new();
    private List<StayRow> allDetectedStays = new();
    private List<StayRow> stays = new();
    private Summary summary = new();
    private bool mapInitialized;
    private List<ShopLocation>? cachedShops;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loading || !points.Any()) return;
        await InitializeMapAsync();
    }

    private async Task OnDurationFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var mins))
        {
            minDurationFilterMinutes = mins;
            ApplyStayFilters();
            mapInitialized = false;
            await InitializeMapAsync();
        }
    }

    private void ApplyStayFilters()
    {
        var minDuration = TimeSpan.FromMinutes(minDurationFilterMinutes);
        stays = allDetectedStays.Where(x => x.Duration >= minDuration).ToList();

        var sequenceByEmployee = new Dictionary<int, int>();
        foreach (var stay in stays.OrderBy(x => x.StartUtc))
        {
            sequenceByEmployee.TryGetValue(stay.EmployeeId, out var sequence);
            stay.Sequence = ++sequence;
            sequenceByEmployee[stay.EmployeeId] = sequence;
        }

        summary = new Summary
        {
            Employees = stays.Select(x => x.EmployeeId).Distinct().Count(),
            Stays = stays.Count,
            Points = points.Count,
            TotalStay = new TimeSpan(stays.Sum(x => x.Duration.Ticks))
        };
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        mapInitialized = false;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            employees = await db.Employees.AsNoTracking()
                .Where(x => !x.IsDeleted)
                .OrderBy(x => x.Name)
                .Select(x => new EmployeeOption { EmployeeID = x.EmployeeID, Name = x.Name, Role = x.Role ?? "Staff" })
                .ToListAsync();

            var fromLocal = fromDate.Date.Add(fromTime.ToTimeSpan());
            var toLocal = toDate.Date.Add(toTime.ToTimeSpan());
            if (toLocal < fromLocal)
                throw new InvalidOperationException("To date/time must be after the From date/time.");

            var fromUtc = IndiaToUtc(fromLocal);
            var toUtc = IndiaToUtc(toLocal).AddSeconds(1);

            var query = db.EmployeeLocationHistory.AsNoTracking()
                .Where(x => x.CapturedAtUtc >= fromUtc && x.CapturedAtUtc < toUtc);

            if (employeeFilter > 0)
                query = query.Where(x => x.EmployeeId == employeeFilter);

            var raw = await query
                .OrderBy(x => x.EmployeeId)
                .ThenBy(x => x.SessionId)
                .ThenBy(x => x.CapturedAtUtc)
                .ToListAsync();

            var employeeNames = employees.ToDictionary(x => x.EmployeeID, x => x.Name);
            points = raw.Select(x => new PointRow
            {
                EmployeeId = x.EmployeeId,
                EmployeeName = employeeNames.TryGetValue(x.EmployeeId, out var name) ? name : $"Employee {x.EmployeeId}",
                SessionId = x.SessionId,
                Latitude = x.Latitude,
                Longitude = x.Longitude,
                AccuracyMeters = x.AccuracyMeters,
                DistanceFromOfficeMeters = x.DistanceFromOfficeMeters,
                AllowedRadiusMeters = x.AllowedRadiusMeters,
                IsWithinAllowedRadius = x.IsWithinAllowedRadius,
                CapturedAtUtc = x.CapturedAtUtc,
                RecordedAtUtc = x.RecordedAtUtc
            }).ToList();

            allDetectedStays = DetectStays(points);
            await EnrichShopMatchesAsync(allDetectedStays);
            ApplyStayFilters();
        }
        catch (Exception ex)
        {
            error = "Unable to analyze location history: " + ex.Message;
            points.Clear();
            allDetectedStays.Clear();
            stays.Clear();
            summary = new Summary();
        }
        finally
        {
            loading = false;
        }
    }

    private async Task InitializeMapAsync()
    {
        if (mapInitialized) return;
        mapInitialized = true;

        var payload = new
        {
            points = points.Select(x => new { x.Latitude, x.Longitude, timestamp = x.CapturedAtUtc.ToUniversalTime().ToString("O") }),
            stays = stays.Select(x => new
            {
                id = x.Id,
                employee = x.EmployeeName,
                start = x.StartUtc.ToUniversalTime().ToString("O"),
                end = x.EndUtc.ToUniversalTime().ToString("O"),
                durationMinutes = x.Duration.TotalMinutes,
                lat = x.Latitude,
                lng = x.Longitude,
                accuracy = x.AccuracyMeters,
                location = x.MatchedLocation,
                distance = x.DistanceFromMatchedLocationMeters
            })
        };

        await JS.InvokeVoidAsync("initializeLocationStayHistoryMap", "location-stay-history-map", payload);
        await JS.InvokeVoidAsync("resolveLocationStayAddresses", "location-stay-history-map", stays.Select(x => new { id = x.Id, lat = x.Latitude, lng = x.Longitude }));
    }

    private async Task FocusStay(long id)
    {
        await JS.InvokeVoidAsync("focusLocationStayHistory", "location-stay-history-map", id);
    }

    private List<StayRow> DetectStays(List<PointRow> source)
    {
        var result = new List<StayRow>();
        var nextId = 1L;

        foreach (var sessionGroup in source
                     .Where(x => x.SessionId != Guid.Empty)
                     .GroupBy(x => new { x.EmployeeId, x.SessionId })
                     .OrderBy(x => x.Key.EmployeeId))
        {
            var ordered = sessionGroup.OrderBy(x => x.CapturedAtUtc).ToList();
            var run = new List<PointRow>();
            PointRow? anchor = null;

            void FinishRun()
            {
                if (run.Count < 2 || anchor is null)
                {
                    run.Clear();
                    anchor = null;
                    return;
                }

                var duration = run[^1].CapturedAtUtc - run[0].CapturedAtUtc;
                if (duration >= TimeSpan.FromMinutes(10))
                {
                    var averageAccuracy = run.Where(x => x.AccuracyMeters > 0).Select(x => x.AccuracyMeters).DefaultIfEmpty().Average();
                    var previous = ordered.IndexOf(run[0]) > 0 ? ordered[ordered.IndexOf(run[0]) - 1] : null;
                    var next = ordered.IndexOf(run[^1]) + 1 < ordered.Count ? ordered[ordered.IndexOf(run[^1]) + 1] : null;

                    result.Add(new StayRow
                    {
                        Id = nextId++,
                        EmployeeId = run[0].EmployeeId,
                        EmployeeName = run[0].EmployeeName,
                        SessionId = run[0].SessionId,
                        StartUtc = run[0].CapturedAtUtc,
                        EndUtc = run[^1].CapturedAtUtc,
                        Duration = duration,
                        Latitude = run.Average(x => x.Latitude),
                        Longitude = run.Average(x => x.Longitude),
                        AccuracyMeters = averageAccuracy,
                        PointCount = run.Count,
                        DistanceFromMatchedLocationMeters = 0,
                        RadiusMeters = run[0].AllowedRadiusMeters,
                        ArrivalSpeedKmh = CalculateSpeedKmh(previous, run[0]),
                        DepartureSpeedKmh = CalculateSpeedKmh(run[^1], next),
                        PlaceCategory = "Field Halt"
                    });
                }

                run.Clear();
                anchor = null;
            }

            foreach (var point in ordered)
            {
                if (anchor is null)
                {
                    anchor = point;
                    run.Add(point);
                    continue;
                }

                var distance = CalculateDistance(anchor.Latitude, anchor.Longitude, point.Latitude, point.Longitude);
                if (distance <= 50d)
                {
                    run.Add(point);
                }
                else
                {
                    FinishRun();
                    anchor = point;
                    run.Add(point);
                }
            }

            FinishRun();
        }

        return result.OrderBy(x => x.StartUtc).ToList();
    }

    private async Task EnrichShopMatchesAsync(List<StayRow> stayRows)
    {
        foreach (var stay in stayRows)
        {
            stay.MatchedLocation = "Field Halt / Client Visit";
            stay.PlaceCategory = "Field Halt";
        }

        try
        {
            if (cachedShops == null)
            {
                var auth = await AuthState.GetAuthenticationStateAsync();
                var user = auth.User;
                var actorUid = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                    ?? user.FindFirst("sub")?.Value
                    ?? user.Identity?.Name
                    ?? "admin";
                var role = user.IsInRole("SuperAdmin") ? "SuperAdmin" : "Admin";
                var ownerUid = FirebaseRealtime.ResolveOwnerUid(actorUid, role);
                var shopsJson = await FirebaseRealtime.GetOwnerTableAsync(ownerUid, "shops");
                if (shopsJson.HasValue && shopsJson.Value.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var shops = new List<ShopLocation>();
                    foreach (var property in shopsJson.Value.EnumerateObject())
                    {
                        var value = property.Value;
                        if (value.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                        var lat = ReadDouble(value, "latitude", "lat");
                        var lng = ReadDouble(value, "longitude", "lng", "lon");
                        var radius = ReadDouble(value, "radiusMeters", "allowedRadiusMeters", "radius");
                        var name = ReadString(value, "name", "brandingName") ?? property.Name;
                        if (!lat.HasValue || !lng.HasValue || !radius.HasValue || radius <= 0) continue;
                        shops.Add(new ShopLocation { Id = property.Name, Name = name, Latitude = lat.Value, Longitude = lng.Value, RadiusMeters = radius.Value });
                    }
                    cachedShops = shops;
                }
                else
                {
                    cachedShops = new List<ShopLocation>();
                }
            }

            var activeShops = cachedShops;
            if (activeShops.Count == 0) return;

            foreach (var stay in stayRows)
            {
                var match = activeShops
                    .Select(shop => new { shop, distance = CalculateDistance(stay.Latitude, stay.Longitude, shop.Latitude, shop.Longitude) })
                    .Where(x => x.distance <= Math.Max(x.shop.RadiusMeters, 120d))
                    .OrderBy(x => x.distance)
                    .FirstOrDefault();

                if (match is not null)
                {
                    stay.MatchedLocation = match.shop.Name;
                    stay.DistanceFromMatchedLocationMeters = match.distance;
                    stay.RadiusMeters = (int)Math.Round(match.shop.RadiusMeters);
                    stay.PlaceCategory = "Worksite";
                }
            }
        }
        catch
        {
            // Shop enrichment is presentation-only. GPS stay detection must not fail because a shop projection is unavailable.
        }
    }

    private static double? ReadDouble(System.Text.Json.JsonElement value, params string[] names)
    {
        foreach (var name in names)
        {
            if (!value.TryGetProperty(name, out var property)) continue;
            if (property.ValueKind == System.Text.Json.JsonValueKind.Number && property.TryGetDouble(out var number)) return number;
            if (property.ValueKind == System.Text.Json.JsonValueKind.String && double.TryParse(property.GetString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out number)) return number;
        }
        return null;
    }

    private static string? ReadString(System.Text.Json.JsonElement value, params string[] names)
    {
        foreach (var name in names)
        {
            if (value.TryGetProperty(name, out var property) && property.ValueKind == System.Text.Json.JsonValueKind.String)
                return property.GetString();
        }
        return null;
    }

    private static double CalculateSpeedKmh(PointRow? a, PointRow? b)
    {
        if (a is null || b is null) return 0;
        var seconds = (b.CapturedAtUtc - a.CapturedAtUtc).TotalSeconds;
        if (seconds <= 0 || seconds > 600) return 0;
        return CalculateDistance(a.Latitude, a.Longitude, b.Latitude, b.Longitude) / seconds * 3.6;
    }

    private static double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        const double radius = 6371000d;
        var p1 = lat1 * Math.PI / 180d;
        var p2 = lat2 * Math.PI / 180d;
        var dp = (lat2 - lat1) * Math.PI / 180d;
        var dl = (lon2 - lon1) * Math.PI / 180d;
        var a = Math.Sin(dp / 2) * Math.Sin(dp / 2) + Math.Cos(p1) * Math.Cos(p2) * Math.Sin(dl / 2) * Math.Sin(dl / 2);
        a = Math.Clamp(a, 0d, 1d);
        return radius * 2d * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1d - a));
    }

    private static DateTime IndiaToUtc(DateTime india)
        => TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(india, DateTimeKind.Unspecified), IndiaTimeZone());

    private static TimeZoneInfo IndiaTimeZone()
        => TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");

    private static string FormatIst(DateTime utc, string format = "dd MMM yyyy HH:mm:ss")
        => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), IndiaTimeZone()).ToString(format);

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1) return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        return $"{Math.Max(0, (int)duration.TotalMinutes)}m {Math.Max(0, duration.Seconds)}s";
    }

    private static string FormatDistance(double meters)
        => meters <= 0 ? "-" : meters >= 1000 ? $"{meters / 1000d:F2} km" : $"{meters:F0} m";

    private static string FormatSpeed(double kmh) => kmh <= 0 ? "-" : $"{kmh:F1} km/h";

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;

    private sealed class EmployeeOption
    {
        public int EmployeeID { get; set; }
        public string Name { get; set; } = "";
        public string Role { get; set; } = "Staff";
    }

    private sealed class PointRow
    {
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = "";
        public Guid SessionId { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double AccuracyMeters { get; set; }
        public double DistanceFromOfficeMeters { get; set; }
        public int AllowedRadiusMeters { get; set; }
        public bool IsWithinAllowedRadius { get; set; }
        public DateTime CapturedAtUtc { get; set; }
        public DateTime RecordedAtUtc { get; set; }
    }

    private sealed class StayRow
    {
        public long Id { get; set; }
        public int Sequence { get; set; }
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = "";
        public Guid SessionId { get; set; }
        public DateTime StartUtc { get; set; }
        public DateTime EndUtc { get; set; }
        public TimeSpan Duration { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double AccuracyMeters { get; set; }
        public int PointCount { get; set; }
        public double ArrivalSpeedKmh { get; set; }
        public double DepartureSpeedKmh { get; set; }
        public string MatchedLocation { get; set; } = "Unknown / Other Location";
        public string PlaceCategory { get; set; } = "Field Halt";
        public double DistanceFromMatchedLocationMeters { get; set; }
        public int RadiusMeters { get; set; }
    }

    private sealed class ShopLocation
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double RadiusMeters { get; set; }
    }

    private sealed class Summary
    {
        public int Employees { get; set; }
        public int Stays { get; set; }
        public int Points { get; set; }
        public TimeSpan TotalStay { get; set; }
    }
}
