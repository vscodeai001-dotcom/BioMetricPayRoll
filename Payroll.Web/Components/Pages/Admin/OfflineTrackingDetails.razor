@page "/admin/offline-tracking-details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Services
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FirebaseEmployeeManagementService FirebaseEmployees
@inject AttendanceRefreshService AttendanceRefresh
@inject ILogger<OfflineTrackingDetails> Logger
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Offline GPS Tracking Details</PageTitle>

<div class="container-fluid py-3 enterprise-offline-page">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <div class="small text-muted text-uppercase fw-bold">GPS Operations</div>
            <h3 class="fw-bold mb-1"><i class="bi bi-cloud-slash me-2"></i>Offline GPS Tracking Details</h3>
            <div class="text-muted">Enterprise view of offline capture, synchronization, GPS sessions, movement, geofence state and recovery history.</div>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@loading">
            <i class="bi bi-arrow-clockwise me-1"></i>@(loading ? "Loading..." : "Refresh")
        </button>
    </div>

    <div class="alert alert-info border-0 shadow-sm">
        <i class="bi bi-shield-check me-2"></i>
        <strong>Audit model:</strong> device capture time is kept separately from server synchronization time.
        Offline GPS points are never displayed as if they were captured when the phone reconnected.
    </div>

    <div class="row g-3 mb-4">
        @Metric("Employees Tracked", summary.Employees.ToString(), "bi-people")
        @Metric("Offline Points", summary.OfflinePoints.ToString(), "bi-cloud-slash")
        @Metric("Offline Sessions", summary.OfflineSessions.ToString(), "bi-clock-history")
        @Metric("Pending / Unsynced", summary.Unsynced.ToString(), "bi-hourglass-split")
        @Metric("Total Distance", FormatDistance(summary.DistanceMeters), "bi-signpost-2")
        @Metric("Last Capture", FormatIst(summary.LastCaptureUtc), "bi-geo-alt")
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <strong><i class="bi bi-funnel me-2"></i>Tracking Filters</strong>
                <div class="small text-muted">Use these filters to investigate one employee, session or offline period.</div>
            </div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync">Apply</button>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <label class="form-label">Employee</label>
                    <select class="form-select" @bind="employeeFilter">
                        <option value="0">All employees</option>
                        @foreach (var e in employees)
                        {
                            <option value="@e.EmployeeID">@e.Name (#@e.EmployeeID)</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">From</label>
                    <input type="date" class="form-control" @bind="fromDate" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">To</label>
                    <input type="date" class="form-control" @bind="toDate" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">Capture</label>
                    <select class="form-select" @bind="captureFilter">
                        <option value="">All</option>
                        <option value="OfflineSync">Offline sync</option>
                        <option value="Online">Online</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Session ID</label>
                    <input class="form-control" placeholder="Optional session GUID" @bind="sessionFilter" />
                </div>
            </div>
        </div>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@error</div>
    }

    @if (loading)
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <span class="spinner-border me-2"></span>Loading enterprise tracking data...
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-12 col-xl-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header">
                        <strong><i class="bi bi-broadcast-pin me-2"></i>Live / Session Health</strong>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0 tracking-table">
                                <thead><tr><th>Employee</th><th>Status</th><th>Last GPS</th><th>Age</th><th>Movement</th><th>Speed</th><th>Radius</th></tr></thead>
                                <tbody>
                                @foreach (var row in liveRows)
                                {
                                    <tr>
                                        <td><strong>@row.EmployeeName</strong><div class="small text-muted">#@row.EmployeeId</div></td>
                                        <td><span class="badge @StatusClass(row.Status)">@row.Status</span></td>
                                        <td>@FormatIst(row.LastUpdatedUtc)</td>
                                        <td>@row.Age</td>
                                        <td>@row.Movement</td>
                                        <td>@row.SpeedKmh.ToString("F1") km/h</td>
                                        <td>@(row.WithinRadius ? "IN" : "OUT")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header"><strong><i class="bi bi-diagram-3 me-2"></i>Offline Lifecycle</strong></div>
                    <div class="card-body">
                        <div class="lifecycle">
                            <div><span>01</span><b>GPS Capture</b><small>Original device timestamp</small></div>
                            <div><span>02</span><b>Local Queue</b><small>Preserve sequence and session</small></div>
                            <div><span>03</span><b>Connectivity Recovery</b><small>Detect online transition</small></div>
                            <div><span>04</span><b>Ordered Sync</b><small>Oldest event first</small></div>
                            <div><span>05</span><b>Server ACK</b><small>Exact event acknowledged</small></div>
                            <div><span>06</span><b>Audit / Replay</b><small>Original capture time retained</small></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Offline Disconnection Intervals (Missing Window Reconciliation) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong><i class="bi bi-clock-history me-2 text-warning"></i>Offline Disconnection Intervals (Missing Window Reconciliation)</strong>
                    <div class="small text-muted">Time periods when employee mobile was offline (airplane mode, network disconnected) and re-integrated upon reconnection.</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(selectedPeriodId))
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearPeriodFilter">
                            <i class="bi bi-x-circle me-1"></i>Show All Points
                        </button>
                    }
                    <span class="badge bg-warning text-dark">@offlinePeriods.Count offline periods</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Offline Started (IST)</th>
                                <th>Reconnected (IST)</th>
                                <th>Duration</th>
                                <th>Disconnect Reason</th>
                                <th>Offline Punches in Gap</th>
                                <th>Breadcrumbs</th>
                                <th>Geofence</th>
                                <th>Reconciliation Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var period in offlinePeriods)
                        {
                            var isSelected = period.Id == selectedPeriodId;
                            <tr class="@(isSelected ? "table-warning fw-semibold" : "")">
                                <td><strong>@period.EmployeeName</strong><div class="small text-muted">#@period.EmployeeId</div></td>
                                <td class="nowrap"><i class="bi bi-wifi-off text-danger me-1"></i>@FormatIst(period.OfflineStartedUtc)</td>
                                <td class="nowrap"><i class="bi bi-wifi text-success me-1"></i>@FormatIst(period.OfflineEndedUtc)</td>
                                <td><span class="badge bg-dark-subtle text-dark">@FormatDuration(period.Duration)</span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-airplane me-1"></i>@period.DisconnectReason</span></td>
                                <td>
                                    @if (period.Punches.Any())
                                    {
                                        <div class="d-flex flex-column gap-1">
                                        @foreach (var p in period.Punches)
                                        {
                                            var isOut = p.Type.Equals("OUT", StringComparison.OrdinalIgnoreCase);
                                            <span class="badge @(isOut ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle") text-start">
                                                @(isOut ? "🔴 OUT" : "🟢 IN") @FormatIst(p.PunchTimeUtc, "HH:mm")
                                                <small class="d-block fw-normal text-muted">(Recorded Offline)</small>
                                            </span>
                                        }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i>None</span>
                                    }
                                </td>
                                <td><span class="badge bg-info-subtle text-info-emphasis">@period.PointCount points</span> · @FormatDistance(period.TotalDistanceMeters)</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success">@period.WithinRadiusCount IN</span>
                                    @if (period.PointCount - period.WithinRadiusCount > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1">@(period.PointCount - period.WithinRadiusCount) OUT</span>
                                    }
                                </td>
                                <td>
                                    @if (period.IsFullySynced)
                                    {
                                        <div>
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Reconciled to Live</span>
                                            <div class="small text-primary mt-1">
                                                Pushed to cloud: @(period.Punches.Any() ? $"{period.Punches.Count} punches & " : "")@period.PointCount points merged
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Sync Pending</span>
                                            <div class="small text-warning-emphasis mt-1">Buffered on device</div>
                                        </div>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm @(isSelected ? "btn-warning" : "btn-outline-primary")" @onclick="() => TogglePeriodFilter(period.Id)">
                                        <i class="bi @(isSelected ? "bi-check2-circle" : "bi-eye") me-1"></i>@(isSelected ? "Active Filter" : "Inspect Route")
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (!offlinePeriods.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-check-circle text-success fs-4 d-block mb-1"></i>
                        No offline disconnect periods recorded in the selected date range. All tracking was captured online in real-time.
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong><i class="bi bi-map me-2"></i>Offline Route / Point Ledger</strong>
                    @if (!string.IsNullOrEmpty(selectedPeriodId))
                    {
                        <span class="badge bg-warning text-dark ms-2">Filtered to selected offline period</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(selectedPeriodId))
                    {
                        <button class="btn btn-sm btn-link text-decoration-none p-0" @onclick="ClearPeriodFilter">Clear Filter</button>
                    }
                    <span class="badge bg-primary-subtle text-primary">@DisplayedPoints.Count points</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive offline-ledger">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Capture IST</th><th>Employee</th><th>Session</th><th>Source</th>
                                <th>Coordinates</th><th>Accuracy</th><th>Office Distance</th>
                                <th>Radius</th><th>State</th><th>Speed</th><th>Sync IST</th><th>Batch</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in DisplayedPoints)
                        {
                            <tr>
                                <td class="nowrap">@FormatIst(p.CapturedAtUtc)</td>
                                <td><strong>@p.EmployeeName</strong><div class="small text-muted">#@p.EmployeeId</div></td>
                                <td><code>@ShortGuid(p.SessionId)</code></td>
                                <td><span class="badge @(p.CaptureSource == "OfflineSync" ? "bg-warning text-dark" : "bg-secondary")">@p.CaptureSource</span></td>
                                <td><code>@p.Latitude.ToString("F6"), @p.Longitude.ToString("F6")</code></td>
                                <td>@p.AccuracyMeters.ToString("F1") m</td>
                                <td>@p.DistanceMeters.ToString("F1") m</td>
                                <td>@p.RadiusMeters m</td>
                                <td><span class="badge @(p.WithinRadius ? "bg-success" : "bg-danger")">@(p.WithinRadius ? "IN" : "OUT")</span><div class="small text-muted">@p.Movement</div></td>
                                <td>@p.SpeedKmh.ToString("F1") km/h</td>
                                <td class="nowrap">@(p.SyncedAtUtc.HasValue ? FormatIst(p.SyncedAtUtc) : "Pending")</td>
                                <td><code>@(p.SyncBatchId.HasValue ? ShortGuid(p.SyncBatchId.Value) : "-")</code></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (!DisplayedPoints.Any())
                {
                    <div class="p-4 text-center text-muted">No GPS points match the selected filters.</div>
                }
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-xl-7">
                <div class="card shadow-sm border-0">
                    <div class="card-header"><strong><i class="bi bi-clock-history me-2"></i>GPS Session Ledger</strong></div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead><tr><th>Employee</th><th>Session</th><th>Started IST</th><th>Last GPS IST</th><th>Ended IST</th><th>Reason</th><th>Points</th><th>Distance</th></tr></thead>
                                <tbody>
                                @foreach (var s in sessions)
                                {
                                    <tr>
                                        <td><strong>@s.EmployeeName</strong><div class="small text-muted">#@s.EmployeeId</div></td>
                                        <td><code>@ShortGuid(s.SessionId)</code></td>
                                        <td class="nowrap">@FormatIst(s.StartedUtc)</td>
                                        <td class="nowrap">@FormatIst(s.LastUpdateUtc)</td>
                                        <td class="nowrap">@(s.EndedUtc.HasValue ? FormatIst(s.EndedUtc) : "ACTIVE")</td>
                                        <td>@(s.EndReason ?? "Active")</td>
                                        <td>@s.TotalPoints</td>
                                        <td>@FormatDistance(s.TotalDistanceMeters)</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card shadow-sm border-0">
                    <div class="card-header"><strong><i class="bi bi-shield-check me-2"></i>Recovery / Audit Events</strong></div>
                    <div class="card-body p-0">
                        <div class="event-list">
                            @foreach (var a in auditEvents)
                            {
                                <div class="event-row">
                                    <div class="event-time">@FormatIst(a.Timestamp)</div>
                                    <div class="event-main">
                                        <div class="fw-semibold">@a.EventType</div>
                                        <div class="small text-muted">@a.UserEmail · @a.EntityID</div>
                                        <pre>@a.Details</pre>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (!auditEvents.Any())
                        {
                            <div class="p-4 text-center text-muted">No GPS recovery/audit events found.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<AttendanceRefreshListener OnAttendanceChanged="HandleAttendanceChanged" OnLocationChanged="HandleAttendanceChanged" />

<style>
.enterprise-offline-page { min-width: 0; }
.enterprise-offline-page .card { border-radius: 14px; overflow: hidden; }
.enterprise-offline-page .card-header { background: rgba(127,127,127,.08); border-bottom-color: rgba(127,127,127,.18); }
.enterprise-offline-page .form-label { font-size: .82rem; font-weight: 700; }
.tracking-table th, .offline-ledger th { white-space: nowrap; font-size: .72rem; text-transform: uppercase; letter-spacing: .03em; }
.tracking-table td, .offline-ledger td { font-size: .78rem; }
.nowrap { white-space: nowrap; }
.offline-ledger { max-height: 520px; overflow: auto; }
.offline-ledger table { min-width: 1200px; }
.event-list { max-height: 460px; overflow: auto; }
.event-row { display:flex; gap:12px; padding:12px 14px; border-bottom:1px solid rgba(127,127,127,.18); }
.event-time { min-width:145px; font-size:.74rem; color:var(--bs-secondary-color); }
.event-main { min-width:0; flex:1; }
.event-main pre { white-space:pre-wrap; overflow-wrap:anywhere; font-size:.7rem; margin:.25rem 0 0; color:var(--bs-secondary-color); }
.lifecycle { display:grid; gap:9px; }
.lifecycle > div { display:grid; grid-template-columns:34px 1fr; column-gap:10px; align-items:center; }
.lifecycle span { grid-row:span 2; width:30px; height:30px; border-radius:50%; display:grid; place-items:center; background:var(--bs-primary); color:#fff; font-size:.7rem; font-weight:700; }
.lifecycle b { font-size:.84rem; }
.lifecycle small { color:var(--bs-secondary-color); }
@@media (max-width: 767.98px) {
    .enterprise-offline-page { padding-left:.25rem; padding-right:.25rem; }
    .offline-ledger { margin:0; }
    .event-time { min-width:0; }
    .event-row { display:block; }
    .event-time { margin-bottom:4px; }
}
</style>

@code {
    private bool loading;
    private string? error;
    private int employeeFilter;
    private string captureFilter = "";
    private string sessionFilter = "";
    private DateTime fromDate = DateTime.Today.AddDays(-1);
    private DateTime toDate = DateTime.Today;

    private List<EmployeeOption> employees = new();
    private List<LiveRow> liveRows = new();
    private List<PointRow> points = new();
    private List<OfflinePeriodRow> offlinePeriods = new();
    private List<SessionRow> sessions = new();
    private List<AuditRow> auditEvents = new();
    private Summary summary = new();
    private string? selectedPeriodId;

    private List<PointRow> DisplayedPoints =>
        string.IsNullOrEmpty(selectedPeriodId)
            ? points
            : offlinePeriods.FirstOrDefault(p => p.Id == selectedPeriodId)?.Points ?? points;

    private void TogglePeriodFilter(string periodId)
    {
        selectedPeriodId = selectedPeriodId == periodId ? null : periodId;
    }

    private void ClearPeriodFilter()
    {
        selectedPeriodId = null;
    }

    private static string FormatDuration(TimeSpan span)
    {
        if (span.TotalDays >= 1) return $"{(int)span.TotalDays}d {span.Hours}h {span.Minutes}m";
        if (span.TotalHours >= 1) return $"{(int)span.TotalHours}h {span.Minutes}m {span.Seconds}s";
        if (span.TotalMinutes >= 1) return $"{(int)span.TotalMinutes}m {span.Seconds}s";
        return $"{Math.Max(1, span.Seconds)}s";
    }

    private CancellationTokenSource? cts;
    private PeriodicTimer? timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        _ = RefreshLoopAsync(cts.Token);
    }

    private async Task HandleAttendanceChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error reacting to attendance/location event in OfflineTrackingDetails");
        }
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(token))
            {
                if (loading) continue;
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Offline tracking background refresh loop stopped.");
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var allEmployees = (await FirebaseEmployees.GetEmployeesAsync())
                .Where(x => !x.IsDeleted)
                .OrderBy(x => x.Name)
                .Select(x => new EmployeeOption { EmployeeID = x.EmployeeID, Name = x.Name })
                .ToList();

            // Retain full employee list for the dropdown filter
            employees = allEmployees;

            var fromUtc = IndiaToUtc(fromDate.Date);
            var toUtc = IndiaToUtc(toDate.Date.AddDays(1));

            var employeeIds = employeeFilter > 0
                ? new[] { employeeFilter }
                : null;

            var historyQuery = db.EmployeeLocationHistory.AsNoTracking()
                .Where(x => x.CapturedAtUtc >= fromUtc && x.CapturedAtUtc < toUtc);

            if (employeeIds is not null)
                historyQuery = historyQuery.Where(x => employeeIds.Contains(x.EmployeeId));

            if (!string.IsNullOrWhiteSpace(captureFilter))
                historyQuery = historyQuery.Where(x => x.CaptureSource == captureFilter);

            if (Guid.TryParse(sessionFilter, out var sessionId))
                historyQuery = historyQuery.Where(x => x.SessionId == sessionId);

            var rawPoints = await historyQuery
                .OrderBy(p => p.CapturedAtUtc)
                .Select(p => new PointRow
                {
                    EmployeeId = p.EmployeeId, SessionId = p.SessionId,
                    Latitude = p.Latitude, Longitude = p.Longitude, AccuracyMeters = p.AccuracyMeters,
                    DistanceMeters = p.DistanceFromOfficeMeters, RadiusMeters = p.AllowedRadiusMeters,
                    WithinRadius = p.IsWithinAllowedRadius, CapturedAtUtc = p.CapturedAtUtc,
                    CaptureSource = p.CaptureSource, SyncBatchId = p.SyncBatchId, SyncedAtUtc = p.SyncedAtUtc,
                    RecordedAtUtc = p.RecordedAtUtc
                }).Take(2000).ToListAsync();

            var employeeNames = allEmployees.ToDictionary(x => x.EmployeeID, x => x.Name);
            foreach (var row in rawPoints)
                row.EmployeeName = employeeNames.TryGetValue(row.EmployeeId, out var n) ? n : $"Employee {row.EmployeeId}";

            points = BuildPointRows(rawPoints);

            var sessionQuery = db.EmployeeGpsSessions.AsNoTracking().AsQueryable();
            if (employeeFilter > 0) sessionQuery = sessionQuery.Where(x => x.EmployeeId == employeeFilter);
            if (Guid.TryParse(sessionFilter, out var sessionId2)) sessionQuery = sessionQuery.Where(x => x.SessionId == sessionId2);

            var rawSessions = await sessionQuery
                .Where(s => s.StartedAtUtc < toUtc &&
                            (s.EndedAtUtc == null || s.EndedAtUtc >= fromUtc))
                .OrderByDescending(s => s.StartedAtUtc)
                .Select(s => new SessionRow
                {
                    EmployeeId = s.EmployeeId, SessionId = s.SessionId,
                    StartedUtc = s.StartedAtUtc, LastUpdateUtc = s.LastUpdateAtUtc,
                    EndedUtc = s.EndedAtUtc, EndReason = s.EndReason,
                    TotalPoints = s.TotalPoints, TotalDistanceMeters = s.TotalDistanceMeters
                }).Take(500).ToListAsync();

            foreach (var row in rawSessions)
                row.EmployeeName = employeeNames.TryGetValue(row.EmployeeId, out var n) ? n : $"Employee {row.EmployeeId}";

            sessions = rawSessions;

            var liveLocations = LiveLocationStore.GetAll().ToDictionary(x => x.EmployeeId);
            var targetEmployees = employeeFilter > 0
                ? allEmployees.Where(e => e.EmployeeID == employeeFilter).ToList()
                : allEmployees;

            var targetEmpIds = targetEmployees.Select(e => e.EmployeeID).ToList();

            var recentHistory = await db.EmployeeLocationHistory.AsNoTracking()
                .Where(x => targetEmpIds.Contains(x.EmployeeId))
                .OrderByDescending(x => x.CapturedAtUtc)
                .Take(500)
                .ToListAsync();

            var historyMap = recentHistory
                .GroupBy(x => x.EmployeeId)
                .ToDictionary(g => g.Key, g => g.First());

            liveRows = targetEmployees.Select(e =>
            {
                if (liveLocations.TryGetValue(e.EmployeeID, out var liveLoc))
                {
                    var status = LiveLocationStore.GetStatus(liveLoc);
                    return new LiveRow
                    {
                        EmployeeId = e.EmployeeID,
                        EmployeeName = e.Name,
                        Status = status.ToString(),
                        LastUpdatedUtc = liveLoc.LastUpdatedUtc,
                        Age = FormatAge(LiveLocationStore.GetAge(liveLoc)),
                        Movement = liveLoc.MovementState,
                        SpeedKmh = liveLoc.SpeedMps * 3.6,
                        WithinRadius = liveLoc.IsWithinAllowedRadius
                    };
                }
                else if (historyMap.TryGetValue(e.EmployeeID, out var hist))
                {
                    var age = DateTime.UtcNow - hist.CapturedAtUtc;
                    return new LiveRow
                    {
                        EmployeeId = e.EmployeeID,
                        EmployeeName = e.Name,
                        Status = "Offline",
                        LastUpdatedUtc = hist.CapturedAtUtc,
                        Age = FormatAge(age),
                        Movement = "No active session",
                        SpeedKmh = 0,
                        WithinRadius = hist.IsWithinAllowedRadius
                    };
                }
                else
                {
                    return new LiveRow
                    {
                        EmployeeId = e.EmployeeID,
                        EmployeeName = e.Name,
                        Status = "Offline",
                        LastUpdatedUtc = DateTime.MinValue,
                        Age = "Never",
                        Movement = "No GPS data",
                        SpeedKmh = 0,
                        WithinRadius = false
                    };
                }
            })
            .OrderBy(x => x.Status == "Live" ? 0 : x.Status == "Stale" ? 1 : 2)
            .ThenBy(x => x.EmployeeName)
            .ToList();

            var auditQuery = db.AuditLogs.AsNoTracking()
                .Where(x => x.Timestamp >= fromUtc && x.Timestamp < toUtc)
                .Where(x =>
                    x.ActionType.Contains("GPS") ||
                    x.EntityType.Contains("Gps") ||
                    x.EntityType.Contains("Location") ||
                    x.ActionType.Contains("OFFLINE"));

            if (employeeFilter > 0)
            {
                var empStr = employeeFilter.ToString();
                auditQuery = auditQuery.Where(x => x.EntityID == empStr);
            }

            auditEvents = await auditQuery
                .OrderByDescending(x => x.Timestamp)
                .Take(300)
                .Select(x => new AuditRow
                {
                    Timestamp = x.Timestamp,
                    UserEmail = x.UserEmail,
                    EntityID = x.EntityID,
                    EventType = x.ActionType + " / " + x.EntityType,
                    Details = x.Details ?? ""
                }).ToListAsync();

            DateTime? maxCaptureUtc = points.Count > 0 ? points.Max(x => x.CapturedAtUtc) : null;
            if (!maxCaptureUtc.HasValue)
            {
                var liveMax = liveRows.Where(r => r.LastUpdatedUtc != DateTime.MinValue).Select(r => (DateTime?)r.LastUpdatedUtc).DefaultIfEmpty(null).Max();
                maxCaptureUtc = liveMax;
            }

            var periodPunches = await db.AttendanceLogs.AsNoTracking()
                .Where(p => p.PunchTime >= fromUtc && p.PunchTime < toUtc)
                .ToListAsync();

            offlinePeriods = BuildOfflinePeriods(points, auditEvents, periodPunches);

            summary = new Summary
            {
                Employees = targetEmployees.Count,
                OfflinePoints = points.Count(x => x.CaptureSource == "OfflineSync"),
                OfflineSessions = sessions.Count(x => x.EndedUtc.HasValue && (x.EndReason ?? "").Contains("OFFLINE", StringComparison.OrdinalIgnoreCase)),
                Unsynced = points.Count(x => !x.SyncedAtUtc.HasValue && x.CaptureSource == "OfflineSync"),
                DistanceMeters = sessions.Sum(x => x.TotalDistanceMeters),
                LastCaptureUtc = maxCaptureUtc
            };
        }
        catch (Exception ex)
        {
            error = "Unable to load offline tracking details: " + ex.Message;
        }
        finally { loading = false; }
    }

    private static List<OfflinePeriodRow> BuildOfflinePeriods(List<PointRow> allPoints, List<AuditRow> audits, List<AttendanceLog> punches)
    {
        var offlinePoints = allPoints
            .Where(p => p.CaptureSource == "OfflineSync")
            .OrderBy(p => p.CapturedAtUtc)
            .ToList();

        var result = new List<OfflinePeriodRow>();
        if (!offlinePoints.Any()) return result;

        foreach (var empGroup in offlinePoints.GroupBy(p => p.EmployeeId))
        {
            var currentPoints = new List<PointRow>();
            PointRow? lastPoint = null;

            foreach (var pt in empGroup)
            {
                if (lastPoint == null ||
                    (pt.CapturedAtUtc - lastPoint.CapturedAtUtc).TotalMinutes > 15 ||
                    pt.SessionId != lastPoint.SessionId)
                {
                    if (currentPoints.Any())
                    {
                        result.Add(CreatePeriod(currentPoints, audits, punches));
                        currentPoints = new List<PointRow>();
                    }
                }
                currentPoints.Add(pt);
                lastPoint = pt;
            }

            if (currentPoints.Any())
            {
                result.Add(CreatePeriod(currentPoints, audits, punches));
            }
        }

        return result.OrderByDescending(x => x.OfflineStartedUtc).ToList();
    }

    private static OfflinePeriodRow CreatePeriod(List<PointRow> cluster, List<AuditRow> audits, List<AttendanceLog> punches)
    {
        var first = cluster.First();
        var last = cluster.Last();
        var empId = first.EmployeeId;
        var empName = first.EmployeeName;

        var relatedAudit = audits.FirstOrDefault(a =>
            a.EntityID == empId.ToString() &&
            Math.Abs((a.Timestamp - first.CapturedAtUtc).TotalMinutes) < 30);

        var reason = "Network Disconnected / Signal Loss";
        if (relatedAudit != null)
        {
            if (relatedAudit.Details.Contains("AIRPLANE", StringComparison.OrdinalIgnoreCase) ||
                relatedAudit.EventType.Contains("AIRPLANE", StringComparison.OrdinalIgnoreCase))
                reason = "Airplane Mode";
            else if (relatedAudit.Details.Contains("MANUAL", StringComparison.OrdinalIgnoreCase))
                reason = "Mobile Data / Wi-Fi Off";
        }

        var punchesInGap = punches
            .Where(p => p.EmployeeID == empId &&
                        p.PunchTime >= first.CapturedAtUtc.AddMinutes(-2) &&
                        p.PunchTime <= last.CapturedAtUtc.AddMinutes(2))
            .OrderBy(p => p.PunchTime)
            .Select(p => new ReconciledPunch
            {
                Type = p.LogType ?? "PUNCH",
                PunchTimeUtc = p.PunchTime,
                IsApproved = p.IsApproved
            })
            .ToList();

        double totalDist = 0;
        for (int i = 1; i < cluster.Count; i++)
        {
            totalDist += CalculateDistance(cluster[i - 1].Latitude, cluster[i - 1].Longitude, cluster[i].Latitude, cluster[i].Longitude);
        }

        return new OfflinePeriodRow
        {
            EmployeeId = empId,
            EmployeeName = empName,
            SessionId = first.SessionId,
            OfflineStartedUtc = first.CapturedAtUtc,
            OfflineEndedUtc = last.CapturedAtUtc,
            PointCount = cluster.Count,
            TotalDistanceMeters = totalDist,
            WithinRadiusCount = cluster.Count(c => c.WithinRadius),
            DisconnectReason = reason,
            IsFullySynced = cluster.All(c => c.SyncedAtUtc.HasValue),
            SyncedAtUtc = cluster.Select(c => c.SyncedAtUtc).Max(),
            Points = cluster,
            Punches = punchesInGap
        };
    }

    private static List<PointRow> BuildPointRows(List<PointRow> rows)
    {
        var previous = new Dictionary<int, PointRow>();
        foreach (var row in rows)
        {
            if (previous.TryGetValue(row.EmployeeId, out var prior))
            {
                var elapsed = (row.CapturedAtUtc - prior.CapturedAtUtc).TotalSeconds;
                var distance = CalculateDistance(prior.Latitude, prior.Longitude, row.Latitude, row.Longitude);
                var speed = elapsed > 0.25 && elapsed <= 300 && distance <= 5000 ? distance / elapsed : 0;
                row.SpeedKmh = speed * 3.6;
                row.Movement = GetMovement(speed);
            }
            previous[row.EmployeeId] = row;
        }
        return rows.OrderByDescending(x => x.CapturedAtUtc).ToList();
    }

    private static string GetMovement(double speedMps)
    {
        if (!double.IsFinite(speedMps) || speedMps <= .5) return "Stopped";
        if (speedMps <= 2) return "Walking";
        if (speedMps <= 8) return "Cycling";
        return "Moving";
    }

    private static string FormatAge(TimeSpan age) =>
        age == TimeSpan.MaxValue ? "Never" :
        age.TotalHours >= 1 ? $"{(int)age.TotalHours}h {age.Minutes}m" :
        $"{Math.Max(0, (int)age.TotalMinutes)}m {Math.Max(0, age.Seconds)}s";

    private static double CalculateDistance(double aLat, double aLon, double bLat, double bLon)
    {
        const double r = 6371000d;
        var p1 = aLat * Math.PI / 180d;
        var p2 = bLat * Math.PI / 180d;
        var dp = (bLat - aLat) * Math.PI / 180d;
        var dl = (bLon - aLon) * Math.PI / 180d;
        var a = Math.Sin(dp / 2) * Math.Sin(dp / 2) +
                Math.Cos(p1) * Math.Cos(p2) * Math.Sin(dl / 2) * Math.Sin(dl / 2);
        return r * 2 * Math.Atan2(Math.Sqrt(Math.Clamp(a, 0, 1)), Math.Sqrt(1 - Math.Clamp(a, 0, 1)));
    }

    private static string FormatDistance(double meters) =>
        meters >= 1000 ? $"{meters / 1000d:F2} km" : $"{meters:F0} m";

    private static string FormatIst(DateTime? utc, string format = "dd-MMM-yyyy HH:mm:ss") =>
        utc.HasValue ? TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc),
            TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata"))
            .ToString(format) : "-";

    private static DateTime IndiaToUtc(DateTime india) =>
        TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(india, DateTimeKind.Unspecified),
            TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata"));

    private static string ShortGuid(Guid id) => id.ToString("N")[..8];

    private static string StatusClass(string status) => status switch
    {
        "Live" => "bg-success",
        "Stale" => "bg-warning text-dark",
        _ => "bg-danger"
    };

    public async ValueTask DisposeAsync()
    {
        try { cts?.Cancel(); } catch { }
        cts?.Dispose();
        timer?.Dispose();
        await ValueTask.CompletedTask;
    }

    private sealed class EmployeeOption { public int EmployeeID { get; set; } public string Name { get; set; } = ""; }
    private sealed class LiveRow { public int EmployeeId { get; set; } public string EmployeeName { get; set; } = ""; public string Status { get; set; } = ""; public DateTime LastUpdatedUtc { get; set; } public string Age { get; set; } = ""; public string Movement { get; set; } = ""; public double SpeedKmh { get; set; } public bool WithinRadius { get; set; } }
    private sealed class PointRow
    {
        public int EmployeeId { get; set; } public string EmployeeName { get; set; } = ""; public Guid SessionId { get; set; }
        public double Latitude { get; set; } public double Longitude { get; set; } public double AccuracyMeters { get; set; }
        public double DistanceMeters { get; set; } public int RadiusMeters { get; set; } public bool WithinRadius { get; set; }
        public DateTime CapturedAtUtc { get; set; } public string CaptureSource { get; set; } = ""; public Guid? SyncBatchId { get; set; }
        public DateTime? SyncedAtUtc { get; set; } public DateTime RecordedAtUtc { get; set; } public double SpeedKmh { get; set; } public string Movement { get; set; } = "Stopped";
    }
    private sealed class OfflinePeriodRow
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = "";
        public Guid SessionId { get; set; }
        public DateTime OfflineStartedUtc { get; set; }
        public DateTime OfflineEndedUtc { get; set; }
        public TimeSpan Duration => OfflineEndedUtc >= OfflineStartedUtc ? OfflineEndedUtc - OfflineStartedUtc : TimeSpan.Zero;
        public int PointCount { get; set; }
        public double TotalDistanceMeters { get; set; }
        public int WithinRadiusCount { get; set; }
        public string DisconnectReason { get; set; } = "Network Disconnected";
        public bool IsFullySynced { get; set; }
        public DateTime? SyncedAtUtc { get; set; }
        public List<PointRow> Points { get; set; } = new();
        public List<ReconciledPunch> Punches { get; set; } = new();
    }
    private sealed class ReconciledPunch
    {
        public string Type { get; set; } = "IN";
        public DateTime PunchTimeUtc { get; set; }
        public bool IsApproved { get; set; } = true;
    }
    private sealed class SessionRow
    {
        public int EmployeeId { get; set; } public string EmployeeName { get; set; } = ""; public Guid SessionId { get; set; }
        public DateTime StartedUtc { get; set; } public DateTime LastUpdateUtc { get; set; } public DateTime? EndedUtc { get; set; }
        public string? EndReason { get; set; } public int TotalPoints { get; set; } public double TotalDistanceMeters { get; set; }
    }
    private sealed class AuditRow { public DateTime Timestamp { get; set; } public string UserEmail { get; set; } = ""; public string? EntityID { get; set; } public string EventType { get; set; } = ""; public string Details { get; set; } = ""; }
    private sealed class Summary { public int Employees { get; set; } public int OfflinePoints { get; set; } public int OfflineSessions { get; set; } public int Unsynced { get; set; } public double DistanceMeters { get; set; } public DateTime? LastCaptureUtc { get; set; } }
}


