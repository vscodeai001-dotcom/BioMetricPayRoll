        builder.AddContent(seq++, Value);
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", $"bi {Icon} fs-4 text-primary");
        builder.CloseElement();
