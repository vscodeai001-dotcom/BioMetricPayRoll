@page "/admin/audit-logs"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@attribute [Authorize(Roles = "SuperAdmin")]

<PageTitle>System Audit Logs</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-shield-check me-2"></i> System Audit Logs</h3>
    <span class="badge bg-warning text-dark">SuperAdmin Only</span>
</div>
<p>Track security events, user changes, and critical updates.</p>

<div class="row p-3 mb-3 bg-light border rounded">
    <div class="col-md-3">
        <label class="form-label small fw-bold">Start Date</label>
        <input type="date" @bind="startDate" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label small fw-bold">End Date</label>
        <input type="date" @bind="endDate" class="form-control" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="LoadLogs">
            <i class="bi bi-search me-1"></i> Search
        </button>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading logs...</em></p>
}
else if (logs == null || !logs.Any())
{
    <div class="alert alert-info">No audit logs found for this period.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover border">
            <thead class="table-dark">
                <tr>
                    <th>Timestamp</th>
                    <th>User (Performer)</th>
                    <th>Action</th>
                    <th>Entity Type</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in logs)
                {
                    <tr>
                        <td style="white-space:nowrap;">@ToIndiaTime(log.Timestamp).ToString("dd-MMM-yyyy HH:mm:ss")</td>
                        <td class="fw-bold">@log.UserEmail</td>
                        <td>
                            <span class="badge @GetBadgeColor(log.ActionType)">@log.ActionType</span>
                        </td>
                        <td>@log.EntityType <small class="text-muted">(ID: @log.EntityID)</small></td>
                        <td class="small text-muted">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code {
    
    private List<AuditLog> logs = new();
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private bool isLoading = false;
    

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs();
    }

    private async Task LoadLogs()
    {
        isLoading = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            
            // Audit timestamps are persisted as UTC (timestamp without time zone).
            // Convert the selected Indian business-date range to UTC for querying.
            var queryStart = IndiaToUtc(startDate.Date);
            var queryEndExclusive = IndiaToUtc(endDate.Date.AddDays(1));

            var features = await db.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(f => f.Id == 1);
            if (features != null && !features.EnableAuditLog)
            {
               
                return;
            }

            logs = await db.AuditLogs
                .AsNoTracking()
                .Where(l => l.Timestamp >= queryStart && l.Timestamp < queryEndExclusive)
                .OrderByDescending(l => l.Timestamp)
                .Take(500) // Safety limit
                .ToListAsync();



        }
        finally
        {
            isLoading = false;
        }
    }

    private static readonly TimeZoneInfo IndiaTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");

    private static DateTime ToIndiaTime(DateTime value) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(value, DateTimeKind.Utc),
            IndiaTimeZone);

    private static DateTime IndiaToUtc(DateTime indiaTime) =>
        TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(indiaTime, DateTimeKind.Unspecified),
            IndiaTimeZone);

    private string GetBadgeColor(string action) => action switch
    {
        "CREATE" => "bg-success",
        "UPDATE" => "bg-info text-dark",
        "DELETE" => "bg-danger",
        "LOGIN" => "bg-secondary",
        _ => "bg-light text-dark border"
    };

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await LoadLogs();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}