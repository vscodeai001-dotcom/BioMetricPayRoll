@page "/admin/tax-declarations"
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject TaxDeclarationService TaxService
@inject Payroll.Web.Services.AttendanceRefreshService AttendanceRefresh
@inject Payroll.Web.Services.NotificationService NotificationService
@inject IToastService toastService
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Manage Tax Declarations</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Tax Declaration</strong> module is currently disabled.</p>
            <hr>
            <p class="mb-0">Please enable it in the Feature Toggle settings.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column h-100">
        @* --- HEADER & FILTERS --- *@
        <div class="flex-shrink-0 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0 text-primary">Employee Tax Declarations</h3>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" @bind="selectedYear" style="width:120px;">
                        <option value="@DateTime.Now.Year">@DateTime.Now.Year</option>
                        <option value="@(DateTime.Now.Year - 1)">@(DateTime.Now.Year - 1)</option>
                    </select>
                    <button class="btn btn-outline-primary btn-sm" @onclick="LoadDeclarations">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-2 d-flex gap-3 align-items-center">
                    <span class="small fw-bold text-muted">Filter:</span>
                    <button class="btn btn-sm @(filterStatus == "All" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => Filter("All")'>All</button>
                    <button class="btn btn-sm @(filterStatus == "Pending" ? "btn-warning" : "btn-outline-secondary")" @onclick='() => Filter("Pending")'>Pending</button>
                    <button class="btn btn-sm @(filterStatus == "Approved" ? "btn-success" : "btn-outline-secondary")" @onclick='() => Filter("Approved")'>Approved</button>
                </div>
            </div>
        </div>

        @* --- DATA TABLE (Fit to Screen) --- *@
        <div class="flex-grow-1 overflow-auto border rounded shadow-sm bg-white">
            <table class="table table-striped table-hover table-sm align-middle mb-0 sticky-header-table">
                <thead class="table-dark">
                    <tr>
                        <th>Employee</th>
                        <th>Regime</th>
                        <th class="text-end">80C</th>
                        <th class="text-end">80D</th>
                        <th class="text-end">Rent Paid</th>
                        <th class="text-end">Other</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredList == null || !filteredList.Any())
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">No declarations found.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in filteredList)
                        {
                            <tr>
                                <td class="fw-bold">
                                    @GetEmployeeName(item.EmployeeId)
                                    <br /><small class="fw-normal text-muted">ID: @item.EmployeeId</small>
                                </td>
                                <td>
                                    @if (item.Regime == "New")
                                    {
                                        <span class="badge bg-info text-dark">New</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Old</span>
                                    }
                                </td>
                                <td class="text-end text-muted">@(item.Regime == "New" ? "-" : item.Section80C.ToString("N0"))</td>
                                <td class="text-end text-muted">@(item.Regime == "New" ? "-" : item.Section80D.ToString("N0"))</td>
                                <td class="text-end text-muted">@(item.Regime == "New" ? "-" : item.HraRentPaid.ToString("N0"))</td>
                                <td class="text-end text-muted">@(item.Regime == "New" ? "-" : item.OtherExemptions.ToString("N0"))</td>
                                <td class="text-center">
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Draft</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Status == "Pending")
                                    {
                                        <button class="btn btn-xs btn-success me-1" @onclick="() => Approve(item)" title="Approve">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button class="btn btn-xs btn-danger" @onclick="() => Reject(item)" title="Reject">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <button class="btn btn-xs btn-outline-secondary" @onclick="() => Unlock(item)" title="Unlock/Revert">
                                            <i class="bi bi-lock-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleDataRefresh" />

<style>
    .sticky-header-table thead th {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .btn-xs {
        padding: 0.1rem 0.4rem;
        font-size: 0.75rem;
    }
</style>

@code {
    private bool isAccessDenied = false;
    private int selectedYear = DateTime.Now.Month > 3 ? DateTime.Now.Year : DateTime.Now.Year - 1;
    private List<TaxDeclaration> allDeclarations = new();
    private List<TaxDeclaration> filteredList = new();
    private List<Employee> employees = new();
    private string filterStatus = "All";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // 1. GATE CHECK
        var settings = await db.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(f => f.Id == 1);
        if (settings != null && !settings.EnableTaxDeclarations)
        {
            isAccessDenied = true;
            return;
        }

        employees = await FirebaseEmployees.GetEmployeesAsync();
        allDeclarations = await db.TaxDeclarations
            .Where(t => t.FinancialYear == selectedYear)
            .OrderByDescending(t => t.SubmissionDate)
            .ToListAsync();
        Filter(filterStatus);
    }

    private async Task LoadDeclarations() => await LoadData();

    private void Filter(string status)
    {
        filterStatus = status;
        if (status == "All") filteredList = allDeclarations;
        else filteredList = allDeclarations.Where(x => x.Status == status).ToList();
    }

    private string GetEmployeeName(int id) => employees.FirstOrDefault(e => e.EmployeeID == id)?.Name ?? $"ID:{id}";

    private async Task HandleDataRefresh()
    {
        await LoadData();
    }

    private async Task Approve(TaxDeclaration item)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Approve this declaration? This locks the regime for payroll.")) return;
        await TaxService.ApproveAsync(item.DeclarationId, "Approved by Admin");
        await NotificationService.NotifyEmployeeAsync(
            item.EmployeeId,
            "Tax Declaration Approved",
            $"Your tax declaration for FY {selectedYear}-{selectedYear + 1} was approved.",
            "/my-tax-declaration");
        await AttendanceRefresh.NotifyDataChangedAsync(item.EmployeeId, null, "TAX_APPROVAL");
        toastService.ShowSuccess("Approved");
        await LoadData();
    }

    private async Task Reject(TaxDeclaration item)
    {
        var reason = await JSRuntime.InvokeAsync<string>("prompt", "Enter rejection reason:");
        if (string.IsNullOrWhiteSpace(reason)) return;
        await TaxService.RejectAsync(item.DeclarationId, reason);
        await NotificationService.NotifyEmployeeAsync(
            item.EmployeeId,
            "Tax Declaration Rejected",
            $"Your tax declaration for FY {selectedYear}-{selectedYear + 1} was rejected. Reason: {reason}",
            "/my-tax-declaration");
        await AttendanceRefresh.NotifyDataChangedAsync(item.EmployeeId, null, "TAX_REJECTION");
        toastService.ShowWarning("Rejected");
        await LoadData();
    }

    private async Task Unlock(TaxDeclaration item)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Unlock this declaration to allow employee edits?")) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.TaxDeclarations.FindAsync(item.DeclarationId);
        if (existing != null)
        {
            existing.Status = "Draft";
            await db.SaveChangesAsync();
            await AttendanceRefresh.NotifyDataChangedAsync(item.EmployeeId, null, "TAX_UNLOCK");
            toastService.ShowInfo("Declaration unlocked.");
            await LoadData();
        }
    }
}