@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@using global::Payroll.Web.Services
@using global::Payroll.Web.Models
@using global::Payroll.Web.Components.UI.Admin

@inject IJSRuntime JSRuntime
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IToastService toastService
@inject ILogger<UserManagement> _logger
@inject AuditService AuditService
@inject Payroll.Web.Services.AttendanceRefreshService AttendanceRefresh
@inject FirebaseRealtimeService FirebaseRealtime
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject Payroll.Web.Services.FirebaseUserManagementService FirebaseUsers
@inject ITenantContextService TenantContext
@inject TenantManagementService TenantManager

@attribute [Authorize(Roles = "SuperAdmin, Admin")]

<PageTitle>👥 User & Role Management</PageTitle>

<div class="page-header-container mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="emoji-icon-badge emoji-icon-badge-primary">
            👥
        </div>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="page-header-title">
                    User &amp; Role Management
                </h2>
                @if (isSuperAdmin)
                {
                    <span class="badge bg-warning text-dark fw-bold rounded-pill px-3 py-1">👑 SuperAdmin Mode</span>
                }
                @if (activeTenant != null)
                {
                    <span class="badge bg-info text-dark fw-bold rounded-pill px-3 py-1">🏢 @activeTenant.CompanyName</span>
                }
            </div>
            <p class="page-header-subtitle">
                <span>🔐 Provision user accounts, assign role permissions, and link credentials to employee profiles</span>
            </p>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold border border-primary border-opacity-25">
            <span>🛡️ Identity & Access Control</span>
        </span>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary mb-3" style="width: 2.5rem; height: 2.5rem;" role="status"></div>
        <p class="text-muted">Loading workspace users &amp; roles...</p>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-12 col-xxl-3 col-xl-4 col-lg-4 mb-4">
            <UserCreationForm NewUserForm="newUserForm"
                              UnlinkedEmployees="unlinkedEmployees"
                              IsSaving="isSaving"
                              IsSuperAdmin="isSuperAdmin"
                              ActiveCompanyName="@(activeTenant?.CompanyName ?? "")"
                              OnCreateUser="CreateNewUser" />
        </div>

        <div class="col-12 col-xxl-9 col-xl-8 col-lg-8 mb-4">

            @* ---- EVENT HANDLERS PASSED TO CHILD ---- *@
            @* ---- STATE BINDINGS PASSED TO CHILD ----- *@

            <UserListTable UserList="userList"
                           IsLoading="isLoading"
                           IsSaving="isSaving"
                           IsSuperAdmin="isSuperAdmin"
                           OnEditRoleRequested="HandleEditRoleStart"
                           OnResetPasswordRequested="HandlePasswordResetStart"
                           OnDeleteUser="ConfirmDeleteUser"
                           UpdateUserRole="UpdateUserRole"
                           ShowEditRoleModal="showEditRoleModal"
                           UserToEditRole="userToEditRole"
                           NewRoleForUser="newRoleForUser"
                           ShowEditRoleModalChanged="((bool v) => showEditRoleModal = v)"
                           UserToEditRoleChanged="((UserRoleViewModel? v) => userToEditRole = v)"
                           NewRoleForUserChanged="((string v) => newRoleForUser = v)" />
        </div>
    </div>
}

@if (showPasswordModal && userToResetPassword != null)
{
    <div class="modal fade show" style="display:block;background:rgba(0,0,0,0.65);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-warning text-dark py-2">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-key-fill me-2"></i>Change Password
                    </h6>
                    <button class="btn-close" @onclick="() => showPasswordModal = false" disabled="@isSaving"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="text-muted small mb-2 text-truncate" title="@userToResetPassword.Email">
                        Account: <strong>@userToResetPassword.Email</strong>
                    </div>
                    <label class="form-label fw-bold small">New Password</label>
                    <input type="password" class="form-control" @bind="newPasswordForUser" placeholder="Min 6 characters" />
                </div>
                <div class="modal-footer bg-light p-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showPasswordModal = false" disabled="@isSaving">Cancel</button>
                    <button class="btn btn-sm btn-warning text-dark fw-bold px-3" @onclick="ExecutePasswordReset" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save Password
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRefresh" />

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isSuperAdmin = false;
    private CompanyTenant? activeTenant;
    private List<CompanyTenant> allTenants = new();

    private List<UserRoleViewModel> userList = new();
    private List<Employee> allEmployees = new();

    private List<Employee> unlinkedEmployees =>
        allEmployees
            .Where(e => !userList.Any(u =>
                (u.EmployeeId.HasValue && u.EmployeeId.Value == e.EmployeeID) ||
                (!string.IsNullOrWhiteSpace(e.Email) && !string.IsNullOrWhiteSpace(u.Email) && string.Equals(e.Email.Trim(), u.Email.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(e.AspNetUserId) && (u.UserId == e.AspNetUserId || u.FirebaseUid == e.AspNetUserId))))
            .ToList();

    private NewUserFormModel newUserForm = new();

    private UserRoleViewModel? userToEditRole;
    private string newRoleForUser = "Employee";
    private bool showEditRoleModal = false;

    private bool showPasswordModal = false;
    private UserRoleViewModel? userToResetPassword;
    private string newPasswordForUser = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAndRoles();
    }

    private async Task LoadUsersAndRoles(AppDbContext? dbContext = null)
    {
        isLoading = true;
        try
        {
            isSuperAdmin = await TenantContext.IsSuperAdminAsync();
            activeTenant = await TenantContext.GetActiveTenantAsync();
            allTenants = await TenantManager.GetAllTenantsAsync();

            allEmployees = await FirebaseEmployees.GetEmployeesAsync();
            var rawUsers = await FirebaseUsers.GetAllUsersAsync(allEmployees);

            if (activeTenant != null)
            {
                // When inside a company workspace (either Company Admin OR SuperAdmin scoped to a company):
                // 1. SuperAdmin sees SuperAdmin account
                // 2. See active company's Admin account
                // 3. See only employees belonging to this active company
                // 4. Exclude all administrators and employees of other companies!
                var otherAdmins = allTenants
                    .Where(t => t.Id != activeTenant.Id)
                    .Select(t => t.AdminEmail.Trim().ToLowerInvariant())
                    .ToHashSet();

                var activeAdminEmail = activeTenant.AdminEmail?.Trim().ToLowerInvariant();
                var activeAdminUserId = activeTenant.AdminUserId;

                var employeeIds = allEmployees.Select(e => e.EmployeeID).ToHashSet();
                var employeeEmails = allEmployees.Where(e => !string.IsNullOrWhiteSpace(e.Email)).Select(e => e.Email!.Trim().ToLowerInvariant()).ToHashSet();
                var employeeUserIds = allEmployees.Where(e => !string.IsNullOrWhiteSpace(e.AspNetUserId)).Select(e => e.AspNetUserId!.Trim()).ToHashSet();

                userList = rawUsers.Where(u =>
                {
                    var isSuperAdminAccount = string.Equals(u.CurrentRole, "SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
                                              string.Equals(u.Email, FirebaseAuthSecurityConstants.CanonicalSuperAdminEmail, StringComparison.OrdinalIgnoreCase);

                    if (isSuperAdminAccount)
                    {
                        // Show SuperAdmin account only if current logged-in user is SuperAdmin
                        return isSuperAdmin;
                    }

                    if (!string.IsNullOrWhiteSpace(u.Email) && otherAdmins.Contains(u.Email.Trim().ToLowerInvariant()))
                        return false;

                    // Current company admin
                    var isCurrentCompanyAdmin = (!string.IsNullOrWhiteSpace(activeAdminEmail) && string.Equals(u.Email?.Trim(), activeAdminEmail, StringComparison.OrdinalIgnoreCase)) ||
                                                (!string.IsNullOrWhiteSpace(activeAdminUserId) && u.UserId == activeAdminUserId);
                    if (isCurrentCompanyAdmin)
                        return true;

                    // Linked to this company's employees
                    if (u.EmployeeId.HasValue && employeeIds.Contains(u.EmployeeId.Value))
                        return true;
                    if (!string.IsNullOrWhiteSpace(u.Email) && employeeEmails.Contains(u.Email.Trim().ToLowerInvariant()))
                        return true;
                    if (!string.IsNullOrWhiteSpace(u.UserId) && employeeUserIds.Contains(u.UserId.Trim()))
                        return true;
                    if (!string.IsNullOrWhiteSpace(u.FirebaseUid) && employeeUserIds.Contains(u.FirebaseUid.Trim()))
                        return true;

                    return false;
                }).ToList();
            }
            else
            {
                userList = rawUsers.Where(u => !string.IsNullOrWhiteSpace(u.Email) && u.Email.Contains('@')).ToList();
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading user data.");
            toastService.ShowError("Error loading user data.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateNewUser()
    {
        isSaving = true;
        try
        {
            if (!isSuperAdmin)
            {
                newUserForm.InitialRole = "Employee";
            }

            if (newUserForm.InitialRole.Equals("Employee", StringComparison.OrdinalIgnoreCase) &&
                !newUserForm.EmployeeId.HasValue)
            {
                toastService.ShowError("Select a saved Employee before creating an Employee account.");
                return;
            }

            var result = await FirebaseUsers.CreateAsync(
                newUserForm.Email,
                newUserForm.Password,
                newUserForm.InitialRole,
                newUserForm.EmployeeId ?? 0,
                newUserForm.Email,
                CancellationToken.None);

            if (!result.Success)
            {
                toastService.ShowError(result.Message);
                return;
            }

            await AttendanceRefresh.NotifyGlobalRefreshAsync("USER_CREATED");
            toastService.ShowSuccess("User created and synchronized.");
            newUserForm = new();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error creating synchronized user.");
            toastService.ShowError(ex.Message);
        }
        finally
        {
            await LoadUsersAndRoles();
            isSaving = false;
        }
    }

    private void HandleEditRoleStart(UserRoleViewModel user)
    {
        userToEditRole = user;
        newRoleForUser = user.CurrentRole;
        showEditRoleModal = true;
    }

    private void HandlePasswordResetStart(UserRoleViewModel user)
    {
        userToResetPassword = user;
        newPasswordForUser = string.Empty;
        showPasswordModal = true;
    }

    private async Task ExecutePasswordReset()
    {
        if (userToResetPassword == null) return;
        if (string.IsNullOrWhiteSpace(newPasswordForUser) || newPasswordForUser.Length < 6)
        {
            toastService.ShowWarning("Password must be at least 6 characters.");
            return;
        }

        isSaving = true;
        try
        {
            var targetId = userToResetPassword.Email ?? userToResetPassword.UserId;
            var result = await FirebaseUsers.ResetPasswordAsync(targetId, newPasswordForUser, CancellationToken.None);
            if (result.Success)
            {
                toastService.ShowSuccess($"Password successfully changed for {userToResetPassword.Email}.");
                showPasswordModal = false;
            }
            else
            {
                toastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error resetting password");
            toastService.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateUserRole()
    {
        if (userToEditRole == null) return;

        if (string.Equals(newRoleForUser, "SuperAdmin", StringComparison.OrdinalIgnoreCase))
        {
            toastService.ShowWarning("Only prakashshiva368@gmail.com can be SuperAdmin. No other account can be assigned SuperAdmin.");
            return;
        }

        if (string.Equals(userToEditRole.Email, TenantManagementService.AuthorizedSuperAdminDeleteEmail, StringComparison.OrdinalIgnoreCase))
        {
            toastService.ShowWarning("The root SuperAdmin role cannot be changed.");
            return;
        }

        if (!isSuperAdmin && !string.Equals(newRoleForUser, "Employee", StringComparison.OrdinalIgnoreCase))
        {
            toastService.ShowWarning("Only SuperAdmin can assign Admin roles.");
            return;
        }

        isSaving = true;

        try
        {
            var targetUid = userToEditRole.FirebaseUid ?? userToEditRole.UserId;
            var result = await FirebaseUsers.ChangeRoleAsync(targetUid, newRoleForUser, CancellationToken.None);
            if (!result.Success)
            {
                toastService.ShowError(result.Message);
                return;
            }

            await AttendanceRefresh.NotifyGlobalRefreshAsync("USER_ROLE_UPDATED");
            toastService.ShowSuccess($"Role updated to {newRoleForUser}.");
            showEditRoleModal = false; // Close modal on success
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error updating role");
            toastService.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
            await LoadUsersAndRoles();
        }
    }

    private async Task HandleRefresh()
    {
        await LoadUsersAndRoles();
    }

    private async Task ConfirmDeleteUser(UserRoleViewModel user)
    {
        if (user.CurrentRole == "SuperAdmin")
        {
            toastService.ShowWarning("Cannot delete SuperAdmin.");
            return;
        }

        if (!isSuperAdmin && user.CurrentRole != "Employee")
        {
            toastService.ShowWarning("Company administrators can only manage employee accounts.");
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Delete account for {user.Email}?")) return;

        await DeleteUser(user);
    }

    private async Task DeleteUser(UserRoleViewModel user)
    {
        isSaving = true;
        try
        {
            var targetUid = user.FirebaseUid ?? user.UserId;
            var result = await FirebaseUsers.DeleteAsync(targetUid, CancellationToken.None);
            if (!result.Success)
            {
                toastService.ShowError(result.Message);
                return;
            }

            await AttendanceRefresh.NotifyGlobalRefreshAsync("USER_DELETED");
            toastService.ShowSuccess("User deleted.");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error deleting user");
            toastService.ShowError(ex.Message);
        }
        finally
        {
            await LoadUsersAndRoles();
            isSaving = false;
        }
    }
}
