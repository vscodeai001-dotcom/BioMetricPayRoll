@page "/admin/attendance-event-monitoring"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@attribute [Authorize(Roles = "Admin,SuperAdmin")]

<PageTitle>Attendance Event Monitoring</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1"><i class="bi bi-activity me-2"></i>Attendance Event Monitoring</h3>
        <div class="text-muted small">Login, logout and single-device session lifecycle. Attendance priority/fallback rules are not changed here.</div>
    </div>
    <button class="btn btn-outline-primary" @onclick="LoadEvents"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
</div>

<div class="row g-2 p-3 mb-3 bg-light border rounded">
    <div class="col-md-3"><label class="form-label small fw-bold">Start</label><input type="date" class="form-control" @bind="startDate" /></div>
    <div class="col-md-3"><label class="form-label small fw-bold">End</label><input type="date" class="form-control" @bind="endDate" /></div>
    <div class="col-md-3"><label class="form-label small fw-bold">Event</label>
        <select class="form-select" @bind="eventFilter">
            <option value="">All events</option>
            <option>LOGIN_ATTEMPT</option><option>LOGIN_SUCCESS</option><option>LOGIN_FAILED</option>
            <option>SECOND_DEVICE_ATTEMPT</option><option>FORCE_LOGOUT_REQUESTED</option><option>FORCED_SESSION_LOGOUT</option>
            <option>LOGOUT_REQUESTED</option><option>DEVICE_LOCK_RELEASED</option><option>LOGOUT_COMPLETED</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100" @onclick="LoadEvents">Search</button></div>
</div>

@if (loading)
{
    <div class="alert alert-secondary">Loading monitored events...</div>
}
else if (!events.Any())
{
    <div class="alert alert-info">No monitored events found for the selected period.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover border align-middle">
            <thead class="table-dark"><tr><th>Time</th><th>User</th><th>Event</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var item in events)
            {
                <tr>
                    <td style="white-space:nowrap">@ToIndiaTime(item.Timestamp).ToString("dd-MMM-yyyy HH:mm:ss")</td>
                    <td><div class="fw-semibold">@item.UserEmail</div><div class="small text-muted">@item.EntityID</div></td>
                    <td><span class="badge @Badge(item.EventType)">@item.EventType</span></td>
                    <td><pre class="small mb-0" style="white-space:pre-wrap;max-width:900px">@item.Details</pre></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Row> events = new();
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string eventFilter = string.Empty;
    private bool loading;

    protected override async Task OnInitializedAsync() => await LoadEvents();

    private async Task LoadEvents()
    {
        loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var from = IndiaToUtc(startDate.Date);
            var to = IndiaToUtc(endDate.Date.AddDays(1));
            var raw = await db.AuditLogs.AsNoTracking()
                .Where(x => x.ActionType == "AUTH_SESSION" && x.EntityType == "EmployeeAttendanceSession" && x.Timestamp >= from && x.Timestamp < to)
                .OrderByDescending(x => x.Timestamp).Take(1000).ToListAsync();
            events = raw.Select(x => new Row(x.Timestamp, x.UserEmail, x.EntityID, ExtractEvent(x.Details), x.Details ?? string.Empty))
                .Where(x => string.IsNullOrWhiteSpace(eventFilter) || x.EventType.Equals(eventFilter, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        finally { loading = false; }
    }

    private static readonly TimeZoneInfo IndiaTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");

    private static DateTime ToIndiaTime(DateTime value) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(value, DateTimeKind.Utc),
            IndiaTimeZone);

    private static DateTime IndiaToUtc(DateTime indiaTime) =>
        TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(indiaTime, DateTimeKind.Unspecified),
            IndiaTimeZone);

    private static string ExtractEvent(string? details)
    {
        if (string.IsNullOrWhiteSpace(details)) return "UNKNOWN";
        try { using var doc = System.Text.Json.JsonDocument.Parse(details); return doc.RootElement.TryGetProperty("EventType", out var p) ? p.GetString() ?? "UNKNOWN" : "UNKNOWN"; }
        catch { return "UNKNOWN"; }
    }

    private static string Badge(string e) => e switch
    {
        "LOGIN_SUCCESS" or "LOGOUT_COMPLETED" => "bg-success",
        "SECOND_DEVICE_ATTEMPT" or "FORCE_LOGOUT_REQUESTED" => "bg-warning text-dark",
        "FORCED_SESSION_LOGOUT" or "LOGIN_FAILED" => "bg-danger",
        _ => "bg-secondary"
    };

    private sealed record Row(DateTime Timestamp, string UserEmail, string? EntityID, string EventType, string Details);
}
