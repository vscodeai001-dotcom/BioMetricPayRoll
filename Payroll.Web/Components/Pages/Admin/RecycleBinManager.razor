@page "/admin/recycle-bin"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Services
@inject ILogger<EmployeeList> _logger
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IToastService toastService
@inject IJSRuntime JSRuntime
@inject Payroll.Web.Services.AuditService AuditService
@inject FirebaseEmployeeManagementService FirebaseEmployeeManagementService
@inject Payroll.Web.Services.AttendanceRefreshService AttendanceRefresh
@attribute [Authorize(Roles = "SuperAdmin")]

<PageTitle>Recycle Bin</PageTitle>

<div class="page-header-container mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="emoji-icon-badge emoji-icon-badge-danger">
            🗑️
        </div>
        <div>
            <h2 class="page-header-title">
                Employee Recycle Bin & Archival
            </h2>
            <p class="page-header-subtitle">
                <span>⚠️ SuperAdmin Restricted: Restore soft-deleted employees or permanently purge historical records</span>
            </p>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2 fw-semibold border border-danger border-opacity-25">
            <span>👑 SuperAdmin Vault</span>
        </span>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">Loading recycle bin... 🗑️</p>
    </div>
}
else if (!deletedEmployees.Any())
{
    <div class="text-center p-5 bg-light rounded-4 border">
        <span class="fs-1 d-block mb-2">🎉</span>
        <p class="mb-0 text-muted fw-semibold">No employees currently in the Recycle Bin. All records are active!</p>
    </div>
}
else
{
    <div class="table-responsive-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>🆔 ID</th>
                        <th>👤 Employee Name</th>
                        <th>📅 Termination Date</th>
                        <th>📌 Status</th>
                        <th class="text-center">⚡ Action</th>
                    </tr>
                </thead>
            <tbody>
                @foreach (var emp in deletedEmployees.OrderByDescending(e => e.TerminationDate))
                {
                    <tr>
                        <td>@emp.EmployeeID</td>
                        <td><strong>@emp.Name</strong></td>
                        <td>@(emp.TerminationDate?.ToString("dd-MMM-yyyy") ?? "N/A")</td>
                        <td><span class="badge bg-danger">Soft Deleted</span></td>
                        <td class="text-center text-nowrap">
                            <button class="btn btn-sm btn-outline-success me-2" @onclick="() => RestoreEmployee(emp)" disabled="@isSaving" title="Restore Employee">
                                <i class="bi bi-arrow-counterclockwise"></i> Restore
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmPermanentDelete(emp)" disabled="@isSaving" title="Permanently Delete (WARNING)">
                                <i class="bi bi-x-octagon-fill"></i> Wipe
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRefresh" />

@code {
    private List<Employee> deletedEmployees = new();
    private bool isLoading = false;
    private bool isSaving = false;
    

    protected override async Task OnInitializedAsync()
    {
        await LoadDeletedEmployees();
    }

    private async Task LoadDeletedEmployees()
    {
        isLoading = true;
        try
        {
           
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            var features = await dbContext.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(f => f.Id == 1);
            if (features != null && !features.EnableRecycleBin)
            {
               
                return;
            }
            // Employee recycle-bin projection is read from Firebase SSOT.
            // Restore and permanent-wipe mutations intentionally remain on the
            // existing SQL mutation boundary below.
            deletedEmployees = (await FirebaseEmployeeManagementService
                    .GetAllEmployeesIncludingDeletedAsync())
                .Where(e => e.IsDeleted)
                .OrderBy(e => e.Name)
                .ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading recycle bin.");
            toastService.ShowError("Failed to load recycle bin.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RestoreEmployee(Employee emp)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Restore {emp.Name} to Active Status?")) return;

        isSaving = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            var entity = await dbContext.Employees.FindAsync(emp.EmployeeID);
            if (entity != null)
            {
                entity.IsDeleted = false; // <-- RESTORE ACTION
                dbContext.Update(entity);
                await dbContext.SaveChangesAsync();

                // Firebase is the shared Employee projection. Keep restore state
                // aligned with SQL and record the destructive-state transition in
                // the Firebase audit stream as well as the legacy SQL audit log.
                var firebaseEmployee = await FirebaseEmployeeManagementService.GetEmployeeAsync(entity.EmployeeID);
                if (firebaseEmployee != null)
                {
                    firebaseEmployee.IsDeleted = false;
                    var firebaseRestore = await FirebaseEmployeeManagementService.SaveEmployeeAsync(firebaseEmployee);
                    if (!firebaseRestore.Success)
                        throw new InvalidOperationException($"Firebase restore synchronization failed: {firebaseRestore.Message}");
                }
                else
                {
                    throw new InvalidOperationException("Firebase Employee record is missing; restore was not considered synchronized.");
                }

                await AuditService.LogAsync("RESTORE", "Employee", entity.EmployeeID.ToString(),
                    $"Employee restored from Recycle Bin.");
                await FirebaseEmployeeManagementService.LogAuditAsync(
                    "RESTORE", "Employee", entity.EmployeeID.ToString(),
                    "Employee restored from Recycle Bin; SQL and Firebase employee state synchronized.");

                await AttendanceRefresh.NotifyEmployeeChangedAsync(entity.EmployeeID, "RESTORED");
            }
            toastService.ShowSuccess("Employee restored successfully.");
            await LoadDeletedEmployees();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Restore failed: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmPermanentDelete(Employee emp)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"WARNING: Permanently delete {emp.Name} (ID: {emp.EmployeeID}) and ALL its history? This action CANNOT be undone.")) return;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "FINAL WARNING: Are you absolutely sure you want to WIPE all data?")) return;
        
        await PermanentDelete(emp);
    }

    private async Task PermanentDelete(Employee emp)
    {
        isSaving = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            var entity = await dbContext.Employees.FindAsync(emp.EmployeeID);

            if (entity != null)
            {
                // Verify the Firebase projection is already in the deleted state
                // before allowing the irreversible SQL wipe. This prevents an
                // orphaned active Firebase Employee from surviving the operation.
                var firebaseState = await FirebaseEmployeeManagementService.GetEmployeeDeletionStateAsync(entity.EmployeeID);
                if (!firebaseState.Exists || !firebaseState.IsDeleted)
                {
                    throw new InvalidOperationException(
                        "Permanent wipe blocked: Firebase Employee projection is not in the soft-deleted state.");
                }

                await FirebaseEmployeeManagementService.LogAuditAsync(
                    "PERMANENT WIPE REQUESTED", "Employee", entity.EmployeeID.ToString(),
                    "SuperAdmin requested permanent Employee wipe after Firebase soft-delete verification.");

                dbContext.Employees.Remove(entity); // <-- PERMANENT DELETE ACTION (CASCADE required in DB)
                await dbContext.SaveChangesAsync();

                await AuditService.LogAsync("PERMANENT WIPE", "Employee", entity.EmployeeID.ToString(),
                    $"Employee record and all linked history permanently deleted after Firebase soft-delete verification.");

                await FirebaseEmployeeManagementService.LogAuditAsync(
                    "PERMANENT WIPE", "Employee", entity.EmployeeID.ToString(),
                    "SQL Employee and linked history permanently deleted after Firebase soft-delete verification. Firebase Employee projection remains as historical tombstone.");
            }

            await AttendanceRefresh.NotifyEmployeeChangedAsync(emp.EmployeeID, "PERMANENT_DELETE");
            toastService.ShowSuccess($"Wipe complete for {emp.Name}.");
            await LoadDeletedEmployees();
        }
        catch (Exception ex)
        {
            // Note: If you get a foreign key error here, the database CASCADE rules need to be checked.
            _logger.LogError(ex, "Permanent delete failed for employee {ID}.", emp.EmployeeID);
            toastService.ShowError($"Wipe failed! Check database cascade rules. Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleRefresh()
    {
        await LoadDeletedEmployees();
    }
}