@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using global::Payroll.Shared.Data
@using global::Payroll.Shared
@using System.Globalization
@inject ILogger<Home> _logger
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject GeoFeatureAccessService GeoAccess
@inject FirebaseAdminDashboardService FirebaseDashboard
@using global::Payroll.Web.Components.UI.Attendance
@attribute [Authorize]
@implements IAsyncDisposable

<PageTitle>Admin Dashboard</PageTitle>

<style>
    .dashboard-container {
        animation: fadeIn .5s ease-in-out
    }

    .welcome-banner {
        background: linear-gradient(135deg,#1e3c72 0%,#2a5298 100%);
        color: white;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 4px 20px rgba(30,60,114,.2);
        position: relative;
        overflow: hidden
    }

        .welcome-banner::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,.1);
            border-radius: 50%
        }

    .kpi-card {
        background: white;
        border: none;
        border-radius: 12px;
        padding: 1.5rem;
        height: 100%;
        transition: all .3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.05)
    }

    body.dark .kpi-card {
        background: #1b222c;
        color: #f3f6fa;
        border-top-color: #3a4654;
        border-right-color: #3a4654;
        border-bottom-color: #3a4654;
        box-shadow: 0 10px 24px rgba(0,0,0,.22);
    }

    body.dark .kpi-card h1,
    body.dark .kpi-card h2,
    body.dark .kpi-card h3,
    body.dark .kpi-card h4,
    body.dark .kpi-card h5,
    body.dark .kpi-card h6 {
        color: #f8fafc !important;
    }

    body.dark .kpi-card .text-muted {
        color: #b8c3d0 !important;
    }

        .kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,.1)
        }

        .kpi-card.primary {
            border-left: 5px solid #0d6efd
        }

        .kpi-card.success {
            border-left: 5px solid #198754
        }

        .kpi-card.warning {
            border-left: 5px solid #ffc107
        }

        .kpi-card.danger {
            border-left: 5px solid #dc3545
        }

        .kpi-card.info {
            border-left: 5px solid #0dcaf0
        }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem
    }

    .shortcut-list .list-group-item {
        border: none;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: .5rem;
        background-color: #f8f9fa;
        transition: background-color .2s
    }

        .shortcut-list .list-group-item:hover {
            background-color: #e9ecef
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }
</style>

@if (!isLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="height:60vh;">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
        <p class="ms-3 text-muted mb-0 fw-semibold">Gathering workforce insights... ⏱️</p>
    </div>
}
else
{
    <AttendanceRefreshListener OnAttendanceChanged="HandleLiveAttendanceChanged"
                               OnRegularizationChanged="HandleLiveRegularizationChanged"
                               OnLocationChanged="HandleLiveLocationChanged"
                               OnSessionStarted="HandleLiveAttendanceChanged"
                               OnGeoSettingsChanged="HandleLiveAttendanceChanged" />
    <div class="dashboard-container">
        <!-- Header Banner -->
        <div class="welcome-banner d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fs-3">👋</span>
                    <h2 class="fw-bold mb-0">Welcome Back, Admin!</h2>
                </div>
                <p class="mb-0 opacity-90 d-flex align-items-center gap-2">
                    <span>📅 @DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
                    <span>•</span>
                    <span>⚡ Real-Time Workforce Intelligence</span>
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-white bg-opacity-25 px-3 py-2 rounded-pill fw-semibold border border-white border-opacity-25">
                    <span class="pulse-indicator pulse-indicator-success me-1"></span> Live Sync Active 🛰️
                </span>
            </div>
        </div>

        <!-- 4 KPI Cards -->
        <div class="row g-3 g-md-4 mb-4">
            <div class="col-xl-3 col-sm-6" @onclick='() => Navigation.NavigateTo("employees")'>
                <div class="kpi-card primary border-accent-primary">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">👥 Total Workforce</p>
                            <h2 class="fw-bold text-dark mb-1">@totalEmployees</h2>
                            <span class="status-pill status-pill-success">
                                <i class="bi bi-person-check-fill"></i> @activeEmployees Active
                            </span>
                        </div>
                        <div class="emoji-icon-badge emoji-icon-badge-primary">
                            👥
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-sm-6" @onclick='() => Navigation.NavigateTo("attendancelogs")'>
                <div class="kpi-card success border-accent-success">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">⏱️ Present Today</p>
                            <h2 class="fw-bold text-dark mb-1">@presentToday <span class="text-muted fs-6 fw-normal">/ @activeEmployees</span></h2>
                            <span class="status-pill status-pill-danger">
                                <i class="bi bi-person-x-fill"></i> @absentTodayEst Absent
                            </span>
                        </div>
                        <div class="emoji-icon-badge emoji-icon-badge-success">
                            🟢
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-sm-6" @onclick='() => Navigation.NavigateTo("run-payroll")'>
                <div class="kpi-card warning border-accent-warning">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">💰 Payroll Cycle</p>
                            <h2 class="fw-bold text-dark mb-1">@(pendingPayrolls > 0 ? "Pending" : "Completed")</h2>
                            <span class="status-pill @(pendingPayrolls > 0 ? "status-pill-warning" : "status-pill-success")">
                                <i class="bi @(pendingPayrolls > 0 ? "bi-hourglass-split" : "bi-check2-circle")"></i> @DateTime.Now.ToString("MMM yyyy")
                            </span>
                        </div>
                        <div class="emoji-icon-badge emoji-icon-badge-warning">
                            ⚡
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-sm-6" @onclick='() => Navigation.NavigateTo("salary-advances")'>
                <div class="kpi-card danger border-accent-danger">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">💳 Salary Advances</p>
                            <h2 class="fw-bold text-dark mb-1">@totalUnpaidAdvanceAmount.ToString("C0", inrCulture)</h2>
                            <span class="status-pill status-pill-danger">
                                <i class="bi bi-exclamation-circle-fill"></i> Needs Recovery
                            </span>
                        </div>
                        <div class="emoji-icon-badge emoji-icon-badge-danger">
                            💸
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if ((userIsSuperAdmin || userIsAdmin) && geoFeatureAvailable)
        {
            <div class="mb-4">
                <Payroll.Web.Components.UI.Attendance.LiveStaffLocationPanel />
            </div>
        }
        
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h5 class="fw-bold mb-0 text-secondary d-flex align-items-center gap-2">
                            <span>📈</span>
                            <span>Daily Operations & Workflows</span>
                        </h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 border rounded-3 bg-light h-100 d-flex align-items-center clickable" @onclick='() => Navigation.NavigateTo("schedule")' style="cursor:pointer">
                                    <div class="me-3 emoji-icon-badge emoji-icon-badge-info">
                                        🌅
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-0">@shiftsScheduledToday</h3>
                                        <span class="text-muted small text-uppercase fw-bold">⏰ Shifts Scheduled Today</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 border rounded-3 bg-light h-100 d-flex align-items-center clickable" @onclick='() => Navigation.NavigateTo("company-attendance-report")' style="cursor:pointer">
                                    <div class="me-3 emoji-icon-badge emoji-icon-badge-primary">
                                        ⏳
                                    </div>
                                    <div>
                                        <h3 class="fw-bold mb-0">@FormatTimeSpan(totalMonthScheduledNet)</h3>
                                        <span class="text-muted small text-uppercase fw-bold">📅 Scheduled Hours (Month)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6 class="fw-bold text-muted small text-uppercase mb-3 d-flex align-items-center gap-2">
                                <span>🚀</span> <span>Quick Actions</span>
                            </h6>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="attendance/regularization-approval" class="btn btn-outline-primary action-pill-btn">
                                    <span>⏱️</span> <i class="bi bi-check2-square"></i> Regularizations
                                </a>
                                <a href="admin/report-center" class="btn btn-outline-success action-pill-btn">
                                    <span>📊</span> <i class="bi bi-file-earmark-bar-graph"></i> Report Center
                                </a>
                                <a href="employees" class="btn btn-outline-info action-pill-btn">
                                    <span>➕</span> <i class="bi bi-person-plus-fill"></i> Add Employee
                                </a>
                                <a href="salary-advances" class="btn btn-outline-warning action-pill-btn">
                                    <span>💳</span> <i class="bi bi-cash-coin"></i> Salary Advances
                                </a>
                                @if (userIsSuperAdmin || settings?.AdminCanManageFeatureToggles == true || settings?.AdminCanManageEmployeePermissions == true)
                                {
                                    <a href="admin/feature-toggles" class="btn btn-outline-secondary action-pill-btn">
                                        <span>⚙️</span> <i class="bi bi-sliders2"></i> System Settings
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-secondary d-flex align-items-center gap-2">
                            <span>💳</span> <span>Recent Advances</span>
                        </h5>
                        <span class="badge bg-danger rounded-pill px-3 py-1">@unpaidAdvances.Count Unpaid</span>
                    </div>
                    <div class="card-body px-4 pb-4">
                        @if (unpaidAdvances.Any())
                        {
                            <div class="list-group list-group-flush shortcut-list">
                                @foreach (var adv in unpaidAdvances.Take(4))
                                {
                                    <div class="list-group-item bg-light border-0 mb-2 rounded-3 p-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="emoji-icon-badge emoji-icon-badge-sm emoji-icon-badge-danger">
                                                    👤
                                                </div>
                                                <div>
                                                    <span class="fw-bold d-block text-dark">@GetEmployeeName(adv.EmployeeID)</span>
                                                    <small class="text-muted">📅 @adv.AdvanceDate?.ToString("dd-MMM") • 🏷️ @adv.AdvanceType</small>
                                                </div>
                                            </div>
                                            <span class="fw-bold text-danger fs-6">@adv.Amount.ToString("C0", inrCulture)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (unpaidAdvances.Count > 4)
                            {
                                <div class="text-center mt-3">
                                    <a href="salary-advances" class="action-pill-btn btn btn-sm btn-outline-primary text-decoration-none">
                                        <span>👀</span> View All Advances
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <span class="fs-1 d-block mb-2">🎉</span>
                                <p class="mb-0 fw-semibold text-success">All Clear! No unpaid advances.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter(Name = "Settings")]
    private FeatureSettings? settings { get; set; }

    private bool isLoaded = false;
    private bool geoFeatureAvailable;
    private bool userIsSuperAdmin = false;
    private bool userIsAdmin = false;
    private int presentToday;
    private int absentTodayEst;
    private int totalEmployees;
    private int activeEmployees;
    private int pendingPayrolls;
    private int shiftsScheduledToday;
    private decimal totalUnpaidAdvanceAmount;
    private TimeSpan totalMonthScheduledNet = TimeSpan.Zero;
    private List<SalaryAdvance> unpaidAdvances = new();
    private List<Employee> employeeList = new();
    private CultureInfo inrCulture = new("en-IN");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = authState.User;

            // ---------------------------------------------------------
            // ROLE CHECK
            // ---------------------------------------------------------
            userIsSuperAdmin = user.IsInRole("SuperAdmin");
            userIsAdmin = user.IsInRole("Admin");

            // Employee must never access Admin Dashboard
            if (user.IsInRole("Employee") &&
                !user.IsInRole("Admin") &&
                !userIsSuperAdmin)
            {
                Navigation.NavigateTo("/employee-home", true);
                return;
            }

            // ---------------------------------------------------------
            // GEO-FENCING
            //
            // IMPORTANT:
            // Admin/SuperAdmin may see the Live Staff Location panel when
            // Geo-Fencing is enabled. Employee is redirected above.
            // ---------------------------------------------------------
            if (user.IsInRole("Admin") || userIsSuperAdmin)
            {
                geoFeatureAvailable = await GeoAccess.IsEnabledAsync();
            }
            else
            {
                geoFeatureAvailable = false;
            }

            await LoadAdminDashboard();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Admin dashboard initialization failed.");
            geoFeatureAvailable = false;
        }
    }

    private async Task LoadAdminDashboard()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var actorUid = authState.User.FindFirst("sub")?.Value
                           ?? authState.User.FindFirst("user_id")?.Value
                           ?? authState.User.Identity?.Name
                           ?? string.Empty;

            // Firebase is the dashboard read authority. Existing Web/SQL
            // calculations are not recreated here. This is an aggregation
            // of already-published SSOT records only.
            var snapshot = await FirebaseDashboard.GetSnapshotAsync(actorUid);

            totalEmployees = snapshot.TotalEmployees;
            activeEmployees = snapshot.ActiveEmployees;
            presentToday = snapshot.PresentToday;
            absentTodayEst = snapshot.AbsentToday;
            totalUnpaidAdvanceAmount = snapshot.UnpaidAdvanceAmount;
            pendingPayrolls = snapshot.PendingPayrolls;
            shiftsScheduledToday = snapshot.ShiftsScheduledToday;
            totalMonthScheduledNet = TimeSpan.FromMilliseconds(snapshot.TotalMonthScheduledMs);
            employeeList = snapshot.EmployeeNames
                .Select(x => new Employee { EmployeeID = x.Key, Name = x.Value })
                .ToList();

            unpaidAdvances = snapshot.RecentAdvances.Select(a => new SalaryAdvance
            {
                EmployeeID = a.EmployeeId,
                Amount = a.Amount,
                AdvanceDate = a.AdvanceDate,
                AdvanceType = a.AdvanceType
            }).ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Firebase Admin dashboard loading error");
        }
        finally
        {
            isLoaded = true;
        }
    }

    private string GetEmployeeName(int id) => employeeList.FirstOrDefault(e => e.EmployeeID == id)?.Name ?? $"ID:{id}";

    private string FormatTimeSpan(TimeSpan ts)
    {
        if (ts < TimeSpan.Zero) ts = TimeSpan.Zero;
        ts = TimeSpan.FromMinutes(Math.Round(ts.TotalMinutes));
        int h = (int)Math.Floor(ts.TotalHours); 
        int m = ts.Minutes;
        return $"{h}h {m}m";
    }

    // ============================================================
    // REAL-TIME ATTENDANCE REFRESH
    // ============================================================

    private async Task HandleLiveAttendanceChanged()
    {
        try
        {
            ScheduleDashboardRefresh();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Live attendance dashboard refresh failed.");
        }
    }

    // ============================================================
    // REAL-TIME LOCATION REFRESH
    //
    // LiveStaffLocationPanel has its own live behaviour, but
    // refreshing the dashboard here keeps dashboard information
    // synchronized when a location event is received.
    // ============================================================

    private async Task HandleLiveLocationChanged()
    {
        // High-frequency GPS events belong to LiveStaffLocationPanel. Do not
        // reload the full KPI dashboard for every location point.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Live location dashboard refresh failed.");
        }
    }

    // ============================================================
    // REAL-TIME REGULARIZATION REFRESH
    // ============================================================

    private async Task HandleLiveRegularizationChanged()
    {
        try
        {
            ScheduleDashboardRefresh();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Live regularization dashboard refresh failed.");
        }
    }
    private CancellationTokenSource? _dashboardRefreshDebounceCts;
    private DateTime _lastDashboardLoadUtc = DateTime.MinValue;
    private readonly SemaphoreSlim _dashboardLoadGate = new(1, 1);

    private void ScheduleDashboardRefresh()
    {
        _dashboardRefreshDebounceCts?.Cancel();
        _dashboardRefreshDebounceCts?.Dispose();
        _dashboardRefreshDebounceCts = new CancellationTokenSource();
        var token = _dashboardRefreshDebounceCts.Token;

        _ = InvokeAsync(async () =>
        {
            try
            {
                // Fast debounce for immediate responsive real-time updates
                await Task.Delay(TimeSpan.FromMilliseconds(100), token);

                await _dashboardLoadGate.WaitAsync(token);
                try
                {
                    await LoadAdminDashboard();
                    _lastDashboardLoadUtc = DateTime.UtcNow;
                }
                finally
                {
                    _dashboardLoadGate.Release();
                }

                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Debounced Firebase dashboard refresh failed.");
            }
        });
    }

    public ValueTask DisposeAsync()
    {
        _dashboardRefreshDebounceCts?.Cancel();
        _dashboardRefreshDebounceCts?.Dispose();
        _dashboardLoadGate.Dispose();
        return ValueTask.CompletedTask;
    }
}