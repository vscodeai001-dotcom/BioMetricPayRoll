@page "/company-attendance-report"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@using global::Payroll.Shared.Models
@using global::Payroll.Web.Services
@using System.Text
@using System.IO
@inject FirebaseAttendanceService FirebaseAttendance
@inject IJSRuntime JSRuntime
@inject ILogger<CompanyAttendanceReport> _logger
@inject IToastService toastService
@inject CsvExportService CsvService
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Company Attendance Report</PageTitle>

<div class="page-header-container">
    <div class="d-flex align-items-center gap-3">
        <div class="emoji-icon-badge emoji-icon-badge-primary">
            📊
        </div>
        <div>
            <h2 class="page-header-title">
                Company Attendance Report
            </h2>
            <p class="page-header-subtitle">
                <span>🏢 Cumulative attendance & workforce metrics derived from verified daily records</span>
            </p>
        </div>
    </div>

    <div>
        <button class="btn btn-outline-success action-pill-btn" @onclick="ExportCompanyReportToCsv" disabled="@(isLoading || companySummary == null)">
            <span>📥</span> <span class="bi bi-file-earmark-spreadsheet-fill"></span> Export CSV
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">📅 Start Date</label>
                <input type="date" class="form-control rounded-3" @bind="startDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold small text-muted">📅 End Date</label>
                <input type="date" class="form-control rounded-3" @bind="endDate" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary action-pill-btn w-100 justify-content-center" @onclick="GenerateReport" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span> Calculating...</span>
                    }
                    else
                    {
                        <span>⚡</span> <span class="bi bi-calculator-fill"></span>
                        <span> Generate Report</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">Calculating company-wide totals... 📊</p>
    </div>
}
else if (companySummary != null)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
        <div class="card-header bg-success text-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold fs-6">
                <span>📈</span> Company-Wide Cumulative Summary
            </span>
            <span class="badge bg-white text-success rounded-pill px-3 py-1 fw-bold">
                📅 @startDate?.ToString("dd-MMM") — @endDate?.ToString("dd-MMM-yyyy")
            </span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3 text-center">
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small text-uppercase fw-bold d-block mb-1">👥 Processed</span>
                        <h4 class="fw-bold text-dark mb-0">@companySummary.TotalEmployeesProcessed</h4>
                        <small class="text-muted">Employees</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small text-uppercase fw-bold d-block mb-1">⏰ Scheduled</span>
                        <h4 class="fw-bold text-info mb-0">@FormatTimeSpan(companySummary.TotalScheduledHours)</h4>
                        <small class="text-muted">Planned (HH:MM)</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small text-uppercase fw-bold d-block mb-1">✅ Worked</span>
                        <h4 class="fw-bold text-success mb-0">@FormatTimeSpan(TimeSpan.FromHours((double)companySummary.TotalWorkedHours))</h4>
                        <small class="text-muted">Total (HH:MM)</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small text-uppercase fw-bold d-block mb-1">⚡ Overtime</span>
                        <h4 class="fw-bold text-primary mb-0">@FormatTimeSpan(companySummary.TotalOvertime)</h4>
                        <small class="text-muted">Extra Hours</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small text-uppercase fw-bold d-block mb-1">📉 Penalty</span>
                        <h4 class="fw-bold text-danger mb-0">@FormatTimeSpan(companySummary.TotalOverallPenalty)</h4>
                        <small class="text-muted">Loss Hours</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small text-uppercase fw-bold d-block mb-1">⏳ Lateness</span>
                        <h4 class="fw-bold text-warning mb-0">@FormatTimeSpan(companySummary.TotalLateness)</h4>
                        <small class="text-muted">Late Arrivals</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (searchPerformed)
{
    <p><em>No summarized attendance data found for the selected period.</em></p>
}
else
{
    <p><em>Select a date range and click "Generate Report".</em></p>
}

<AttendanceRefreshListener
    OnAttendanceChanged="GenerateReport" />

@code {
    private DateTime? startDate;
    private DateTime? endDate;
    private bool isLoading = false;
    private bool searchPerformed = false;
    private CompanyCumulativeSummary? companySummary;

    protected override void OnInitialized()
    {
        var today = DateTime.Now.Date;
        startDate = new DateTime(today.Year, today.Month, 1);
        endDate = startDate.Value.AddMonths(1).AddDays(-1);
        if (endDate > today) endDate = today;
    }

    // ---
    // --- THIS IS THE REWRITTEN METHOD ---
    // ---
    private async Task GenerateReport()
    {
        if (!startDate.HasValue || !endDate.HasValue || startDate.Value > endDate.Value)
        {
            toastService.ShowWarning("Please select a valid date range.");
            return;
        }

        isLoading = true;
        searchPerformed = true;
        companySummary = null;
        StateHasChanged();

        try
        {
            var filterStartDate = DateOnly.FromDateTime(startDate.Value);
            var filterEndDate = DateOnly.FromDateTime(endDate.Value);

            // Read the final calculated DailySummary projection from Firebase.
            // SQL remains the authoritative attendance calculation/mutation boundary.
            var summaries = await FirebaseAttendance.GetDailySummariesAsync(
                filterStartDate, filterEndDate);

            if (!summaries.Any())
            {
                isLoading = false;
                StateHasChanged();
                return;
            }

            // 2. Group and sum the results in memory
            var summary = new CompanyCumulativeSummary
            {
                TotalEmployeesProcessed = summaries.Select(s => s.EmployeeID).Distinct().Count(),
                // FIX 1: Calculate Ticks and convert to TimeSpan *AFTER* fetching data (in C# memory)
                TotalScheduledHours = TimeSpan.FromTicks(summaries.Sum(s => s.ScheduledShiftDuration.Ticks)), // This part is fine because Ticks is long
                TotalWorkedHours = summaries.Sum(s => s.EarnedStandardHours + (decimal)s.TotalOvertimeDuration.TotalHours),
                TotalOverallPenalty = TimeSpan.FromTicks(summaries.Sum(s => s.TotalPenaltyDuration.Ticks)),
                TotalOvertime = TimeSpan.FromTicks(summaries.Sum(s => s.TotalOvertimeDuration.Ticks)),
                TotalLateness = TimeSpan.FromTicks(summaries.Sum(s => s.TotalLateness.Ticks)),
                TotalBreakPenalty = TimeSpan.FromTicks(summaries.Sum(s => s.TotalBreakPenalty.Ticks)),

                TotalEarlyLeave = TimeSpan.Zero // This field is not in DailySummary, so we omit it
            };

            companySummary = summary;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error generating company attendance report from summaries");
            toastService.ShowError($"An error occurred: {ex.Message}");
            companySummary = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    // This method now works perfectly with the new summary object
    private async Task ExportCompanyReportToCsv()
    {
        if (companySummary == null || !startDate.HasValue || !endDate.HasValue)
        {
            toastService.ShowWarning("No summary data to export. Please generate a report first.");
            return;
        }

        try
        {
            // Pass the summary object and date range
            var csvData = CsvService.GenerateCompanyReportCsv(companySummary, startDate.Value, endDate.Value);
            var fileName = $"CompanyReport_{startDate:yyyy-MM-dd}_to_{endDate:yyyy-MM-dd}.csv";

            var memoryStream = new MemoryStream(Encoding.UTF8.GetBytes(csvData));
            using var streamRef = new DotNetStreamReference(stream: memoryStream);

            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
            toastService.ShowSuccess("Export successful!");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error exporting company report to CSV");
            toastService.ShowError("An error occurred while exporting the file.");
        }
    }

    private string FormatTimeSpan(TimeSpan ts)
    {
        if (ts < TimeSpan.Zero) ts = TimeSpan.Zero;
        ts = TimeSpan.FromMinutes(Math.Round(ts.TotalMinutes));
        int h = (int)Math.Floor(ts.TotalHours);
        int m = ts.Minutes;
        return $"{h:D2}:{m:D2}";
    }
}