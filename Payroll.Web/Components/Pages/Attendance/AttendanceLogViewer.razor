    // ============================================================

    private async Task ExportCsv()
    {
        if (logs == null ||
            !logs.Any())
        {
            toastService.ShowWarning(
                "No data to export.");

            return;
        }

        try
        {
            var recordsForExport =
                logs.Select(
                    l =>
                        new Payroll.Shared.Services
                            .DailyAttendanceRecord
                        {
                            EmployeeID =
                                l.EmployeeID,

                            EmployeeName =
                                l.EmployeeName,

                            BiometricID =
                                employees?
                                    .FirstOrDefault(
                                        e =>
                                            e.EmployeeID ==
                                            l.EmployeeID)
                                    ?.BiometricID ??
                                "N/A",

                            Date =
                                l.Date,

                            Status =
                                l.Status,

                            ShiftStartTime =
                                l.ShiftStart,

                            ShiftEndTime =
                                l.ShiftEnd,

                            ScheduledShiftDuration =
                                l.ScheduledShiftDuration,

                            TotalOvertimeDuration =
                                l.OvertimeDuration,

                            TotalPenalty =
                                l.TotalPenalty,

                            TotalLateness =
                                l.LatenessDuration,

                            TotalBreakPenalty =
                                l.BreakPenalty,

                            TotalEarlyLeave =
                                l.EarlyLeavePenalty,

                            WorkedHours =
                                TimeSpan.FromHours(
                                    (double)
                                    l.FinalWorkedHours),

                            FinalWorkedHours =
                                l.FinalWorkedHours,

                            PunchTimes =
                                l.Punches
                                    .Split(
                                        " / ",
                                        StringSplitOptions
                                            .RemoveEmptyEntries)
                                    .Select(
                                        s =>
                                            TimeOnly.Parse(s))
                                    .ToList()
                        })
                    .ToList();

            var csvData =
                CsvService.GenerateAttendanceLogCsv(
                    recordsForExport);

            var fileName =
                $"AttendanceLog_{startDate:yyyy-MM-dd}_to_{endDate:yyyy-MM-dd}.csv";

            var memoryStream =
                new MemoryStream(
                    Encoding.UTF8.GetBytes(
                        csvData));

            using var streamRef =
                new DotNetStreamReference(
                    stream: memoryStream);

            await JSRuntime.InvokeVoidAsync(
                "downloadFileFromStream",
                fileName,
                streamRef);

            toastService.ShowSuccess(
                "Export successful!");
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Error exporting attendance logs.");

            toastService.ShowError(
                "An error occurred during export.");
        }
    }

    // ============================================================
    // FORMAT
    // ============================================================

    private string FormatTime(
        TimeSpan ts)
    {
        if (ts < TimeSpan.Zero)
        {
            ts = TimeSpan.Zero;
        }

        int totalMinutes =
            (int)Math.Round(
                ts.TotalMinutes);

        int hours =
            totalMinutes / 60;

        int minutes =
            totalMinutes % 60;

        return
            $"{hours:D2}:{minutes:D2}";
    }

    private string FormatDecimalHoursToTime(
        decimal hours)
    {
        if (hours < 0)
        {
            hours = 0;
        }

        return FormatTime(
            TimeSpan.FromHours(
                (double)hours));
    }

    // ============================================================
    // REPROCESS
    // ============================================================

    private async Task ReprocessAttendance()
    {
        if (!startDate.HasValue ||
            !endDate.HasValue)
        {
            return;
        }

        var confirm =
            await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"This will re-calculate attendance for ALL employees from {startDate:dd-MMM} to {endDate:dd-MMM}. Continue?");

        if (!confirm)
        {
            return;
        }

        isLoading =
            true;

        await InvokeAsync(
            StateHasChanged);

        try
        {
            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            var allEmployees =
                await dbContext.Employees
                    .ToListAsync();

            var settings =
                await dbContext.CompanySettings
                    .FirstOrDefaultAsync(
                        s =>
                            s.SettingID == 1)
                ?? new CompanySetting();

            var featureSettings =
                await dbContext.FeatureSettings
                    .FirstOrDefaultAsync(
                        f => f.Id == 1)
                ?? new FeatureSettings();

            var holidays =
                await dbContext.CompanyHolidays
                    .ToListAsync();

            var dStart =
                DateOnly.FromDateTime(
                    startDate.Value.Date);

            var dEnd =
                DateOnly.FromDateTime(
                    endDate.Value.Date);

            int count = 0;

            for (
                var day = dStart;
                day <= dEnd;
                day = day.AddDays(1))
            {
                var dayDateTime =
                    day.ToDateTime(
                        TimeOnly.MinValue);

                var nextDayDateTime =
                    dayDateTime.AddDays(1);

                var allPunches =
                    await dbContext.AttendanceLogs
                        .Where(
                            l =>
                                l.PunchTime >=
                                    dayDateTime &&
                                l.PunchTime <
                                    nextDayDateTime)
                        .ToListAsync();

                var allSchedules =
                    await dbContext.ShiftSchedules
                        .Where(
                            s =>
                                s.ShiftDate ==
                                day)
                        .ToListAsync();

                var allLeaves =
                    await dbContext.LeaveRequests
                        .AsNoTracking()
                        .Where(
                            l =>
                                l.LeaveDate.HasValue &&
                                l.LeaveDate.Value >=
                                    dayDateTime &&
                                l.LeaveDate.Value <
                                    nextDayDateTime &&
                                l.IsApproved)
                        .OrderBy(
                            l =>
                                l.LeaveType ==
                                "Loss of Pay (Auto)"
                                    ? 1
                                    : 0)
                        .ThenByDescending(
                            l =>
                                l.LeaveRequestID)
                        .ToListAsync();

                foreach (var emp in allEmployees)
                {
                    if (emp.HireDate > day)
                    {
                        continue;
                    }

                    var existing =
                        await dbContext.DailySummaries
                            .FirstOrDefaultAsync(
                                s =>
                                    s.EmployeeID ==
                                        emp.EmployeeID &&
                                    s.ShiftDate ==
                                        day);

                    if (
                        existing != null &&
                        existing.IsManualOverride)
                    {
                        count++;
                        continue;
                    }

                    var empPunches =
                        allPunches
                            .Where(
                                p =>
                                    p.EmployeeID ==
                                    emp.EmployeeID)
                            .ToList();

                    var empSchedule =
                        allSchedules
                            .FirstOrDefault(
                                s =>
                                    s.EmployeeID ==
                                        emp.EmployeeID);

                    var empLeave =
                        allLeaves
                            .Where(
                                l =>
                                    l.EmployeeID ==
                                        emp.EmployeeID &&
                                    l.IsApproved)
                            .OrderBy(
                                l =>
                                    l.LeaveType ==
                                    "Loss of Pay (Auto)"
                                        ? 1
                                        : 0)
                            .ThenByDescending(
                                l =>
                                    l.LeaveRequestID)
                            .FirstOrDefault();

                    var result =
                        Calculator.CalculateDailyResult(
                            emp,
                            dayDateTime,
                            empPunches,
                            empLeave,
                            empSchedule,
                            settings,
                            holidays,
                            featureSettings);

                    if (existing == null)
                    {
                        existing =
                            new DailySummary
                            {
                                EmployeeID =
                                    emp.EmployeeID,

                                ShiftDate =
                                    day
                            };

                        dbContext.DailySummaries
                            .Add(existing);
                    }

                    existing.Status =
                        result.Status;

                    existing.EarnedStandardHours =
                        result
                            .EarnedStandardDuration
                            .TotalHours < 0
                                ? 0
                                : (decimal)
                                    result
                                        .EarnedStandardDuration
                                        .TotalHours;

                    existing.TotalOvertimeDuration =
                        result.TotalOvertimeDuration;

                    existing.TotalPenaltyDuration =
                        result.TotalPenalty;

                    existing.TotalLateness =
                        result.TotalLateness;

                    existing.TotalBreakPenalty =
                        result.TotalBreakPenalty;

                    existing.ScheduledShiftDuration =
                        result.ScheduledShiftDuration;

                    existing.ShiftAllowanceEarned =
                        result.ShiftAllowanceEarned;

                    existing.IsManualOverride =
                        false;

                    count++;
                }

                await dbContext.SaveChangesAsync();
            }

            await AuditService.LogAsync(
                "UPDATE",
                "Attendance",
                $"Range:{dStart}-{dEnd}",
                $"Mass attendance re-processed {count} daily summaries.");

            toastService.ShowSuccess(
    $"Successfully re-processed {count} records.");

            // ------------------------------------------------------------
            // Refresh the fingerprint cache after manual re-processing.
            // This prevents the next automatic page refresh from
            // unnecessarily recalculating the same punches.
            // ------------------------------------------------------------

            await SeedProcessedPunchFingerprintsAsync(
                dStart,
                dEnd);

            await LoadLogs(
                autoProcessNewPunches: false);
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Error re-processing attendance.");

            toastService.ShowError(
                $"Error: {ex.Message}");
        }
        finally
        {
            isLoading =
                false;

            await InvokeAsync(
                StateHasChanged);
        }
    }
