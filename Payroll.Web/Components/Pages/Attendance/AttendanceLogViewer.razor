    // ============================================================
    // EXPORT
    // ============================================================

    private async Task ExportCsv()
    {
        if (logs == null ||
            !logs.Any())
        {
            toastService.ShowWarning(
                "No data to export.");

            return;
        }

        try
        {
            var recordsForExport =
                logs.Select(
                    l =>
                        new Payroll.Shared.Services
                            .DailyAttendanceRecord
                        {
                            EmployeeID =
                                l.EmployeeID,

                            EmployeeName =
                                l.EmployeeName,

                            BiometricID =
                                employees?
                                    .FirstOrDefault(
                                        e =>
                                            e.EmployeeID ==
                                            l.EmployeeID)
                                    ?.BiometricID ??
                                "N/A",

                            Date =
                                l.Date,

                            Status =
                                l.Status,

                            ShiftStartTime =
                                l.ShiftStart,

                            ShiftEndTime =
                                l.ShiftEnd,

                            ScheduledShiftDuration =
                                l.ScheduledShiftDuration,

                            TotalOvertimeDuration =
                                l.OvertimeDuration,

                            TotalPenalty =
                                l.TotalPenalty,

                            TotalLateness =
                                l.LatenessDuration,

                            TotalBreakPenalty =
                                l.BreakPenalty,

                            TotalEarlyLeave =
                                l.EarlyLeavePenalty,

                            WorkedHours =
                                TimeSpan.FromHours(
                                    (double)
                                    l.FinalWorkedHours),

                            FinalWorkedHours =
                                l.FinalWorkedHours,

                            PunchTimes =
                                l.Punches
                                    .Split(
                                        " / ",
                                        StringSplitOptions
                                            .RemoveEmptyEntries)
                                    .Select(
                                        s =>
                                            TimeOnly.Parse(s))
                                    .ToList()
                        })
                    .ToList();

            var csvData =
                CsvService.GenerateAttendanceLogCsv(
                    recordsForExport);

            var fileName =
                $"AttendanceLog_{startDate:yyyy-MM-dd}_to_{endDate:yyyy-MM-dd}.csv";

            var memoryStream =
                new MemoryStream(
                    Encoding.UTF8.GetBytes(
                        csvData));

            using var streamRef =
                new DotNetStreamReference(
                    stream: memoryStream);

            await JSRuntime.InvokeVoidAsync(
                "downloadFileFromStream",
                fileName,
                streamRef);

            toastService.ShowSuccess(
                "Export successful!");
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Error exporting attendance logs.");

            toastService.ShowError(
                "An error occurred during export.");
        }
    }

    // ============================================================
    // FORMAT
    // ============================================================

    private string FormatTime(
        TimeSpan ts)
    {
        if (ts < TimeSpan.Zero)
        {
            ts = TimeSpan.Zero;
        }

        int totalMinutes =
            (int)Math.Round(
                ts.TotalMinutes);

        int hours =
            totalMinutes / 60;

        int minutes =
            totalMinutes % 60;

        return
            $"{hours:D2}:{minutes:D2}";
    }

    private string FormatDecimalHoursToTime(
        decimal hours)
    {
        if (hours < 0)
        {
            hours = 0;
        }

        return FormatTime(
            TimeSpan.FromHours(
                (double)hours));
    }

    // ============================================================
    // SEARCH & RE-PROCESS MERGED ACTION
    // ============================================================

    private async Task ExecuteSearchAndProcessAsync()
    {
        if (!startDate.HasValue || !endDate.HasValue)
        {
            return;
        }

        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Merged Search + Re-Process:
            // 1. Checks and processes any new or updated attendance punches and approved leaves.
            // 2. Immediately loads and renders the attendance log summaries from local storage.
            await LoadLogs(autoProcessNewPunches: true, forceRecalculate: true);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error executing attendance search and processing.");
            toastService.ShowError("Error loading attendance data.");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ============================================================
    // REPROCESS (Backward compatibility forwarded to merged action)
    // ============================================================

    private async Task ReprocessAttendance()
    {
        await ExecuteSearchAndProcessAsync();
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await LoadLogs(autoProcessNewPunches: true, isBackgroundRefresh: true);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Realtime refresh failed for attendance log viewer.");
        }
    }
