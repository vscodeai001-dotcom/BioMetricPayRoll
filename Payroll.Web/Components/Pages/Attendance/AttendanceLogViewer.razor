@page "/attendancelogs"
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Text
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Models
@using global::Payroll.Web.Models
@using global::Payroll.Web.Services
@using global::Payroll.Shared.Services
@using System.Security.Cryptography
@using System.Threading
@using System.Text.Json
@inject Payroll.Web.Services.AuditService AuditService
@using global::Payroll.Web.Components.Pages.Attendance

@inject Payroll.Shared.Services.AttendanceCalculatorService Calculator
@inject IJSRuntime JSRuntime
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<AttendanceLogViewer> _logger
@inject IToastService toastService
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject Payroll.Web.Services.FirebaseAttendanceService FirebaseAttendanceService
@inject Payroll.Web.Services.FirebaseAttendanceMutationService FirebaseAttendanceMutations
@inject Payroll.Web.Services.AttendanceProcessingCoordinator AttendanceProcessingCoordinator
@inject CsvExportService CsvService

@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Attendance Log Summary</PageTitle>

<div class="page-header-container">
    <div class="d-flex align-items-center gap-3">
        <div class="emoji-icon-badge emoji-icon-badge-primary">
            ⏱️
        </div>
        <div>
            <h2 class="page-header-title">
                Attendance Master Logs
            </h2>
            <p class="page-header-subtitle">
                <span>📊 Daily breakdown of biometric & mobile GPS punches, worked shifts & lateness rules</span>
            </p>
        </div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-primary action-pill-btn"
                @onclick="ExecuteSearchAndProcessAsync"
                disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Searching...</span>
            }
            else
            {
                <i class="bi bi-search me-1"></i>
                <span>Search</span>
            }
        </button>

        <button class="btn btn-outline-success action-pill-btn"
                @onclick="ExportCsv"
                disabled="@(logs == null || !logs.Any())">
            <span>📥</span> <i class="bi bi-file-earmark-spreadsheet-fill"></i>
            <span>Export CSV</span>
        </button>
    </div>
</div>

<AttendanceFilterBar
    Employees="employees"
    @bind-SelectedEmployeeId="selectedEmployeeId"
    @bind-StartDate="startDate"
    @bind-EndDate="endDate"
    IsLoading="isLoading"
    OnSearch="ExecuteSearchAndProcessAsync" />

@if (cumulative != null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-stat-card border-accent-purple text-center">
                <div class="stat-label">📅 Scheduled</div>
                <div class="stat-number text-purple" style="color: #8b5cf6;">
                    @FormatTime(cumulative.TotalScheduledHours)
                </div>
                <div class="stat-sub">Shift Plan</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-stat-card border-accent-success text-center">
                <div class="stat-label">✅ Worked</div>
                <div class="stat-number text-success">
                    @FormatDecimalHoursToTime(cumulative.TotalWorkedHours)
                </div>
                <div class="stat-sub">Actual Worked</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-stat-card border-accent-primary text-center">
                <div class="stat-label">⚡ Overtime</div>
                <div class="stat-number text-primary">
                    @FormatTime(cumulative.TotalOvertime)
                </div>
                <div class="stat-sub">Approved OT</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-stat-card border-accent-danger text-center">
                <div class="stat-label">📉 Penalty</div>
                <div class="stat-number text-danger">
                    @FormatTime(cumulative.TotalOverallPenalty)
                </div>
                <div class="stat-sub">Loss of Hours</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-stat-card border-accent-warning text-center">
                <div class="stat-label">⏳ Lateness</div>
                <div class="stat-number text-warning">
                    @FormatTime(cumulative.TotalLateness)
                </div>
                <div class="stat-sub">Late Arrival</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="premium-stat-card border-accent-info text-center">
                <div class="stat-label">☕ Break Pen.</div>
                <div class="stat-number text-info">
                    @FormatTime(cumulative.TotalBreakPenalty)
                </div>
                <div class="stat-sub">Excess Break</div>
            </div>
        </div>
    </div>
}

@if (_showingCachedAttendance)
{
    <div class="alert alert-warning py-2 mb-3" role="status">
        <i class="bi bi-cloud-slash me-1"></i>
        Firebase attendance data is temporarily unavailable. Showing the last cached attendance data.
    </div>
}

<AttendanceLogTable
    Logs="logs"
    IsLoading="isLoading"
    OnCorrect="OpenCorrectionDrawer" />

<AttendanceCorrectionDrawer
    Show="showDrawer"
    Record="selectedRecord"
    OnClose="CloseDrawer"
    OnSaved="@(() => LoadLogs(autoProcessNewPunches: true))" />

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code
{
    // ============================================================
    // INDIA BUSINESS TIMEZONE
    // ============================================================

    private static readonly TimeZoneInfo IndiaTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById(
            "Asia/Kolkata");

    // ============================================================
    // STATE
    // ============================================================

    private List<Employee>? employees;

    private List<AttendanceLogDto> logs =
        new();

    private CompanyCumulativeSummary? cumulative;

    private DotNetObjectReference<AttendanceLogViewer>?
        _dotNetRef;

    private int selectedEmployeeId = 0;

    private DateTime? startDate;

    private DateTime? endDate;

    private bool isLoading = false;

    private bool showDrawer = false;

    private AttendanceLogDto? selectedRecord;

    private int _refreshVersion = 0;

    // Prevent overlapping realtime refreshes and ignore callbacks that arrive
    // after the component has been disposed or its Blazor circuit is gone.
    private readonly SemaphoreSlim _refreshGate = new(1, 1);
    private bool _disposed = false;
    private bool _attendanceCacheReady = false;
    private bool _showingCachedAttendance = false;

    private static TimeSpan GetDisplayScheduledDuration(
        TimeOnly? start,
        TimeOnly? end,
        int breakMinutes)
    {
        if (!start.HasValue || !end.HasValue)
            return TimeSpan.Zero;

        var startDateTime = DateTime.Today.Add(start.Value.ToTimeSpan());
        var endDateTime = DateTime.Today.Add(end.Value.ToTimeSpan());

        if (endDateTime <= startDateTime)
            endDateTime = endDateTime.AddDays(1);

        var duration = endDateTime - startDateTime -
                       TimeSpan.FromMinutes(Math.Max(0, breakMinutes));

        return duration > TimeSpan.Zero
            ? duration
            : TimeSpan.Zero;
    }

    // ============================================================
    // AUTOMATIC PUNCH PROCESSING STATE
    // ============================================================
    //
    // Stores the fingerprint of punches that have already been
    // processed for each employee/date.
    //
    // IMPORTANT:
    // This does NOT change the database design.
    // The singleton coordinator prevents duplicate employee/date processing
    // across Web circuits and remembers the last processed punch fingerprint.
    // Manual-override state is included in the idempotency decision.

    // ============================================================
    // INDIA NOW
    // ============================================================

    private static DateTime IndiaNow()
    {
        return TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.UtcNow,
            IndiaTimeZone);
    }

    private static DateTime IndiaToday()
    {
        return IndiaNow().Date;
    }

    // ============================================================
    // INITIALIZATION
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        var today =
            IndiaToday();

        startDate =
            new DateTime(
                today.Year,
                today.Month,
                1);

        endDate =
            today;

        try
        {
            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            employees =
                await FirebaseEmployees.GetEmployeesAsync();

            // --------------------------------------------------------
            // Restore the idempotency state from the local compatibility
            // projection before the first automatic processing pass.
            // This prevents a page/app restart from recalculating every
            // unchanged employee/date combination.
            // --------------------------------------------------------

            await SeedProcessedPunchFingerprintsAsync(
                DateOnly.FromDateTime(startDate!.Value.Date),
                DateOnly.FromDateTime(endDate!.Value.Date));

            // --------------------------------------------------------
            // IMPORTANT
            // Automatically synchronize attendance when the page
            // opens.
            //
            // It will only recalculate employee/date combinations
            // whose punch fingerprint is new or changed.
            // --------------------------------------------------------

            await LoadLogs(
                autoProcessNewPunches: true);
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Critical error initializing AttendanceLogViewer");

            toastService.ShowError(
                "Failed to load page data.");
        }
    }

    // ============================================================
    // SIGNALR REFRESH
    // ============================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _dotNetRef =
                DotNetObjectReference.Create(this);

            await JSRuntime.InvokeVoidAsync(
                "attendanceRefresh.start");

            await JSRuntime.InvokeVoidAsync(
                "attendanceRefresh.registerViewer",
                _dotNetRef);

            await JSRuntime.InvokeVoidAsync(
                "attendanceCache.initialize");

            _attendanceCacheReady = true;
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Attendance refresh registration failed.");
        }
    }

    [JSInvokable]
    public async Task RefreshFromNotification()
    {
        if (_disposed)
            return;

        var version =
            Interlocked.Increment(
                ref _refreshVersion);

        try
        {
            await _refreshGate.WaitAsync();

            try
            {
                if (_disposed)
                    return;

                await InvokeAsync(
                    async () =>
                    {
                        if (_disposed)
                            return;

                        // ------------------------------------------------
                        // Realtime attendance notifications can arrive in
                        // bursts. Only one refresh is allowed at a time.
                        // LoadLogs still uses the existing punch fingerprint
                        // logic, so unchanged records are not recalculated.
                        // ------------------------------------------------

                        await LoadLogs(
                            autoProcessNewPunches: true,
                            isBackgroundRefresh: true);

                        if (
                            !_disposed &&
                            version ==
                            Volatile.Read(
                                ref _refreshVersion))
                        {
                            StateHasChanged();
                        }
                    });
            }
            finally
            {
                _refreshGate.Release();
            }
        }
        catch (ObjectDisposedException)
        {
            // Component/circuit was disposed while a realtime callback was
            // in flight. This is an expected lifecycle condition.
        }
        catch (InvalidOperationException ex)
        {
            // Blazor can reject an InvokeAsync when the circuit is no longer
            // usable. Do not let that failure propagate back into JavaScript.
            _logger.LogDebug(
                ex,
                "Attendance realtime refresh skipped because the component circuit is unavailable.");
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Live attendance refresh failed.");
        }
    }

    private string BuildAttendanceCacheKey(DateOnly from, DateOnly to, int employeeId) =>
        $"attendance:{from:yyyy-MM-dd}:{to:yyyy-MM-dd}:{employeeId}";

    private async Task WriteAttendanceCacheAsync(
        string key,
        List<DailySummary> summaries,
        List<AttendanceLog> punches)
    {
        try
        {
            var payload = JsonSerializer.Serialize(new AttendanceCachePayload
            {
                SavedUtc = DateTime.UtcNow,
                DailySummaries = summaries,
                AttendanceLogs = punches
            });

            await JSRuntime.InvokeVoidAsync(
                "attendanceCache.set", key, payload);
        }
        catch (Exception ex)
        {
            _logger.LogDebug(ex, "Attendance cache write skipped.");
        }
    }

    private async Task<AttendanceCachePayload?> ReadAttendanceCacheAsync(string key)
    {
        try
        {
            var payload = await JSRuntime.InvokeAsync<string?>(
                "attendanceCache.get", key);

            if (string.IsNullOrWhiteSpace(payload))
                return null;

            var cached = JsonSerializer.Deserialize<AttendanceCachePayload>(payload);
            if (cached == null)
                return null;

            // Cache is a resilience fallback, not an alternate SSOT.
            // Keep it bounded so old attendance cannot silently become current data.
            if (DateTime.UtcNow - cached.SavedUtc > TimeSpan.FromDays(7))
                return null;

            return cached;
        }
        catch (Exception ex)
        {
            _logger.LogDebug(ex, "Attendance cache read skipped.");
            return null;
        }
    }

    private sealed class AttendanceCachePayload
    {
        public DateTime SavedUtc { get; set; }
        public List<DailySummary> DailySummaries { get; set; } = new();
        public List<AttendanceLog> AttendanceLogs { get; set; } = new();
    }

    // ============================================================
    // DISPOSE
    // ============================================================

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _refreshVersion);

        if (_dotNetRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "attendanceRefresh.unregisterViewer",
                    _dotNetRef);
            }
            catch
            {
                // Circuit may already be disconnected.
            }

            _dotNetRef.Dispose();

            _dotNetRef = null;
        }

        _refreshGate.Dispose();
    }

    // ============================================================
    // LOAD LOGS
    // ============================================================

    private async Task LoadLogs(
        bool autoProcessNewPunches = false,
        bool isBackgroundRefresh = false,
        bool forceRecalculate = false)
    {
        if (!startDate.HasValue ||
            !endDate.HasValue)
        {
            return;
        }

        if (!isBackgroundRefresh)
        {
            isLoading = true;
            _showingCachedAttendance = false;

            logs.Clear();

            cumulative = null;

            await InvokeAsync(
                StateHasChanged);
        }

        try
        {
            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            // ----------------------------------------------------
            // BUSINESS DATES
            // ----------------------------------------------------

            var dStart =
                DateOnly.FromDateTime(
                    startDate.Value.Date);

            var dEnd =
                DateOnly.FromDateTime(
                    endDate.Value.Date);

            var queryEndExclusive =
                endDate.Value.Date.AddDays(1);

            // ----------------------------------------------------
            // EMPLOYEES
            // ----------------------------------------------------

            var activeEmployees = (await FirebaseEmployees.GetEmployeesAsync())
                .Where(e => !e.IsDeleted &&
                    (selectedEmployeeId <= 0 || e.EmployeeID == selectedEmployeeId))
                .OrderBy(e => e.Name)
                .ToList();

            var activeEmployeeIds =
    activeEmployees
        .Select(
            e => e.EmployeeID)
        .ToHashSet();

            // ----------------------------------------------------
            // SYNCHRONIZE APPROVED LEAVE
            // ----------------------------------------------------

            if (activeEmployeeIds.Count > 0)
            {
                await SynchronizeApprovedLeaveSummariesAsync(
                    dbContext,
                    activeEmployees,
                    activeEmployeeIds,
                    dStart,
                    dEnd,
                    queryEndExclusive);
            }

            // ----------------------------------------------------
            // AUTOMATIC NEW-PUNCH PROCESSING
            // ----------------------------------------------------
            //
            // IMPORTANT:
            //
            // This does NOT replace ReprocessAttendance().
            //
            // It only checks whether raw attendance punches have changed.
            //
            // Example:
            //
            // 11:30
            // 11:33
            // 11:34
            //
            // already processed
            //      ↓
            // NO calculation
            //
            // New punch:
            //
            // 11:30
            // 11:33
            // 11:34
            // 17:27
            //
            // fingerprint changed
            //      ↓
            // calculate ONLY that employee/date
            //
            // ----------------------------------------------------

            if (autoProcessNewPunches &&
                activeEmployeeIds.Count > 0)
            {
                await AutoProcessChangedPunchesAsync(
                    dbContext,
                    activeEmployees,
                    activeEmployeeIds,
                    dStart,
                    dEnd,
                    queryEndExclusive,
                    forceRecalculate);
            }

            // ----------------------------------------------------
            // DAILY SUMMARIES
            // ----------------------------------------------------

            List<DailySummary> data = new();
            var cacheKey = BuildAttendanceCacheKey(dStart, dEnd, selectedEmployeeId);
            try
            {
                data = selectedEmployeeId > 0
                    ? await FirebaseAttendanceService.GetDailySummariesAsync(selectedEmployeeId, dStart, dEnd)
                    : await FirebaseAttendanceService.GetDailySummariesAsync(dStart, dEnd);
            }
            catch (Exception firebaseReadEx)
            {
                _logger.LogWarning(firebaseReadEx, "Firebase attendance summary read failed. Range: {Start} to {End}", dStart, dEnd);

                if (!_attendanceCacheReady)
                    throw;

                var cached = await ReadAttendanceCacheAsync(cacheKey);
                if (cached is null)
                    throw;

                data = cached.DailySummaries;
                _showingCachedAttendance = true;
            }

            if (selectedEmployeeId > 0)
            {
                data = data.Where(ds => ds.EmployeeID == selectedEmployeeId).ToList();
            }

            // Deduplicate by (EmployeeID, ShiftDate): Firebase may return multiple entries
            // for the same employee+date. Keep the most complete record (highest EarnedStandardHours,
            // then largest SummaryID as tiebreaker). Application-level fix — no DB changes.
            data = data
                .GroupBy(ds => (ds.EmployeeID, ds.ShiftDate))
                .Select(g => g.OrderByDescending(ds => ds.EarnedStandardHours)
                              .ThenByDescending(ds => ds.SummaryID)
                              .First())
                .ToList();

            // ----------------------------------------------------
            // EMPLOYEE IDS
            // ----------------------------------------------------

            var employeeIds =
                data
                    .Select(
                        d => d.EmployeeID)
                    .Distinct()
                    .ToList();

            // Fix: If viewing a single employee, ensure they are in the list even if data is empty.
            if (selectedEmployeeId > 0 && !employeeIds.Contains(selectedEmployeeId))
            {
                employeeIds.Add(selectedEmployeeId);
            }
            else if (selectedEmployeeId <= 0)
            {
                // Fix: Ensure all active employees are considered for punch loading
                // if we are showing all employees.
                foreach (var id in activeEmployeeIds)
                {
                    if (!employeeIds.Contains(id)) employeeIds.Add(id);
                }
            }

            // ----------------------------------------------------
            // SCHEDULES
            // ----------------------------------------------------

            var schedules =
                employeeIds.Count == 0
                    ? new List<ShiftSchedule>()
                    : await dbContext.ShiftSchedules
                        .AsNoTracking()
                        .Where(
                            s =>
                                employeeIds.Contains(
                                    s.EmployeeID) &&
                                s.ShiftDate >= dStart &&
                                s.ShiftDate <= dEnd)
                        .ToListAsync();

            // ----------------------------------------------------
            // RAW PUNCHES
            //
            // IMPORTANT:
            // PunchTime is treated as existing business-local
            // attendance time.
            //
            // Do NOT add/subtract 5:30 here.
            // ----------------------------------------------------

            List<AttendanceLog> relevantLogs;
            try
            {
                relevantLogs =
                    employeeIds.Count == 0
                        ? new List<AttendanceLog>()
                        : await FirebaseAttendanceService.GetAttendancePunchesAsync(
                            dStart,
                            dEnd,
                            selectedEmployeeId > 0 ? selectedEmployeeId : null);
            }
            catch (Exception firebasePunchEx)
            {
                if (!_attendanceCacheReady)
                    throw;

                var cached = await ReadAttendanceCacheAsync(cacheKey);
                if (cached is null)
                    throw;

                relevantLogs = cached.AttendanceLogs;
                _showingCachedAttendance = true;
                _logger.LogWarning(firebasePunchEx,
                    "Firebase attendance punch read failed. Using cached attendance data for {CacheKey}.", cacheKey);
            }

            if (employeeIds.Count > 0)
            {
                relevantLogs = relevantLogs
                    .Where(l => l.EmployeeID.HasValue && employeeIds.Contains(l.EmployeeID.Value))
                    .OrderBy(l => l.PunchTime)
                    .ToList();
            }

            if (!_showingCachedAttendance && _attendanceCacheReady)
            {
                await WriteAttendanceCacheAsync(cacheKey, data, relevantLogs);
            }

            // ----------------------------------------------------
            // MAP DTO
            // ----------------------------------------------------

            var activeEmpMap = activeEmployees.ToDictionary(e => e.EmployeeID);
            var schedMap = schedules
                .GroupBy(s => (s.EmployeeID, s.ShiftDate))
                .ToDictionary(g => g.Key, g => g.First());
            var punchesByEmpDate = relevantLogs
                .Where(l => l.EmployeeID.HasValue)
                .GroupBy(l => (l.EmployeeID!.Value, DateOnly.FromDateTime(l.PunchTime.Date)))
                .ToDictionary(g => g.Key, g => DeduplicatePunchesForDisplay(g.OrderBy(l => l.PunchTime).ThenBy(l => l.LogID).ToList()));

            logs =
                data
                    .Select(
                        ds =>
                        {
                            activeEmpMap.TryGetValue(ds.EmployeeID, out var emp);
                            schedMap.TryGetValue((ds.EmployeeID, ds.ShiftDate), out var scheduleOverride);

                            TimeOnly? sStart =
                                scheduleOverride?.StartTime ??
                                emp?.ShiftStartTime;

                            TimeOnly? sEnd =
                                scheduleOverride?.EndTime ??
                                emp?.ShiftEndTime;

                            // ------------------------------------------------
                            // WORKED HOURS
                            //
                            // Standard earned hours + OT.
                            // Clamp negative values to zero.
                            // ------------------------------------------------

                            decimal standardHours =
                                ds.EarnedStandardHours;

                            if (standardHours < 0)
                            {
                                standardHours = 0;
                            }

                            TimeSpan overtime =
                                ds.TotalOvertimeDuration;

                            if (overtime <
                                TimeSpan.Zero)
                            {
                                overtime =
                                    TimeSpan.Zero;
                            }

                            decimal finalWorkedHours =
                                standardHours +
                                (decimal)
                                overtime.TotalHours;

                            var isWeeklyOffWorked =
                                ds.Status == "Weekly Off (Worked)";

                            var displayScheduledDuration =
                                isWeeklyOffWorked
                                    ? GetDisplayScheduledDuration(
                                        sStart,
                                        sEnd,
                                        emp?.StandardBreakMinutes ?? 0)
                                    : ds.ScheduledShiftDuration;

                            // ------------------------------------------------
                            // PENALTY BREAKDOWN
                            // ------------------------------------------------

                            TimeSpan earlyLeavePenalty =
                                ds.TotalPenaltyDuration -
                                ds.TotalLateness -
                                ds.TotalBreakPenalty;

                            if (
                                earlyLeavePenalty <
                                TimeSpan.Zero)
                            {
                                earlyLeavePenalty =
                                    TimeSpan.Zero;
                            }

                            var dto =
                                new AttendanceLogDto
                                {
                                    EmployeeID =
                                        ds.EmployeeID,

                                    EmployeeName =
                                        emp?.Name ??
                                        "Unknown",

                                    Date =
                                        ds.ShiftDate,

                                    Status =
                                        ds.Status,

                                    ShiftStart =
                                        sStart,

                                    ShiftEnd =
                                        sEnd,

                                    ScheduledShiftDuration =
                                        displayScheduledDuration,

                                    TotalPenalty =
                                        ds.TotalPenaltyDuration,

                                    LatenessDuration =
                                        ds.TotalLateness,

                                    BreakPenalty =
                                        ds.TotalBreakPenalty,

                                    EarlyLeavePenalty =
                                        earlyLeavePenalty,

                                    OvertimeDuration =
                                        overtime,

                                    ShiftWorkedDuration =
                                        TimeSpan.FromHours(
                                              isWeeklyOffWorked
                                                  ? 0
                                                  : (double)standardHours),

                                    FinalWorkedHours =
                                        isWeeklyOffWorked
                                            ? (decimal)overtime.TotalHours
                                            : finalWorkedHours
                                };

                            // ------------------------------------------------
                            // DAILY PUNCHES
                            // ------------------------------------------------

                            if (!punchesByEmpDate.TryGetValue((ds.EmployeeID, ds.ShiftDate), out var dayPunchLogs))
                            {
                                dayPunchLogs = new List<AttendanceLog>();
                            }
                            var dayPunches = dayPunchLogs.Select(l => l.PunchTime).ToList();

                            dto.Punches =
                                string.Join(
                                    "\n",
                                    dayPunchLogs.Select(
                                        l =>
                                            $"{l.PunchTime:HH:mm:ss}  {l.DeviceID ?? "Unknown"}  #{l.LogID}  {l.LogType}"));

                            // ------------------------------------------------
                            // BREAKS
                            // ------------------------------------------------

                            if (dayPunches.Count >= 4)
                            {
                                TimeSpan totalBreak =
                                    TimeSpan.Zero;

                                int gaps = 0;

                                TimeSpan maxGap =
                                    TimeSpan.Zero;

                                TimeOnly? lunchStart =
                                    null;

                                TimeOnly? lunchEnd =
                                    null;

                                for (
                                    int i = 1;
                                    i <
                                        dayPunches.Count - 1;
                                    i += 2)
                                {
                                    var prevIn =
                                        dayPunches[i - 1];

                                    var outTime =
                                        dayPunches[i];

                                    var inTime =
                                        dayPunches[i + 1];

                                    if (
                                        inTime >
                                        outTime)
                                    {
                                        // Exclude gap between regular shift completion and post-shift overtime
                                        if (sEnd.HasValue)
                                        {
                                            var shiftEndDt = (sStart.HasValue && sEnd.Value < sStart.Value)
                                                ? ds.ShiftDate.AddDays(1).ToDateTime(sEnd.Value)
                                                : ds.ShiftDate.ToDateTime(sEnd.Value);

                                            if (prevIn < shiftEndDt && inTime >= shiftEndDt)
                                            {
                                                continue;
                                            }
                                        }

                                        // Exclude gap between pre-shift overtime and regular shift start
                                        if (sStart.HasValue)
                                        {
                                            var shiftStartDt = ds.ShiftDate.ToDateTime(sStart.Value);
                                            if (outTime <= shiftStartDt && inTime >= shiftStartDt)
                                            {
                                                continue;
                                            }
                                        }

                                        var gap =
                                            inTime -
                                            outTime;

                                        totalBreak +=
                                            gap;

                                        gaps++;

                                        if (
                                            gap >
                                            maxGap)
                                        {
                                            maxGap =
                                                gap;

                                            lunchStart =
                                                TimeOnly
                                                    .FromDateTime(
                                                        outTime);

                                            lunchEnd =
                                                TimeOnly
                                                    .FromDateTime(
                                                        inTime);
                                        }
                                    }
                                }

                                dto.TotalBreakTime =
                                    totalBreak;

                                dto.GapsCount =
                                    gaps;

                                dto.LunchOut =
                                    lunchStart;

                                dto.LunchIn =
                                    lunchEnd;
                            }

                            return dto;
                        })
                    .DistinctBy(
                        x => (x.EmployeeID, x.Date))
                    .OrderByDescending(
                        x => x.Date)
                    .ThenBy(
                        x => x.EmployeeName)
                    .ToList();

            // ----------------------------------------------------
            // CUMULATIVE
            // ----------------------------------------------------

            decimal totalWorkedHours =
    data.Sum(
        x =>
            Math.Max(
                0m,
                x.EarnedStandardHours)
            +
            (decimal)Math.Max(
                0d,
                x.TotalOvertimeDuration.TotalHours));

            cumulative =
                new CompanyCumulativeSummary
                {
                    TotalScheduledHours =
                        TimeSpan.FromTicks(
                            data.Sum(
                                x =>
                                    x.ScheduledShiftDuration
                                        .Ticks)),

                    TotalWorkedHours =
                        totalWorkedHours,

                    TotalOvertime =
                        TimeSpan.FromTicks(
                            data.Sum(
                                x =>
                                    x.TotalOvertimeDuration
                                        .Ticks)),

                    TotalOverallPenalty =
                        TimeSpan.FromTicks(
                            data.Sum(
                                x =>
                                    x.TotalPenaltyDuration
                                        .Ticks)),

                    TotalLateness =
                        TimeSpan.FromTicks(
                            data.Sum(
                                x =>
                                    x.TotalLateness
                                        .Ticks)),

                    TotalBreakPenalty =
                        TimeSpan.FromTicks(
                            data.Sum(
                                x =>
                                    x.TotalBreakPenalty
                                        .Ticks))
                };
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Error loading attendance logs.");

            toastService.ShowError(
                "Error loading attendance data.");
        }
        finally
        {
            if (!isBackgroundRefresh)
            {
                isLoading = false;
            }

            await InvokeAsync(
                StateHasChanged);
        }
    }

    // ============================================================
    // AUTOMATIC NEW / CHANGED PUNCH PROCESSING
    // ============================================================

    private async Task AutoProcessChangedPunchesAsync(
        AppDbContext dbContext,
        List<Employee> activeEmployees,
        HashSet<int> activeEmployeeIds,
        DateOnly dStart,
        DateOnly dEnd,
        DateTime queryEndExclusive,
        bool forceRecalculate = false)
    {
        try
        {
            // --------------------------------------------------------
            // Load raw punches only.
            // PunchTime is already business-local.
            // DO NOT convert timezone here.
            // --------------------------------------------------------

            var punches =
                await dbContext.AttendanceLogs
                    .Where(
                        p =>
                            activeEmployeeIds.Contains(
                                p.EmployeeID ?? 0) &&
                            p.PunchTime >=
                                dStart.ToDateTime(
                                    TimeOnly.MinValue) &&
                            p.PunchTime <
                                queryEndExclusive)
                    .OrderBy(
                        p => p.PunchTime)
                    .ToListAsync();

            // --------------------------------------------------------
            // Load settings required by the EXISTING calculator.
            // --------------------------------------------------------

            var settings =
                await dbContext.CompanySettings
                    .FirstOrDefaultAsync(
                        s => s.SettingID == 1)
                ?? new CompanySetting();

            var featureSettings =
                await dbContext.FeatureSettings
                    .FirstOrDefaultAsync(
                        f => f.Id == 1)
                ?? new FeatureSettings();

            var holidays =
                await dbContext.CompanyHolidays
                    .ToListAsync();

            // --------------------------------------------------------
            // Load schedules.
            // --------------------------------------------------------

            var schedules =
                await dbContext.ShiftSchedules
                    .Where(
                        s =>
                            activeEmployeeIds.Contains(
                                s.EmployeeID) &&
                            s.ShiftDate >= dStart &&
                            s.ShiftDate <= dEnd)
                    .ToListAsync();

            // --------------------------------------------------------
            // Load approved leaves.
            // --------------------------------------------------------

            var allLeaves =
                await dbContext.LeaveRequests
                    .AsNoTracking()
                    .Where(
                        l =>
                            activeEmployeeIds.Contains(
                                l.EmployeeID) &&
                            l.LeaveDate.HasValue &&
                            l.LeaveDate.Value >=
                                dStart.ToDateTime(
                                    TimeOnly.MinValue) &&
                            l.LeaveDate.Value <
                                queryEndExclusive &&
                            l.IsApproved)
                    .OrderBy(
                        l =>
                            l.LeaveType ==
                            "Loss of Pay (Auto)"
                                ? 1
                                : 0)
                    .ThenByDescending(
                        l => l.LeaveRequestID)
                    .ToListAsync();

            // --------------------------------------------------------
            // Pre-index existing summaries, schedules, and leaves
            // Eliminates N+1 database round-trips for 5000+ employees
            // --------------------------------------------------------

            var existingSummaries = await dbContext.DailySummaries
                .Where(s => activeEmployeeIds.Contains(s.EmployeeID) && s.ShiftDate >= dStart && s.ShiftDate <= dEnd)
                .ToListAsync();

            var existingSummaryMap = new Dictionary<(int EmployeeId, DateOnly Date), DailySummary>(existingSummaries.Count);
            foreach (var s in existingSummaries)
            {
                existingSummaryMap[(s.EmployeeID, s.ShiftDate)] = s;
            }

            var scheduleMap = schedules
                .GroupBy(s => (s.EmployeeID, s.ShiftDate))
                .ToDictionary(g => g.Key, g => g.First());

            var leaveMap = allLeaves
                .Where(l => l.LeaveDate.HasValue)
                .GroupBy(l => (l.EmployeeID, DateOnly.FromDateTime(l.LeaveDate!.Value.Date)))
                .ToDictionary(
                    g => g.Key,
                    g => g.OrderBy(l => l.LeaveType == "Loss of Pay (Auto)" ? 1 : 0)
                          .ThenByDescending(l => l.LeaveRequestID)
                          .First());

            // --------------------------------------------------------
            // Group punches by employee + business date.
            // --------------------------------------------------------

            var groups =
                punches
                    .GroupBy(
                        p =>
                            new
                            {
                                EmployeeId =
                                    p.EmployeeID!.Value,

                                Date =
                                    DateOnly.FromDateTime(
                                        p.PunchTime.Date)
                            })
                    .OrderBy(
                        g => g.Key.Date)
                    .ThenBy(
                        g => g.Key.EmployeeId)
                    .ToList();

            bool changed = false;
            var updatedSummaries = new List<DailySummary>();
            var processedAfterSave = new List<(string Key, string Fingerprint, bool ManualOverride)>();

            foreach (var group in groups)
            {
                var employeeId =
                    group.Key.EmployeeId;

                var date =
                    group.Key.Date;

                // ----------------------------------------------------
                // Create deterministic fingerprint.
                // ----------------------------------------------------

                var fingerprint =
                    CreatePunchFingerprint(
                        group);

                var cacheKey =
                    $"{employeeId}:{date:yyyy-MM-dd}";

                // ----------------------------------------------------
                // If this exact punch set was already processed,
                // DO NOT run the calculator again.
                // ----------------------------------------------------

                // Serialize processing for this exact employee/date key.
                // Firebase/SignalR can deliver the same change to multiple
                // Web circuits, so the check is repeated after acquiring the
                // key lock.
                using var processingLease =
                    await AttendanceProcessingCoordinator.AcquireAsync(cacheKey);

                var employee =
                    activeEmployees.FirstOrDefault(
                        e =>
                            e.EmployeeID ==
                            employeeId);

                if (employee == null)
                {
                    continue;
                }

                // ----------------------------------------------------
                // Existing daily summary (O(1) memory lookup).
                // ----------------------------------------------------

                existingSummaryMap.TryGetValue((employeeId, date), out var existing);

                // ----------------------------------------------------
                // Respect manual overrides.
                //
                // We still remember the punch fingerprint so that
                // the same punch doesn't repeatedly attempt to
                // overwrite the manual record.
                // ----------------------------------------------------

                if (
                    existing != null &&
                    existing.IsManualOverride)
                {
                    AttendanceProcessingCoordinator.MarkProcessed(
                        cacheKey,
                        fingerprint,
                        manualOverride: true);

                    continue;
                }

                // Re-check after loading the current summary and after taking
                // the employee/date lock. This closes the duplicate-processing
                // window between two realtime callbacks.
                bool hasCorruptedSummary = existing != null &&
                    !existing.IsManualOverride &&
                    existing.EarnedStandardHours == 0 &&
                    existing.TotalOvertimeDuration == TimeSpan.Zero &&
                    group.Any();

                if (!forceRecalculate && !hasCorruptedSummary &&
                    AttendanceProcessingCoordinator.IsAlreadyProcessed(
                        cacheKey,
                        fingerprint,
                        existing?.IsManualOverride ?? false))
                {
                    continue;
                }

                // ----------------------------------------------------
                // Schedule (O(1) memory lookup).
                // ----------------------------------------------------

                scheduleMap.TryGetValue((employeeId, date), out var schedule);

                // ----------------------------------------------------
                // Leave (O(1) memory lookup).
                // ----------------------------------------------------

                leaveMap.TryGetValue((employeeId, date), out var leave);

                // ----------------------------------------------------
                // Use the EXISTING calculation engine.
                //
                // No calculation rules are changed here.
                //
                // Odd punch count is passed as-is.
                // The calculator decides the current worked time.
                // ----------------------------------------------------

                var result =
                    Calculator.CalculateDailyResult(
                        employee,
                        date.ToDateTime(
                            TimeOnly.MinValue),
                        group.ToList(),
                        leave,
                        schedule,
                        settings,
                        holidays,
                        featureSettings);

                // ----------------------------------------------------
                // Create summary if necessary.
                // ----------------------------------------------------

                if (existing == null)
                {
                    existing =
                        new DailySummary
                        {
                            EmployeeID =
                                employeeId,

                            ShiftDate =
                                date
                        };

                    dbContext.DailySummaries
                        .Add(existing);
                    existingSummaryMap[(employeeId, date)] = existing;
                }

                // ----------------------------------------------------
                // Apply EXACTLY the same result mapping used by the
                // existing manual ReprocessAttendance().
                // ----------------------------------------------------

                var newEarnedHours =
                    result.EarnedStandardDuration.TotalHours < 0
                        ? 0
                        : (decimal)result.EarnedStandardDuration.TotalHours;

                bool isNew = dbContext.Entry(existing).State == EntityState.Added;
                bool isDifferent = isNew ||
                    existing.Status != result.Status ||
                    existing.EarnedStandardHours != newEarnedHours ||
                    existing.TotalOvertimeDuration != result.TotalOvertimeDuration ||
                    existing.TotalPenaltyDuration != result.TotalPenalty ||
                    existing.TotalLateness != result.TotalLateness ||
                    existing.TotalBreakPenalty != result.TotalBreakPenalty ||
                    existing.ScheduledShiftDuration != result.ScheduledShiftDuration ||
                    existing.ShiftAllowanceEarned != result.ShiftAllowanceEarned ||
                    existing.IsManualOverride != false;

                if (isDifferent)
                {
                    existing.Status = result.Status;
                    existing.EarnedStandardHours = newEarnedHours;
                    existing.TotalOvertimeDuration = result.TotalOvertimeDuration;
                    existing.TotalPenaltyDuration = result.TotalPenalty;
                    existing.TotalLateness = result.TotalLateness;
                    existing.TotalBreakPenalty = result.TotalBreakPenalty;
                    existing.ScheduledShiftDuration = result.ScheduledShiftDuration;
                    existing.ShiftAllowanceEarned = result.ShiftAllowanceEarned;
                    existing.IsManualOverride = false;

                    changed = true;
                    updatedSummaries.Add(existing);
                }

                // ----------------------------------------------------
                // Mark fingerprint as processed for this exact punch set.
                // ----------------------------------------------------

                processedAfterSave.Add((
                    cacheKey,
                    fingerprint,
                    ManualOverride: false));
            }

            // ----------------------------------------------------
            // Active employees without punches for evaluated dates.
            // Guarantees all active employees appear (Absent / Off / Leave)
            // for Today and any searched date, matching AutomatedJobsService.
            // ----------------------------------------------------
            var processedPunchKeys = groups.Select(g => (g.Key.EmployeeId, g.Key.Date)).ToHashSet();
            var today = DateOnly.FromDateTime(DateTime.Today);
            var maxDateToEvaluate = dEnd < today ? dEnd : today;

            for (var curDate = dStart; curDate <= maxDateToEvaluate; curDate = curDate.AddDays(1))
            {
                foreach (var emp in activeEmployees)
                {
                    if (processedPunchKeys.Contains((emp.EmployeeID, curDate)))
                    {
                        continue;
                    }

                    // ----------------------------------------------------
                    // Guard: employee has punches in the loaded SQLite data
                    // for this date — treat them as already handled.
                    //
                    // Without this, a sync-timing race can cause the no-punch
                    // loop to run Calculator with empty punches and overwrite a
                    // correct "Present" / "Weekly Off (Worked)" summary with
                    // "Absent" before FirebaseSqliteSyncService finishes
                    // writing the GeofenceAuto punch into attendancelogs.
                    // ----------------------------------------------------
                    if (punches.Any(p =>
                            p.EmployeeID == emp.EmployeeID &&
                            DateOnly.FromDateTime(p.PunchTime.Date) == curDate))
                    {
                        continue;
                    }

                    if (emp.HireDate.HasValue && emp.HireDate.Value > curDate)
                    {
                        continue;
                    }

                    if (emp.TerminationDate.HasValue && emp.TerminationDate.Value < curDate)
                    {
                        continue;
                    }

                    existingSummaryMap.TryGetValue((emp.EmployeeID, curDate), out var existing);

                    if (existing != null && existing.IsManualOverride)
                    {
                        continue;
                    }

                    if (existing != null && !forceRecalculate)
                    {
                        // Always skip past dates.
                        // For today: skip if the existing summary already reflects
                        // a meaningful worked state — punches may not have reached
                        // local SQLite yet (Firebase sync in-flight).
                        if (curDate < today) continue;

                        var isWorkedStatus =
                            existing.Status is "Present" or "Weekly Off (Worked)" or
                            "Half Day" or "Late" or "Missing Punch" or "Early Leave";
                        if (isWorkedStatus) continue;
                    }

                    scheduleMap.TryGetValue((emp.EmployeeID, curDate), out var schedule);
                    leaveMap.TryGetValue((emp.EmployeeID, curDate), out var leave);

                    var result = Calculator.CalculateDailyResult(
                        emp,
                        curDate.ToDateTime(TimeOnly.MinValue),
                        new List<AttendanceLog>(),
                        leave,
                        schedule,
                        settings,
                        holidays,
                        featureSettings);

                    if (result.Status == "Not Employed")
                    {
                        continue;
                    }

                    if (existing == null)
                    {
                        existing = new DailySummary
                        {
                            EmployeeID = emp.EmployeeID,
                            ShiftDate = curDate
                        };
                        dbContext.DailySummaries.Add(existing);
                        existingSummaryMap[(emp.EmployeeID, curDate)] = existing;
                    }

                    var standardHours = result.EarnedStandardDuration.TotalHours < 0
                        ? 0
                        : (decimal)result.EarnedStandardDuration.TotalHours;

                    bool isNew = existing.SummaryID == 0;
                    bool hasChanged = isNew ||
                        existing.Status != result.Status ||
                        existing.EarnedStandardHours != standardHours ||
                        existing.TotalOvertimeDuration != result.TotalOvertimeDuration ||
                        existing.TotalPenaltyDuration != result.TotalPenalty ||
                        existing.TotalLateness != result.TotalLateness ||
                        existing.TotalBreakPenalty != result.TotalBreakPenalty ||
                        existing.ScheduledShiftDuration != result.ScheduledShiftDuration;

                    if (hasChanged)
                    {
                        existing.Status = result.Status;
                        existing.EarnedStandardHours = standardHours;
                        existing.TotalOvertimeDuration = result.TotalOvertimeDuration;
                        existing.TotalPenaltyDuration = result.TotalPenalty;
                        existing.TotalLateness = result.TotalLateness;
                        existing.TotalBreakPenalty = result.TotalBreakPenalty;
                        existing.ScheduledShiftDuration = result.ScheduledShiftDuration;
                        existing.ShiftAllowanceEarned = result.ShiftAllowanceEarned;
                        existing.IsManualOverride = false;

                        changed = true;
                        if (!updatedSummaries.Contains(existing))
                        {
                            updatedSummaries.Add(existing);
                        }
                    }
                }
            }

            if (changed)
            {
                await dbContext.SaveChangesAsync();

                // Non-blocking concurrent background sync to Firebase Realtime Database
                var summariesToSync = updatedSummaries.ToList();
                _ = Task.Run(async () =>
                {
                    using var semaphore = new SemaphoreSlim(6, 6);
                    var syncTasks = summariesToSync.Select(async summaryToSync =>
                    {
                        await semaphore.WaitAsync();
                        try
                        {
                            await FirebaseAttendanceMutations.UpsertDailySummaryAsync(summaryToSync, "MODIFIED");
                        }
                        catch (Exception ex)
                        {
                            _logger.LogWarning(ex, "Failed to sync daily summary to Firebase for EmpID {EmpId}, Date {Date}", summaryToSync.EmployeeID, summaryToSync.ShiftDate);
                        }
                        finally
                        {
                            semaphore.Release();
                        }
                    });
                    await Task.WhenAll(syncTasks);
                });
            }

            foreach (var processed in processedAfterSave)
            {
                AttendanceProcessingCoordinator.MarkProcessed(
                    processed.Key,
                    processed.Fingerprint,
                    processed.ManualOverride);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(
                ex,
                "Automatic attendance synchronization failed.");
        }
    }

    // ============================================================
    // SEED PROCESSED PUNCH FINGERPRINTS
    // ============================================================

    private async Task SeedProcessedPunchFingerprintsAsync(
        DateOnly dStart,
        DateOnly dEnd)
    {
        try
        {
            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            var punches =
                await dbContext.AttendanceLogs
                    .AsNoTracking()
                    .Where(
                        p =>
                            p.EmployeeID.HasValue &&
                            p.PunchTime >=
                                dStart.ToDateTime(
                                    TimeOnly.MinValue) &&
                            p.PunchTime <
                                dEnd
                                    .AddDays(1)
                                    .ToDateTime(
                                        TimeOnly.MinValue))
                    .OrderBy(
                        p => p.PunchTime)
                    .ToListAsync();

            var summaryList =
                await dbContext.DailySummaries
                    .AsNoTracking()
                    .Where(
                        s =>
                            s.ShiftDate >= dStart &&
                            s.ShiftDate <= dEnd)
                    .ToListAsync();

            var summaries =
                summaryList
                    .GroupBy(s => $"{s.EmployeeID}:{s.ShiftDate:yyyy-MM-dd}")
                    // Legacy/compatibility data can contain duplicate summaries
                    // for the same employee/day. Keep the newest SummaryID rather
                    // than failing the entire attendance synchronization pass.
                    .ToDictionary(
                        g => g.Key,
                        g => g.OrderByDescending(s => s.SummaryID).First());

            foreach (
                var group in
                punches.GroupBy(
                    p =>
                        new
                        {
                            EmployeeId = p.EmployeeID!.Value,
                            Date = DateOnly.FromDateTime(p.PunchTime.Date)
                        }))
            {
                var key =
                    $"{group.Key.EmployeeId}:{group.Key.Date:yyyy-MM-dd}";

                // Only seed an idempotency marker when a DailySummary
                // already exists. A punch set without a summary still needs
                // the normal automatic calculation on the next pass.
                if (summaries.TryGetValue(key, out var summary))
                {
                    AttendanceProcessingCoordinator.MarkProcessed(
                        key,
                        CreatePunchFingerprint(group),
                        summary.IsManualOverride);
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Unable to seed attendance punch fingerprints.");
        }
    }

    // ============================================================
    // PUNCH FINGERPRINT
    // ============================================================

    private static string CreatePunchFingerprint(
        IEnumerable<AttendanceLog> punches)
    {
        var raw =
            string.Join(
                "|",
                punches
                    .OrderBy(
                        p => p.PunchTime)
                    .ThenBy(
                        p => p.LogID)
                    .Select(
                        p =>
                            $"{p.LogID}|" +
                            $"{p.PunchTime.Ticks}|" +
                            $"{p.LogType ?? string.Empty}|" +
                            $"{p.BiometricID ?? string.Empty}|" +
                            $"{p.DeviceID ?? string.Empty}|" +
                            $"{p.IsApproved}|" +
                            $"{p.Latitude?.ToString("R", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty}|" +
                            $"{p.Longitude?.ToString("R", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty}"));

        var bytes =
            SHA256.HashData(
                Encoding.UTF8.GetBytes(raw));

        return Convert.ToHexString(
            bytes);
    }

    private static List<AttendanceLog> DeduplicatePunchesForDisplay(List<AttendanceLog> list)
    {
        if (list == null || list.Count <= 1) return list ?? new List<AttendanceLog>();
        var result = new List<AttendanceLog>();
        foreach (var p in list)
        {
            bool isDup = false;
            if (!string.IsNullOrWhiteSpace(p.BiometricID))
            {
                if (result.Any(x => x.EmployeeID == p.EmployeeID &&
                                    string.Equals(x.BiometricID, p.BiometricID, StringComparison.OrdinalIgnoreCase)))
                {
                    isDup = true;
                }
            }

            if (!isDup)
            {
                var match = result.FirstOrDefault(x => x.EmployeeID == p.EmployeeID &&
                    Math.Abs((x.PunchTime - p.PunchTime).TotalSeconds) < 60);
                if (match != null)
                {
                    var t1 = (match.LogType ?? "").ToUpperInvariant();
                    var t2 = (p.LogType ?? "").ToUpperInvariant();
                    bool isOut1 = t1.Contains("OUT");
                    bool isOut2 = t2.Contains("OUT");
                    if (isOut1 == isOut2)
                    {
                        // Same direction within 60 s — clear duplicate, drop incoming.
                        isDup = true;
                    }
                    else
                    {
                        // Opposite direction within 60 s — geofence/Android sync race.
                        // Keep the punch that matches the expected alternating position
                        // (even index = IN, odd index = OUT).
                        int matchIndex = result.IndexOf(match);
                        bool expectedOutAtMatch = (matchIndex % 2 != 0);
                        if (expectedOutAtMatch == isOut1)
                        {
                            // Already-added punch is correctly positioned — drop incoming.
                            isDup = true;
                        }
                        else
                        {
                            // Incoming punch fits better — replace the existing one.
                            result[matchIndex] = p;
                            isDup = true;
                        }
                    }
                }
            }

            if (!isDup)
                result.Add(p);
        }
        return result;
    }

    // ============================================================
    // APPROVED LEAVE SYNCHRONIZATION
    // ============================================================

    private async Task
        SynchronizeApprovedLeaveSummariesAsync(
            AppDbContext dbContext,
            List<Employee> activeEmployees,
            HashSet<int> activeEmployeeIds,
            DateOnly dStart,
            DateOnly dEnd,
            DateTime queryEndExclusive)
    {
        var approvedLeaves =
            await dbContext.LeaveRequests
                .Where(
                    l =>
                        activeEmployeeIds.Contains(
                            l.EmployeeID) &&
                        l.IsApproved &&
                        l.LeaveDate.HasValue &&
                        l.LeaveDate.Value >=
                            dStart.ToDateTime(
                                TimeOnly.MinValue) &&
                        l.LeaveDate.Value <
                            queryEndExclusive)
                .OrderBy(
                    l => l.LeaveDate)
                .ThenBy(
                    l => l.EmployeeID)
                .ThenBy(
                    l =>
                        l.LeaveType ==
                        "Loss of Pay (Auto)"
                            ? 1
                            : 0)
                .ThenByDescending(
                    l => l.LeaveRequestID)
                .ToListAsync();

        if (approvedLeaves.Count == 0)
        {
            return;
        }

        var settings =
            await dbContext.CompanySettings
                .FirstOrDefaultAsync(
                    s => s.SettingID == 1)
            ?? new CompanySetting();

        var featureSettings =
            await dbContext.FeatureSettings
                .FirstOrDefaultAsync(
                    f => f.Id == 1)
            ?? new FeatureSettings();

        var holidays =
            await dbContext.CompanyHolidays
                .AsNoTracking()
                .ToListAsync();

        var schedules =
            await dbContext.ShiftSchedules
                .Where(
                    s =>
                        activeEmployeeIds.Contains(
                            s.EmployeeID) &&
                        s.ShiftDate >= dStart &&
                        s.ShiftDate <= dEnd)
                .ToListAsync();

        var punches =
            await dbContext.AttendanceLogs
                .Where(
                    l =>
                        activeEmployeeIds.Contains(
                            l.EmployeeID ?? 0) &&
                        l.PunchTime >=
                            dStart.ToDateTime(
                                TimeOnly.MinValue) &&
                        l.PunchTime <
                            queryEndExclusive)
                .ToListAsync();

        var summaries =
            await dbContext.DailySummaries
                .Where(
                    s =>
                        activeEmployeeIds.Contains(
                            s.EmployeeID) &&
                        s.ShiftDate >= dStart &&
                        s.ShiftDate <= dEnd)
                .ToListAsync();

        bool changed = false;

        foreach (var leave in approvedLeaves)
        {
            if (!leave.LeaveDate.HasValue)
            {
                continue;
            }

            var leaveDate =
                DateOnly.FromDateTime(
                    leave.LeaveDate.Value.Date);

            var employee =
                activeEmployees.FirstOrDefault(
                    e =>
                        e.EmployeeID ==
                        leave.EmployeeID);

            if (employee == null)
            {
                continue;
            }

            var processingKey =
                $"{leave.EmployeeID}:{leaveDate:yyyy-MM-dd}";

            // Leave-driven attendance updates must serialize with automatic
            // punch processing and manual corrections for the same day.
            using var processingLease =
                await AttendanceProcessingCoordinator.AcquireAsync(processingKey);

            var existing =
                summaries.FirstOrDefault(
                    s =>
                        s.EmployeeID ==
                            leave.EmployeeID &&
                        s.ShiftDate ==
                            leaveDate);

            if (
                existing != null &&
                existing.IsManualOverride)
            {
                continue;
            }

            var empPunches =
                punches
                    .Where(
                        p =>
                            p.EmployeeID ==
                            employee.EmployeeID)
                    .Where(
                        p =>
                            p.PunchTime.Date ==
                            leaveDate
                                .ToDateTime(
                                    TimeOnly.MinValue)
                                .Date)
                    .ToList();

            var empSchedule =
                schedules.FirstOrDefault(
                    s =>
                        s.EmployeeID ==
                            employee.EmployeeID &&
                        s.ShiftDate ==
                            leaveDate);

            var empLeave =
                approvedLeaves
                    .Where(
                        l =>
                            l.EmployeeID ==
                                employee.EmployeeID &&
                            l.LeaveDate.HasValue &&
                            DateOnly.FromDateTime(
                                l.LeaveDate.Value.Date) ==
                                leaveDate)
                    .OrderBy(
                        l =>
                            l.LeaveType ==
                            "Loss of Pay (Auto)"
                                ? 1
                                : 0)
                    .ThenByDescending(
                        l =>
                            l.LeaveRequestID)
                    .FirstOrDefault();

            if (empLeave == null)
            {
                continue;
            }

            var result =
                Calculator.CalculateDailyResult(
                    employee,
                    leaveDate.ToDateTime(
                        TimeOnly.MinValue),
                    empPunches,
                    empLeave,
                    empSchedule,
                    settings,
                    holidays,
                    featureSettings);

            if (existing == null)
            {
                existing =
                    new DailySummary
                    {
                        EmployeeID =
                            employee.EmployeeID,

                        ShiftDate =
                            leaveDate
                    };

                dbContext.DailySummaries
                    .Add(existing);

                summaries.Add(existing);
            }

            existing.Status =
                result.Status;

            existing.EarnedStandardHours =
                result.EarnedStandardDuration
                    .TotalHours < 0
                        ? 0
                        : (decimal)
                            result
                                .EarnedStandardDuration
                                .TotalHours;

            existing.TotalOvertimeDuration =
                result.TotalOvertimeDuration;

            existing.TotalPenaltyDuration =
                result.TotalPenalty;

            existing.TotalLateness =
                result.TotalLateness;

            existing.TotalBreakPenalty =
                result.TotalBreakPenalty;

            existing.ScheduledShiftDuration =
                result.ScheduledShiftDuration;

            existing.IsManualOverride =
                false;

            changed = true;
        }

        if (changed)
        {
            await dbContext.SaveChangesAsync();

            // Leave changes alter the attendance state. Clear any previous
            // automatic fingerprint so a later pass can reconcile the new
            // source state, while the manual/leave override flag still
            // protects the summary from being overwritten.
            foreach (var leave in approvedLeaves)
            {
                if (!leave.LeaveDate.HasValue)
                    continue;

                var leaveDate =
                    DateOnly.FromDateTime(leave.LeaveDate.Value.Date);

                AttendanceProcessingCoordinator.Invalidate(
                    $"{leave.EmployeeID}:{leaveDate:yyyy-MM-dd}");
            }
        }
    }

