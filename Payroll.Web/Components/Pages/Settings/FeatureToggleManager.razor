@page "/admin/feature-toggles"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Services
@using global::Payroll.Shared.Data
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "SuperAdmin, Admin")]

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IToastService toastService
@inject IJSRuntime JSRuntime
@inject FeatureCleanUpService CleanerService
@inject Payroll.Web.Services.DatabaseBackupRestoreService BackupService
@inject ILogger<FeatureToggleManager> _logger
@inject AuthenticationStateProvider AuthState
@inject Payroll.Web.Services.AttendanceRefreshService AttendanceRefresh
@inject Payroll.Web.Services.ITenantContextService TenantContext
@inject Payroll.Web.Services.FirebaseRealtimeService FirebaseRealtime

<PageTitle>Feature & Permission Manager</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0 text-primary fw-bold">Feature & Permission Manager</h3>
        <p class="text-muted small mb-0">Master control panel for system modules and role capabilities.</p>
    </div>
    @* SuperAdmin or authorized Admin can save settings *@
    @if (userIsSuperAdmin || settings?.AdminCanManageFeatureToggles == true || settings?.AdminCanManageEmployeePermissions == true)
    {
        <button class="btn btn-primary shadow-sm" @onclick="SaveAllSettings" disabled="@(isSaving || isLoading)">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Saving...</span>
            }
            else
            {
                <i class="bi bi-save me-2"></i>
                <span>Save All Changes</span>
            }
        </button>
    }
</div>

@if (isLoading || !authCheckCompleted)
{
    <div class="text-center py-5 text-muted">
        <div class="spinner-border text-secondary mb-2" role="status"></div>
        <p>Loading configuration...</p>
    </div>
}
else if (settings == null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>CRITICAL:</strong> Could not initialize feature settings. Check database connection.
    </div>
}
else
{
    @* --- TABS NAVIGATION --- *@
    <ul class="nav nav-tabs nav-tabs-bordered mb-0 border-bottom-0">
        @if (userIsSuperAdmin || settings.AdminCanManageFeatureToggles)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == "modules" ? "active fw-bold" : "")" @onclick="@(() => activeTab = "modules")">
                    <i class="bi bi-grid-fill me-2"></i> Core Modules
                </button>
            </li>
        }
        @if (userIsSuperAdmin)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == "admin" ? "active fw-bold" : "")" @onclick="@(() => activeTab = "admin")">
                    <i class="bi bi-person-lock me-2"></i> Admin Permissions
                </button>
            </li>
        }
        
        @if (userIsSuperAdmin || settings.AdminCanManageEmployeePermissions || settings.AdminCanManageFeatureToggles)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == "employee" ? "active fw-bold" : "")" @onclick="@(() => activeTab = "employee")">
                    <i class="bi bi-people-fill me-2"></i> Employee Permissions
                </button>
            </li>
        }

        @if (userIsSuperAdmin)
        {
            <li class="nav-item ms-auto">
                <button class="nav-link text-danger @(activeTab == "danger" ? "active fw-bold" : "")" @onclick="@(() => activeTab = "danger")">
                    <i class="bi bi-radioactive me-2"></i> Danger Zone
                </button>
            </li>
        }
    </ul>

    @* --- MAIN CONTENT CONTAINER --- *@
    <div class="card shadow-sm border-top-0 rounded-bottom-3">
        <div class="card-body p-4 bg-light-subtle">

            @* ====================================================================================== *@
            @* TAB 1: CORE MODULES *@
            @* ====================================================================================== *@
            @if (userIsSuperAdmin || settings.AdminCanManageFeatureToggles)
            {
                <div class="@(activeTab == "modules" ? "" : "d-none")">
                    
                    @* --- ROW 1: 3 Columns --- *@
                    <div class="row g-4 mb-4">
                        
                        @* 1. PAYROLL & COMPENSATION *@
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-white fw-bold text-primary border-bottom py-3">
                                    <i class="bi bi-wallet2 me-2"></i> Payroll & Compensation
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnablePayroll" id="c_payroll" />
                                        <label class="form-check-label" for="c_payroll">Run Payroll</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableSalaryAdvance" id="c_advance" />
                                        <label class="form-check-label" for="c_advance">Salary Advance</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableBonusManagement" id="c_bonus" />
                                        <label class="form-check-label" for="c_bonus">Bonus Management</label>
                                    </div>
                                    <div class="form-check form-switch mb-2 ms-4">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EmployeeCanViewBonus" disabled="@(!settings.EnableBonusManagement)" id="c_emp_bonus" />
                                        <label class="form-check-label small text-muted" for="c_emp_bonus">↳ Employee View Bonuses</label>
                                    </div>
                                    <hr class="my-2 text-muted opacity-25">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableYearEndSummary" id="c_yearend" />
                                        <label class="form-check-label" for="c_yearend">Year-End Summary</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableFlexibleBenefits" id="c_fbp" />
                                        <label class="form-check-label fw-bold text-danger" for="c_fbp">FBP / Comp. Structuring</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* 2. STATUTORY & TAX *@
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-white fw-bold text-danger border-bottom py-3">
                                    <i class="bi bi-bank me-2"></i> Statutory & Tax
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableStatutoryCompliance" id="c_pf_esi" />
                                        <label class="form-check-label" for="c_pf_esi">PF & ESI Compliance</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableProfessionalTax" id="c_pt" />
                                        <label class="form-check-label" for="c_pt">Professional Tax</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableTdsDeduction" id="c_tds_ded" />
                                        <label class="form-check-label" for="c_tds_ded">Enable TDS Deduction</label>
                                    </div>
                                    <hr class="my-2 text-muted opacity-25">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableTaxDeclarations" id="c_tds" />
                                        <label class="form-check-label fw-bold text-primary" for="c_tds">Tax Declarations (IT Proofs)</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* 3. WORKFORCE & ATTENDANCE *@
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-white fw-bold text-info border-bottom py-3">
                                    <i class="bi bi-people-fill me-2"></i> Workforce & Attendance
                                </div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableEmployeeManagement" id="c_emp_mgmt" />
                                        <label class="form-check-label" for="c_emp_mgmt">Employee Management</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableShiftScheduling" id="c_shift" />
                                        <label class="form-check-label" for="c_shift">Shift Scheduling</label>
                                    </div>
                                    
                                    <div class="form-check form-switch mb-2 ms-4">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableAutoShiftRotation" id="c_auto_shift" disabled="@(!settings.EnableShiftScheduling)" />
                                        <label class="form-check-label fw-bold text-primary small" for="c_auto_shift">↳ Auto Shift Rotation</label>
                                    </div>

                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableShiftAllowance" id="c_shift_allow" />
                                        <label class="form-check-label" for="c_shift_allow">Night Shift Allowance</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnablePunchCorrection" id="c_punch" />
                                        <label class="form-check-label" for="c_punch">Punch Correction & Approvals</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableGeoFencing" id="c_geo" />
                                        <label class="form-check-label fw-bold text-primary" for="c_geo">Enable Geo-Fencing (Mobile)</label>
                                    </div>
                                    <div class="form-check form-switch mb-2 ms-4">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableDualAttendance" id="c_dual_attendance" disabled="@(!settings.EnableGeoFencing)" />
                                        <label class="form-check-label fw-bold text-success small" for="c_dual_attendance">↳ Dual Attendance (Biometric + Geo-Fencing)</label>
                                    </div>
                                    <div class="form-check form-switch mb-2 ms-4">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableAutomaticGeofencePunching" id="c_auto_geo_punch" disabled="@(!settings.EnableGeoFencing)" />
                                        <label class="form-check-label fw-bold text-warning small" for="c_auto_geo_punch">↳ Automatic Geofence Punching (IN / OUT)</label>
                                    </div>
                                    <div class="small text-muted ms-4 mb-2">
                                        @if (!settings.EnableGeoFencing)
                                        {
                                            <span>Geo-Fencing is OFF: all GPS, Dual Attendance and Automatic Geofence Punching are disabled. Physical biometric attendance remains active.</span>
                                        }
                                        else if (settings.EnableDualAttendance && settings.EnableAutomaticGeofencePunching)
                                        {
                                            <span>Full Dual Attendance: physical biometric is highest priority; automatic geofence IN/OUT is also recorded and reconciled.</span>
                                        }
                                        else if (settings.EnableDualAttendance)
                                        {
                                            <span>Dual Attendance: physical biometric and geofence are active; automatic geofence punching is disabled.</span>
                                        }
                                        else if (settings.EnableAutomaticGeofencePunching)
                                        {
                                            <span>Automatic Geo Attendance: geofence automatically records IN/OUT; physical biometric is disabled in single Geo mode.</span>
                                        }
                                        else
                                        {
                                            <span>Geo-Fencing is active without automatic punching. Manual employee punch is available.</span>
                                        }
                                    </div>
                                    <hr class="my-2 text-muted opacity-25">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableCompanyReports" id="c_reports" />
                                        <label class="form-check-label" for="c_reports">Company Reports & Analytics</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableCustomReporting" id="c_cust_report" />
                                        <label class="form-check-label" for="c_cust_report">Enable Custom Reporting</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableRegularizationRequest" id="c_reg_req" />
                                        <label class="form-check-label fw-bold text-success" for="c_reg_req">Regularization Requests (Emp)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* --- ROW 2: 2 Columns --- *@
                    <div class="row g-4">
                        
                        @* --- CARD 4: LEAVE MANAGEMENT & EXIT --- *@
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-white fw-bold text-success border-bottom py-3">
                                    <i class="bi bi-calendar-check me-2"></i> Leave & Exit Lifecycle
                                </div>
                                <div class="card-body pt-0">
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableLeaveManagement" id="c_leave" />
                                        <label class="form-check-label fw-bold" for="c_leave">Enable Leave Module</label>
                                    </div>

                                    @* --- GATED SUB-FEATURES (Accrual and Sandwich) --- *@
                                    @* CRITICAL FIX: The disabled attribute must check the master toggle *@
                                    <div class="row g-2 ms-2 border-start ps-3 mb-4 bg-light rounded py-2">
                                        <div class="col-md-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableLeaveAccrual"
                                                       disabled="@(!settings.EnableLeaveManagement)" id="c_accrual" />
                                                <label class="form-check-label small" for="c_accrual">Leave Accrual (Credits)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableSandwichRule"
                                                       disabled="@(!settings.EnableLeaveManagement)" id="c_sandwich" />
                                                <label class="form-check-label small" for="c_sandwich">Sandwich Rule Logic</label>
                                            </div>
                                        </div>
                                    </div>
                                    @* --- END GATED SUB-FEATURES --- *@

                                    <hr class="my-2 text-muted opacity-25">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableResignationModule" id="c_exit" />
                                        <label class="form-check-label fw-bold text-danger" for="c_exit">Exit & FnF Settlement</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* 5. SYSTEM & TOOLS *@
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-header bg-white fw-bold text-secondary border-bottom py-3">
                                    <i class="bi bi-gear-wide-connected me-2"></i> System & Tools
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableEmailNotifications" id="c_email" />
                                                <label class="form-check-label" for="c_email">Email Notifications</label>
                                            </div>
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableInAppNotifications" id="c_in_app" />
                                                <label class="form-check-label fw-bold text-primary" for="c_in_app">In-App Notification Bell</label>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" @bind="settings.ShowThemeToggle" id="c_theme" />
                                                <label class="form-check-label" for="c_theme">Dark/Light Toggle</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableAuditLog" id="c_audit" />
                                                <label class="form-check-label" for="c_audit">Enable Audit Trails</label>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EnableRecycleBin" id="c_recycle" />
                                                <label class="form-check-label" for="c_recycle">Enable Recycle Bin</label>
                                            </div>
                                        </div>
                                    </div>
                                    <hr class="my-3 text-muted opacity-25" />
                                    <div class="mb-1">
                                        <label class="form-label fw-bold text-warning small mb-2">
                                            <i class="bi bi-fire me-1"></i> Firebase Plan Mode (Data & Bandwidth Optimization)
                                        </label>
                                        <div class="d-flex gap-3 align-items-center">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="planMode" id="planSpark" value="Spark"
                                                       checked="@(settings.FirebasePlanMode != "Blaze")"
                                                       @onchange="@(() => settings.FirebasePlanMode = "Spark")" />
                                                <label class="form-check-label fw-bold text-success small" for="planSpark">
                                                    ⚡ Spark (Free Tier - 80% Bandwidth Optimized)
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="planMode" id="planBlaze" value="Blaze"
                                                       checked="@(settings.FirebasePlanMode == "Blaze")"
                                                       @onchange="@(() => settings.FirebasePlanMode = "Blaze")" />
                                                <label class="form-check-label fw-bold text-danger small" for="planBlaze">
                                                    🔥 Blaze (Pay-as-you-go - Full Unrestricted Sync)
                                                </label>
                                            </div>
                                        </div>
                                        <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">
                                            Spark mode restricts background live node caching and auto-purges tracking history older than 24h to save up to 80% bandwidth.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ====================================================================================== *@
            @* TAB 2: ADMIN PERMISSIONS *@
            @* ====================================================================================== *@
            @if (userIsSuperAdmin)
            {
                <div class="@(activeTab == "admin" ? "" : "d-none")">
                    <h5 class="text-success mb-3 border-bottom pb-2">Admin Role Permissions</h5>
                    
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card bg-light border-0 h-100 shadow-sm">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark mb-3">Core Views</h6>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanViewDashboard" id="a1" />
                                        <label class="form-check-label" for="a1">View Dashboard</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanViewAttendance" id="a2" />
                                        <label class="form-check-label" for="a2">View Attendance Logs</label>
                                    </div>
                                     <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanViewReports" id="a5" />
                                        <label class="form-check-label" for="a5">View Reports</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                             <div class="card bg-light border-0 h-100 shadow-sm">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark mb-3">Management</h6>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanManageEmployees" id="a3" />
                                        <label class="form-check-label" for="a3">Manage Employees</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanManageShifts" id="a4" />
                                        <label class="form-check-label" for="a4">Manage Shifts</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanManagePunchApprovals" id="a9" />
                                        <label class="form-check-label" for="a9">Punch Approval Requests</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                             <div class="card border-danger border-2 h-100 shadow-sm">
                                <div class="card-body">
                                    <h6 class="fw-bold text-danger mb-3">High Risk Actions</h6>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanRunPayroll" id="a6" />
                                        <label class="form-check-label" for="a6">Run Payroll Calculation</LAbel>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanEditSettings" id="a7" />
                                        <label class="form-check-label" for="a7">Edit Global Settings</LAbel>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanManageEmployeePermissions" id="a8" />
                                        <label class="form-check-label" for="a8">Manage Employee Perms</label>
                                    </div>
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.AdminCanManageFeatureToggles" id="a_ft" />
                                        <label class="form-check-label" for="a_ft">Manage Feature Toggles</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ====================================================================================== *@
            @* TAB 3: EMPLOYEE PERMISSIONS *@
            @* ====================================================================================== *@
            @if (userIsSuperAdmin || settings.AdminCanManageEmployeePermissions || settings.AdminCanManageFeatureToggles)
            {
                <div class="@(activeTab == "employee" ? "" : "d-none")">
                    <h5 class="text-info mb-3 border-bottom pb-2">Employee Portal Permissions</h5>
                    <p class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        Note: Permissions for modules disabled by SuperAdmin are automatically locked.
                    </p>

                    <div class="row g-4">
                        @* MENU VISIBILITY *@
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-light fw-bold">Menu Visibility</div>
                                <div class="card-body">
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EmployeeCanViewDashboard" id="e1" />
                                        <label class="form-check-label" for="e1">Show "Employee Home" Dashboard</label>
                                    </div>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" role="switch" @bind="settings.EmployeeToolsVisible" id="e2" />
                                        <label class="form-check-label" for="e2">Show "Employee Tools" Sidebar Menu</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* SELF SERVICE FEATURES *@
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-light fw-bold">Self-Service Features</div>
                                <div class="card-body">
                                    @* ATTENDANCE GROUP *@
                                    <div class="mb-3 border-bottom pb-2">
