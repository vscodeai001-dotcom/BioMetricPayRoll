                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Admin Full Name</label>
                                <input type="text" class="form-control" @bind="editingTenant.AdminName" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Admin Phone</label>
                                <input type="tel" class="form-control" @bind="editingTenant.AdminPhone" />
                            </div>

                            @* --- CREDENTIALS MANAGEMENT (EMAIL & RESET PASSWORD) --- *@
                            <div class="col-12">
                                <div class="card border border-primary-subtle bg-primary-subtle bg-opacity-10 p-3 rounded-3 shadow-none">
                                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold">
                                        <i class="bi bi-shield-lock-fill"></i>
                                        <span>🔑 Company Administrator Credentials (Login &amp; Password)</span>
                                    </div>
                                    <div class="text-muted small mb-3">
                                        Saved credentials immediately synchronize with ASP.NET Identity &amp; Firebase Auth so the administrator can log in directly without separate setup.
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold small">Administrator Email / Username <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-envelope-at-fill text-primary"></i></span>
                                            <input type="email" class="form-control" @bind="editAdminEmail" placeholder="admin@company.com" />
                                        </div>
                                    </div>

                                    <div>
                                        <label class="form-label fw-bold small">New / Reset Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white"><i class="bi bi-key-fill text-primary"></i></span>
                                            <input type="@(showEditPassword ? "text" : "password")"
                                                   class="form-control"
                                                   @bind="editAdminPassword"
                                                   placeholder="Leave blank to retain current password (min 6 chars)" />
                                            <button class="btn btn-outline-secondary" type="button" @onclick="() => showEditPassword = !showEditPassword" title="Toggle password visibility">
                                                <i class="bi @(showEditPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                            </button>
                                        </div>
                                        <div class="form-text small text-muted">
                                            Enter a password to update or reset this administrator's login access.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="edit_active" @bind="editingTenant.IsActive" />
                                    <label class="form-check-label fw-bold" for="edit_active">Company Is Active</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseEditTenantModal" disabled="@isSavingEdit">Cancel</button>
                        <button type="button" class="btn btn-primary fw-bold px-4" @onclick="SubmitSaveEditTenant" disabled="@isSavingEdit">
                            @if (isSavingEdit)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Updating...</span>
                            }
                            else
                            {
                                <i class="bi bi-save me-1"></i>
                                <span>Save Changes</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ========================================================================= *@
    @* MODAL 5: DELETE COMPANY (CLOUD + LOCAL WIPE)                             *@
    @* ========================================================================= *@
    @if (showDeleteModal && tenantToDelete != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.75);" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3 border-top border-4 border-danger">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Permanently Delete Company
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteCompanyModal" disabled="@isDeletingCompany"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-danger d-flex align-items-start gap-2 mb-3">
                            <i class="bi bi-shield-slash-fill fs-3 flex-shrink-0 text-danger"></i>
                            <div>
                                <strong class="fs-6">PERMANENT &amp; IRREVERSIBLE WIPE</strong>
                                <div class="small mt-1">
                                    You are about to completely delete <strong>@tenantToDelete.CompanyName (@tenantToDelete.CompanyCode)</strong>:
                                </div>
                                <ul class="mb-0 mt-2 small ps-3">
                                    <li>All employee master records &amp; biometric IDs</li>
                                    <li>All attendance logs, punches &amp; GPS history</li>
                                    <li>All salary snapshots, advances &amp; payslips</li>
                                    <li>All Firebase Cloud Realtime DB nodes under <code>owners/@tenantToDelete.TenantId</code></li>
                                </ul>
                            </div>
                        </div>

                        <div class="p-3 bg-body-tertiary rounded-2 mb-3 border small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Company:</span>
                                <strong>@tenantToDelete.CompanyName</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Tenant ID:</span>
                                <code>@tenantToDelete.TenantId</code>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Company Admin:</span>
                                <span>@tenantToDelete.AdminEmail</span>
                            </div>
                        </div>

                        <div class="text-muted small mb-0">
                            <i class="bi bi-lock-fill text-warning me-1"></i>
                            Authorized exclusively for SuperAdmin <code>prakashshiva368@gmail.com</code>.
                        </div>

                        @if (!string.IsNullOrWhiteSpace(deleteErrorMessage))
                        {
                            <div class="alert alert-danger py-2 small mt-3 mb-0">@deleteErrorMessage</div>
                        }
                    </div>
                    <div class="modal-footer bg-light-subtle">
                        <button type="button" class="btn btn-secondary" @onclick="CloseDeleteCompanyModal" disabled="@isDeletingCompany">Cancel</button>
                        <button type="button" class="btn btn-danger fw-bold" @onclick="ConfirmDeleteCompanyAsync" disabled="@isDeletingCompany">
                            @if (isDeletingCompany)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Deleting Cloud &amp; Local DB...</span>
                            }
                            else
                            {
                                <i class="bi bi-trash3-fill me-1"></i>
                                <span>Yes, Delete Company Entirely</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private bool isSuperAdmin = false;
    private string currentUserEmail = string.Empty;
    private CompanyTenant? activeTenant;
    private List<CompanyTenant> allTenants = new();

    // Filters
    private string searchQuery = string.Empty;
    private string selectedPlanFilter = string.Empty;
    private string selectedStatusFilter = string.Empty;

    // Modals state
    private bool showCreateModal = false;
    private bool isSubmitting = false;
    private string? createErrorMessage;
    private CreateTenantRequest newTenant = new();

    private bool showFeaturesModal = false;
    private bool isSavingFeatures = false;
    private CompanyTenant? selectedTenant;
    private FeatureSettings? editingFeatures;

    private bool showCompanySettingsModal = false;
    private bool isSavingCompanySetting = false;
    private CompanySetting? editingCompanySetting;

    private bool showEditModal = false;
    private bool isSavingEdit = false;
    private CompanyTenant? editingTenant;
    private string editAdminEmail = string.Empty;
    private string editAdminPassword = string.Empty;
    private bool showEditPassword = false;
    private string? editErrorMessage;

    // Delete Company Modal state
    private bool showDeleteModal = false;
    private bool isDeletingCompany = false;
    private string? deleteErrorMessage;
    private CompanyTenant? tenantToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            currentUserEmail = authState.User.Identity?.Name ?? FirebaseAuthSecurityConstants.CanonicalSuperAdminEmail;

            isSuperAdmin = await TenantContext.IsSuperAdminAsync();
            if (isSuperAdmin)
            {
                await TenantManager.EnsureDefaultTenantSeededAsync();
                allTenants = await TenantManager.GetAllTenantsAsync();
                activeTenant = await TenantContext.GetActiveTenantAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load multi-tenant management data.");
            ToastService.ShowError("Could not load tenants: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<CompanyTenant> FilteredTenants
    {
        get
        {
            var query = allTenants.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim().ToLowerInvariant();
                query = query.Where(t => t.CompanyName.ToLowerInvariant().Contains(q) ||
                                         t.CompanyCode.ToLowerInvariant().Contains(q) ||
                                         t.AdminEmail.ToLowerInvariant().Contains(q) ||
                                         t.AdminName.ToLowerInvariant().Contains(q));
            }

            if (!string.IsNullOrWhiteSpace(selectedPlanFilter))
            {
                query = query.Where(t => t.PlanMode.Equals(selectedPlanFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(selectedStatusFilter))
            {
                if (selectedStatusFilter == "Active")
                    query = query.Where(t => t.IsActive);
                else if (selectedStatusFilter == "Inactive")
                    query = query.Where(t => !t.IsActive);
            }

            return query.ToList();
        }
    }

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        selectedPlanFilter = string.Empty;
        selectedStatusFilter = string.Empty;
    }

    private async Task LaunchTenantWorkspace(string tenantId)
    {
        try
        {
            await TenantContext.SetActiveTenantIdAsync(tenantId);
            try
            {
                await JSRuntime.InvokeVoidAsync("setTenantCookie", tenantId);
            }
            catch { }
            ToastService.ShowSuccess($"Workspace switched to tenant: {tenantId} 🚀");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to switch tenant workspace to {TenantId}", tenantId);
            ToastService.ShowError("Could not switch workspace: " + ex.Message);
        }
    }

    private async Task ToggleTenantStatus(CompanyTenant tenant)
    {
        try
        {
            var success = await TenantManager.ToggleTenantActiveAsync(tenant.Id);
            if (success)
            {
                tenant.IsActive = !tenant.IsActive;
                ToastService.ShowSuccess($"Status of {tenant.CompanyName} updated to {(tenant.IsActive ? "Active" : "Suspended")}");
            }
            else
            {
                ToastService.ShowError("Could not toggle tenant status.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling tenant status for {TenantId}", tenant.TenantId);
            ToastService.ShowError("Status update failed.");
        }
    }

    // --- CREATE MODAL ---
    private void OpenCreateModal()
    {
        newTenant = new CreateTenantRequest
        {
            CompanyName = "",
            CompanyCode = "",
            IconEmoji = "🏢",
            PlanMode = "Spark",
            AdminEmail = "",
            AdminPassword = "",
            AdminName = "",
            AdminPhone = "",
            OfficeLatitude = 11.9416,
            OfficeLongitude = 79.8083,
            GeoRadiusMeters = 100,
            WorkDayCutoffHour = 22,
            InitialFeatures = new FeatureSettings
            {
                EnablePayroll = true,
                EnableSalaryAdvance = true,
                EnableBonusManagement = true,
                EnableGeoFencing = true,
                EnableDualAttendance = false,
                EnableShiftScheduling = true,
                EnableLeaveManagement = true,
                AdminCanViewDashboard = true,
                AdminCanManageEmployees = true,
                AdminCanViewAttendance = true,
                AdminCanRunPayroll = true,
                AdminCanEditSettings = true
            }
        };
        createErrorMessage = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        createErrorMessage = null;
    }

    private async Task SubmitCreateTenant()
    {
        if (string.IsNullOrWhiteSpace(newTenant.CompanyName))
        {
            createErrorMessage = "Please enter a Company Name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newTenant.AdminEmail))
        {
            createErrorMessage = "Please enter the Admin Email.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newTenant.AdminPassword) || newTenant.AdminPassword.Length < 6)
        {
            createErrorMessage = "Admin Password must be at least 6 characters.";
            return;
        }

        isSubmitting = true;
        createErrorMessage = null;

        try
        {
            var result = await TenantManager.CreateTenantAsync(newTenant);
            if (result.Success && result.Tenant != null)
            {
                ToastService.ShowSuccess($"Company '{result.Tenant.CompanyName}' created successfully! 🎉");
                CloseCreateModal();
                await LoadDataAsync();
            }
            else
            {
                createErrorMessage = result.ErrorMessage ?? "Failed to create company tenant.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating tenant company.");
            createErrorMessage = "An unexpected error occurred: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // --- FEATURES MODAL ---
    private async Task OpenFeatureTogglesModal(CompanyTenant tenant)
    {
        selectedTenant = tenant;
        editingFeatures = await TenantManager.GetTenantFeaturesAsync(tenant.Id);
        if (editingFeatures == null)
        {
            editingFeatures = new FeatureSettings { Id = tenant.FeatureSettingsId };
        }
        showFeaturesModal = true;
    }

    private void CloseFeaturesModal()
    {
        showFeaturesModal = false;
        selectedTenant = null;
        editingFeatures = null;
    }

    private async Task SubmitSaveFeatures()
    {
        if (selectedTenant == null || editingFeatures == null) return;

        isSavingFeatures = true;
        try
        {
            var success = await TenantManager.SaveTenantFeaturesAsync(selectedTenant.Id, editingFeatures);
            if (success)
            {
                ToastService.ShowSuccess($"Features and admin permissions saved for {selectedTenant.CompanyName}! 🎛️");
                CloseFeaturesModal();
            }
            else
            {
                ToastService.ShowError("Could not save tenant feature toggles.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving tenant features.");
            ToastService.ShowError("Failed to save feature toggles: " + ex.Message);
        }
        finally
        {
            isSavingFeatures = false;
        }
    }

    // --- COMPANY SETTINGS MODAL ---
    private async Task OpenCompanySettingsModal(CompanyTenant tenant)
    {
        selectedTenant = tenant;
        editingCompanySetting = await TenantManager.GetTenantCompanySettingAsync(tenant.Id);
        if (editingCompanySetting == null)
        {
            editingCompanySetting = new CompanySetting { CompanyName = tenant.CompanyName };
        }
        showCompanySettingsModal = true;
    }

    private void CloseCompanySettingsModal()
    {
        showCompanySettingsModal = false;
        selectedTenant = null;
        editingCompanySetting = null;
    }

    private async Task SubmitSaveCompanySettings()
    {
        if (selectedTenant == null || editingCompanySetting == null) return;

        isSavingCompanySetting = true;
        try
        {
            var success = await TenantManager.UpdateTenantCompanySettingAsync(selectedTenant.Id, editingCompanySetting);
            if (success)
            {
                ToastService.ShowSuccess($"Office & attendance settings updated for {selectedTenant.CompanyName}! 🏢");
                CloseCompanySettingsModal();
                await LoadDataAsync();
            }
            else
            {
                ToastService.ShowError("Could not save company office settings.");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving tenant company settings.");
            ToastService.ShowError("Failed to save office settings: " + ex.Message);
        }
        finally
        {
            isSavingCompanySetting = false;
        }
    }

    // --- EDIT TENANT MODAL ---
    private void OpenEditTenantModal(CompanyTenant tenant)
    {
        selectedTenant = tenant;
        editingTenant = new CompanyTenant
        {
            Id = tenant.Id,
            TenantId = tenant.TenantId,
            CompanyName = tenant.CompanyName,
            CompanyCode = tenant.CompanyCode,
            AdminUserId = tenant.AdminUserId,
            AdminEmail = tenant.AdminEmail,
            AdminName = tenant.AdminName,
            AdminPhone = tenant.AdminPhone,
            IconEmoji = tenant.IconEmoji,
            PlanMode = tenant.PlanMode,
            IsActive = tenant.IsActive,
            CompanySettingId = tenant.CompanySettingId,
            FeatureSettingsId = tenant.FeatureSettingsId
        };
        editAdminEmail = tenant.AdminEmail;
        editAdminPassword = string.Empty;
        showEditPassword = false;
        editErrorMessage = null;
        showEditModal = true;
    }

    private void CloseEditTenantModal()
    {
        showEditModal = false;
        selectedTenant = null;
        editingTenant = null;
        editErrorMessage = null;
    }

    private async Task SubmitSaveEditTenant()
    {
        if (editingTenant == null) return;

        editErrorMessage = null;
        isSavingEdit = true;
        try
        {
            var result = await TenantManager.UpdateTenantProfileAndCredentialsAsync(
                editingTenant,
                editAdminEmail,
                string.IsNullOrWhiteSpace(editAdminPassword) ? null : editAdminPassword);

            if (result.Success)
            {
                ToastService.ShowSuccess($"Tenant profile & credentials saved for {editingTenant.CompanyName}!");
                CloseEditTenantModal();
                await LoadDataAsync();
            }
            else
            {
                editErrorMessage = result.ErrorMessage ?? "Failed to update tenant profile.";
                ToastService.ShowError(editErrorMessage);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating tenant.");
            editErrorMessage = ex.Message;
            ToastService.ShowError("Failed to update tenant: " + ex.Message);
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private async Task CopyAdminCredentials(CompanyTenant tenant)
    {
        try
        {
            var loginUrl = Navigation.BaseUri + "Identity/Account/Login";
            var text = $"🏢 Company: {tenant.CompanyName}\n🔑 Admin Email: {tenant.AdminEmail}\n🌐 Login URL: {loginUrl}";
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            ToastService.ShowSuccess($"Copied administrator credentials for {tenant.CompanyName} to clipboard!");
        }
        catch
        {
            ToastService.ShowInfo($"Admin Email: {tenant.AdminEmail}");
        }
    }

    // --- DELETE COMPANY MODAL ---
    private void OpenDeleteCompanyModal(CompanyTenant tenant)
    {
        tenantToDelete = tenant;
        deleteErrorMessage = null;
        isDeletingCompany = false;
        showDeleteModal = true;
    }

    private void CloseDeleteCompanyModal()
    {
        if (isDeletingCompany) return;
        showDeleteModal = false;
        tenantToDelete = null;
        deleteErrorMessage = null;
    }

    private async Task ConfirmDeleteCompanyAsync()
    {
        if (tenantToDelete == null) return;

        isDeletingCompany = true;
        deleteErrorMessage = null;

        try
        {
            var userEmail = string.IsNullOrWhiteSpace(currentUserEmail)
                ? FirebaseAuthSecurityConstants.CanonicalSuperAdminEmail
                : currentUserEmail;

            var result = await TenantManager.DeleteEntireCompanyAsync(tenantToDelete.TenantId, userEmail);

            if (result.Success)
            {
                ToastService.ShowSuccess($"Company '{tenantToDelete.CompanyName}' ({tenantToDelete.CompanyCode}) deleted successfully from Cloud and Local DB! 🗑️");
                showDeleteModal = false;
                tenantToDelete = null;
                await LoadDataAsync();
            }
            else
            {
                deleteErrorMessage = result.ErrorMessage ?? "Failed to delete company.";
                ToastService.ShowError(deleteErrorMessage);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting company tenant.");
            deleteErrorMessage = "An unexpected error occurred: " + ex.Message;
            ToastService.ShowError(deleteErrorMessage);
        }
        finally
        {
            isDeletingCompany = false;
        }
    }
}
