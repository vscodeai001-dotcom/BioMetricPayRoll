                                            <input class="form-check-input" type="checkbox" id="m_tds" @bind="editingFeatures.EnableTdsDeduction" />
                                            <label class="form-check-label fw-bold" for="m_tds">📑 TDS Deduction</label>
                                            <div class="form-text small">Income tax deduction and tax declaration module.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
