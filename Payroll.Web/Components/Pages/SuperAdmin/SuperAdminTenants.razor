                                            <input class="form-check-input" type="checkbox" id="m_reports" @bind="editingFeatures.EnableCompanyReports" />
                                            <label class="form-check-label fw-bold" for="m_reports">📈 Company Reports</label>
                                            <div class="form-text small">Attendance summaries, muster rolls &amp; export tools.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* SECTION 2: ATTENDANCE & GEOFENCING *@
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-success text-white fw-bold py-2">
                                <i class="bi bi-geo-alt-fill me-2"></i>2. Attendance &amp; Geofencing Rules
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-12 col-sm-6 col-lg-4">
