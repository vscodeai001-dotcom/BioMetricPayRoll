                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-warning text-dark fw-bold py-2">
                                <i class="bi bi-shield-lock-fill me-2"></i>3. Company Administrator Rights (Granted to @selectedTenant.AdminEmail)
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_dash" @bind="editingFeatures.AdminCanViewDashboard" />
                                            <label class="form-check-label fw-bold" for="p_dash">📊 View Admin Dashboard</label>
                                            <div class="form-text small">Access to high-level KPIs, attendance charts &amp; stats.</div>
