                                            <div class="form-text small">Require employees to be within GPS boundary.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="a_dual" @bind="editingFeatures.EnableDualAttendance" />
                                            <label class="form-check-label fw-bold" for="a_dual">🔄 Dual Attendance Mode</label>
                                            <div class="form-text small">Both biometric hardware machine and mobile geofence active.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="a_auto_punch" @bind="editingFeatures.EnableAutomaticGeofencePunching" />
                                            <label class="form-check-label fw-bold" for="a_auto_punch">⚡ Automatic GPS Punching</label>
                                            <div class="form-text small">Auto IN/OUT generated when entering/exiting geofence.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="a_correction" @bind="editingFeatures.EnablePunchCorrection" />
                                            <label class="form-check-label fw-bold" for="a_correction">🛠️ Punch Correction Requests</label>
                                            <div class="form-text small">Allow employees to request missed punch adjustments.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="a_reg" @bind="editingFeatures.EnableRegularizationRequest" />
                                            <label class="form-check-label fw-bold" for="a_reg">📋 Attendance Regularization</label>
                                            <div class="form-text small">Formal attendance dispute &amp; regularization workflow.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="a_audit" @bind="editingFeatures.EnableAuditLog" />
                                            <label class="form-check-label fw-bold" for="a_audit">🛡️ Audit Logging</label>
                                            <div class="form-text small">Comprehensive tracking of punch corrections and changes.</div>
                                        </div>
                                    </div>
                                </div>
