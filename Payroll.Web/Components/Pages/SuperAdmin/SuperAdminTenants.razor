                                            <input class="form-check-input" type="checkbox" id="p_att" @bind="editingFeatures.AdminCanViewAttendance" />
                                            <label class="form-check-label fw-bold" for="p_att">🕒 View Attendance Logs</label>
                                            <div class="form-text small">Inspect daily punch logs, in/out timestamps &amp; flags.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_payroll" @bind="editingFeatures.AdminCanRunPayroll" />
                                            <label class="form-check-label fw-bold" for="p_payroll">⚡ Process &amp; Run Payroll</label>
                                            <div class="form-text small">Allow admin to compute salaries and issue payslips.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_settings" @bind="editingFeatures.AdminCanEditSettings" />
                                            <label class="form-check-label fw-bold" for="p_settings">⚙️ Edit Company Settings</label>
                                            <div class="form-text small">Allow admin to change cutoff hours, GPS radius, etc.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_shifts" @bind="editingFeatures.AdminCanManageShifts" />
                                            <label class="form-check-label fw-bold" for="p_shifts">📅 Manage Shift Rosters</label>
                                            <div class="form-text small">Create shifts and assign shifts to staff members.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_approvals" @bind="editingFeatures.AdminCanManagePunchApprovals" />
                                            <label class="form-check-label fw-bold" for="p_approvals">✅ Approve Punch Corrections</label>
                                            <div class="form-text small">Approve or reject employee manual punch requests.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_reports" @bind="editingFeatures.AdminCanViewReports" />
                                            <label class="form-check-label fw-bold" for="p_reports">📈 View Executive Reports</label>
                                            <div class="form-text small">Access to monthly attendance &amp; payroll reports.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_emp_perms" @bind="editingFeatures.AdminCanManageEmployeePermissions" />
                                            <label class="form-check-label fw-bold" for="p_emp_perms">🔐 Delegate Employee Permissions</label>
                                            <div class="form-text small">Allow admin to customize what employees can see.</div>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6 col-lg-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" id="p_feat_toggles" @bind="editingFeatures.AdminCanManageFeatureToggles" />
                                            <label class="form-check-label fw-bold" for="p_feat_toggles">🎛️ Manage Feature Toggles</label>
                                            <div class="form-text small">Allow admin to access and toggle company features.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseFeaturesModal" disabled="@isSavingFeatures">Cancel</button>
                        <button type="button" class="btn btn-primary fw-bold px-4" @onclick="SubmitSaveFeatures" disabled="@isSavingFeatures">
                            @if (isSavingFeatures)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving Configuration...</span>
                            }
                            else
                            {
                                <i class="bi bi-save me-1"></i>
                                <span>Save Feature Toggles</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ========================================================================= *@
    @* MODAL 3: OFFICE LOCATION & GEOFENCE SETTINGS *@
    @* ========================================================================= *@
    @if (showCompanySettingsModal && selectedTenant != null && editingCompanySetting != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-geo-alt-fill me-2"></i>Office Location &amp; Attendance Rules: @selectedTenant.CompanyName
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseCompanySettingsModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label fw-bold small">Company Name</label>
                                <input type="text" class="form-control" @bind="editingCompanySetting.CompanyName" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold small">Office Address Line 1</label>
                                <input type="text" class="form-control" @bind="editingCompanySetting.AddressLine1" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold small">City, State, Pincode</label>
                                <input type="text" class="form-control" @bind="editingCompanySetting.CityStatePincode" />
                            </div>
                        </div>

                        <h6 class="fw-bold text-success border-bottom pb-2 mb-3">📍 GPS &amp; Geofencing Boundary</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small">Office Latitude</label>
                                <input type="number" step="0.000001" class="form-control" @bind="editingCompanySetting.OfficeLatitude" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small">Office Longitude</label>
                                <input type="number" step="0.000001" class="form-control" @bind="editingCompanySetting.OfficeLongitude" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small">Geofence Radius (Meters)</label>
                                <input type="number" class="form-control" min="20" max="5000" @bind="editingCompanySetting.GeoRadiusMeters" />
                            </div>
                        </div>

                        <h6 class="fw-bold text-success border-bottom pb-2 mb-3">⏰ Work Day &amp; Grace Rules</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small">Work Day Cutoff Hour (24h)</label>
                                <input type="number" min="0" max="23" class="form-control" @bind="editingCompanySetting.WorkDayCutoffHour" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small">Late Grace Minutes</label>
                                <input type="number" min="0" max="120" class="form-control" @bind="editingCompanySetting.LateGraceMinutes" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small">Early Exit Grace Minutes</label>
                                <input type="number" min="0" max="120" class="form-control" @bind="editingCompanySetting.EndTimeGraceMinutes" />
                            </div>
                        </div>

                        <h6 class="fw-bold text-success border-bottom pb-2 mb-3">📠 Biometric Machine Network Settings (Optional)</h6>
                        <div class="row g-3">
                            <div class="col-12 col-md-8">
                                <label class="form-label fw-bold small">ZKTeco Device IP</label>
                                <input type="text" class="form-control" placeholder="192.168.1.201" @bind="editingCompanySetting.ZktecoIP" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fw-bold small">ZKTeco Port</label>
                                <input type="number" class="form-control" @bind="editingCompanySetting.ZktecoPort" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseCompanySettingsModal" disabled="@isSavingCompanySetting">Cancel</button>
                        <button type="button" class="btn btn-success fw-bold px-4" @onclick="SubmitSaveCompanySettings" disabled="@isSavingCompanySetting">
                            @if (isSavingCompanySetting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Saving Rules...</span>
                            }
                            else
                            {
                                <i class="bi bi-save me-1"></i>
                                <span>Save Office Settings</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

