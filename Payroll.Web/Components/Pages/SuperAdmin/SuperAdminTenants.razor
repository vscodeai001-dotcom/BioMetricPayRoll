@page "/superadmin/tenants"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Services
@using Blazored.Toast.Services

@attribute [Authorize]

@inject ITenantContextService TenantContext
@inject TenantManagementService TenantManager
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject ILogger<SuperAdminTenants> Logger
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>👑 SuperAdmin Multi-Tenant Command Center</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5 my-5">
        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
        <h5 class="text-muted">Loading Enterprise Tenant Management Portal...</h5>
    </div>
}
else if (!isSuperAdmin)
{
    <div class="container py-5">
        <div class="card border-danger shadow-sm mx-auto" style="max-width: 600px;">
            <div class="card-body text-center p-5">
                <div class="display-1 text-danger mb-3">🚫</div>
                <h3 class="card-title text-danger fw-bold">Access Restricted</h3>
                <p class="card-text text-muted mb-4">
                    The SuperAdmin Multi-Tenant Management Portal is exclusively reserved for the root system administrator.
                </p>
                <a href="/" class="btn btn-primary px-4">
                    <i class="bi bi-house-door-fill me-2"></i>Return to Application
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-3 px-md-4 py-4">
        @* --- TOP HEADER --- *@
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h2 class="fw-bold mb-0 text-primary">👑 Multi-Tenant Command Center</h2>
                    <span class="badge bg-warning text-dark px-2 py-1 fw-bold fs-6">SUPERADMIN</span>
                </div>
                <p class="text-muted small mb-0 mt-1">
                    Provision new client companies, configure isolated feature toggles &amp; permissions, and launch into tenant workspaces.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-secondary" @onclick="LoadDataAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                </button>
                <button class="btn btn-success fw-bold shadow-sm" @onclick="OpenCreateModal">
                    <i class="bi bi-building-add me-1"></i>✨ Register New Company
                </button>
            </div>
        </div>

        @* --- KPI METRICS CARDS --- *@
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 tenant-kpi-card bg-primary text-white">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase">Total Companies</div>
                            <div class="display-6 fw-bold">@allTenants.Count</div>
                            <div class="small text-white-50 mt-1">
                                <span class="badge bg-white text-primary fw-bold">@allTenants.Count(t => t.IsActive) Active</span>
                                @if (allTenants.Count(t => !t.IsActive) > 0)
                                {
                                    <span class="badge bg-danger ms-1">@allTenants.Count(t => !t.IsActive) Inactive</span>
                                }
                            </div>
                        </div>
                        <div class="fs-1 opacity-75">🏢</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 tenant-kpi-card bg-success text-white">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase">Spark Optimization</div>
                            <div class="display-6 fw-bold">@allTenants.Count(t => t.PlanMode == "Spark")</div>
                            <div class="small text-white-50 mt-1">
                                <span>⚡ 80% Bandwidth Saver</span>
                            </div>
                        </div>
                        <div class="fs-1 opacity-75">⚡</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 tenant-kpi-card bg-danger text-white">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase">Blaze Enterprise</div>
                            <div class="display-6 fw-bold">@allTenants.Count(t => t.PlanMode == "Blaze")</div>
                            <div class="small text-white-50 mt-1">
                                <span>🔥 High Throughput</span>
                            </div>
                        </div>
                        <div class="fs-1 opacity-75">🔥</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 tenant-kpi-card bg-dark text-white">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase">Active Workspace</div>
                            <div class="h4 fw-bold mb-1 text-truncate" style="max-width: 180px;">
                                @(activeTenant?.IconEmoji ?? "🏢") @(activeTenant?.CompanyName ?? "None")
                            </div>
                            <div class="small text-white-50">
                                Code: <span class="badge bg-warning text-dark fw-bold">@(activeTenant?.CompanyCode ?? "N/A")</span>
                            </div>
                        </div>
                        <div class="fs-1 opacity-75">🎯</div>
                    </div>
                </div>
            </div>
        </div>

        @* --- SEARCH & FILTER BAR --- *@
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" placeholder="Search company by name, code or admin email..."
                                   @bind="searchQuery" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <select class="form-select" @bind="selectedPlanFilter">
                            <option value="">All Plans (Spark &amp; Blaze)</option>
                            <option value="Spark">⚡ Spark Only</option>
                            <option value="Blaze">🔥 Blaze Only</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <select class="form-select" @bind="selectedStatusFilter">
                            <option value="">All Statuses</option>
                            <option value="Active">🟢 Active Only</option>
                            <option value="Inactive">🔴 Suspended Only</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2 text-md-end text-muted small">
                        Showing <strong>@FilteredTenants.Count</strong> of @allTenants.Count
                    </div>
                </div>
            </div>
        </div>

        @* --- TENANT CARDS GRID --- *@
        @if (FilteredTenants.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
                <div class="display-3 mb-3">🔍</div>
                <h5>No client companies matched your search criteria</h5>
                <p class="small mb-3">Try adjusting your filters or register a new company.</p>
                <div>
                    <button class="btn btn-outline-primary" @onclick="ResetFilters">Reset Filters</button>
                    <button class="btn btn-success ms-2" @onclick="OpenCreateModal">✨ Register New Company</button>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var tenant in FilteredTenants)
                {
                    var isCurrentActive = activeTenant?.TenantId == tenant.TenantId;
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 tenant-card shadow-sm border-0 rounded-3 position-relative @(isCurrentActive ? "border border-2 border-primary" : "")">
                            @if (isCurrentActive)
                            {
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge bg-primary shadow-sm">
                                        <i class="bi bi-check-circle-fill me-1"></i>Active Workspace
                                    </span>
                                </div>
                            }

                            <div class="card-body p-4 d-flex flex-column">
                                @* Header *@
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <div class="tenant-emoji-badge fs-2 p-2 rounded-3 bg-light-subtle border">
                                        @tenant.IconEmoji
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <h5 class="fw-bold mb-1 text-truncate" title="@tenant.CompanyName">@tenant.CompanyName</h5>
                                        <div class="d-flex align-items-center flex-wrap gap-1">
                                            <span class="badge bg-secondary-subtle text-secondary-emphasis fw-bold">@tenant.CompanyCode</span>
                                            <span class="badge @(tenant.PlanMode == "Blaze" ? "bg-danger" : "bg-success")">
                                                @(tenant.PlanMode == "Blaze" ? "🔥 Blaze" : "⚡ Spark")
                                            </span>
                                            @if (tenant.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">🟢 Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">🔴 Suspended</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @* Admin Info *@
                                <div class="tenant-info-box p-3 rounded-2 bg-body-tertiary mb-3 small">
                                    <div class="d-flex align-items-center mb-1 text-truncate">
                                        <i class="bi bi-person-badge text-primary me-2"></i>
                                        <strong class="me-1">Admin:</strong>
                                        <span class="text-truncate">@tenant.AdminName</span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1 text-truncate">
                                        <i class="bi bi-envelope text-primary me-2"></i>
                                        <span class="text-truncate" title="@tenant.AdminEmail">@tenant.AdminEmail</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(tenant.AdminPhone))
                                    {
                                        <div class="d-flex align-items-center mb-1">
                                            <i class="bi bi-telephone text-primary me-2"></i>
                                            <span>@tenant.AdminPhone</span>
                                        </div>
                                    }
                                    <div class="d-flex align-items-center text-muted mb-2">
                                        <i class="bi bi-calendar3 me-2"></i>
                                        <span>Registered: @tenant.CreatedAtUtc.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">Login Access:</span>
                                        <button class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold"
                                                style="font-size: 0.78rem;"
                                                title="Copy administrator login details to share with company admin"
                                                @onclick="() => CopyAdminCredentials(tenant)">
                                            <i class="bi bi-clipboard-check me-1"></i>Copy Login Info
                                        </button>
                                    </div>
                                </div>

                                @* Action Buttons *@
                                <div class="mt-auto d-flex flex-column gap-2">
                                    <div class="d-grid gap-2">
                                        @if (isCurrentActive)
                                        {
                                            <a href="/" class="btn btn-primary fw-bold">
                                                <i class="bi bi-box-arrow-in-right me-1"></i>Go To Dashboard
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary fw-bold" @onclick="() => LaunchTenantWorkspace(tenant.TenantId)">
                                                <i class="bi bi-rocket-takeoff-fill me-1"></i>🚀 Enter Workspace
                                            </button>
                                        }
                                    </div>

                                    <div class="d-flex gap-1 justify-content-between">
                                        <button class="btn btn-sm btn-outline-secondary flex-grow-1" title="Configure Feature Toggles &amp; Admin Permissions"
                                                @onclick="() => OpenFeatureTogglesModal(tenant)">
                                            <i class="bi bi-sliders me-1"></i>Features
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary flex-grow-1" title="Company Settings &amp; Geofence"
                                                @onclick="() => OpenCompanySettingsModal(tenant)">
                                            <i class="bi bi-geo-alt me-1"></i>Office
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary flex-grow-1" title="Edit Tenant Profile"
                                                @onclick="() => OpenEditTenantModal(tenant)">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                        <button class="btn btn-sm @(tenant.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                title="@(tenant.IsActive ? "Suspend Tenant" : "Activate Tenant")"
                                                @onclick="() => ToggleTenantStatus(tenant)">
                                            <i class="bi @(tenant.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                title="Delete Company Entirely (Local DB + Firebase Cloud)"
                                                @onclick="() => OpenDeleteCompanyModal(tenant)">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ========================================================================= *@
    @* MODAL 1: REGISTER NEW COMPANY & ADMIN *@
    @* ========================================================================= *@
    @if (showCreateModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg rounded-3">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-building-add me-2"></i>Register New Client Company &amp; Administrator
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateModal"></button>
                    </div>

                    <div class="modal-body p-4">
                        @if (!string.IsNullOrWhiteSpace(createErrorMessage))
                        {
                            <div class="alert alert-danger d-flex align-items-center mb-3">
                                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                                <div>@createErrorMessage</div>
                            </div>
                        }

                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="bi bi-1-circle-fill me-1"></i> Company Profile
                            </h6>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small">Company Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" placeholder="e.g. Acme Corporation" @bind="newTenant.CompanyName" />
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label fw-bold small">Company Code</label>
                                    <input type="text" class="form-control text-uppercase" placeholder="ACME" maxlength="10" @bind="newTenant.CompanyCode" />
                                    <div class="form-text small">Short unique code</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label fw-bold small">Icon Emoji</label>
                                    <select class="form-select" @bind="newTenant.IconEmoji">
                                        <option value="🏢">🏢 Corporate</option>
                                        <option value="🏭">🏭 Industrial</option>
                                        <option value="🏥">🏥 Hospital</option>
                                        <option value="🏦">🏦 Financial</option>
                                        <option value="🚀">🚀 Tech Startup</option>
                                        <option value="💻">💻 IT Software</option>
                                        <option value="🏪">🏪 Retail</option>
                                        <option value="🏨">🏨 Hotel</option>
                                        <option value="🏫">🏫 School/Edu</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small">Firebase Infrastructure Plan</label>
                                    <select class="form-select" @bind="newTenant.PlanMode">
                                        <option value="Spark">⚡ Spark (Free / 80% Realtime Bandwidth Optimized)</option>
                                        <option value="Blaze">🔥 Blaze (Paid / Unthrottled Enterprise Cloud)</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small">Work Day Cutoff Hour (24h)</label>
                                    <input type="number" class="form-control" min="0" max="23" @bind="newTenant.WorkDayCutoffHour" />
                                    <div class="form-text small">Hour at which day attendance rolls over (default 22:00)</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="bi bi-2-circle-fill me-1"></i> Company Administrator Credentials
                            </h6>
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small">Admin Email Address <span class="text-danger">*</span></label>
                                    <input type="email" class="form-control" placeholder="admin@company.com" @bind="newTenant.AdminEmail" />
                                    <div class="form-text small">Used for company admin portal login</div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small">Admin Temporary Password <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" placeholder="Minimum 6 characters" @bind="newTenant.AdminPassword" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small">Admin Full Name</label>
                                    <input type="text" class="form-control" placeholder="e.g. John Doe" @bind="newTenant.AdminName" />
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-bold small">Admin Phone Number</label>
                                    <input type="tel" class="form-control" placeholder="+91 98765 43210" @bind="newTenant.AdminPhone" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="bi bi-3-circle-fill me-1"></i> Office Location &amp; Geofencing
                            </h6>
                            <div class="row g-3">
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-bold small">Office Latitude</label>
                                    <input type="number" step="0.000001" class="form-control" @bind="newTenant.OfficeLatitude" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-bold small">Office Longitude</label>
                                    <input type="number" step="0.000001" class="form-control" @bind="newTenant.OfficeLongitude" />
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label fw-bold small">Geofence Radius (Meters)</label>
                                    <input type="number" class="form-control" min="20" max="5000" @bind="newTenant.GeoRadiusMeters" />
                                </div>
                            </div>
                        </div>

                        <div>
                            <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
                                <i class="bi bi-4-circle-fill me-1"></i> Initial Feature Switches &amp; Admin Rights
                            </h6>
                            <div class="row g-2">
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_payroll" @bind="newTenant.InitialFeatures.EnablePayroll" />
                                        <label class="form-check-label small fw-bold" for="c_payroll">💰 Payroll Engine</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_geofence" @bind="newTenant.InitialFeatures.EnableGeoFencing" />
                                        <label class="form-check-label small fw-bold" for="c_geofence">📍 Geo-Fencing</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_dual" @bind="newTenant.InitialFeatures.EnableDualAttendance" />
                                        <label class="form-check-label small fw-bold" for="c_dual">🔄 Dual Attendance</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_advance" @bind="newTenant.InitialFeatures.EnableSalaryAdvance" />
                                        <label class="form-check-label small fw-bold" for="c_advance">💵 Salary Advance</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_bonus" @bind="newTenant.InitialFeatures.EnableBonusManagement" />
                                        <label class="form-check-label small fw-bold" for="c_bonus">🎁 Bonus System</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_shifts" @bind="newTenant.InitialFeatures.EnableShiftScheduling" />
                                        <label class="form-check-label small fw-bold" for="c_shifts">📅 Shift Schedules</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_leave" @bind="newTenant.InitialFeatures.EnableLeaveManagement" />
                                        <label class="form-check-label small fw-bold" for="c_leave">🏖️ Leave Manager</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_admin_dash" @bind="newTenant.InitialFeatures.AdminCanViewDashboard" />
                                        <label class="form-check-label small fw-bold" for="c_admin_dash">📊 Admin Dashboard</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_admin_emp" @bind="newTenant.InitialFeatures.AdminCanManageEmployees" />
                                        <label class="form-check-label small fw-bold" for="c_admin_emp">👥 Manage Employees</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_admin_run_payroll" @bind="newTenant.InitialFeatures.AdminCanRunPayroll" />
                                        <label class="form-check-label small fw-bold" for="c_admin_run_payroll">⚡ Admin Run Payroll</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_admin_settings" @bind="newTenant.InitialFeatures.AdminCanEditSettings" />
                                        <label class="form-check-label small fw-bold" for="c_admin_settings">⚙️ Admin Edit Settings</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="c_auto_punch" @bind="newTenant.InitialFeatures.EnableAutomaticGeofencePunching" />
                                        <label class="form-check-label small fw-bold" for="c_auto_punch">⚡ Auto GPS Punch</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

