@page "/bonus-management"
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Components.UI.Finance
@inject FirebaseBonusService FirebaseBonuses
@inject IToastService toastService
@inject IJSRuntime JSRuntime
@inject AttendanceRefreshService AttendanceRefresh
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Bonus Management</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Bonus Management</strong> module is currently disabled.</p>
            <hr>
            <p class="mb-0">Please contact your SuperAdmin to enable this feature.</p>
        </div>
    </div>
}
else
{
    <h3>Bonus Management</h3>
    <p>Issue one-time bonuses or ex-gratia payments to employees.</p>

    <BonusEntryForm NewBonus="newBonus"
                    Employees="employeeList"
                    OnSaved="LoadData" />

    <div class="mb-4"></div>

    <BonusHistoryTable Bonuses="bonusList"
                       Employees="employeeList"
                       IsLoading="isLoading"
                       OnDelete="DeleteBonus" />
}

<AttendanceRefreshListener OnBonusChanged="HandleRealtimeRefresh" />

@code {
    private List<Employee>? employeeList;
    private List<BonusRecord>? bonusList;
    private BonusRecord newBonus = new();
    private bool isLoading = true;
    private bool isAccessDenied = false;

    protected override async Task OnInitializedAsync()
    {
        newBonus.BonusDate = DateTime.Now;
        await CheckPermissionsAndLoadData(isSilent: false);
    }

    private async Task CheckPermissionsAndLoadData(bool isSilent = false)
    {
        if (!isSilent && bonusList == null)
        {
            isLoading = true;
            await InvokeAsync(StateHasChanged);
        }
        try
        {
            if (!await FirebaseBonuses.IsEnabledAsync())
            {
                isAccessDenied = true;
                return;
            }

            if (employeeList == null)
            {
                employeeList = await FirebaseBonuses.GetActiveEmployeesAsync();
            }

            var freshBonuses = await FirebaseBonuses.GetAsync();
            bonusList = freshBonuses;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Bonus load failed: {ex.Message}");
            if (bonusList == null) bonusList = new List<BonusRecord>();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadData()
    {
        await CheckPermissionsAndLoadData(isSilent: true);
    }

    private async Task DeleteBonus(BonusRecord bonus)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Delete this bonus record?")) return;
        if (bonus.PayrollID_Paid.HasValue)
        {
            toastService.ShowWarning("A payroll-attached bonus cannot be deleted.");
            return;
        }
        if (!await FirebaseBonuses.DeleteAsync(bonus))
        {
            toastService.ShowError("Unable to delete the bonus from Firebase.");
            return;
        }
        toastService.ShowSuccess("Bonus deleted.");

        try
        {
            await AttendanceRefresh.NotifyBonusChangedAsync(bonus.EmployeeID, "DELETED");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to notify bonus deleted: {ex.Message}");
        }

        await LoadData();
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await CheckPermissionsAndLoadData(isSilent: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}