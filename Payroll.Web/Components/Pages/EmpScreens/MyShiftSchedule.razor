@page "/my-shifts"
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Shared.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject Payroll.Web.Services.FirebaseShiftScheduleService FirebaseShiftSchedules
@inject AuthenticationStateProvider AuthStateProvider
@inject IToastService toastService
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Employee, SuperAdmin")]

<PageTitle>My Shift Schedule</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Shift Scheduling</strong> module is currently disabled or you do not have permission to view your schedule.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else
{
    <div class="page-header-container">
        <div class="d-flex align-items-center gap-3">
            <div class="emoji-icon-badge emoji-icon-badge-info">
                🔄
            </div>
            <div>
                <h2 class="page-header-title">
                    My Shift Schedule & Roster
                </h2>
                <p class="page-header-subtitle">
                    <span>⏰ View your assigned shift hours, weekly off schedule and rotation timings</span>
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2 fw-semibold">
                <span>🌅 Morning</span> • <span>🌆 Evening</span> • <span>🌙 Night</span>
            </span>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">📅 Select Month</label>
                    <input type="month" class="form-control rounded-3" @bind="selectedMonth" @bind:after="LoadShifts" />
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted fw-semibold">Loading your shift roster... 🔄</p>
        </div>
    }
    else if (shifts == null || !shifts.Any())
    {
        <div class="alert alert-info rounded-4 p-4 shadow-sm mb-4">
            <span class="fs-4 me-2">ℹ️</span>
            No custom shifts scheduled for this month. You are assigned to the <strong>Default Shift</strong>.
        </div>
        @if (defaultShift != null)
        {
            <div class="card border-0 shadow-sm rounded-4 w-100 w-md-50">
                <div class="card-body p-4">
                    <h6 class="fw-bold d-flex align-items-center gap-2">
                        <span>⏰</span> Default Shift Profile
                    </h6>
                    <p class="mb-1 text-muted"><strong>Time:</strong> @(defaultShift.ShiftStartTime?.ToString("hh:mm tt") ?? "N/A") - @(defaultShift.ShiftEndTime?.ToString("hh:mm tt") ?? "N/A")</p>
                    <p class="mb-0 text-muted"><strong>Weekly Off:</strong> @(defaultShift.CompOffDayOfWeek?.ToString() ?? "None")</p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="table-responsive-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>📅 Date</th>
                            <th>🗓️ Day of Week</th>
                            <th>⏰ Scheduled Shift</th>
                            <th>📌 Status / Type</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var day in daysInMonth)
                    {
                        var shift = shifts.FirstOrDefault(s => s.ShiftDate == day);
                        var isOff = defaultShift?.CompOffDayOfWeek.HasValue == true && day.DayOfWeek == defaultShift.CompOffDayOfWeek.Value;
                        <tr class="@(shift != null ? "table-primary" : isOff ? "table-secondary" : "")">
                            <td>@day.ToString("dd-MMM-yyyy")</td>
                            <td>@day.DayOfWeek</td>
                            <td>
                                @if (shift != null)
                                {
                                    <strong>@shift.StartTime.ToString("hh:mm tt") - @shift.EndTime.ToString("hh:mm tt")</strong>
                                }
                                else if (isOff)
                                {
                                    <span class="badge bg-secondary">Weekly Off</span>
                                }
                                else
                                {
                                    <span class="text-muted">Default (@(defaultShift?.ShiftStartTime?.ToString("hh:mm tt")) - @(defaultShift?.ShiftEndTime?.ToString("hh:mm tt")))</span>
                                }
                            </td>
                            <td>
                                @if (shift != null)
                                {
                                    <span class="badge bg-primary">Scheduled</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code {
    private DateTime selectedMonth = DateTime.Now;
    private List<ShiftSchedule> shifts = new();
    private List<DateOnly> daysInMonth = new();
    private Employee? defaultShift;
    private bool isLoading = true;
    private bool isAccessDenied = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData();
    }

    private async Task CheckPermissionsAndLoadData()
    {
        isLoading = true;
        try
        {
            // 1. SECURITY / FEATURE CHECK from Firebase SSOT.
            var isModuleEnabled = await FirebaseShiftSchedules.IsShiftSchedulingEnabledAsync();
            var canView = await FirebaseShiftSchedules.CanEmployeeViewShiftsAsync();
            if (!isModuleEnabled || !canView)
            {
                isAccessDenied = true;
                isLoading = false;
                return;
            }

            isAccessDenied = false;

            // 2. Resolve the authenticated employee against the canonical
            // Firebase employee directory.
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var employeeId = int.TryParse(
                auth.User.FindFirst("employee_id")?.Value, out var claimedEmployeeId)
                ? claimedEmployeeId
                : 0;

            // Employee-scoped Firebase rules allow the authenticated employee
            // to read only their own employee record. Do not read the entire
            // employees collection and do not fall back to the legacy DB.
            var emp = await FirebaseShiftSchedules.GetEmployeeAsync(employeeId);

            if (emp == null)
            {
                shifts.Clear();
                defaultShift = null;
                return;
            }

            defaultShift = emp;
            var start = new DateOnly(selectedMonth.Year, selectedMonth.Month, 1);
            var end = start.AddMonths(1).AddDays(-1);

            daysInMonth.Clear();
            for (var dt = start; dt <= end; dt = dt.AddDays(1))
                daysInMonth.Add(dt);

            shifts = await FirebaseShiftSchedules.GetSchedulesAsync(emp.EmployeeID, start, end);
        }
        finally { isLoading = false; }
    }

    private async Task LoadShifts()
    {
        await CheckPermissionsAndLoadData();
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await CheckPermissionsAndLoadData();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}