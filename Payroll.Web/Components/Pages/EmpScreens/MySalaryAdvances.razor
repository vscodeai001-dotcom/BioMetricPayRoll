@page "/my-salary-advances"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@using Microsoft.AspNetCore.Components.Authorization

@inject FirebaseAdvanceService FirebaseAdvances
@inject ILogger<MySalaryAdvances> _logger
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IToastService toastService
@inject NavigationManager Navigation

@attribute [Authorize(Roles = "Employee, SuperAdmin")]

<PageTitle>My Salary Advances</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Salary Advance</strong> module is currently disabled or you do not have permission to view this page.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else
{
    <div class="page-header-container">
        <div class="d-flex align-items-center gap-3">
            <div class="emoji-icon-badge emoji-icon-badge-danger">
                💳
            </div>
            <div>
                <h2 class="page-header-title">
                    My Salary Advance Records
                </h2>
                <p class="page-header-subtitle">
                    <span>💸 Track emergency advances disbursed & automated payroll deductions</span>
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill px-3 py-2 fw-semibold border">
                <span>⚠️ Automatic Cycle Recovery</span>
            </span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted fw-semibold">Loading your advance history... 💳</p>
        </div>
    }
    else if (linkedEmployee == null)
    {
        <div class="alert alert-danger rounded-4 p-4 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Your user account is not linked to an employee profile. Please notify your administrator.
        </div>
    }
    else if (!advanceHistory.Any())
    {
        <div class="text-center p-5 bg-light rounded-4 border">
            <span class="fs-1 d-block mb-2">🎉</span>
            <p class="mb-0 text-muted fw-semibold">No salary advances recorded. You're all clear!</p>
        </div>
    }
    else
    {
        <div class="table-responsive-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>📅 Date Disbursed</th>
                            <th>🏷️ Advance Type</th>
                            <th class="text-end">💵 Amount</th>
                            <th>📌 Recovery Status</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var advance in advanceHistory.OrderByDescending(p => p.AdvanceDate))
                    {
                        <tr>
                            <td>@advance.AdvanceDate?.ToString("dd-MMM-yyyy")</td>
                            <td>@advance.AdvanceType</td>
                            <td class="text-end">@advance.Amount.ToString("C", inrCulture)</td>
                            <td>
                                @if (advance.PayrollID_Paid.HasValue)
                                {
                                    <span class="badge bg-success rounded-pill">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark rounded-pill">Unpaid</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
}

<AttendanceRefreshListener OnAdvanceChanged="HandleRealtimeRefresh" />

@code {
    private List<SalaryAdvance> advanceHistory = new();
    private bool isLoading = true;
    private bool isAccessDenied = false; // Security Flag
    private Employee? linkedEmployee;
    private System.Globalization.CultureInfo inrCulture = new System.Globalization.CultureInfo("en-IN");

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData(isSilent: false);
    }

    private async Task CheckPermissionsAndLoadData(bool isSilent = false)
    {
        if (!isSilent && (advanceHistory == null || !advanceHistory.Any()))
        {
            isLoading = true;
            await InvokeAsync(StateHasChanged);
        }
        try
        {
            // Firebase is the SSOT for the self-service gate.
            if (!await FirebaseAdvances.IsEnabledAsync() || !await FirebaseAdvances.CanEmployeeViewAsync())
            {
                isAccessDenied = true;
                isLoading = false;
                return;
            }

            // 2. Load Data (Only if authorized)
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                if (!int.TryParse(user.FindFirst("employee_id")?.Value, out var employeeId) || employeeId <= 0)
                {
                    linkedEmployee = null;
                }
                else
                {
                    if (linkedEmployee == null)
                    {
                        linkedEmployee = (await FirebaseAdvances.GetActiveEmployeesAsync())
                            .FirstOrDefault(e => e.EmployeeID == employeeId);
                    }
                    if (linkedEmployee != null)
                    {
                        var fresh = await FirebaseAdvances.GetAsync(employeeId);
                        advanceHistory = fresh;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading employee advance history.");
            if (!isSilent)
            {
                toastService.ShowError("An error occurred while loading your data.");
            }
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await CheckPermissionsAndLoadData(isSilent: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}