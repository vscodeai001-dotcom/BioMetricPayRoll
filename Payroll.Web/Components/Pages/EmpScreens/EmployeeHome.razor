@page "/employee-home"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Web.Components.UI.Leave
@using global::Payroll.Web.Components.UI.Attendance
@attribute [Authorize(Roles = "Employee, SuperAdmin")]

@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Employee Home</PageTitle>

<style>
    .app-tile {
        background: white;
        border: 1px solid #eee;
        border-radius: 16px;
        padding: 1rem;
        text-align: center;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        height: 100%;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    body.dark .app-tile {
        background: #1b222c;
        color: #f3f6fa;
        border-color: #3a4654;
        box-shadow: 0 10px 24px rgba(0,0,0,.22);
    }

    body.dark .app-tile .text-muted,
    body.dark .app-tile small {
        color: #b8c3d0 !important;
    }

        .app-tile:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
            border-color: #cce5ff;
        }

    .tile-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin: 0 auto .65rem auto;
    }

    .card-gradient-blue {
        background: linear-gradient(135deg, #0061ff 0%, #60efff 100%);
        color: white;
        border: none;
    }

    .card-gradient-purple {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
    }

    .employee-summary-card {
        min-height: 205px;
    }

    .employee-dashboard-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        align-items: start;
    }

    .employee-dashboard-summary {
        grid-column: 1;
        margin-bottom: 0 !important;
    }

    .employee-dashboard-quick {
        grid-column: 1;
        grid-row: auto;
    }

    .employee-dashboard-applications {
        grid-column: 1;
    }

</style>

<AuthorizeView>
    <Authorized>
        <div class="page-header-container">
            <div class="d-flex align-items-center gap-3">
                <div class="emoji-icon-badge emoji-icon-badge-lg emoji-icon-badge-primary">
                    👤
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h2 class="page-header-title">
                            Hello, @(linkedEmployee?.Name ?? context.User.Identity?.Name)! 👋
                        </h2>
                    </div>
                    <p class="page-header-subtitle">
                        <span>🏢 Employee Self-Service Portal</span> • <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1">@(linkedEmployee?.Role ?? "Team Member")</span>
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2">
                    <span class="pulse-indicator pulse-indicator-success"></span>
                    <span>📅 @DateTime.Now.ToString("dd MMMM yyyy")</span>
                </span>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">Loading your workspace... ⏱️</p>
    </div>
}
else
{
    <div class="employee-dashboard-layout">
    <div class="row g-4 align-items-start employee-overview-row employee-dashboard-summary">

        @* ============================================================
           1. SALARY CARD
           ============================================================ *@

        @if (featureSettings?.EnablePayroll == true &&
            featureSettings?.EmployeeCanViewPayslip == true)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card card-gradient-blue shadow-sm employee-summary-card rounded-4">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-uppercase small fw-bold opacity-75">
                                    💰 Current Salary
                                </span>
                                <span class="badge bg-white bg-opacity-25 rounded-pill px-2 py-1">Gross Wage</span>
                            </div>

                            @if (linkedEmployee != null)
                            {
                                <h2 class="fw-bold mb-0 mt-3">
                                    @linkedEmployee.MonthlySalary.ToString(
                                    "C0",
                                                new System.Globalization.CultureInfo("en-IN"))
                                </h2>

                                <small class="opacity-75">
                                    per Month • Direct Deposit 🏦
                                </small>
                            }
                        </div>

                        <div class="mt-4">
                            <a href="my-payslips"
                               class="btn btn-light text-primary fw-bold rounded-pill px-4 w-100 action-pill-btn justify-content-center">
                                <span>📄</span> View Payslips
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============================================================
           2. LEAVE BALANCES
           ============================================================ *@

        @if (featureSettings?.EnableLeaveManagement == true &&
            featureSettings?.EmployeeCanViewLeave == true)
        {
            <div class="col-md-6 col-xl-4">

                @if (linkedEmployee != null)
                {
                    <div class="card border-0 shadow-sm employee-summary-card rounded-4">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-secondary mb-0 d-flex align-items-center gap-2">
                                    <span>🏖️</span> Leave Balance
                                </h6>
                                <a href="my-leave-request" class="small text-decoration-none fw-semibold">Apply Off &rarr;</a>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-end mb-1">
                                    <span class="fw-bold text-primary small">
                                        🌴 Paid Leave
                                    </span>

                                    <span class="fw-bold">
                                        @linkedEmployee.PaidLeaveBalance <small class="text-muted fw-normal">days</small>
                                    </span>
                                </div>

                                <div class="progress rounded-pill" style="height: 8px;">
                                    <div class="progress-bar bg-primary"
                                         style="width: @(Math.Min(linkedEmployee.PaidLeaveBalance * 10, 100))%">
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between align-items-end mb-1">
                                    <span class="fw-bold text-success small">
                                        🤒 Sick Leave
                                    </span>

                                    <span class="fw-bold">
                                        @linkedEmployee.SickLeaveBalance <small class="text-muted fw-normal">days</small>
                                    </span>
                                </div>

                                <div class="progress rounded-pill" style="height: 8px;">
                                    <div class="progress-bar bg-success"
                                         style="width: @(Math.Min(linkedEmployee.SickLeaveBalance * 10, 100))%">
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm d-flex align-items-center justify-content-center bg-light rounded-4">
                        <span class="text-muted">
                            🏖️ Leave info unavailable
                        </span>
                    </div>
                }

            </div>
        }

        @* ============================================================
           3. QUICK ATTENDANCE
           ============================================================ *@

        @if (featureSettings?.EmployeeCanViewAttendance == true)
        {
            <div class="employee-dashboard-quick">

                @if (linkedEmployee != null)
                {
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-secondary mb-0 d-flex align-items-center gap-2">
                                    <span>⏱️</span> Quick Punch
                                </h6>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1">
                                    <span class="pulse-indicator pulse-indicator-success me-1"></span> Live GPS
                                </span>
                            </div>

                            <MobilePunchWidget EmployeeId="@linkedEmployee.EmployeeID" EmployeeName="@linkedEmployee.Name" />

                            <div class="mt-3 text-center">
                                <a href="my-attendance"
                                   class="small text-decoration-none fw-bold text-primary">
                                    <span>📋</span> View My Attendance Logs &rarr;
                                </a>
                            </div>

                        </div>
                    </div>
                }

            </div>
        }

    </div>

    @* ============================================================
       4. APPLICATION GRID
       ============================================================ *@

    <div class="employee-dashboard-applications">
    <h5 class="fw-bold text-secondary mb-3 d-flex align-items-center gap-2">
        <span>🚀</span> Self-Service Applications
    </h5>

    <div class="row g-3 row-cols-2 row-cols-md-3">

        @* Attendance *@
        @if (featureSettings?.EmployeeCanViewAttendance == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-attendance")'>
                    <div class="emoji-icon-badge emoji-icon-badge-success mb-2">
                        ⏱️
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Attendance
                    </h6>

                    <small class="text-muted">
                        Logs & History
                    </small>
                </div>
            </div>
        }

        @* Leave *@
        @if (featureSettings?.EnableLeaveManagement == true &&
            featureSettings?.EmployeeCanViewLeave == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-leave-request")'>
                    <div class="emoji-icon-badge emoji-icon-badge-warning mb-2">
                        🏖️
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Apply Leave
                    </h6>

                    <small class="text-muted">
                        Request Off
                    </small>
                </div>
            </div>
        }

        @* Payslips *@
        @if (featureSettings?.EnablePayroll == true &&
            featureSettings?.EmployeeCanViewPayslip == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-payslips")'>
                    <div class="emoji-icon-badge emoji-icon-badge-primary mb-2">
                        💵
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Payslips
                    </h6>

                    <small class="text-muted">
                        Download PDF
                    </small>
                </div>
            </div>
        }

        @* Shifts *@
        @if (featureSettings?.EnableShiftScheduling == true &&
            featureSettings?.EmployeeCanViewShifts == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-shifts")'>
                    <div class="emoji-icon-badge emoji-icon-badge-info mb-2">
                        🔄
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Roster
                    </h6>

                    <small class="text-muted">
                        My Shifts
                    </small>
                </div>
            </div>
        }

        @* Salary Advances *@
        @if (featureSettings?.EnableSalaryAdvance == true &&
            featureSettings?.EmployeeCanViewAdvance == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-salary-advances")'>
                    <div class="emoji-icon-badge emoji-icon-badge-danger mb-2">
                        💳
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Advances
                    </h6>

                    <small class="text-muted">
                        Request & Balance
                    </small>
                </div>
            </div>
        }

        @* Bonuses *@
        @if (featureSettings?.EnableBonusManagement == true &&
            featureSettings?.EmployeeCanViewBonus == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-bonuses")'>
                    <div class="emoji-icon-badge emoji-icon-badge-purple mb-2">
                        🎁
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Bonuses
                    </h6>

                    <small class="text-muted">
                        Incentive History
                    </small>
                </div>
            </div>
        }

        @* Tax *@
        @if (featureSettings?.EnableTaxDeclarations == true &&
            featureSettings?.EmployeeCanViewTax == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-tax-declaration")'>
                    <div class="emoji-icon-badge emoji-icon-badge-primary mb-2">
                        📝
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Tax Proofs
                    </h6>

                    <small class="text-muted">
                        80C Declarations
                    </small>
                </div>
            </div>
        }

        @* Regularization *@
        @if (featureSettings?.EnablePunchCorrection == true &&
            featureSettings?.EnableRegularizationRequest == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-regularization")'>
                    <div class="emoji-icon-badge emoji-icon-badge-warning mb-2">
                        🔧
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Correction
                    </h6>

                    <small class="text-muted">
                        Fix Missed Punch
                    </small>
                </div>
            </div>
        }

        @* Reports *@
        @if (featureSettings?.EnableCustomReporting == true &&
            featureSettings?.EmployeeCanViewReports == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-reports")'>
                    <div class="emoji-icon-badge emoji-icon-badge-info mb-2">
                        📊
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Reports
                    </h6>

                    <small class="text-muted">
                        My Stats & Trends
                    </small>
                </div>
            </div>
        }

        @* Resignation *@
        @if (featureSettings?.EnableResignationModule == true &&
            featureSettings?.EmployeeCanViewResignation == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-resignation")'>
                    <div class="emoji-icon-badge emoji-icon-badge-danger mb-2">
                        🚪
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Resignation
                    </h6>

                    <small class="text-muted">
                        Exit Clearance
                    </small>
                </div>
            </div>
        }

        @* Profile / Settings *@
        <div class="col">
            <div class="app-tile"
                 @onclick='() => Navigation.NavigateTo("my-profile")'>
                <div class="emoji-icon-badge emoji-icon-badge-purple mb-2">
                    👤
                </div>

                <h6 class="fw-bold text-dark mb-1">
                    My Profile
                </h6>

                <small class="text-muted">
                    Employment &amp; Account
                </small>
            </div>
        </div>

    </div>
    </div>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code
{
    private Employee? linkedEmployee;
    private bool isLoading = true;
    private FeatureSettings? featureSettings;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            var authState =
                await Auth.GetAuthenticationStateAsync();

            var user =
                authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                return;
            }

            var email =
                user.Identity.Name;

            if (string.IsNullOrWhiteSpace(email))
            {
                return;
            }

            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            // ----------------------------------------------------
            // Load feature settings
            // ----------------------------------------------------

            featureSettings =
                await dbContext.FeatureSettings
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        f => f.Id == 1);

            // ----------------------------------------------------
            // Load employee
            // ----------------------------------------------------

            linkedEmployee = await FirebaseEmployees.GetEmployeeByEmailAsync(email);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Employee Home loading failed: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}