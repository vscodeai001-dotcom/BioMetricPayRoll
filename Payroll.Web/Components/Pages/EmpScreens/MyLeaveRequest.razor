@page "/my-leave-request"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AttendanceRefreshService AttendanceRefresh
@inject NotificationService NotificationService
@inject ILogger<MyLeaveRequest> _logger
@inject IToastService toastService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject Payroll.Web.Services.FirebaseAttendanceCalendarMutationService FirebaseCalendar
@attribute [Authorize(Roles = "Employee")]

<PageTitle>Request Leave</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Leave Management</strong> module is currently disabled or you do not have permission to request leave.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else
{
    <div class="page-header-container">
        <div class="d-flex align-items-center gap-3">
            <div class="emoji-icon-badge emoji-icon-badge-warning">
                🏖️
            </div>
            <div>
                <h2 class="page-header-title">
                    Apply for Leave & Time-Off
                </h2>
                <p class="page-header-subtitle">
                    <span>🌴 Submit leave requests for manager approval & track status in real-time</span>
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold">
                🌴 Paid: @(linkedEmployee?.PaidLeaveBalance ?? 0) days
            </span>
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold">
                🤒 Sick: @(linkedEmployee?.SickLeaveBalance ?? 0) days
            </span>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <EditForm Model="newLeaveRequest" OnValidSubmit="SubmitLeaveRequest">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Start Date</label>
                        <InputDate class="form-control" @bind-Value="newLeaveRequest.LeaveDate" />
                        <ValidationMessage For="@(() => newLeaveRequest.LeaveDate)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">End Date (Optional)</label>
                        <InputDate class="form-control" @bind-Value="newLeaveRequest.EndDate" />
                        <ValidationMessage For="@(() => newLeaveRequest.EndDate)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Leave Type</label>
                        <InputSelect class="form-select" @bind-Value="newLeaveRequest.LeaveType">
                            <option value="">-- Select Type --</option>
                            <option value="Paid Leave">Paid Leave</option>
                            <option value="Sick Leave">Sick Leave</option>
                            <option value="Vacation">Vacation</option>
                            <option value="Other">Other (See Notes)</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newLeaveRequest.LeaveType)" />
                    </div>
                    <div class="col-md-4 d-flex align-items-center pt-4">
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" type="checkbox" role="switch" @bind-Value="newLeaveRequest.IsHalfDay" id="isHalfDayToggle" />
                            <label class="form-check-label" for="isHalfDayToggle">Request as Half-Day</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes / Reason</label>
                        <InputText class="form-control" @bind-Value="newLeaveRequest.Notes" placeholder="Please provide a reason, especially if 'Other'" />
                        <ValidationMessage For="@(() => newLeaveRequest.Notes)" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span> Submitting...</span>
                            }
                            else
                            {
                                <span class="bi bi-send"></span>
                                <span> Submit Request</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private LeaveRequest newLeaveRequest = new();
    private Employee? linkedEmployee;
    private bool isSubmitting = false;
    private bool isAccessDenied = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData();
    }

    private async Task CheckPermissionsAndLoadData()
    {
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();

            // 1. SECURITY CHECK
            var settings = await dbContext.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1);
            if (settings != null)
            {
                // Strict Hierarchy: EnableLeaveManagement (Parent) -> EmployeeCanViewLeave (Child)
                bool isModuleEnabled = settings.EnableLeaveManagement;
                bool canView = settings.EmployeeCanViewLeave;

                if (!isModuleEnabled || !canView)
                {
                    isAccessDenied = true;
                    return;
                }
            }

            // 2. Load Employee
            newLeaveRequest.LeaveDate = DateTime.Now.Date;
            await LoadLinkedEmployee(dbContext);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error initializing MyLeaveRequest.");
        }
    }

    private async Task LoadLinkedEmployee(AppDbContext dbContext)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userEmail = authState.User.Identity?.Name;

        if (userEmail != null)
        {
            linkedEmployee = await FirebaseEmployees.GetEmployeeByEmailAsync(userEmail);

            if (linkedEmployee == null)
            {
                toastService.ShowError("Your account is not linked to an employee record. Contact Admin.");
            }
        }
    }

    private async Task SubmitLeaveRequest()
    {
        if (linkedEmployee == null) return;

        if (string.IsNullOrEmpty(newLeaveRequest.LeaveType))
        {
            toastService.ShowWarning("Please select a leave type.");
            return;
        }

        DateTime startDate = newLeaveRequest.LeaveDate!.Value.Date;
        DateTime endDate = newLeaveRequest.EndDate?.Date ?? startDate;

        if (endDate < startDate)
        {
            toastService.ShowWarning("End Date cannot be before Start Date.");
            return;
        }

        isSubmitting = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            int successfullyAddedCount = 0;
            var firstLeaveDate = (DateTime?)null;
            var lastLeaveDate = (DateTime?)null;

            var addedEntries = new List<LeaveRequest>();
            for (DateTime day = startDate; day <= endDate; day = day.AddDays(1))
            {
                bool exists = await dbContext.LeaveRequests.AnyAsync(lr =>
                    lr.EmployeeID == linkedEmployee!.EmployeeID &&
                    lr.LeaveDate.HasValue &&
                    lr.LeaveDate!.Value.Date == day.Date);

                if (exists) continue;

                var newEntry = new LeaveRequest
                {
                    EmployeeID = linkedEmployee!.EmployeeID,
                    LeaveDate = day,
                    LeaveType = newLeaveRequest.LeaveType,
                    IsApproved = false,
                    Status = "Pending",
                    IsHalfDay = newLeaveRequest.IsHalfDay,
                    Notes = newLeaveRequest.Notes
                };
                dbContext.LeaveRequests.Add(newEntry);
                addedEntries.Add(newEntry);
                
                if (firstLeaveDate == null)
                    firstLeaveDate = day;
                lastLeaveDate = day;
                
                successfullyAddedCount++;
            }

            if (successfullyAddedCount > 0)
            {
                await dbContext.SaveChangesAsync();

                foreach (var entry in addedEntries)
                {
                    await FirebaseCalendar.UpsertLeaveAsync(entry, linkedEmployee.Name);
                }

                var leaveEmployee = await FirebaseEmployees.GetEmployeeAsync(linkedEmployee!.EmployeeID);
                if (leaveEmployee != null)
                {
                    await NotificationService.NotifyAdminsAsync(
                        "New Leave Request",
                        $"{leaveEmployee.Name} submitted {successfullyAddedCount} leave request(s) starting {firstLeaveDate:dd-MMM-yyyy}.",
                        "/leave-management");
                }

                // ================================================================
                // BROADCAST REAL-TIME LEAVE SUBMISSIONS TO ALL CONNECTED CLIENTS
                // Admin dashboard should refresh immediately to show pending requests
                // ================================================================
                try
                {
                    if (firstLeaveDate.HasValue)
                    {
                        await AttendanceRefresh.NotifyLeaveChangedAsync(
                            linkedEmployee!.EmployeeID,
                            firstLeaveDate,
                            "SUBMITTED");
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogWarning(
                        ex,
                        "Failed to broadcast leave submission for EmployeeId={EmployeeId}",
                        linkedEmployee!.EmployeeID);
                }
                
                toastService.ShowSuccess($"{successfullyAddedCount} leave request(s) submitted successfully!");
                Navigation.NavigateTo("/my-leave-history");
            }
            else
            {
                toastService.ShowError("No new requests were submitted (possible duplicates found).");
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error submitting leave request.");
            toastService.ShowError("An error occurred while submitting your request.");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}