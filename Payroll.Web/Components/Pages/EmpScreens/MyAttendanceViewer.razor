@page "/my-attendance"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Models
@using global::Payroll.Shared.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<MyAttendanceViewer> _logger
@inject IToastService toastService
@inject UserManager<IdentityUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject Payroll.Web.Services.FirebaseAttendanceService FirebaseAttendance
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Employee")]

<PageTitle>My Attendance</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>Attendance viewing is disabled or you do not have permission to access this page.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else
{
    <div class="page-header-container">
        <div class="d-flex align-items-center gap-3">
            <div class="emoji-icon-badge emoji-icon-badge-primary">
                ⏱️
            </div>
            <div>
                <h2 class="page-header-title">
                    My Attendance History
                </h2>
                <p class="page-header-subtitle">
                    <span>📊 Breakdown of your daily biometric & mobile punches, calculated hours & overtime</span>
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold border border-success border-opacity-25">
                <span class="pulse-indicator pulse-indicator-success me-1"></span> Verified Punch Logs
            </span>
        </div>
    </div>

    @* --- FILTER CONTROLS --- *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">📅 Start Date</label>
                    <input type="date" class="form-control rounded-3" @bind="startDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">📅 End Date</label>
                    <input type="date" class="form-control rounded-3" @bind="endDate" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary action-pill-btn w-100 justify-content-center" @onclick="LoadLogsAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span> Searching...</span>
                        }
                        else
                        {
                            <span>🔍</span> <span class="bi bi-search"></span>
                            <span> Search Records</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* --- CUMULATIVE SUMMARY BAR --- *@
    @if (!isLoading && cumulativeSummary != null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-header bg-primary text-white py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="fw-bold fs-6">
                    <span>📈</span> Cumulative Summary
                </span>
                <span class="badge bg-white text-primary rounded-pill px-3 py-1 fw-bold">
                    📅 @startDate?.ToString("dd-MMM") — @endDate?.ToString("dd-MMM-yyyy")
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3 text-center">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="text-muted small text-uppercase fw-bold d-block mb-1">⏰ Scheduled</span>
                            <h4 class="fw-bold text-info mb-0">@FormatTimeSpan(cumulativeSummary.TotalScheduledHours)</h4>
                            <small class="text-muted">Target Hours</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="text-muted small text-uppercase fw-bold d-block mb-1">✅ Worked</span>
                            <h4 class="fw-bold text-success mb-0">@FormatTimeScreen(cumulativeSummary.TotalWorkedHours)</h4>
                            <small class="text-muted">Actual Worked</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="text-muted small text-uppercase fw-bold d-block mb-1">📉 Penalty</span>
                            <h4 class="fw-bold text-danger mb-0">@FormatTimeSpan(cumulativeSummary.TotalOverallPenalty)</h4>
                            <small class="text-muted">Loss Hours</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 h-100">
                            <span class="text-muted small text-uppercase fw-bold d-block mb-1">⚡ Overtime</span>
                            <h4 class="fw-bold text-primary mb-0">@FormatTimeSpan(cumulativeSummary.TotalOvertime)</h4>
                            <small class="text-muted">Approved OT</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* --- DATA TABLE --- *@
    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted fw-semibold">Loading attendance records... ⏱️</p>
        </div>
    }
    else if (dailySummaries == null || !dailySummaries.Any())
    {
        <div class="text-center p-5 bg-light rounded-4 border">
            <span class="fs-1 d-block mb-2">⏱️</span>
            <p class="mb-0 text-muted fw-semibold">@statusMessage</p>
        </div>
    }
    else
    {
        <div class="table-responsive-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>📅 Date</th>
                            <th>📌 Status</th>
                            <th class="text-center">⏰ Scheduled</th>
                            <th class="text-center">✅ Worked</th>
                            <th class="text-center">📉 Penalty</th>
                            <th class="text-center">⚡ OT</th>
                            <th>📱 Raw Punches</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var record in dailySummaries.OrderByDescending(r => r.Date))
                    {
                        <tr>
                            <td>@record.Date.ToString("dd-MMM-yyyy (ddd)")</td>
                            <td>@record.Status</td>
                            <td class="text-center">@FormatTimeSpan(record.ScheduledShiftDuration)</td>
                            <td class="text-center" style="font-weight: bold;">@FormatTimeScreen(record.FinalWorkedHours)</td>
                            <td class="text-center">@FormatTimeSpan(record.TotalPenalty)</td>
                            <td class="text-center">@FormatTimeSpan(record.OvertimeDuration)</td>
                            <td>@record.Punches</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
}

<style>
    .employee-raw-punches {
        max-width: 18rem;
        overflow-x: auto;
        white-space: nowrap;
        scrollbar-width: thin;
        cursor: ew-resize;
    }

    .employee-raw-punches:focus,
    .employee-raw-punches:hover {
        outline: 1px solid rgba(13, 110, 253, .35);
        outline-offset: 1px;
        scroll-behavior: smooth;
    }
</style>

<AttendanceRefreshListener
    OnAttendanceChanged="LoadLogsAsync" />

@code {
    private List<DailyAttendanceRecord> dailySummaries = new();
    private CompanyCumulativeSummary? cumulativeSummary;
    private DateTime? startDate;
    private DateTime? endDate;
    private bool isLoading = false;
    private bool isAccessDenied = false;
    private string statusMessage = "Search for your attendance data.";
    private Employee? linkedEmployee;

    private class DailyAttendanceRecord
    {
        public DateOnly Date { get; set; }
        public string Status { get; set; } = "Absent";
        public TimeSpan ScheduledShiftDuration { get; set; }
        public TimeSpan TotalPenalty { get; set; }
        public TimeSpan OvertimeDuration { get; set; }
        public decimal FinalWorkedHours { get; set; }
        public string Punches { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData();
    }

    private async Task CheckPermissionsAndLoadData()
    {
        isLoading = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();

            // 1. SECURITY CHECK
            var settings = await dbContext.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1);
            if (settings != null)
            {
                // Strict Hierarchy: EnableEmployeeManagement (Core) AND EmployeeCanViewAttendance (Child)
                bool isModuleEnabled = settings.EnableEmployeeManagement;
                bool canView = settings.EmployeeCanViewAttendance;

                if (!isModuleEnabled || !canView)
                {
                    isAccessDenied = true;
                    isLoading = false;
                    return;
                }
            }

            // 2. Initialize Defaults
            var today = DateTime.Now.Date;
            startDate = new DateTime(today.Year, today.Month, 1);
            endDate = today;

            // 3. Load Data
            await LoadLinkedEmployee(dbContext);
            if (linkedEmployee != null)
            {
                await LoadLogsAsync();
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error initializing MyAttendanceViewer.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLinkedEmployee(AppDbContext dbContext)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userEmail = authState.User.Identity?.Name;

        if (userEmail != null)
        {
            linkedEmployee = await FirebaseEmployees.GetEmployeeByEmailAsync(userEmail);

            if (linkedEmployee == null)
            {
                statusMessage = "Your account is not linked to an employee record.";
            }
        }
    }

    private async Task LoadLogsAsync()
    {
        if (linkedEmployee == null) return;

        if (!startDate.HasValue || !endDate.HasValue || startDate.Value > endDate.Value)
        {
            toastService.ShowWarning("Please select a valid date range.");
            return;
        }

        isLoading = true;
        dailySummaries.Clear();
        cumulativeSummary = null;
        statusMessage = "Loading attendance data...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var emp = linkedEmployee!;
            var filterStartDate = DateOnly.FromDateTime(startDate.Value);
            var filterEndDate = DateOnly.FromDateTime(endDate.Value);
            var loadedSummaries = await FirebaseAttendance.GetDailySummariesAsync(
                emp.EmployeeID, filterStartDate, filterEndDate);

            if (!loadedSummaries.Any())
            {
                statusMessage = "No attendance records found for this period.";
                isLoading = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var relevantLogs = await FirebaseAttendance.GetAttendancePunchesAsync(
                emp.EmployeeID, filterStartDate, filterEndDate);

            var cumulative = new CompanyCumulativeSummary
            {
                TotalEmployeesProcessed = 1,
                EmployeeName = emp.Name
            };

            foreach (var ds in loadedSummaries)
            {
                var isWeeklyOffWorked = ds.Status == "Weekly Off (Worked)";
                decimal workedHours = isWeeklyOffWorked
                    ? (decimal)ds.TotalOvertimeDuration.TotalHours
                    : ds.EarnedStandardHours + (decimal)ds.TotalOvertimeDuration.TotalHours;
                cumulative.TotalScheduledHours += isWeeklyOffWorked
                    ? TimeSpan.Zero
                    : ds.ScheduledShiftDuration;
                cumulative.TotalWorkedHours += workedHours;
                cumulative.TotalOverallPenalty += ds.TotalPenaltyDuration;
                cumulative.TotalOvertime += ds.TotalOvertimeDuration;

                var punchesForDay = relevantLogs
                    .Where(l => l.PunchTime.Date == ds.ShiftDate.ToDateTime(TimeOnly.MinValue).Date)
                    .Select(l => l.PunchTime.ToString("HH:mm"));

                dailySummaries.Add(new DailyAttendanceRecord
                {
                    Date = ds.ShiftDate,
                    Status = ds.Status,
                    ScheduledShiftDuration = isWeeklyOffWorked
                        ? TimeSpan.Zero
                        : ds.ScheduledShiftDuration,
                    TotalPenalty = ds.TotalPenaltyDuration,
                    OvertimeDuration = ds.TotalOvertimeDuration,
                    FinalWorkedHours = workedHours,
                    Punches = string.Join(" / ", punchesForDay)
                });
            }

            cumulativeSummary = cumulative;
            statusMessage = "";
        }
        catch (Exception ex)
        {
            statusMessage = $"An error occurred: {ex.Message}";
            _logger.LogError(ex, "Error loading logs");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // --- Helper Formatting ---
    private string FormatTimeSpan(TimeSpan ts)
    {
        if (ts < TimeSpan.Zero) ts = TimeSpan.Zero;
        ts = TimeSpan.FromMinutes(Math.Round(ts.TotalMinutes));
        return $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}";
    }

    private string FormatTimeScreen(object? value)
    {
        if (value == null) return "00:00";
        if (value is decimal dec)
        {
            var ts = TimeSpan.FromHours((double)dec);
            ts = TimeSpan.FromMinutes(Math.Round(ts.TotalMinutes));
            return $"{(int)ts.TotalHours:D2}:{ts.Minutes:D2}";
        }
        return value.ToString() ?? "00:00";
    }
}