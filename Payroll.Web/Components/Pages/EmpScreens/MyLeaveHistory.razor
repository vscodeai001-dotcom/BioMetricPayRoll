@page "/my-leave-history"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<MyLeaveHistory> _logger
@inject UserManager<IdentityUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject IToastService toastService
@inject NavigationManager Navigation

@attribute [Authorize(Roles = "Employee, SuperAdmin")]

<PageTitle>My Leave History</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Leave Management</strong> module is currently disabled or you do not have permission to view leave history.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else
{
    <div class="page-header-container">
        <div class="d-flex align-items-center gap-3">
            <div class="emoji-icon-badge emoji-icon-badge-purple">
                🏖️
            </div>
            <div>
                <h2 class="page-header-title">
                    My Leave History & Time-Off
                </h2>
                <p class="page-header-subtitle">
                    <span>📅 Complete ledger of approved leaves, pending requests, half-days & Loss-of-Pay (LOP)</span>
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="/my-leave-request" class="action-pill-btn action-pill-btn-primary">
                <span>➕ Apply New Leave</span>
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted fw-semibold">Loading leave history... 🏖️</p>
        </div>
    }
    else if (linkedEmployee == null)
    {
        <div class="alert alert-danger shadow-sm rounded-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Your user account is not linked to an employee record. Cannot load data.
        </div>
    }
    else if (!leaveHistory.Any())
    {
        <div class="text-center p-5 bg-light rounded-4 border">
            <span class="fs-1 d-block mb-2">🏖️</span>
            <p class="mb-0 text-muted fw-semibold">No leave records found. You haven't taken any leaves yet!</p>
        </div>
    }
    else
    {
        <div class="table-responsive-card">
            <div class="table-responsive leave-history-table">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>📅 Leave Date</th>
                            <th>🏷️ Leave Type</th>
                            <th>🌓 Half Day?</th>
                            <th>📌 Status</th>
                            <th>📝 Notes & Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in leaveHistory.OrderByDescending(p => p.LeaveDate))
                        {
                            <tr class="@(leave.LeaveType == "Loss of Pay (Auto)" ? "auto-lop-row" : "")">
                                <td>@leave.LeaveDate?.ToString("dd-MMM-yyyy")</td>
                                <td>@leave.LeaveType</td>
                                <td>@(leave.IsHalfDay ? "Yes" : "No")</td>
                                <td>
                                    @if (leave.LeaveType == "Loss of Pay (Auto)")
                                    {
                                        <span class="badge bg-danger rounded-pill">Auto LOP</span>
                                    }
                                    else if (leave.IsApproved)
                                    {
                                        <span class="badge bg-success rounded-pill">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill">Pending</span>
                                    }
                                </td>
                                <td>@leave.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<AttendanceRefreshListener OnLeaveChanged="HandleRealtimeRefresh" />

@code {
    private List<LeaveRequest> leaveHistory = new();
    private bool isLoading = true;
    private bool isAccessDenied = false;
    private Employee? linkedEmployee;

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData(isSilent: false);
    }

    private async Task CheckPermissionsAndLoadData(bool isSilent = false)
    {
        if (!isSilent && (leaveHistory == null || !leaveHistory.Any()))
        {
            isLoading = true;
            await InvokeAsync(StateHasChanged);
        }
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();

            // 1. SECURITY CHECK: Load Feature Flags
            var settings = await dbContext.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1);
            if (settings != null)
            {
                // Strict Hierarchy Check: Parent (Leave) AND Child (View Leave)
                bool isModuleEnabled = settings.EnableLeaveManagement;
                bool canView = settings.EmployeeCanViewLeave;

                if (!isModuleEnabled || !canView)
                {
                    isAccessDenied = true;
                    isLoading = false;
                    return;
                }
            }

            // 2. Load Data
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                if (linkedEmployee == null)
                {
                    var email = user.Identity.Name;
                    linkedEmployee = await FirebaseEmployees.GetEmployeeByEmailAsync(email);
                }

                if (linkedEmployee != null)
                {
                    var fresh = await dbContext.LeaveRequests
                        .Where(p => p.EmployeeID == linkedEmployee.EmployeeID)
                        .OrderByDescending(p => p.LeaveDate)
                        .ToListAsync();
                    leaveHistory = fresh;
                }
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading employee leave history.");
            if (!isSilent)
            {
                toastService.ShowError("An error occurred while loading your data.");
            }
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await CheckPermissionsAndLoadData(isSilent: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}