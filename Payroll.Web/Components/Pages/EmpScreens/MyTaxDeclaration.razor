@page "/my-tax-declaration"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject TaxDeclarationService TaxService
@inject NotificationService NotificationService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject IToastService toastService
@inject NavigationManager Nav
@attribute [Authorize(Roles = "Employee, SuperAdmin")]

<PageTitle>My Tax Declaration</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Tax Declaration</strong> module is currently disabled or you do not have permission to view this page.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center h-100">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="d-flex flex-column h-100">
        @* --- HEADER --- *@
        <div class="page-header-container mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="emoji-icon-badge emoji-icon-badge-success">
                    📑
                </div>
                <div>
                    <h2 class="page-header-title">
                        Income Tax Declaration (ITD)
                    </h2>
                    <p class="page-header-subtitle">
                        <span>⚖️ FY @currentYear - @(currentYear + 1) • Select Regime & Declare Investments</span>
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (declaration.Status == "Approved")
                {
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fw-semibold border border-success border-opacity-25">
                        <span class="pulse-indicator pulse-indicator-success me-1"></span> 🔒 Locked & Approved
                    </span>
                }
                else if (declaration.Status == "Pending")
                {
                    <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill px-3 py-2 fw-semibold border border-warning border-opacity-25">
                        ⏳ Submitted for Review
                    </span>
                }
                else
                {
                    <button class="action-pill-btn action-pill-btn-success" @onclick="SubmitDeclaration" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <span>🚀 Submit Declaration</span>
                    </button>
                }
            </div>
        </div>

        @* --- MAIN CONTENT (Scrollable) --- *@
        <div class="flex-grow-1 overflow-hidden">
            <div class="row h-100 g-0">

                @* LEFT: REGIME SELECTION *@
                <div class="col-md-4 h-100 overflow-auto pe-2">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light fw-bold">1. Select Tax Regime</div>
                        <div class="card-body">
                            <div class="d-grid gap-3">
                                <label class="card p-3 border-2 cursor-pointer @(declaration.Regime == "New" ? "border-success bg-success-subtle" : "border-light")" @onclick='() => SetRegime("New")'>
                                    <div class="d-flex justify-content-between">
                                        <strong>New Regime (Default)</strong>
                                        @if (declaration.Regime == "New")
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                    </div>
                                    <small class="text-muted mt-2">Lower tax rates, but <strong>NO deductions</strong> allowed (except Std Ded).</small>
                                </label>

                                <label class="card p-3 border-2 cursor-pointer @(declaration.Regime == "Old" ? "border-primary bg-primary-subtle" : "border-light")" @onclick='() => SetRegime("Old")'>
                                    <div class="d-flex justify-content-between">
                                        <strong>Old Regime</strong>
                                        @if (declaration.Regime == "Old")
                                        {
                                            <i class="bi bi-check-circle-fill text-primary"></i>
                                        }
                                    </div>
                                    <small class="text-muted mt-2">Higher rates, but allows <strong>80C, HRA, 80D</strong> exemptions.</small>
                                </label>
                            </div>

                            @if (declaration.Status == "Rejected")
                            {
                                <div class="alert alert-danger mt-4">
                                    <strong><i class="bi bi-exclamation-octagon me-2"></i>Rejected by Admin</strong>
                                    <p class="small mb-0 mt-1">Remarks: @declaration.AdminRemarks</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* RIGHT: DEDUCTIONS FORM *@
                <div class="col-md-8 h-100 overflow-auto ps-2">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-light fw-bold d-flex justify-content-between">
                            <span>2. Declare Investments</span>
                            <span class="badge bg-secondary">Old Regime Only</span>
                        </div>
                        <div class="card-body">
                            <fieldset disabled="@(declaration.Regime == "New" || declaration.Status == "Approved" || declaration.Status == "Pending")">

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">80C Investments (Max 1.5L)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input type="number" class="form-control" @bind="declaration.Section80C" placeholder="PF, LIC, PPF..." />
                                        </div>
                                        <div class="form-text small">Provident Fund, Life Insurance, ELSS, etc.</div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">80D Medical Insurance</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input type="number" class="form-control" @bind="declaration.Section80D" />
                                        </div>
                                        <div class="form-text small">Health insurance premiums for self/parents.</div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">HRA (Rent Paid Yearly)</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input type="number" class="form-control" @bind="declaration.HraRentPaid" />
                                        </div>
                                        <div class="form-text small">Actual rent paid per annum. Upload receipts later.</div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Other Exemptions</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₹</span>
                                            <input type="number" class="form-control" @bind="declaration.OtherExemptions" />
                                        </div>
                                        <div class="form-text small">LTA, NPS (80CCD), etc.</div>
                                    </div>
                                </div>

                                @if (declaration.Regime == "New")
                                {
                                    <div class="alert alert-info mt-4 d-flex align-items-center">
                                        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                                        <div>
                                            <strong>You selected the New Regime.</strong><br />
                                            Deductions are not applicable. You will be taxed at lower slab rates on your gross income (minus Standard Deduction).
                                        </div>
                                    </div>
                                }
                            </fieldset>
                        </div>
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Total Declared Deductions:</span>
                                <h5 class="mb-0 text-success fw-bold">₹ @TotalDeductions.ToString("N2")</h5>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code {
    private bool isLoading = true;
    private bool isAccessDenied = false;
    private bool isSaving = false;
    private int currentYear = DateTime.Now.Month > 3 ? DateTime.Now.Year : DateTime.Now.Year - 1;
    private TaxDeclaration declaration = new();
    private Employee? employee;
    private decimal TotalDeductions => declaration.Regime == "New" ? 0 : (declaration.Section80C + declaration.Section80D + declaration.HraRentPaid + declaration.OtherExemptions);

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData();
    }

    private async Task CheckPermissionsAndLoadData()
    {
        isLoading = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();

            // 1. SECURITY CHECK
            var settings = await dbContext.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(f => f.Id == 1);
            if (settings != null)
            {
                // Strict Hierarchy: EnableTaxDeclarations (Parent) -> EmployeeCanViewTax (Child)
                bool isModuleEnabled = settings.EnableTaxDeclarations;
                bool canView = settings.EmployeeCanViewTax;

                if (!isModuleEnabled || !canView)
                {
                    isAccessDenied = true;
                    isLoading = false;
                    return;
                }
            }

            // 2. Get Employee
            var authState = await AuthState.GetAuthenticationStateAsync();
            var email = authState.User.Identity?.Name;
            if (email == null) return;

            employee = await FirebaseEmployees.GetEmployeeByEmailAsync(email);
            if (employee == null) return;

            // 3. Get or Create Declaration
            declaration = await TaxService.GetOrCreateDeclarationAsync(employee.EmployeeID, currentYear);
        }
        catch (Exception)
        {
            toastService.ShowError("Error loading data.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetRegime(string regime)
    {
        if (declaration.Status == "Approved" || declaration.Status == "Pending") return;
        declaration.Regime = regime;
        if (regime == "New")
        {
            // Clear values visually
            declaration.Section80C = 0;
            declaration.Section80D = 0;
            declaration.HraRentPaid = 0;
            declaration.OtherExemptions = 0;
        }
    }

    private async Task SubmitDeclaration()
    {
        isSaving = true;
        try
        {
            await TaxService.SubmitAsync(declaration);
            await NotificationService.NotifyAdminsAsync(
                "New Tax Declaration",
                $"{employee?.Name ?? "Employee"} submitted a tax declaration for FY {currentYear}-{currentYear + 1}.",
                "/admin/tax-declarations");
            toastService.ShowSuccess("Tax declaration submitted for approval.");
            await CheckPermissionsAndLoadData(); // Refresh status
        }
        catch (Exception ex)
        {
            toastService.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await CheckPermissionsAndLoadData();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}