@page "/my-bonuses"
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject FirebaseBonusService FirebaseBonuses
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IToastService toastService
@attribute [Authorize(Roles = "Employee, SuperAdmin")]

<PageTitle>My Bonuses</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Bonus Management</strong> module is currently disabled or you do not have permission to view bonuses.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else
{
    <div class="page-header-container">
        <div class="d-flex align-items-center gap-3">
            <div class="emoji-icon-badge emoji-icon-badge-warning">
                🎁
            </div>
            <div>
                <h2 class="page-header-title">
                    My Bonuses & Incentives
                </h2>
                <p class="page-header-subtitle">
                    <span>⭐ History of performance bonuses, festival incentives, and ex-gratia payouts</span>
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning bg-opacity-10 text-dark rounded-pill px-3 py-2 fw-semibold border border-warning border-opacity-25">
                <span>💰 Verified Payroll Disbursed</span>
            </span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted fw-semibold">Loading bonus records... 🎁</p>
        </div>
    }
    else if (bonuses == null || !bonuses.Any())
    {
        <div class="text-center p-5 bg-light rounded-4 border">
            <span class="fs-1 d-block mb-2">🎁</span>
            <p class="mb-0 text-muted fw-semibold">No bonus records found. Keep up the great work!</p>
        </div>
    }
    else
    {
        <div class="table-responsive-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>📅 Disbursed Date</th>
                            <th>📝 Description & Purpose</th>
                            <th class="text-end">💵 Bonus Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in bonuses)
                        {
                            <tr>
                                <td>@b.BonusDate.ToString("dd-MMM-yyyy")</td>
                                <td>@b.Description</td>
                                <td class="text-end fw-bold text-success">@b.Amount.ToString("C", new System.Globalization.CultureInfo("en-IN"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<AttendanceRefreshListener OnBonusChanged="HandleRealtimeRefresh" />

@code {
    private List<BonusRecord>? bonuses;
    private bool isLoading = true;
    private bool isAccessDenied = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData(isSilent: false);
    }

    private async Task CheckPermissionsAndLoadData(bool isSilent = false)
    {
        if (!isSilent && bonuses == null)
        {
            isLoading = true;
            await InvokeAsync(StateHasChanged);
        }
        try
        {
            if (!await FirebaseBonuses.IsEnabledAsync() || !await FirebaseBonuses.CanEmployeeViewAsync())
            {
                isAccessDenied = true;
                isLoading = false;
                return;
            }

            var auth = await AuthState.GetAuthenticationStateAsync();
            var claim = auth.User.FindFirst("employee_id")?.Value;
            if (!int.TryParse(claim, out var employeeId) || employeeId <= 0)
            {
                isAccessDenied = true;
                isLoading = false;
                return;
            }

            var fresh = await FirebaseBonuses.GetAsync(employeeId);
            bonuses = fresh;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Bonus load failed: {ex.Message}");
            if (bonuses == null) bonuses = new List<BonusRecord>();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await CheckPermissionsAndLoadData(isSilent: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}