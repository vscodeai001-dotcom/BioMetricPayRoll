@page "/my-regularization"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<AppDbContext> DbFactory
@inject RegularizationService RegularizationService
@inject AuthenticationStateProvider AuthState
@inject IToastService toastService
@attribute [Authorize(Roles = "Employee, SuperAdmin")]

<PageTitle>Punch Regularization</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Punch Correction</strong> module is currently disabled or you do not have permission to request regularization.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else if (isLoading)
{
    <p><em>Loading data...</em></p>
}
else if (linkedEmployee == null)
{
    <div class="alert alert-danger">Employee record not linked.</div>
}
else
{
    <div class="container-fluid d-flex flex-column h-100">
        <h3 class="text-primary fw-bold mb-3 flex-shrink-0">Request Punch Correction</h3>
        <p class="text-muted small mb-4 flex-shrink-0">
            Missing punches from the current month are detected automatically. Select one on the right to pre-fill this request, or enter a manual correction.
        </p>

        <div class="row g-4 flex-grow-1 overflow-auto">
            @* --- LEFT: SUBMISSION FORM --- *@
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span>New Request</span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="ResetForm">New Manual Request</button>
                    </div>
                    <div class="card-body">
                        <EditForm Model="formModel" OnValidSubmit="SubmitRequest">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label fw-bold">Date of Missed Punch</label>
                                <InputDate @bind-Value="formModel.DateOfPunch" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                <ValidationMessage For="@(() => formModel.DateOfPunch)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Punch Type Missed</label>
                                <InputSelect @bind-Value="formModel.PunchTypeString" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="IN">IN Punch (Check-in)</option>
                                    <option value="OUT">OUT Punch (Check-out)</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => formModel.PunchTypeString)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Claimed Time</label>
                                <InputText @bind-Value="formModel.PunchTimeNew" type="time" class="form-control" required />
                                <ValidationMessage For="@(() => formModel.PunchTimeNew)" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">Reason</label>
                                <InputTextArea @bind-Value="formModel.Reason" rows="3" class="form-control" placeholder="E.g., Forgot ID card, Client meeting ran late, etc." required />
                                <ValidationMessage For="@(() => formModel.Reason)" />
                            </div>

                            <button type="submit" class="btn btn-success w-100" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Submit for Approval
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>

            @* --- RIGHT: MISSING PUNCHES + REQUEST STATUS --- *@
            <div class="col-md-6">
                <div class="card shadow-sm h-100 d-flex flex-column">
                    <div class="card-header regularization-missing-header fw-bold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-exclamation-circle me-1"></i>Missing Punches</span>
                        <span class="badge bg-warning text-dark">Current Month</span>
                    </div>
                    <div class="card-body p-0 overflow-auto">
                        @if (!missingPunches.Any())
                        {
                            <div class="p-3 text-center text-success">
                                <i class="bi bi-check-circle me-1"></i>No historical missing punches detected this month.
                                <div class="small text-muted mt-1">Days with zero punches are treated as Absent, not as a punch correction.</div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="sticky-top regularization-table-head">
                                        <tr>
                                            <th>Date</th>
                                            <th>Existing Punches</th>
                                            <th>Missing</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in missingPunches)
                                        {
                                            var existing = GetLatestRequest(item);
                                            <tr>
                                                <td class="fw-bold text-nowrap">@item.Date.ToString("dd-MMM")</td>
                                                <td class="small text-muted">@item.PunchSummary</td>
                                                <td><span class="badge @(item.MissingType == "IN" ? "bg-info" : "bg-warning text-dark")">@item.MissingType</span></td>
                                                <td class="text-center text-nowrap">
                                                    @if (existing == null)
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartCorrection(item)">Request</button>
                                                    }
                                                    else if (existing.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    }
                                                    else if (existing.Status == "Approved")
                                                    {
                                                        <span class="badge bg-success">Approved</span>
                                                    }
                                                    else if (RegularizationService.CanResubmit(existing))
                                                    {
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartCorrection(item)">Request Again</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Rejected</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="border-top px-3 py-2 regularization-requests-section">
                            <div class="fw-bold small mb-2">My Requests</div>
                            <table class="table table-sm table-striped table-hover regularization-requests-table mb-0">
                                <thead>
                                    <tr><th>Date</th><th>Type</th><th>Time</th><th>Status</th><th>Admin Remarks</th></tr>
                                </thead>
                                <tbody>
                                    @if (!myRequests.Any())
                                    {
                                        <tr><td colspan="5" class="text-center text-muted">No requests found.</td></tr>
                                    }
                                    @foreach (var req in myRequests)
                                    {
                                        <tr title="@RegularizationService.GetDisplayAdminRemarks(req.AdminRemarks)">
                                            <td>@req.DateOfPunch.ToString("dd-MMM")</td>
                                            <td>@(req.IsInPunch ? "IN" : "OUT")</td>
                                            <td>@req.PunchTimeNew.ToString("HH:mm")</td>
                                            <td><span class="badge @GetBadge(req.Status)">@req.Status</span></td>
                                            <td class="small text-muted">@GetRemarks(req)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<AttendanceRefreshListener
    OnRegularizationChanged="LoadData"
    OnAttendanceChanged="LoadData" />

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isAccessDenied = false;
    private Employee? linkedEmployee;
    private List<AttendanceRegularization> myRequests = new();
    private List<MissingPunchItem> missingPunches = new();
    private RegularizationFormModel formModel = new() { DateOfPunch = DateTime.Now.Date.AddDays(-1), PunchTimeNew = "09:00" };

    private sealed class MissingPunchItem
    {
        public DateOnly Date { get; init; }
        public string MissingType { get; init; } = "OUT";
        public string PunchSummary { get; init; } = "";
    }

    public class RegularizationFormModel
    {
        [Required] public DateTime DateOfPunch { get; set; }
        [Required] public string PunchTimeNew { get; set; } = "09:00";
        [Required(ErrorMessage = "Select IN or OUT.")] public string? PunchTypeString { get; set; }
        [Required, StringLength(250)] public string Reason { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var settings = await db.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1);
            if (settings != null)
            {
                if (!settings.EnablePunchCorrection || !settings.EnableRegularizationRequest)
                {
                    isAccessDenied = true;
                    isLoading = false;
                    return;
                }
            }

            var auth = await AuthState.GetAuthenticationStateAsync();
            var email = auth.User.Identity?.Name;
            linkedEmployee = await db.Employees.FirstOrDefaultAsync(e => e.Email == email);
            if (linkedEmployee != null)
            {
                var now = DateTime.Now;
                var monthStart = new DateOnly(now.Year, now.Month, 1);
                var today = DateOnly.FromDateTime(now);

                myRequests = await db.AttendanceRegularizations
                    .Where(r => r.EmployeeId == linkedEmployee.EmployeeID)
                    .OrderByDescending(r => r.SubmissionDate)
                    .Take(50)
                    .ToListAsync();

                var logs = await db.AttendanceLogs.AsNoTracking()
                    .Where(l => l.EmployeeID == linkedEmployee.EmployeeID &&
                                l.PunchTime.Date >= monthStart.ToDateTime(TimeOnly.MinValue).Date &&
                                l.PunchTime.Date <= today.ToDateTime(TimeOnly.MaxValue).Date)
                    .OrderBy(l => l.PunchTime)
                    .ThenBy(l => l.LogID)
                    .ToListAsync();

                missingPunches = logs
                    .GroupBy(l => DateOnly.FromDateTime(l.PunchTime))
                    .Where(g => g.Key < today && g.Count() % 2 != 0)
                    .OrderByDescending(g => g.Key)
                    .Select(g =>
                    {
                        var lastType = g.OrderBy(x => x.PunchTime).ThenBy(x => x.LogID).LastOrDefault()?.LogType?.ToUpperInvariant();
                        var missing = lastType == "IN" ? "OUT" : lastType == "OUT" ? "IN" : (g.Count() % 2 == 1 ? "OUT" : "IN");
                        return new MissingPunchItem
                        {
                            Date = g.Key,
                            MissingType = missing,
                            PunchSummary = string.Join(", ", g.OrderBy(x => x.PunchTime).ThenBy(x => x.LogID).Select(x => x.PunchTime.ToString("HH:mm")))
                        };
                    })
                    .ToList();
            }
        }
        finally { isLoading = false; }
    }

    private AttendanceRegularization? GetLatestRequest(MissingPunchItem item)
    {
        var isIn = item.MissingType == "IN";
        return myRequests
            .Where(r => r.DateOfPunch == item.Date && r.IsInPunch == isIn)
            .OrderByDescending(r => r.SubmissionDate)
            .ThenByDescending(r => r.RegularizationId)
            .FirstOrDefault();
    }

    private void StartCorrection(MissingPunchItem item)
    {
        formModel = new RegularizationFormModel
        {
            DateOfPunch = item.Date.ToDateTime(TimeOnly.MinValue),
            PunchTypeString = item.MissingType,
            PunchTimeNew = "09:00",
            Reason = ""
        };
        toastService.ShowSuccess($"{item.Date:dd-MMM-yyyy} {item.MissingType} selected. Enter the claimed time and reason.");
    }

    private void ResetForm()
    {
        formModel = new RegularizationFormModel
        {
            DateOfPunch = DateTime.Now.Date.AddDays(-1),
            PunchTimeNew = "09:00",
            PunchTypeString = null,
            Reason = ""
        };
    }

    private async Task SubmitRequest()
    {
        if (linkedEmployee == null || string.IsNullOrEmpty(formModel.PunchTypeString)) return;
        isSaving = true;

        try
        {
            TimeOnly claimedTime = TimeOnly.Parse(formModel.PunchTimeNew);
            bool isInPunch = formModel.PunchTypeString == "IN";
            await RegularizationService.SubmitRequestAsync(
                linkedEmployee.EmployeeID,
                DateOnly.FromDateTime(formModel.DateOfPunch),
                claimedTime,
                formModel.Reason,
                isInPunch);

            toastService.ShowSuccess("Request submitted. Awaiting approval.");
            ResetForm();
            await LoadData();
        }
        catch (Exception ex)
        {
            toastService.ShowError(ex.Message);
        }
        finally { isSaving = false; }
    }

    private string GetRemarks(AttendanceRegularization req)
    {
        var remarks = RegularizationService.GetDisplayAdminRemarks(req.AdminRemarks);
        return string.IsNullOrWhiteSpace(remarks) ? "-" : remarks;
    }

    private string GetBadge(string status) => status switch
    {
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-warning text-dark"
    };
}
